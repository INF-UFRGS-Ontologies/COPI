SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StorageProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/MaterialEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StorageProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/MaterialEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> (basin)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "basin"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "A basin is a vessel that is designed to store liquid or solid material, characterized by being typically open at the top and installed partly or totally below grade."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "Uma bacia é um vaso projetado para armazenar material líquido ou sólido, caracterizado por ser tipicamente aberto no topo e instalado parcial ou totalmente abaixo do nível do solo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "Every basin is a vessel that bears a storage function and has an open top configuration and is installed partly below grade."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "Basin(x) ↔ Vessel(x) ∧ ∃f(StorageFunction(f) ∧ bearerOf(x,f)) ∧ ∃p(OpenTop(p) ∧ hasGeometricProperty(x,p)) ∧ ∃q(PartlyBelowGrade(q) ∧ hasInstallationProperty(x,q))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "[ISO 15926-4] A <BASIN> is a <FLUID CONTAINER>, intended to store liquid or solid material partly or totally below grade and that is typically open"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "[CFIHOS] A container intended to store liquid or solid material partly or totally below grade and that is typically open."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "[SLB Glossary] A depression in the crust of the Earth, caused by plate tectonic activity and subsidence, in which sediments accumulate."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> "[OnePetro] A large area with a general containment and an often thick accumulation of rock. A sedimentary basin is an area of regional settling that can be characterized in space, time, and sedimentary fill .It is a physical depression at the earth's surface which accumulates and preserves sediments. The scale of basins varies greatly, from ocean basins to small ponds.\n        \n        ==References==\n        \n         Helwig, J. A. 1985. Origin and Classification of Sedimentary Basins. Offshore Technology Conference. http://www.doi.org/doi:10.4043/4843-MS"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/StorageFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000321>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000214> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SupportFunction> (support function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SupportFunction> "support function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SupportFunction> "A bearing is a material artifact that is designed to support and locate moving or static mechanical elements while reducing friction in the connection."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SupportFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SupportFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SupportingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SupportFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SupportingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SupportingProcess> (supporting process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SupportingProcess> "supporting process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SupportingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SupportingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalSupport>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> (bearing)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> "bearing"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> "A bearing is a material artifact that is designed to support and locate moving or static mechanical elements while reducing friction in the connection."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> "Um mancal é um artefato material que é projetado para suportar e localizar elementos mecânicos móveis ou estáticos enquanto reduz o atrito na conexão."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> "[ISO 15926-4] A <BEARING> is a <SUPPORT> intended to support and locate a moving or static element"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> "[CFIHOS] A physical object intended to support and locate a moving or static element and capable of reducing friction and transfer forces in a connection."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SupportFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000215> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionFunction> (drilling fluid conduction function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionFunction> "drilling fluid conduction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionFunction> "A bell nipple is a pipe that conducts drilling fluids in drilling operations and is characterized by an enlarged diameter that serves as a funnel and a location at the wellhead assembly."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess> (drilling fluid conduction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess> "drilling fluid conduction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/DrillingTool>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/DrillingTool>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> (bell nipple)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "bell nipple"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "A bell nipple is a pipe that conducts drilling fluids in drilling operations and is characterized by an enlarged diameter that serves as a funnel and a location at the wellhead assembly."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "Um bell nipple é um tubo que conduz fluidos de perfuração em operações de perfuração e é caracterizado por um diâmetro alargado que serve como funil e uma localização no conjunto da cabeça do poço."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "Every bell nipple is a pipe that bears a DrillingFluidConductionFunction and has an enlarged diameter shape and is located at a wellhead assembly."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "∀x(BellNipple(x) ↔ (Pipe(x) ∧ ∃f(DrillingFluidConductionFunction(f) ∧ bearerOf(x,f)) ∧ ∃s(EnlargedDiameter(s) ∧ hasCharacteristicShape(x,s)) ∧ ∃l(WellheadAssembly(l) ∧ hasLocation(x,l))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "[ISO 15926-4] A <BELL NIPPLE> is an <ARTEFACT> and a large diameter <PIPING NETWORK SEGMENT> fitted to the top of the blowout preventers that the flow line attaches to via a side outlet, to allow the drilling fluid to flow back over the shale shakers to the mud tanks. Also an enlarged pipe at the top of a casing string that serves as a funnel to guide drilling tools into the top of a well"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "[CFIHOS] A Bell nipple is a section of large diameter pipe fitted to the top of the blowout preventers that the flow line attaches to via a side outlet, to allow the drilling fluid to flow back over the shale shakers to the mud tanks. Also an enlarged pipe at the top of a casing string that serves as a funnel to guide drilling tools into the top of a well."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "[SLB Glossary] An enlarged pipe at the top of a casing string that serves as a funnel to guide drilling tools into the top of a well."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> "[OnePetro] A funnel shaped pipe at the top of the casing that guides tool string entry and may have a side port for fluid pumping."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000321> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/DrillingFluidConductionFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/SideOutlet>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SideOutlet> "side outlet"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SideOutlet> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000216> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)
