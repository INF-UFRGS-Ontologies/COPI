SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> (transformer)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> "transformer"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> "A transformer is an electrical equipment that transforms electrical power from one circuit to another at the same frequency through electromagnetic induction using windings and a magnetic core."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> "Um transformador é um equipamento elétrico que transforma energia elétrica de um circuito para outro na mesma frequência através de indução eletromagnética usando enrolamentos e um núcleo magnético."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> "[ISO 15926-4] A <TRANSFORMER> is an <ELECTRIC TO ELECTRIC ENERGY CONVERTER> that is capable of <TRANSFORMING> power from one circuit to another without changing frequency and works on the principle of mutual induction"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> "[CFIHOS] A transformer that, by electromagnetic induction, transforms a system of alternating voltage and current into another system of voltage and current usually of different values and at the same frequency for the purpose of transmitting electrical power."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> "[POSC Caesar] A physical object that transforms continuous currents from one voltage to another, or continuous into alternating currents or vice versa."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> (process controlled flow function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> "process controlled flow function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> "A control valve is a valve that modulates flow rate in response to external control signals by means of an actuator-driven closure element."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> (process controlled flow process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> "process controlled flow process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/ControlSignal>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> (control valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "control valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "A control valve is a valve that modulates flow rate in response to external control signals by means of an actuator-driven closure element."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "Uma válvula de controle é uma válvula que modula a vazão em resposta a sinais de controle externos por meio de um elemento de fechamento acionado por atuador."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "[ISO 15926-4] A <CONTROL VALVE> is a <VALVE> and an <FINAL CONTROL FUNCTION>, operated by an <ACTUATOR> that can be used to modify the fluid flow rate in response to a signal from a <CONTROLLER>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "[CFIHOS] A valve that can be used to modify (regulate) the fluid flow rate in a process control system. It usually includes an actuator, which responds to a signal from the controlling system and changes the position of the flow controlling element in the valve."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "[SLB Glossary] A valve that controls a process variable, such as pressure, flow or temperature, by modulating its opening in response to a signal from a controller."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "[ISA 5.1] a device, other than a common, hand-actuated process block valve or self-actuated check valve, that directly manipulates the flow of one or more fluid process streams."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "[OnePetro] Modulating valve that controls either the flow rate, liquid level, or pressure in process equipment. In the latter case, it is often referred to as a (pressure) regulator. \n        \n        (Note - Typically, high pressure gas from the pipeline is used as the supply medium needed to energize the valve actuator.) https://www.ipieca.org/resources/methane-emissions-glossary"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> "[POSC Caesar] A valve that can be used to modify (regulate)  the fluid flow rate in a process control system. It usually includes an actuator, which responds to a signal from the controlling system and changes the position of the flow controlling element in the valve."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> <https://spec.industrialontologies.org/ontology/construct/Assembly>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentFunction> (pressure containment function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentFunction> "pressure containment function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentFunction> "A pressure vessel is a vessel that bears a pressure containment function, designed to safely withstand internal and/or external pressure loads."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentFunction> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentProcess> (pressure containment process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentProcess> "pressure containment process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> (pressure vessel)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> "pressure vessel"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> "A pressure vessel is a vessel that bears a pressure containment function, designed to safely withstand internal and/or external pressure loads."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> "Um vaso de pressão é um vaso que possui uma função de contenção sob pressão, projetado para suportar com segurança cargas de pressão internas e/ou externas."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> "Every pressure vessel is a vessel that has a pressure containment function, and every vessel with a pressure containment function is a pressure vessel."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> "∀x (PressureVessel(x) ↔ (Vessel(x) ∧ ∃f (PressureContainmentFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> "[POSC Caesar] A vessel intended to withstand external and/or internal pressure"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PressureContainmentFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction> (instrumentation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction> "instrumentation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction> "An instrument is a material artifact that has the designed function to perform measurement, monitoring, or control of process variables."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationProcess> (instrumentation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationProcess> "instrumentation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/MeasurementInformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> (instrument)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> "instrument"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> "An instrument is a material artifact that has the designed function to perform measurement, monitoring, or control of process variables."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> "Um instrumento é um artefato material que tem a função projetada de realizar medição, monitoramento ou controle de variáveis de processo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> "Every instrument is a material artifact that has an instrumentation function, and every material artifact that has an instrumentation function is an instrument."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> "∀x(Instrument(x) ↔ (Assembly(x) ∧ ∃f(InstrumentationFunction(f) ∧ hasFunction(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> "[ISA 5.1] a device used for direct or indirect measurement, monitoring, and/or control of a variable, including primary elements, indicators, controllers, final control elements, computing devices, and electrical devices such as annunciators, switches, and pushbuttons."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> (heat transfer function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> "heat transfer function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> "A heat exchanger is a pressure vessel that bears the designed function of transferring thermal energy between two or more fluid streams while maintaining their separation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> (heat transfer process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> "heat transfer process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> (heat exchanger)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> "heat exchanger"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> "A heat exchanger is a pressure vessel that bears the designed function of transferring thermal energy between two or more fluid streams while maintaining their separation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> "Um trocador de calor é um vaso de pressão que possui a função projetada de transferir energia térmica entre duas ou mais correntes de fluido mantendo sua separação."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> "Every heat exchanger is an assembly that has the function of heat transfer and has component parts including heat transfer surfaces and fluid passages for separated streams."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> "∀x (HeatExchanger(x) ↔ (Assembly(x) ∧ ∃f(HeatTransferFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> "[ISO 15926-4] A <HEAT EXCHANGER> is an <EXCHANGER> that has the capability of <HEAT EXCHANGING>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> "[CFIHOS] A physical object that is intended to transfer heat from one object to another."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000090> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "An angle valve is a valve that has valve ports which are not in-line but arranged at an angle to each other."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> (angle valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "angle valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "An angle valve is a valve that has valve ports which are not in-line but arranged at an angle to each other."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "Uma válvula angular é uma válvula que tem portas da válvula que não estão alinhadas, mas dispostas em ângulo uma em relação à outra."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "Every angle valve is a valve that has a non-inline port arrangement."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "∀x (AngleValve(x) → Valve(x) ∧ ∃p (hasPart(x,p) ∧ NonInlinePortArrangement(p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "Constructive type defined by geometric configuration. Under OWA, sufficient conditions for non-inline port arrangement could lead to false positives where complex multi-port manifolds or specialized valves with angular components get incorrectly classified as standard angle valves."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "[ISO 15926-4] An <ANGLE VALVE> is an <ARTEFACT> and a <VALVE> that has valve ports which are not in-line"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> "[SLB Glossary] A variation of the globe valve in which the end connections are at right angles to each other, rather than being in line."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000093> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> (process controlled flow function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> "process controlled flow function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> "A ball control valve is a control valve that uses a spherical ball closure element with rotary actuation to modulate fluid flow in response to control signals."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> (process controlled flow process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> "process controlled flow process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> (ball control valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "ball control valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "A ball control valve is a control valve that uses a spherical ball closure element with rotary actuation to modulate fluid flow in response to control signals."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "Uma válvula de controle esférica é uma válvula de controle que usa um elemento de fechamento esférico com atuação rotativa para modular o fluxo de fluido em resposta a sinais de controle."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "BallControlValve SubClassOf ControlValve and hasComponentPartAtAllTimes some BallClosure and hasComponentPartAtAllTimes some RotaryActuator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "∀x(BallControlValve(x) → ControlValve(x) ∧ ∃b(BallClosure(b) ∧ hasComponentPartAtAllTimes(x,b)) ∧ ∃a(RotaryActuator(a) ∧ hasComponentPartAtAllTimes(x,a)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "Using necessary conditions for this constructive subtype. While the ball closure mechanism is structurally distinctive, declaring equivalence could force classification of complex multi-way valves or specialized manifolds containing ball elements as standard ball control valves, which may not align with industrial maintenance categories."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "[ISO 15926-4] A <BALL CONTROL VALVE> is an <INSTRUMENTATION ITEM> and a <CONTROL VALVE> and a <BALL VALVE>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> "[CFIHOS] A ball valve that is equipped with an actuator that manipulates a stream of fluid in the response to a signal from an external sensing element and with input of energy from an external source."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000119>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000122>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A ball valve is a valve that controls fluid flow using a spherical ball closure member that rotates approximately 90 degrees to align or misalign its flow passage with the valve body ports."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> (ball valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "ball valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "A ball valve is a valve that controls fluid flow using a spherical ball closure member that rotates approximately 90 degrees to align or misalign its flow passage with the valve body ports."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "Uma válvula esfera é uma válvula que controla o fluxo de fluidos usando um elemento de fechamento esférico que gira aproximadamente 90 graus para alinhar ou desalinhar sua passagem de fluxo com as portas do corpo da válvula."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "Every ball valve is a valve that has a ball closure component and participates in rotational motion processes"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "∀x(BallValve(x) → Valve(x) ∧ ∃y(BallClosure(y) ∧ hasComponentPartAtAllTimes(x,y)) ∧ ∃z(RotationalMotionProcess(z) ∧ participatesIn(x,z)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "As a constructive type defined by physical mechanism, sufficient conditions are omitted to avoid false positives under Open World Assumption. Complex multi-way valves or specialized equipment containing ball mechanisms should not be automatically classified as standard ball valves without domain expert validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "[ISO 15926-4] A <BALL VALVE> is a <ROTARY VALVE> which uses a hollow, perforated or pivoting ball, of either \"floating\" design or \"trunnion\" mounted design to provide fluid flow control. The open position is when the ball hole is in line with the flow and closed when it is pivoted 90-degrees by the stem operator"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "[CFIHOS] A rotary valve that has a ball closure member."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "[SLB Glossary] A valve using a spherical closure element (ball) which is rotated through 90° to open and close the valve."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "[OnePetro] Any of several valves that rotate a ball with a flow passage to allow or deny flow."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> "[POSC Caesar] A rotary valve that has a ball closure member."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000120>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A block and bleed valve is a valve that has one seat which provides a seal, and a bleeder line and valve that are tapped into the valve bonnet for controlled venting of downstream pressure."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> (block and bleed valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "block and bleed valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "A block and bleed valve is a valve that has one seat which provides a seal, and a bleeder line and valve that are tapped into the valve bonnet for controlled venting of downstream pressure."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "Uma válvula de bloqueio e sangria é uma válvula que possui um assento que fornece vedação, e uma linha de sangria e válvula que são conectadas ao castelo da válvula para ventilação controlada da pressão a jusante."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "Every block and bleed valve is a valve that has component parts: exactly one seat, a bleeder line, and a bleeder valve integrated into the bonnet."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "∀x(BlockAndBleedValve(x) → Valve(x) ∧ ∃s(SingleSeat(s) ∧ hasComponentPartAtAllTimes(x,s)) ∧ ∃l(BleederLine(l) ∧ hasComponentPartAtAllTimes(x,l)) ∧ ∃v(BleederValve(v) ∧ hasComponentPartAtAllTimes(x,v)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "Constructive types require necessary conditions only due to Open World Assumption. The structural differentia (single seat + bleeder system) could theoretically be present in specialized equipment that should not be classified as a standard block and bleed valve without domain expert validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "[ISO 15926-4] A <BLOCK AND BLEED VALVE> is a <BLOCK VALVE> and a <BLEED VALVE> that has one seat which provides a seal, and a bleeder line and valve that are tapped into the block valves bonnet"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> "[CFIHOS] A valve that has one seat which provides a seal, and a bleeder line and valve that are tapped into the block valve's bonnet."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000096> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationFunction> (rapid depressurization function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationFunction> "rapid depressurization function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationFunction> "A blow down valve is a valve that bears a designed function for rapid depressurization of high pressure systems."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationProcess> (rapid depressurization process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationProcess> "rapid depressurization process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> (blow down valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> "blow down valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> "A blow down valve is a valve that bears a designed function for rapid depressurization of high pressure systems."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> "Uma válvula de blow down é uma válvula que possui uma função projetada para despressurização rápida de sistemas de alta pressão."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> "Every blow down valve is a valve that has the function of rapid depressurization."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> "∀x (BlowDownValve(x) ↔ Valve(x) ∧ ∃f (RapidDepressurizationFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> "[ISO 15926-4] A <BLOW DOWN VALVE is an <ARTEFACT> and a <VALVE> that can be used for rapid depressurizing of a high pressure system"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> "[CFIHOS] A valve that can be used for rapid depressurizing of a high pressure system."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000097> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/RapidDepressurizationFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> (compression function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> "compression function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> "A blower is a compressor that compresses and supplies air or gas at medium pressure and medium volume flow."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> (compression process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> "compression process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> (blower)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "blower"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "A blower is a compressor that compresses and supplies air or gas at medium pressure and medium volume flow."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "Um soprador é um compressor que comprime e fornece ar ou gás em pressão média e vazão volumétrica média."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "Every blower is a compressor that has the function of compressing gas and operates at medium pressure and medium volume flow ranges."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "∀x (Blower(x) ↔ (Compressor(x) ∧ ∃f,p,v (CompressionFunction(f) ∧ bearerOf(x,f) ∧ MediumPressureRange(p) ∧ MediumVolumeFlowRange(v) ∧ hasOperatingParameter(x,p) ∧ hasOperatingParameter(x,v))))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "[ISO 15926-4] A <BLOWER> is a <FunctionalObject> that is capable of <BLOWING> a medium volume flow"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "[CFIHOS] A physical object intended to compress and supply air or gas at medium pressure and medium volume flow."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> "[POSC Caesar] A physical object intended to compress and supply air or gas at medium pressure and medium volume flow."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000098> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000115>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> (process controlled flow function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> "process controlled flow function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> "A butterfly control valve is a control valve that has a rotating disc closure mechanism and bears a process-controlled flow function enabling automated flow modulation in response to external control signals."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> (process controlled flow process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> "process controlled flow process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> (butterfly control valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "butterfly control valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "A butterfly control valve is a control valve that has a rotating disc closure mechanism and bears a process-controlled flow function enabling automated flow modulation in response to external control signals."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "Uma válvula borboleta de controle é uma válvula de controle que possui um mecanismo de fechamento por disco rotativo e possui uma função de fluxo controlado por processo, permitindo modulação automatizada do fluxo em resposta a sinais de controle externos."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "Every butterfly control valve is a valve that has-component-part-at-all-times some rotating disc and has-component-part-at-all-times some actuator and bearer-of some process-controlled flow function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "∀x(ButterflyControlValve(x) → Valve(x) ∧ ∃d(RotatingDisc(d) ∧ hasComponentPartAtAllTimes(x,d)) ∧ ∃a(Actuator(a) ∧ hasComponentPartAtAllTimes(x,a)) ∧ ∃f(ProcessControlledFlowFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "This is a constructive type that combines two existing differentia (butterfly mechanism + control function). Under OWA, providing sufficient conditions could lead to false positives where any valve with both a rotating disc and control capability would be classified as this specific type, even if it has additional specialized features or hybrid mechanisms."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "[ISO 15926-4] A <BUTTERFLY CONTROL VALVE> is an <INSTRUMENTATION ITEM> and a <CONTROL VALVE> and a <BUTTERFLY VALVE>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> "[CFIHOS] A butterfly valve that is equipped with an actuator that manipulates a stream of fluid in the response to a signal from an external sensing element and with input of energy from an external source."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000094>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000119>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000099> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000122>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A butterfly valve is a valve that has a disc-type closure member with a shaft parallel to the plane of the disc and an axis of rotation transverse to the flow direction."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> (butterfly valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "butterfly valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "A butterfly valve is a valve that has a disc-type closure member with a shaft parallel to the plane of the disc and an axis of rotation transverse to the flow direction."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "Uma válvula borboleta é uma válvula que possui um membro de fechamento tipo disco com haste paralela ao plano do disco e eixo de rotação transversal à direção do fluxo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "Every butterfly valve is a valve that has a disc-type closure member and has a transverse rotation axis."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "∀x (ButterflyValve(x) → Valve(x) ∧ ∃y(DiscTypeClosure(y) ∧ hasComponentPartAtAllTimes(x,y)) ∧ ∃z(TransverseRotationAxis(z) ∧ hasComponentPartAtAllTimes(x,z)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "This is a constructive classification based on physical mechanism. Under the Open World Assumption, any artifact with a disc-type closure and transverse rotation axis would be forced into the ButterflyValve class, including specialized hybrid equipment or custom manifolds containing butterfly mechanisms that should not be classified as standard butterfly valves for maintenance purposes."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "[ISO 15926-4] A <BUTTERFLY VALVE> is a <ROTARY VALVE> that has a closure member of a disc type with a shaft parallel, or near parallel, to the plane of the disc, with an axis of rotation transverse to the flow direction"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "[CFIHOS] A rotary valve that has a closure member of a disc type with a shaft parallel, or near parallel, to the plane of the disc, with an axis of rotation transverse to the flow direction."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "[SLB Glossary] A short face-to-face valve that has a movable vane in the center of the flow stream, which rotates 90° as the butterfly valve opens and closes."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "[OnePetro] A quick opening, low pressure valve, common on large openings through which solids will move, that allows high flow rate when open."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> "[POSC Caesar] A rotary valve that has a closure member of a disc type with a shaft parallel, or near parallel, to the plane of the disc, with an axis of rotation transverse to the flow direction."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000120>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000123>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> (compression function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> "compression function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> "A centrifugal compressor is a compressor that uses one or more centrifugal impellers to accelerate gas through radial flow and generate pressure increase by centrifugal action."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> (compression process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> "compression process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CompressionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> (centrifugal compressor)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "centrifugal compressor"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "A centrifugal compressor is a compressor that uses one or more centrifugal impellers to accelerate gas through radial flow and generate pressure increase by centrifugal action."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "Um compressor centrífugo é um compressor que usa um ou mais impelidores centrífugos para acelerar o gás através de fluxo radial e gerar aumento de pressão por ação centrífuga."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "Every centrifugal compressor is a compressor that has component part at all times some centrifugal impeller and participates in some radial flow pattern."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "∀x (CentrifugalCompressor(x) → Compressor(x) ∧ ∃i(CentrifugalImpeller(i) ∧ hasComponentPartAtAllTimes(x,i)) ∧ ∃p(RadialFlowPattern(p) ∧ participatesIn(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "Using necessary conditions for this constructive type because under OWA, any equipment with a centrifugal impeller could be incorrectly classified as a standard centrifugal compressor, including specialized hybrid equipment or multi-stage systems that contain centrifugal elements but should not be forced into this maintenance category. Domain expert validation needed to confirm structural differentia is sufficient."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "[ISO 15926-4] A <CENTRIFUGAL COMPRESSOR> is an <ARTEFACT> and a <COMPRESSOR> in which one ore more impellers accelerate the gas and where the main flow through the impeller is radial, and generates pressure increase by means of centrifugal action and a volute or diffuser casing."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "[CFIHOS] A dynamic compressor in which one ore more impellers accelerate the gas and where the main flow through the impeller is radial."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> "[POSC Caesar] A dynamic compressor in which one ore more impellers accelerate the gas and where the main flow through the impeller is radial."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/CompressionFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> (pumping function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> "pumping function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> "A centrifugal pump is a pump that uses centrifugal force generated by rotating impellers with vanes to increase fluid pressure through a volute casing."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> (pumping process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> "pumping process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> (centrifugal pump)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "centrifugal pump"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "A centrifugal pump is a pump that uses centrifugal force generated by rotating impellers with vanes to increase fluid pressure through a volute casing."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "Uma bomba centrífuga é uma bomba que usa força centrífuga gerada por impulsores rotativos com pás para aumentar a pressão do fluido através de uma carcaça voluta."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "Every centrifugal pump is a pump that has a centrifugal impeller as component part at all times and has a volute casing as component part at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "∀x(CentrifugalPump(x) → Pump(x) ∧ ∃y(CentrifugalImpeller(y) ∧ hasComponentPartAtAllTimes(x,y)) ∧ ∃z(VoluteCasing(z) ∧ hasComponentPartAtAllTimes(x,z)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "Constructive classification based on physical mechanism. Under Open World Assumption, any equipment with centrifugal impellers and volute casing could be inferred as a standard centrifugal pump, potentially misclassifying specialized hybrid equipment or complex pump systems that contain centrifugal stages but serve different operational roles."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "[ISO 15926-4] A <CENTRIFUGAL PUMP> is an <ARTEFACT> and a <PUMP> in which centrifugal force imparted by impeller is convered to pressure in the volute casing. NOTE - Combine with either  BARE PUMP or PUMP SYSTEM,"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "[CFIHOS] A dynamic pump that contains impellers provided with vanes to generate centrifugal force to achieve the required pressure head."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "[SLB Glossary] A type of pump commonly used in the handling and mixing of oilfield fluids."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "[OnePetro] Pump with an impeller or rotor that spins in a housing and the drag forces on the fluids cause them to flow."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> "[POSC Caesar] A dynamic pump utilizing impellers provided with vanes generating centrifugal force to achieve the required pressure head."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000331>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> (backflow prevention function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "backflow prevention function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "A check valve is a valve that bears a backflow prevention function, automatically permitting fluid to flow in one direction only while preventing reverse flow."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> (backflow prevention process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> "backflow prevention process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> (check valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "check valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "A check valve is a valve that bears a backflow prevention function, automatically permitting fluid to flow in one direction only while preventing reverse flow."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "Uma válvula de retenção é uma válvula que possui uma função de prevenção de refluxo, permitindo automaticamente que o fluido flua em apenas uma direção enquanto previne o fluxo reverso."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "Every check valve is a valve that has the function to prevent backflow and automatically allow unidirectional fluid flow."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "∀x(CheckValve(x) ↔ Valve(x) ∧ ∃f(BackflowPreventionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "[ISO 15926-4] A <CHECK VALVE> is a <VALVE> that permits fluid to flow in one direction only"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "[CFIHOS] A valve that permits fluid to flow in one direction only."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "[SLB Glossary] A mechanical device that permits fluid to flow or pressure to act in one direction only."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "[OnePetro] A valve that only allows flow in one direction."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> "[POSC Caesar] A valve that permits fluid to flow in one direction only."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction>)))

