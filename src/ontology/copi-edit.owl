AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725> "filter medium"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725> "A material artifact that is a permeable material used in a filtration device, through which filtrate passes and on which the filter cake is deposited."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725> "Um artefato material que é um material permeável usado em um dispositivo de filtração, através do qual passa o filtrado e sobre o qual se deposita a torta de filtração."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725> "The medium is a component of the filter, not a filter; the distinction rests on parthood, which is not a sufficient condition."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725> "[SLB Glossary] A permeable material used in a filtration device through which filtrate passes and on which the filter cake is deposited."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SelectivePermeabilityFunction>))

