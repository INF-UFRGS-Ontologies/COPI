AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferFunction> "A material artifact that is a tube extended with one or more fins to increase its outer surface area, bearing an extended-surface heat transfer function."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferProcess> (extended surface heat transfer process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferProcess> "extended surface heat transfer process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferMedium>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferMedium>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> (finned tube)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> "finned tube"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> "A material artifact that is a tube extended with one or more fins to increase its outer surface area, bearing an extended-surface heat transfer function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> "Um artefato material que é um tubo estendido com uma ou mais aletas para aumentar sua área de superfície externa, possuindo uma função de transferência de calor por superfície estendida."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> "The differentia is structural (presence of fins), so under OWA it cannot be a sufficient condition."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> "[ISO 15926-4] A <FINNED TUBE> is a <TUBE> that is extended with one or more fins to increase its outer surface area"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ExtendedSurfaceHeatTransferFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction> (gas detection function)

