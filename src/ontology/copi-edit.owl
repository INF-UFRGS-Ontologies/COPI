SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingProcess> <https://www.inf.ufrgs.br/ontologies/copi/HeatingProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/HeatingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FuelPortion>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/CombustionProduct>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> (furnace)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> "furnace"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> "A furnace is a heater that bears the function to induce chemical reactions in process fluids through heating."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> "Um forno é um aquecedor que possui a função de induzir reações químicas em fluidos de processo através do aquecimento."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> "Every furnace is a heater that has the function to induce reactions in process fluids by heating them."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> "∀x(Furnace(x) ↔ Heater(x) ∧ ∃f(ReactiveHeatingFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> "[ISO 15926-4] A <FURNACE> is a <HEATER> that is intended to induce a reaction in a process fluid by heating it"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> "[CFIHOS] A physical object that is intended to induce a reaction in a process fluid by heating it."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000124> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000217>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/OvercurrentProtectionByFusingFunction> (overcurrent protection by fusing function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/OvercurrentProtectionByFusingFunction> "overcurrent protection by fusing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/OvercurrentProtectionByFusingFunction> "A fuse is an electrical equipment that protects circuits by interrupting current flow through the intentional melting of a fusible element when current exceeds specified values for a sufficient duration."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/OvercurrentProtectionByFusingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/OvercurrentProtectionByFusingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CurrentInterruptionByFusing>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/OvercurrentProtectionByFusingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CurrentInterruptionByFusing>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CurrentInterruptionByFusing> (current interruption by fusing)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CurrentInterruptionByFusing> "current interruption by fusing"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CurrentInterruptionByFusing> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> (fuse)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> "fuse"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> "A fuse is an electrical equipment that protects circuits by interrupting current flow through the intentional melting of a fusible element when current exceeds specified values for a sufficient duration."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> "Um fusível é um equipamento elétrico que protege circuitos interrompendo o fluxo de corrente através do derretimento intencional de um elemento fusível quando a corrente excede valores especificados por uma duração suficiente."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> "[ISO 15926-4] A <FUSE> is an <ARTEFACT> and a <PROTECTOR> and an <ELECTRICAL ELEMENT> that opens the circuit in which it is inserted by breaking the current when this exceeds a given value for a sufficient time"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> "[CFIHOS] A physical object that by the fusing of one or more of its specially designed and proportioned components, opens the circuit in which it is inserted by breaking the current when this exceeds a given value for a sufficient time."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> "[POSC Caesar] A physical object that by the fusing of one or more of its specially designed and proportioned components, opens the circuit in which it is inserted by breaking the current when this exceeds a given value for a sufficient time."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/OvercurrentProtectionByFusingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000338>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> (separation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> "separation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> "A gas cyclone separator is a separator that separates solid particles or liquid droplets from gas using centrifugal force generated by cyclonic flow geometry."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> (separation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> "separation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> (gas cyclone separator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> "gas cyclone separator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> "A gas cyclone separator is a separator that separates solid particles or liquid droplets from gas using centrifugal force generated by cyclonic flow geometry."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> "Um separador ciclônico de gás é um separador que separa partículas sólidas ou gotículas líquidas do gás usando força centrífuga gerada pela geometria de fluxo ciclônico."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> "Every gas cyclone separator is a separator that has a cyclonic flow chamber as component part and participates in centrifugal separation processes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> "∀x (GasCycloneSeparator(x) → Separator(x) ∧ ∃y(CyclonicFlowChamber(y) ∧ hasComponentPartAtAllTimes(x,y)) ∧ ∃z(CentrifugalSeparationProcess(z) ∧ participatesIn(x,z)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> "Constructive type defined by cyclonic mechanism. Under Open World Assumption, any device with cyclonic flow chamber could be falsely classified as gas cyclone separator, including specialized multi-stage cyclones or hybrid separator designs that should not be forced into this standard maintenance category."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> "[CFIHOS] A static device generating centrifugal force from an incoming flow which separates solid or liquids from a gas of a different density."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000283> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction> (gas detection function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction> "gas detection function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction> "A gas detector is a detector that has the designed function to sense the presence of a specified concentration of a gas."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction> <https://www.inf.ufrgs.br/ontologies/copi/DetectionFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/DetectionFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DetectionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess> (gas detection process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess> "gas detection process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess> <https://www.inf.ufrgs.br/ontologies/copi/DetectionProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/DetectionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DetectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> (gas detector)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> "gas detector"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> "A gas detector is a detector that has the designed function to sense the presence of a specified concentration of a gas."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> "Um detector de gás é um detector que tem a função projetada de detectar a presença de uma concentração especificada de um gás."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> "Every gas detector is a detector that bears a GasDetectionFunction and has a GasDetectingMeasuringElement as component part at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> "∀x(GasDetector(x) ↔ (Detector(x) ∧ ∃f(GasDetectionFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> "[ISO 15926-4] A <GAS DETECTOR> is a <DETECTOR> and a <GAS DETECTING INSTRUMENT> using a <GAS DETECTING MEASURING ELEMENT> that is intended to sense the presence of a specified concentration of a gas"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> "[CFIHOS] A detector that is intended to sense the presence of a specified concentration of a gas."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> "[POSC Caesar] A detector that is intended to sense the presence of a specified concentration of a gas."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000284> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000246> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> (mechanical energy generation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> "mechanical energy generation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> "A gas engine is an engine that uses gaseous fuel as input, employs a spark ignition system, and operates with a reciprocating piston mechanism to generate mechanical energy."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> (mechanical energy generation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> "mechanical energy generation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FuelPortion>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfAir>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/ExhaustGas>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> (gas engine)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "gas engine"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "A gas engine is an engine that uses gaseous fuel as input, employs a spark ignition system, and operates with a reciprocating piston mechanism to generate mechanical energy."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "Um motor a gás é um motor que usa combustível gasoso como entrada, emprega um sistema de ignição por centelha e opera com um mecanismo de pistão alternativo para gerar energia mecânica."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "Every gas engine is an engine that has gaseous fuel portion as input and has spark ignition system as component part at all times and has reciprocating piston mechanism as component part at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "∀x(GasEngine(x) → Engine(x) ∧ ∃f,s,r(FuelPortion(f) ∧ SparkIgnitionSystem(s) ∧ ReciprocatingPistonMechanism(r) ∧ hasInput(x,f) ∧ hasComponentPartAtAllTimes(x,s) ∧ hasComponentPartAtAllTimes(x,r)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "Gas engine is defined by constructive characteristics (gaseous fuel, spark ignition, reciprocating mechanism) rather than a unique function. Under Open World Assumption, making these conditions sufficient could lead to false positives where complex hybrid engines or experimental designs with these features are automatically classified as standard gas engines when they might require different maintenance/operational categories."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "[ISO 15926-4] A <GAS ENGINE> is an <INTERNAL COMBUSTION ENGINE> and a <RECIPROCATING PISTON ENGINE> in which gaseous fuel is mixed with air to form a combustible mixture in a cylinder which is fired by spark ignition"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "[CFIHOS] An internal combustion engine that is a reciprocating engine in which gaseous fuel is mixed with air to form a combustible mixture in a cylinder which is fired by spark ignition."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> "[POSC Caesar] An internal combustion engine that is a reciprocating engine in which gaseous fuel is mixed with air to form a combustible mixture in a cylinder which is fired by spark ignition."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000264>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000285> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationFunction> (turbomachinery power generation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationFunction> "turbomachinery power generation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationFunction> "A gas turbine is a turbine that has an integrated compressor and combustion chamber, designed to compress ambient air, mix it with fuel for combustion, and expand the resulting hot gases through a turbine section to generate mechanical power."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationProcess> (turbomachinery power generation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationProcess> "turbomachinery power generation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfAir>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FuelPortion>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/ExhaustGas>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286> (gas turbine)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286> "gas turbine"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286> "A gas turbine is a turbine that has an integrated compressor and combustion chamber, designed to compress ambient air, mix it with fuel for combustion, and expand the resulting hot gases through a turbine section to generate mechanical power."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286> "Uma turbina a gás é uma turbina que possui um compressor e câmara de combustão integrados, projetada para comprimir ar ambiente, misturá-lo com combustível para combustão, e expandir os gases quentes resultantes através de uma seção de turbina para gerar energia mecânica."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286> "[ISO 15926-4] A <GAS TURBINE> is a <TURBINE> that compresses air which is then mixed with fuel for combustion and expansion through a turbine section to generate relatively high power output for either mechanical drive or power generation"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286> "[CFIHOS] A turbine that compresses air which is then mixed with fuel for combustion and expansion through a turbine section to generate relatively high power output for either mechanical drive or power generation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286> "[POSC Caesar] A turbine that compresses air which is then mixed with fuel for combustion and expansion through a turbine section to generate relatively high power output for either mechanical drive or power generation."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TurbomachineryPowerGenerationFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/TurbineSection>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TurbineSection> "turbine section"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TurbineSection> <https://spec.industrialontologies.org/ontology/construct/Assembly>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> (sealing function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> "sealing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> "A gasket is a material artifact made of deformable material arranged in closed loops that bears a sealing function to prevent leakage between mating surfaces with limited relative movement."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SealingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SealingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SealingProcess> (sealing process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SealingProcess> "sealing process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/MatingSurface>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/SealedJoint>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> (gasket)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "gasket"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "A gasket is a material artifact made of deformable material arranged in closed loops that bears a sealing function to prevent leakage between mating surfaces with limited relative movement."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "Uma junta é um artefato material feito de material deformável arranjado em loops fechados que possui uma função de vedação para prevenir vazamentos entre superfícies de acoplamento com movimento relativo limitado."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "Every gasket is a material artifact that has component part some deformable material and bears some sealing function and has property some closed loop geometry."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "∀x(Gasket(x) ↔ MaterialArtifact(x) ∧ ∃f(SealingFunction(f) ∧ bearerOf(x,f)) ∧ ∃m(DeformableMaterial(m) ∧ hasComponentPartAtAllTimes(x,m)) ∧ ∃g(ClosedLoopGeometry(g) ∧ hasProperty(x,g)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "Constructive basis (CLAUDE.md): the definition constrains material and geometry — deformable material arranged in closed loops — not function alone. As equivalent it made MaterialArtifact + SealingFunction sufficient for gasket-hood, so every sealing artifact was inferred to be a gasket. Those constructive conditions live only in differentia_expression and do not reach the OWL, so equivalence asserted far more than intended."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "[ISO 15926-4] A <GASKET> is an <ARTEFACT> and a <SEAL> that is one or more closed loops of deformable material used between mating surfaces which have only very limited movement relative to each other"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "[CFIHOS] A seal that is one or more closed loops of deformable material used between mating surfaces which have only very limited movement relative to each other."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "[OnePetro] Any of several replaceable seals in equipment or tools."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> "[POSC Caesar] A seal that is one or more closed loops of deformable material used between mating surfaces which have only very limited movement relative to each other."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SealingFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000287> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> (enclosure function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "enclosure function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "A casing that contains and houses the internal components of a gear mechanism, providing protective enclosure and structural support."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> (enclosure process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> "enclosure process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> (gear casing)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> "gear casing"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> "A casing that contains and houses the internal components of a gear mechanism, providing protective enclosure and structural support."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> "Um invólucro que contém e abriga os componentes internos de um mecanismo de engrenagem, fornecendo invólucro protetor e suporte estrutural."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> "GearCasing ⊑ casing ⊓ ∃hasContent.GearMechanism"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> "∀x(GearCasing(x) → casing(x) ∧ ∃y(GearMechanism(y) ∧ hasContent(x,y)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> "This is a constructive type defined by its physical configuration as a specific type of casing. Under OWA, declaring equivalence could lead to over-classification where any casing containing gear-like components might be inappropriately classified as a standard gear casing, including custom enclosures or hybrid systems that should not fall into this maintenance category."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> "[ISO 15926-4] A <GEAR CASING> is a <HOUSING> that contains the internal components of a gear."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000288> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> (pumping function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> "pumping function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> "A gear pump is a pump that contains gear teeth within a casing or enclosure to transport liquid at relatively high back pressures through meshing action."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> (pumping process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> "pumping process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> (gear pump)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "gear pump"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "A gear pump is a pump that contains gear teeth within a casing or enclosure to transport liquid at relatively high back pressures through meshing action."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "Uma bomba de engrenagem é uma bomba que contém dentes de engrenagem dentro de um invólucro ou carcaça para transportar líquido em pressões de retorno relativamente altas através de ação de engrenamento."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "Every gear pump is a pump that has as component part at all times a gear mechanism and a pump casing, and bears a pumping function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "∀x (GearPump(x) → Pump(x) ∧ ∃g,c (GearMechanism(g) ∧ PumpCasing(c) ∧ hasComponentPartAtAllTimes(x,g) ∧ hasComponentPartAtAllTimes(x,c)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "Using necessary conditions for this constructive type. While the gear mechanism is definitionally necessary for gear pumps, making it sufficient under OWA could lead to false positives - any complex equipment containing gears (like gearboxes with integrated pumps or multi-function units) might be incorrectly classified as standard gear pumps for maintenance purposes."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "[ISO 15926-4] A <GEAR PUMP> is a <ROTARY PUMP> that contains gear teeth within an casing or enclosure to transport liquid at relatively high back pressures"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> "[POSC Caesar] A rotary pump that contains gear teeth within an casing or enclosure to transport liquid at relatively high back pressures and by which gear meshing serves as reverse flow seal."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000335>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> (power transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> "power transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> "An Assembly that bears a PowerTransmissionFunction and that has circumferential teeth for positive mechanical engagement with mating gears or racks to transmit rotational motion and power."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess> (power transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess> "power transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> (gear wheel)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> "gear wheel"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> "An Assembly that bears a PowerTransmissionFunction and that has circumferential teeth for positive mechanical engagement with mating gears or racks to transmit rotational motion and power."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> "Um Assembly que porta uma PowerTransmissionFunction e que possui dentes circunferenciais para engajamento mecânico positivo com engrenagens ou cremalheiras correspondentes para transmitir movimento rotacional e potência."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> "Constructive differentia based on physical structure (toothed geometry). Under OWA, asserting equivalence could force classification of complex hybrid mechanisms or specialized toothed components that should not be categorized as standard gear wheels for maintenance purposes."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> "[ISO 15926-4] A <GEAR WHEEL> is an <ARTEFACT> and a <TRANSMITTER(force)> and that is a toothed wheel usend in conjunction with another, or with a rack, to transmit motion"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000121>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000290> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> (enclosure function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "enclosure function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "A valve body that has a globular geometry designed to accommodate the perpendicular flow path and disc closure mechanism characteristic of globe valve operation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> (enclosure process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> "enclosure process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> (globe valve body)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> "globe valve body"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> "A valve body that has a globular geometry designed to accommodate the perpendicular flow path and disc closure mechanism characteristic of globe valve operation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> "Um corpo de válvula que possui geometria globular projetada para acomodar o caminho de fluxo perpendicular e o mecanismo de fechamento por disco característico da operação de válvula globo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> "Every globe valve body is a valve body that has globular geometry for perpendicular flow path accommodation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> "∀x (GlobeValveBody(x) → ValveBody(x) ∧ ∃g (GlobularGeometry(g) ∧ hasDesignCharacteristic(x,g)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> "Constructive type defined by structural geometry. Under OWA, asserting equivalence based on globular geometry alone could lead to false classifications of complex assemblies or hybrid components that contain globular elements but should not be classified as standard globe valve bodies."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> "[ISO 15926-4] A <GLOBE VALVE BODY> is a <VALVE BODY> of a globe valve"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000078>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000291> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationFunction> (gravity separation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationFunction> "gravity separation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationFunction> "A gravity separator is a separator that performs separation based on differences in specific gravity of the substances being separated."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationFunction> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationProcess> (gravity separation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationProcess> "gravity separation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationProcess> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> (gravity separator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> "gravity separator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> "A gravity separator is a separator that performs separation based on differences in specific gravity of the substances being separated."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> "Um separador gravitacional é um separador que realiza separação baseada nas diferenças de gravidade específica das substâncias sendo separadas."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> "Every gravity separator is a separator that bears a GravitySeparationFunction"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> "∀x(GravitySeparator(x) ↔ Separator(x) ∧ ∃f(GravitySeparationFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> "[ISO 15926-4] A <GRAVITY SEPARATOR> is an <ARTEFACT> and a <FLUID SEPARATOR> that is based on the difference in specific gravity for the substances to be separated"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> "[CFIHOS] A separator that is based on the difference in specific gravity for the substances to be separated."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> "[POSC Caesar] A separator that is based on the difference in specific gravity for the substances to be separated."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/GravitySeparationFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000292> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> (fluid distribution function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> "fluid distribution function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> "A header is a manifold that connects to many smaller pipes for collecting discharge from multiple sources or distributing fluid to multiple destinations."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> (fluid distribution process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> "fluid distribution process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> (header)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> "header"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> "A header is a manifold that connects to many smaller pipes for collecting discharge from multiple sources or distributing fluid to multiple destinations."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> "Um header é um manifold que se conecta a muitos tubos menores para coletar descarga de múltiplas fontes ou distribuir fluido para múltiplos destinos."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> "Header ≡ manifold ⊓ ∃connects_to.SmallPipe ⊓ ∃participatesIn.MultiStreamDistributionProcess"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> "∀x(Header(x) ↔ (manifold(x) ∧ ∃y(SmallPipe(y) ∧ connects_to(x,y)) ∧ ∃z(MultiStreamDistributionProcess(z) ∧ participatesIn(x,z))))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> "[ISO 15926-4] A <HEADER> is an <ARTEFACT> and a <PIPING NETWORK SEGMENT> that is pipe or manifold that is used to collect the discharge from many smaller pipes (a collecting header) , or can be used to distribute fluid to many smaller pipes (distributing header)"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> "[SLB Glossary] The location, acquisition and processing parameters, and other pertinent information attached to a well log, seismic record and traces."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000293> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> (heat transfer function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> "heat transfer function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> "A MaterialArtifact that bears a HeatTransferFunction and that is intended to be used in a non-tubular heat exchanger to segregate two fluid media while facilitating thermal energy transfer between them."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> (heat transfer process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> "heat transfer process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> (heat transfer plate)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> "heat transfer plate"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> "A MaterialArtifact that bears a HeatTransferFunction and that is intended to be used in a non-tubular heat exchanger to segregate two fluid media while facilitating thermal energy transfer between them."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> "Um MaterialArtifact que possui uma HeatTransferFunction e que é destinado a ser usado em um trocador de calor não tubular para segregar dois meios fluidos enquanto facilita a transferência de energia térmica entre eles."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> "Every heat transfer plate is a MaterialArtifact that bears a HeatTransferFunction and participates in segregating two fluid media in a non-tubular heat exchanger."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> "∀x(HeatTransferPlate(x) → MaterialArtifact(x) ∧ ∃f(HeatTransferFunction(f) ∧ bearerOf(x,f)) ∧ ∃p(MediaSeparationProcess(p) ∧ participatesIn(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> "Constructive classification basis requires necessary conditions only. Under OWA, sufficient conditions for 'plate geometry used in non-tubular heat exchangers' could lead to false positives - other components with plate-like surfaces might be incorrectly classified as heat transfer plates without domain expert validation of the structural and application-specific criteria."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> "[ISO 15926-4] A <HEAT TRANSFER PLATE> is a <PLATE> that is intended to be used in a non tubular heat exchanger to segregate the two media"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingFunction> (solid storage and dispensing function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingFunction> "solid storage and dispensing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingFunction> "A hopper is a vessel that is designed to store solid materials and dispense them through a controlled discharge opening."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingProcess> (solid storage and dispensing process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingProcess> "solid storage and dispensing process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfSolid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfSolid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> (hopper)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "hopper"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "A hopper is a vessel that is designed to store solid materials and dispense them through a controlled discharge opening."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "Um hopper é um vaso projetado para armazenar materiais sólidos e dispensá-los através de uma abertura de descarga controlada."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "Every hopper is a vessel that bears a SolidStorageAndDispensingFunction and has a SolidDischargeOpening as component part."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "∀x(Hopper(x) ↔ (Vessel(x) ∧ ∃f(SolidStorageAndDispensingFunction(f) ∧ bearerOf(x,f)) ∧ ∃p(SolidDischargeOpening(p) ∧ hasComponentPartAtAllTimes(x,p))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "[ISO 15926-4] A <HOPPER> is a <CONTAINER> with a conical shape that is intended to store solids for filling or dosing purposes"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "[CFIHOS] A vessel with a conical shape for filling or dosing purposes."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "[SLB Glossary] The device used to facilitate the addition of drilling fluid additives to the whole mud system."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "[OnePetro] Mixing chamber where dry components can be evenly mixed with liquids. The dry materials are introduced at the bottom of the hopper through a nozzle."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> "[POSC Caesar] A vessel with a conical shape for filling or dosing purposes"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000295> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SolidStorageAndDispensingFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> (fluid conduction function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> "fluid conduction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> "A hose is a flexible pipe designed to conduct liquids under pressure while accommodating positional movement and bending."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> (fluid conduction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> "fluid conduction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> (hose)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "hose"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "A hose is a flexible pipe designed to conduct liquids under pressure while accommodating positional movement and bending."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "Uma mangueira é um tubo flexível projetado para conduzir líquidos sob pressão enquanto acomoda movimento posicional e flexão."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "Every hose is a pipe that has flexibility and is capable of conducting liquids under pressure."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "∀x (Hose(x) → Pipe(x) ∧ ∃q(Flexibility(q) ∧ hasQuality(x,q)) ∧ ∃c(PressurizedFluidConduction(c) ∧ capableOf(x,c)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "Using necessary conditions because this is a constructive type defined by physical properties (flexibility). Under OWA, asserting equivalence would force any artifact with flexibility and pressure capability to be classified as a hose, potentially including complex equipment with flexible components that should not be categorized as standard hoses."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "[ISO 15926-4] A <HOSE> is a <TUBULAR> that is flexible and capable of conducting liquids under pressure"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "[CFIHOS] A tubular which is flexible and capable of conveying liquids under pressure."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> "[POSC Caesar] A tubular which is flexible and capable of conveying liquids under pressure."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000321>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> (enclosure function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "enclosure function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "An Assembly that bears both an EnclosureFunction and a SupportFunction, providing protective boundaries around internal components while structurally supporting them."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> (enclosure process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> "enclosure process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> (housing)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "housing"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "An Assembly that bears both an EnclosureFunction and a SupportFunction, providing protective boundaries around internal components while structurally supporting them."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "Um Assembly que possui tanto uma EnclosureFunction quanto uma SupportFunction, fornecendo limites protetivos ao redor de componentes internos enquanto os suporta estruturalmente."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "Housing SubClassOf Assembly and (bearerOf some EnclosureFunction) and (bearerOf some SupportFunction)"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "∀x (Housing(x) → Assembly(x) ∧ ∃f₁(EnclosureFunction(f₁) ∧ bearerOf(x,f₁)) ∧ ∃f₂(SupportFunction(f₂) ∧ bearerOf(x,f₂)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "Constructive type based on physical configuration. Under OWA, sufficient conditions would force any assembly with enclosure and support functions to be classified as a standard housing, potentially misclassifying specialized equipment with housing-like properties but different maintenance categories."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "[ISO 15926-4] A <HOUSING> is an <ARTEFACT> and an <ENCLOSURE> and a <SUPPORT> that, next to separation, also provides support"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "[CFIHOS] An enclosure that also provides support."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> "[SLB Glossary] The outside steel case of a cartridge or a sonde in a wireline logging tool."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000297> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> (actuation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "actuation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "A hydraulic actuator is an actuator that converts hydraulic fluid pressure into mechanical motion through hydraulic power transmission."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> (actuation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> "actuation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/ControlSignal>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> (hydraulic actuator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> "hydraulic actuator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> "A hydraulic actuator is an actuator that converts hydraulic fluid pressure into mechanical motion through hydraulic power transmission."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> "Um atuador hidráulico é um atuador que converte pressão de fluido hidráulico em movimento mecânico através de transmissão de potência hidráulica."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> "Constructive classification based on hydraulic power source. Under Open World Assumption, asserting equivalence could incorrectly classify complex hydraulic-mechanical hybrid systems or specialized equipment containing hydraulic actuator components as standard hydraulic actuators."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> "[ISO 15926-4] A <HYDRAULIC ACTUATOR> is an <INSTRUMENTATION ITEM> and a <CONTROLLED ACTUATOR> and a <HYDRAULICALLY ACTUATED ARTEFACT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> "[CFIHOS] An actuator intended to be operated by hydraulic power."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> "[POSC Caesar] An actuator intended to be operated by hydraulic power."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000260>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000298> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000327>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> (mechanical energy generation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> "mechanical energy generation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> "A hydraulic motor is a motor that generates mechanical energy by converting high pressure hydraulic oil to rotational motion."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> (mechanical energy generation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> "mechanical energy generation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> (hydraulic motor)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "hydraulic motor"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "A hydraulic motor is a motor that generates mechanical energy by converting high pressure hydraulic oil to rotational motion."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "Um motor hidráulico é um motor que gera energia mecânica convertendo óleo hidráulico de alta pressão em movimento rotacional."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "Every hydraulic motor is a motor that has hydraulic fluid input and participates in hydraulic-to-mechanical energy conversion process"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "∀x(HydraulicMotor(x) → Motor(x) ∧ ∃f,p(HydraulicFluid(f) ∧ hasInput(x,f) ∧ HydraulicToMechanicalEnergyConversionProcess(p) ∧ participatesIn(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "Constructive classification based on hydraulic mechanism. Under Open World Assumption, any device with hydraulic input might be misclassified as a hydraulic motor without domain expert validation of the complete structural requirements."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "[ISO 15926-4] A <HYDRAULIC MOTOR> is an <ARTEFACT> and a <MOTOR> and a <HYDRAULIC TO ROTATION ENERGY CONVERTER> that is intended to generate power by means of high pressure oil"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "[CFIHOS] A motor that is intended to generate power by means of high pressure oil."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> "[POSC Caesar] A motor that is intended to generate power by means of high pressure oil."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000315>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000299> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingFunction> (hydraulic pumping function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingFunction> "hydraulic pumping function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingFunction> "A hydraulic pump is a positive displacement pump that converts mechanical power into hydraulic energy for hydraulic drive systems."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingFunction> <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingProcess> (hydraulic pumping process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingProcess> "hydraulic pumping process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingProcess> <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000300> (hydraulic pump)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000300> "hydraulic pump"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000300> "A hydraulic pump is a positive displacement pump that converts mechanical power into hydraulic energy for hydraulic drive systems."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000300> "Uma bomba hidráulica é uma bomba de deslocamento positivo que converte energia mecânica em energia hidráulica para sistemas de acionamento hidráulico."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000300> "[ISO 15926-4] A <HYDRAULIC PUMP> is a <POSITIVE DISPLACEMENT PUMP> used in hydraulic drive systems and can be hydrostatic or hydrodynamic. It is a mechanical source of power that converts mechanical power into hydraulic energy (hydrostatic energy i.e. flow, pressure). It generates flow with enough power to overcome pressure induced by the load at the pump outlet. When a hydraulic pump operates, creates a vacuum at the pump inlet, which forces liquid from the reservoir into the inlet line to the pump and by mechanical action delivers this liquid to the pump outlet and forces it into the hydraulic system."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000300> "[OnePetro] An artificial lift system that is powered by injected fluid (usually water), that powers a pump similar to the rotating pump used in electrical submersible pumps."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000300> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000331> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/HydraulicPumpingFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/SuctionPort>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/DischargePort>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SuctionPort> "suction port"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SuctionPort> <https://www.inf.ufrgs.br/ontologies/copi/FluidPort>)
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DischargePort> "discharge port"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DischargePort> <https://www.inf.ufrgs.br/ontologies/copi/FluidPort>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000300> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> (separation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> "separation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> "A hydrocyclone is a separator that separates fluid mixtures using centrifugal forces generated by tangential flow through a conical chamber."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> (separation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> "separation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> (hydrocyclone)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "hydrocyclone"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "A hydrocyclone is a separator that separates fluid mixtures using centrifugal forces generated by tangential flow through a conical chamber."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "Um hidrociclone é um separador que separa misturas de fluidos usando forças centrífugas geradas por fluxo tangencial através de uma câmara cônica."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "Every hydrocyclone is a separator that has a conical section as component part at all times and participates in centrifugal separation processes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "∀x(Hydrocyclone(x) ↔ Separator(x) ∧ ∃c(ConicalSection(c) ∧ hasComponentPartAtAllTimes(x,c)) ∧ ∃p(CentrifugalSeparationProcess(p) ∧ participatesIn(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "[ISO 15926-4] A <HYDROCYCLONE> is a <CYCLONE> and a <CYLINDRICAL VESSEL>, intended to separate a fluid by hydraulic forces"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "[SLB Glossary] An item of solids-control equipment consisting of an inverted cone, the mud being fed tangentially into the upper (larger diameter) part."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> "[OnePetro] A cone shaped device for separating fluids and the solids dispersed in fluids."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferFunction> (energy transfer function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferFunction> "energy transfer function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferFunction> "An impeller is an assembly consisting of rotating vanes mounted on a hub that transfers energy to or from fluids through dynamic rotational force within an enclosure."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferProcess> (energy transfer process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferProcess> "energy transfer process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> (impeller)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "impeller"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "An impeller is an assembly consisting of rotating vanes mounted on a hub that transfers energy to or from fluids through dynamic rotational force within an enclosure."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "Um impulsor é um conjunto que consiste em pás rotativas montadas em um cubo que transfere energia para ou de fluidos através de força rotacional dinâmica dentro de um invólucro."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "Every impeller is an assembly that has rotating vanes and a hub as component parts at all times, participates in rotational motion, and bears an energy transfer function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "∀x(Impeller(x) → Assembly(x) ∧ ∃v,h(RotatingVanes(v) ∧ Hub(h) ∧ hasComponentPartAtAllTimes(x,v) ∧ hasComponentPartAtAllTimes(x,h) ∧ ∃m(RotationalMotion(m) ∧ participatesIn(x,m)) ∧ ∃f(EnergyTransferFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "Constructive classification based on physical mechanism. Under OWA, defining sufficient conditions for the rotating vane assembly could lead to false positives where other rotating equipment with vanes (like turbine rotors or fan assemblies) might be incorrectly classified as impellers when they should remain in their specific equipment categories."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "[ISO 15926-4] An <IMPELLER> is a <MECHANICAL TO MECHANICAL ENERGY CONVERTER> that is an assembly of rotating vanes within an enclosure which is used to impart energy to or derive energy from a fluid through dynamic force"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "[DEXPI] An energy converter component that is an assembly of rotating vanes within an enclosure which is used to impart energy to or derive energy from a fluid through dynamic force (from ``_)."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "[SLB Glossary] In electromagnetics or electrical circuit theory, the ratio of voltage to current when these are represented by phasor quantities in alternating current circuits. (A phasor is a complex number that represents the amplitude and phase of a quantity that varies sinusoidally in time.) Electrical impedance, also symbolized by Z, is a complex number that has the same units (ohms) as resistivity."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> "[OnePetro] The rotating pump component that drives the fluid in a centrifugal pump."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnergyTransferFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000302> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/RotatingVanes>))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/RotatingVanes> "rotating vanes"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RotatingVanes> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionFunction> (waste combustion function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionFunction> "waste combustion function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionFunction> "An incinerator is a furnace that is designed to combust waste material for disposal purposes."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess> (waste combustion process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess> "waste combustion process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/WasteMaterial>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfSolid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> (incinerator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> "incinerator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> "An incinerator is a furnace that is designed to combust waste material for disposal purposes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> "Um incinerador é um forno que é projetado para combustir material de resíduo para fins de descarte."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> "Every incinerator is a furnace that bears a waste combustion function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> "∀x(Incinerator(x) ↔ Furnace(x) ∧ ∃f(WasteCombustionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> "[ISO 15926-4] An <INCINERATOR> is an <ARTEFACT> and a <FURNACE> that is intended for the combustion of waste material"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> "[CFIHOS] A furnace that is intended for the combustion of waste material."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> "[OnePetro] Also known as an enclosed combustor\n        \n        Flares are not 100% efficient, and some methane (un-combusted) is emitted during flaring as a result of un-combusted gas being released via the equipment exhaust stream. Flares cannot be performance tested to guarantee that they achieve the same efficiency as an incinerator or enclosed combustor. Studies suggest that the efficiency of a flare during windy conditions can be as low as 50%. The many components and complex network of small gathering lines in flare are a source of fugitive emissions.\n        \n        Incinerators are used when flaring is not a viable option. The combustion efficiency of an incinerator is known to be over 99% which is higher than a flare. Plus, they are more suitable for applications involving carcinogenic gases like BTEX and H2S applications. Incineration of waste gas products may not be a new concept for the\n        \n        oil and gas industry however, in recent years the design and technology have resulted in optimal performance, increased reliability and reduce capital and operating costs for operators.\n        \n        An enclosed combustor is a newer iteration of the incinerator. The combustion device is completely enclosed except for the combustion air intake and the exhaust discharge. It operates like an incinerator with more restriction to allow it to be able to operate in a reduced spacing capacity. The surfaces exposed to the atmosphere operate below the temperature that would ignite a flammable substance present in the surrounding area. Because of the reduced space capacity all air intakes must be equipped with a flame arresting device as a safety feature to allow the unit to be 10 meters away from wells or operating equipment. https://energynow.com/2021/07/the-differences-between-flares-incinerators-and-enclosed-combustors/"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000281> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/WasteCombustionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000303> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000217>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> (injection function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> "injection function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> "An injection pump is a pump that is specifically designed to inject fluid into reservoirs or production systems, typically at relatively high pressures."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess>))

