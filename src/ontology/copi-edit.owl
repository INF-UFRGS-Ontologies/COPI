SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ConnectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ConnectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ConnectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> (coupling)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "coupling"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "A coupling is a material artifact that bears a connection function to join separate parts or systems together."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "Um acoplamento é um artefato material que possui uma função de conexão para unir partes ou sistemas separados."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "Every coupling is a material artifact that has the function to connect separate parts or systems together."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "∀x(Coupling(x) ↔ MaterialArtifact(x) ∧ ∃f(ConnectionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "[ISO 15926-4] <COUPLING> is the <Activity> of connecting with a coupling or coupler"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "[CFIHOS] Connecting with a coupling or coupler."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "[SLB Glossary] An electrical or mechanical device that joins parts of systems and can affect the interaction of, or energy transfer between, parts of systems."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "[OnePetro] The connection point of jointed pipe. It may be a steel shell with female threads to which the pins are connected or a formed female connection (box) on the end of tubing."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> "[POSC Caesar] Connecting with a coupling or coupler"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ConnectionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DampingFunction> (damping function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DampingFunction> "damping function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/DampingFunction> "A damper is an assembly that bears the designed function to suppress, regulate, or reduce unfavorable dynamic characteristics such as vibrations, pressure fluctuations, or flow disturbances."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DampingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DampingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DampingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DampingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DampingProcess>))

