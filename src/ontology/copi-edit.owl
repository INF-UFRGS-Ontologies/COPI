SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PositionLimitDetectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> (limit switch)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> "limit switch"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> "A limit switch is an instrument that bears a position limit detection function, mechanically actuated by object motion to provide electrical switching signals when predetermined position limits are reached."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> "Um limit switch é um instrumento que possui uma função de detecção de limite de posição, acionado mecanicamente pelo movimento de objetos para fornecer sinais de chaveamento elétrico quando limites de posição predeterminados são atingidos."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> "[ISO 15926-4] A <LIMIT SWITCH> is an <INSTRUMENTATION ITEM> and a <POSITION SWITCH> that is a switch preventing the travel of an object in a mechanism past some predetermined point, mechanically operated by the motion of the object itself"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> "[POSC Caesar] A position switch having a positive opening operation."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PositionLimitDetectionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000132> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A manual valve is a valve that has a manual actuator requiring hand power for operation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> (manual valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> "manual valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> "A manual valve is a valve that has a manual actuator requiring hand power for operation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> "Uma válvula manual é uma válvula que possui um atuador manual que requer força manual para operação."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> "Every manual valve is a valve that has a manual actuator as component part."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> "∀x(ManualValve(x) → Valve(x) ∧ ∃y(ManualActuator(y) ∧ hasComponentPartAtAllTimes(x,y)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> "Constructive classification based on actuation mechanism. Under OWA, any valve with a manual actuator component might be classified as manual valve even if it has additional automated features (hybrid valves). Starting with necessary conditions allows domain experts to validate that manual actuation is both necessary and sufficient before upgrading to equivalent axiom."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> "[CFIHOS] A valve that is regulated with hand power."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A needle valve is a valve that has a conical needle-shaped closure member that seats into a small orifice to provide precise flow control."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> (needle valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "needle valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "A needle valve is a valve that has a conical needle-shaped closure member that seats into a small orifice to provide precise flow control."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "Uma válvula agulha é uma válvula que possui um membro de fechamento cônico em forma de agulha que se assenta em um pequeno orifício para fornecer controle preciso de fluxo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "Every needle valve is a valve that has a needle plug component and has a small orifice seat component."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "∀x(NeedleValve(x) → Valve(x) ∧ ∃y(NeedlePlug(y) ∧ hasComponentPartAtAllTimes(x,y)) ∧ ∃z(SmallOrificeSeat(z) ∧ hasComponentPartAtAllTimes(x,z)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "As a constructive type defined by specific structural features (needle plug geometry), providing sufficient conditions under the Open World Assumption could lead to over-classification. Complex valve assemblies or custom equipment containing needle-like mechanisms might be incorrectly classified as standard needle valves for maintenance purposes."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "[ISO 15926-4] A <NEEDLE VALVE> is a <GLOBE VALVE> that has a closure member with the shape of a conical plug (needle) which closes into a small seat"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "[CFIHOS] A globe valve that has a closure member with the shape of a conical plug (needle) which closes into a small seat."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "[SLB Glossary] A type of small valve used for flow metering, having a tapered needlepoint plug or closure element and a seat having a small orifice."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "[OnePetro] A low volume, small orifice, high pressure bleed valve."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> "[POSC Caesar] A globe valve that has a closure member with the shape of a conical plug (needle) which closes into a small seat."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000134> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlFunction> (binary flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlFunction> "binary flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlFunction> "An on-off control valve is a control valve that bears a binary flow control function, having only two defined positions: fully open and fully closed."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlFunction> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlProcess> (binary flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlProcess> "binary flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/ControlSignal>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000135> (on-off control valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000135> "on-off control valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000135> "An on-off control valve is a control valve that bears a binary flow control function, having only two defined positions: fully open and fully closed."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000135> "Uma válvula de controle liga-desliga é uma válvula de controle que possui uma função de controle de fluxo binária, tendo apenas duas posições definidas: totalmente aberta e totalmente fechada."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000135> "Every on-off control valve is a control valve that has a BinaryFlowControlFunction and has component part a BinaryPositioner."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000135> "∀x(OnOffControlValve(x) ↔ ControlValve(x) ∧ ∃f(BinaryFlowControlFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000135> "[ISO 15926-4] An <ON-OFF CONTROL VALVE> is an <INSTRUMENTATION ITEM> and a <CONTROL VALVE> that only has two defined positions, being fully open and fully closed"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000135> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/BinaryFlowControlFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> (flow measurement function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> "flow measurement function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> "An orifice plate is a flow element that consists of a thin plate with a specified hole through which fluid flows to create differential pressure for flow rate measurement."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> (flow measurement process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> "flow measurement process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> (orifice plate)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "orifice plate"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "An orifice plate is a flow element that consists of a thin plate with a specified hole through which fluid flows to create differential pressure for flow rate measurement."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "Uma placa de orifício é um elemento de medição de fluxo que consiste de uma placa fina com um orifício especificado através do qual o fluido flui para criar pressão diferencial para medição da taxa de fluxo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "Every orifice plate is a flow element that has a thin plate component and has a specified hole component and bears a flow measurement function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "∀x(OrificePlate(x) → FlowMeasuringElement(x) ∧ ∃p,h(ThinPlate(p) ∧ SpecifiedHole(h) ∧ hasComponentPartAtAllTimes(x,p) ∧ hasComponentPartAtAllTimes(x,h)) ∧ ∃f(FlowMeasurementFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "Constructive classification based on physical structure. Under OWA, any plate with a hole could potentially be classified as an orifice plate, but many perforated plates serve different purposes (structural, filtering, etc.). The structural differentia alone is not sufficient without industrial context validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "[CFIHOS] A physical object that is a thin plate with a specified hole in the middle. It is usually placed in a pipe to measure the rate of fluid flow."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> "[OnePetro] Part of an orifice metering system. A plate with a hole through which a single phase flow produces a pressure drop."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000116>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000321>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000136> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000081>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementFunction> (phase sequence measurement function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementFunction> "phase sequence measurement function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementFunction> "A phase sequence meter is an electric measuring instrument that bears a phase sequence measurement function to determine and indicate the sequence in which the instantaneous voltages of phase conductors reach their maximum value in a polyphase electrical system."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementProcess> (phase sequence measurement process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementProcess> "phase sequence measurement process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/VisualIndication>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> (phase sequence meter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> "phase sequence meter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> "A phase sequence meter is an electric measuring instrument that bears a phase sequence measurement function to determine and indicate the sequence in which the instantaneous voltages of phase conductors reach their maximum value in a polyphase electrical system."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> "Um medidor de sequência de fases é um instrumento de medição elétrica que possui uma função de medição de sequência de fases para determinar e indicar a sequência na qual as tensões instantâneas dos condutores de fase atingem seu valor máximo em um sistema elétrico polifásico."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> "Every phase sequence meter is an electric measuring instrument that has the function to measure phase sequence and has as input polyphase electrical signals."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> "∀x(PhaseSequenceMeter(x) ↔ ElectricMeasuringInstrument(x) ∧ ∃f(PhaseSequenceMeasurementFunction(f) ∧ bearerOf(x,f)) ∧ ∃s(InformationContentEntity(s) ∧ hasInput(x,s)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> "[ISO 15926-4] A <PHASE SEQUENCE METER> is an <ELECTRIC VARIABLE MEASURING INSTRUMENT> that indicates, on a polyphase system, the sequence in which the instantaneous voltage of the phase conductors reach their maximum value"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PhaseSequenceMeasurementFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000137> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> (backflow prevention function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "backflow prevention function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "A piston check valve is a check valve that has a piston-type closure member that moves linearly along the flow axis under gravity or spring loading to prevent backflow."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> (backflow prevention process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> "backflow prevention process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> (piston check valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "piston check valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "A piston check valve is a check valve that has a piston-type closure member that moves linearly along the flow axis under gravity or spring loading to prevent backflow."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "Uma válvula de retenção tipo pistão é uma válvula de retenção que possui um elemento de fechamento tipo pistão que se move linearmente ao longo do eixo de fluxo sob ação da gravidade ou mola para prevenir refluxo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "Every piston check valve is a check valve that has a piston closure as component part."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "∀x(PistonCheckValve(x) → CheckValve(x) ∧ ∃y(PistonClosure(y) ∧ hasComponentPartAtAllTimes(x,y)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "Using necessary conditions because this is a constructive type defined by physical mechanism. Under Open World Assumption, any artifact with a piston closure could potentially be classified as piston check valve, but specialized hybrid valves or custom manifolds containing piston mechanisms should not be automatically asserted into this standard maintenance category without domain expert validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "[ISO 15926-4] A <PISTON CHECK VALVE> is a <LIFT CHECK VALVE> and a <PISTON VALVE> that has a free gravity or spring loaded piston type closure member"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "[CFIHOS] A lift check valve that has a free gravity or spring loaded piston type closure member."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> "[POSC Caesar] A lift check valve that has a free gravity or spring loaded piston type closure member."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000138> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> (heat transfer function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> "heat transfer function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> "A plate heat exchanger is a heat exchanger that has heat transfer plates as its primary heat transfer surface."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> (heat transfer process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> "heat transfer process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> (plate heat exchanger)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "plate heat exchanger"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "A plate heat exchanger is a heat exchanger that has heat transfer plates as its primary heat transfer surface."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "Um trocador de calor de placas é um trocador de calor que possui placas de transferência de calor como sua superfície primária de transferência de calor."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "Every plate heat exchanger is a heat exchanger that has component part heat transfer plates at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "∀x(PlateHeatExchanger(x) → HeatExchanger(x) ∧ ∃p(HeatTransferPlate(p) ∧ hasComponentPartAtAllTimes(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "Using necessary conditions for this constructive type. While the plate-based structure is characteristic, under the Open World Assumption, asserting equivalence could lead to false positives where any equipment with heat transfer plates (e.g., specialized hybrid equipment, multi-function process units) would be automatically classified as a standard plate heat exchanger. Domain expert validation is needed to confirm the structural differentia is sufficient."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "[ISO 15926-4] A <PLATE HEAT EXCHANGER> is a <NON-TUBULAR HEAT EXCHANGER> that uses metal plates to transfer heat between two fluids"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "[CFIHOS] A heat exchanger using plates as the device for separating the two fluids and across which the energy is transferred."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> "[POSC Caesar] An indirect contact heat exchanger that separates the hot and cold fluids by plates."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000139> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000294>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A plug valve is a valve that has a cylindrical or tapered plug closure member which operates by quarter-turn rotation on its axis to control fluid flow by sealing against a seat."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> (plug valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "plug valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "A plug valve is a valve that has a cylindrical or tapered plug closure member which operates by quarter-turn rotation on its axis to control fluid flow by sealing against a seat."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "Uma válvula plug é uma válvula que possui um elemento de fechamento em forma de plugue cilíndrico ou cônico que opera por rotação de um quarto de volta em seu eixo para controlar o fluxo de fluido selando contra um assento."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "Every plug valve is a valve that has a plug closure component and participates in quarter-turn rotation processes"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "∀x(PlugValve(x) → Valve(x) ∧ ∃p(PlugClosure(p) ∧ hasComponentPartAtAllTimes(x,p)) ∧ ∃r(QuarterTurnRotationProcess(r) ∧ participatesIn(x,r)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "Constructive classification requires necessary conditions only. Under OWA, any artifact with a plug closure and quarter-turn mechanism would be forcibly classified as a plug valve, but specialized multi-port valves or custom manifolds containing plug mechanisms should not automatically inherit the standard plug valve classification without domain expert validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "[ISO 15926-4] A <PLUG VALVE> is a <ROTARY VALVE> that has a quarter turn action in which the closure member is a cylindrical or tapered plug which operates by rotating on its axis and sealing against a downstream seat"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "[CFIHOS] A rotary valve that has a quarter turn action in which the closure member is a cylindrical or tapered plug which operates by rotating on its axis and sealing against a downstream seat."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "[SLB Glossary] A quarter-turn valve whose closure element is usually a tapered plug having a rectangular port."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "[OnePetro] A high pressure valve with a rotatable plug that allows or denies flow."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> "[POSC Caesar] A rotary valve that has a quarter turn action in which the closure member is a cylindrical or tapered plug which operates by rotating on its axis and sealing against a downstream seat."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000120>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000140> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationFunction> (electrical power transformation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationFunction> "electrical power transformation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationFunction> "A power transformer is a transformer that bears an electrical power transformation function, realized by electromagnetic induction to transform alternating voltage and current systems to different levels at the same frequency for power transmission purposes."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationProcess> (electrical power transformation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationProcess> "electrical power transformation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> (power transformer)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> "power transformer"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> "A power transformer is a transformer that bears an electrical power transformation function, realized by electromagnetic induction to transform alternating voltage and current systems to different levels at the same frequency for power transmission purposes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> "Um transformador de potência é um transformador que possui uma função de transformação de energia elétrica, realizada por indução eletromagnética para transformar sistemas de tensão e corrente alternadas para diferentes níveis na mesma frequência para fins de transmissão de energia."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> "[ISO 15926-4] A <POWER TRANSFORMER> is an <ARTEFACT> and a <TRANSFORMER> and an <ELECTRIC POWER CONVERTER> that, by electromagnetic induction, transforms a system of alternating voltage and current into another system of voltage and current usually of different values and at the same frequency for the purpose of transmitting electrical power"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> "[POSC Caesar] A transformer that, by electromagnetic induction, transforms a system of alternating voltage and current into another system of voltage and current usually of different values and at the same frequency for the purpose of transmitting electrical power."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000141> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalPowerTransformationFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction> (pressure sensing function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction> "pressure sensing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction> "A pressure element is an instrument that bears a pressure sensing function."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingProcess> (pressure sensing process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingProcess> "pressure sensing process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureSensingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureSensingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> (pressure element)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> "pressure element"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> "A pressure element is an instrument that bears a pressure sensing function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> "Um elemento de pressão é um instrumento que possui uma função de detecção de pressão."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> "[CFIHOS] A detecting element intended to sense pressure."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> "[POSC Caesar] A detecting element intended to sense pressure."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000076>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000116>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000128>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementFunction> (pressure measurement function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementFunction> "pressure measurement function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementFunction> "A pressure gauge is an indicator that bears the function of measuring and displaying pressure values."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementFunction> <https://www.inf.ufrgs.br/ontologies/copi/IndicationFunction>)
