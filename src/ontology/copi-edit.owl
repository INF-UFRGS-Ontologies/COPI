SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDirectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidDirectionProcess>))
