SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FormationFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/FormationFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> (master valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> "master valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> "A valve that bears a primary well isolation function and is a component of a christmas tree, controlling all flow from the wellbore."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> "Uma válvula que possui uma função de isolamento primário do poço e é um componente de uma árvore de natal, controlando todo o fluxo do poço."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> "The definition is partly positional ('on the christmas tree', 'main shut-in valve on the well'); under OWA a positional differentia cannot be sufficient."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> "[SLB Glossary] A valve located on the Christmas tree that controls all flow from the wellbore."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> "[OnePetro] The main shut-in valve on the well."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingFunction> (instrument mounting function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingFunction> "instrument mounting function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingFunction> "A material artifact that is a structure on which groups of instrument hardware are mounted and which houses the operator-process interface."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingProcess> (instrument mounting process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingProcess> "instrument mounting process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/VisualIndication>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> (panel)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> "panel"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> "A material artifact that is a structure on which groups of instrument hardware are mounted and which houses the operator-process interface."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> "Um artefato material que é uma estrutura sobre a qual grupos de instrumentos são montados e que abriga a interface operador-processo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> "The ISA definition is structure-led and enumerative (sections, cubicles, consoles, desks); no sufficient condition follows from it."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> "[ISO 15926-4] A <PANEL> is an <ARTEFACT> and a <SUPPORT> that is a usually vertical mount for <DISPLAYING> something"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> "[ISA 5.1] a freestanding or built-in structure consisting of one or more sections, cubicles, consoles, or desks that has groups of instrument hardware mounted on it, houses the operator-process interface, and is given a unique designation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentMountingFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementFunction> (reciprocating displacement function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementFunction> "reciprocating displacement function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementFunction> "A material artifact, normally cylindrical and provided with a closed end, that reciprocates within a hollow outer cylinder to change its internal volume in order to discharge pressurized liquid or gas."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementProcess> (reciprocating displacement process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementProcess> "reciprocating displacement process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> (piston)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> "piston"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> "A material artifact, normally cylindrical and provided with a closed end, that reciprocates within a hollow outer cylinder to change its internal volume in order to discharge pressurized liquid or gas."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> "Um artefato material, normalmente cilíndrico e provido de uma extremidade fechada, que se move alternadamente dentro de um cilindro externo oco para alterar seu volume interno a fim de descarregar líquido ou gás pressurizado."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> "Shape constraints in the source definition are constructive; under OWA they cannot be sufficient conditions."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> "[ISO 15926-4] A <PISTON> is an <ENGINE COMPONENT> and a <DISPLACER> that is normally of the cylindrical shape and provided with a closed end, intended to reciprocate within a hollow outer cylinder to change the internal volume of the outer cylinder  in order to either discharge pressurized liquid or gas"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ReciprocatingDisplacementFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationFunction> (electromagnetic field generation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationFunction> "electromagnetic field generation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationFunction> "A material artifact that is a winding on the stator of a machine, bearing an electromagnetic field generation function."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationProcess> (electromagnetic field generation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationProcess> "electromagnetic field generation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> (stator winding)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> "stator winding"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> "A material artifact that is a winding on the stator of a machine, bearing an electromagnetic field generation function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> "Um artefato material que é um enrolamento no estator de uma máquina, possuindo uma função de geração de campo eletromagnético."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> "Differentia is positional (on the stator, not the rotor); positional conditions are not sufficient under OWA."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> "[ISO 15926-4] A <STATOR WINDING> is a <WINDING> on the stator of a machine."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ElectromagneticFieldGenerationFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceFunction> (multipath fluid conveyance function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceFunction> "multipath fluid conveyance function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceFunction> "An assembly of several tubes assembled together, bearing a multipath fluid conveyance function that allows multiple flow paths from a single source."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceProcess>))

