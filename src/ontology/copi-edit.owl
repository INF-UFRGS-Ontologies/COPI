SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/LevelMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/LevelMeasurementResult>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/LevelMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> (level transmitter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> "level transmitter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> "A level transmitter is a transmitter that measures the level (height) of liquid or bulk solid material in a container and produces a standardized electrical output signal proportional to the measured level."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> "Um transmissor de nível é um transmissor que mede o nível (altura) de material líquido ou sólido a granel em um recipiente e produz um sinal elétrico de saída padronizado proporcional ao nível medido."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> "[ISO 15926-4] A <LEVEL TRANSMITTER> is a <PROCESS VARIABLE TRANSMITTER> and a <LEVEL MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> "[CFIHOS] A transmitter that produces a continuous standardized output signal dependent of a received input signal from a level sensor."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> "[ISA 5.1] ISA 5.1 tag abbreviation 'LT'. First letter 'L': Level. Succeeding letters: 'T' = Transmit."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> "[POSC Caesar] A transmitter that is producing a continuous standardized output signal dependent of a received input signal from a level sensor."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/LevelMeasurementAndTransmissionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PositionLimitDetectionFunction> (position limit detection function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PositionLimitDetectionFunction> "position limit detection function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PositionLimitDetectionFunction> "A limit switch is an instrument that bears a position limit detection function, mechanically actuated by object motion to provide electrical switching signals when predetermined position limits are reached."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PositionLimitDetectionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PositionLimitDetectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PositionLimitDetectionProcess>))
