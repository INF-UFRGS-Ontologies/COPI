SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> (tube bundle)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> "tube bundle"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> "An assembly of several tubes assembled together, bearing a multipath fluid conveyance function that allows multiple flow paths from a single source."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> "Uma montagem de vários tubos reunidos, possuindo uma função de condução de fluido em múltiplos caminhos que permite vários percursos de fluxo a partir de uma única fonte."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> "The differentia is the structural fact of several tubes assembled together; not sufficient under OWA."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> "[ISO 15926-4] A <TUBE BUNDLE> is a <BUNDLE(petro)> that consists of several tubes assembled together allowing multiple flow paths from a single source."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/MultipathFluidConveyanceFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/Tube>))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/Tube> "tube"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/Tube> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)

