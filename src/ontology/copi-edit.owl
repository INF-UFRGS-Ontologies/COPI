SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlameDetectionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlameDetectionProcess>))

