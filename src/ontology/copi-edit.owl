SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ConnectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ConnectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> (flange)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "flange"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "A flange is a material artifact characterized by a projecting flat rim, plate, collar, or rib geometry, designed to provide mechanical connection between components."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "Um flange é um artefato material caracterizado por uma geometria de aro plano projetante, placa, colar ou nervura, projetado para fornecer conexão mecânica entre componentes."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "Every flange is a material artifact that has a projecting flat rim geometry and has the function of mechanically connecting components."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "∀x(Flange(x) → MaterialArtifact(x) ∧ ∃g(ProjectingFlatRimGeometry(g) ∧ hasCharacteristic(x,g)) ∧ ∃f(MechanicalConnectionFunction(f) ∧ hasFunction(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "Using necessary conditions because this is a constructive type defined by structural geometry. Under OWA, any artifact with projecting flat rim geometry would be forced into the flange category, which could incorrectly classify specialized equipment or complex assemblies that contain flange-like features but serve different primary functions."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "[ISO 15926-4] A <FLANGE> is an <ARTEFACT> and a <CONNECTOR> that is a projecting flat rim, plate, collar, or rib for strength or for attachment to another object"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "[CFIHOS] A physical object that is a projecting flat rim, plate, collar or rib."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "[SLB Glossary] A connection profile used in pipe work and associated equipment to provide a means of assembling and disassembling components."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> "[OnePetro] A common, high pressure wellhead connection, using bolt attached flange plates and metal-to-metal seals."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000238>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ConnectionFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000321>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000273> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> (waste gas disposal function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> "waste gas disposal function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> "A flare is a burner that safely disposes of unwanted gases through controlled combustion at an elevated location."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalProcess> (waste gas disposal process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalProcess> "waste gas disposal process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> (flare)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "flare"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "A flare is a burner that safely disposes of unwanted gases through controlled combustion at an elevated location."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "Um flare é um queimador que descarta com segurança gases indesejados através de combustão controlada em local elevado."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "Every flare is a burner that bears a waste gas disposal function and has component parts flare tip, flare stack, and pilot system."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "∀x (Flare(x) ↔ (Burner(x) ∧ ∃f (WasteGasDisposalFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "Over-reaching equivalence (ODR-022 §17). The definition adds \"at an elevated location\", a structural condition not carried by WasteGasDisposalFunction. As equivalent it absorbed flare tip — its own component."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "[ISO 15926-4] A <FLARE> is a <BURNER> that has a capability of <FLARING>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "[CFIHOS] A system that burns waste in an elevated flame in the open air."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "[DEXPI] An artefact and waste gas emitter that is intended to burn waste gas in secure distance from the plant or platform."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "[SLB Glossary] The burning of unwanted gas through a pipe (also called a flare)."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> "[OnePetro] A burner on a remote line used for disposal of hydrocarbons during clean-up, emergency shut downs and for disposal of small volume waste streams of mixed gasses that cannot easily or safely be separated."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000274> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> (waste gas disposal function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> "waste gas disposal function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> "A flare tip is a burner that specifically burns waste gas emitted from industrial processes and discharges the combustion products into the atmosphere."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WasteGasBurningProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WasteGasBurningProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WasteGasBurningProcess> (waste gas burning process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WasteGasBurningProcess> "waste gas burning process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasBurningProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasBurningProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/WasteMaterial>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WasteGasBurningProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/CombustionProduct>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> (flare tip)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "flare tip"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "A flare tip is a burner that specifically burns waste gas emitted from industrial processes and discharges the combustion products into the atmosphere."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "Um queimador de flare é um queimador que especificamente queima gás residual emitido de processos industriais e descarrega os produtos de combustão na atmosfera."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "Every flare tip is a burner that has the function to dispose of waste gas from processes by burning it into the atmosphere"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "∀x(FlareTip(x) ↔ Burner(x) ∧ ∃f(WasteGasDisposalFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "[ISO 15926-4] A <FLARE TIP> is an <ARTEFACT> and a <BURNER> that burns gas emitted from a process into the atmosphere"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "[CFIHOS] A burner that burns gas emitted from a process into the atmosphere."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> "[POSC Caesar] A burner that burns gas emitted from a process into the atmosphere."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/WasteGasDisposalFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000275> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationFunction> (flash vaporization function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationFunction> "flash vaporization function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationFunction> "A flash drum is a separator that performs flash vaporization to separate lighter components (which vaporize and are drawn off at the top) from heavier components (which remain liquid and are drawn off at the bottom)."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationProcess> (flash vaporization process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationProcess> "flash vaporization process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> (flash drum)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> "flash drum"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> "A flash drum is a separator that performs flash vaporization to separate lighter components (which vaporize and are drawn off at the top) from heavier components (which remain liquid and are drawn off at the bottom)."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> "Um tambor de flash é um separador que realiza vaporização flash para separar componentes mais leves (que vaporizam e são retirados no topo) de componentes mais pesados (que permanecem líquidos e são retirados no fundo)."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> "Every flash drum is a separator that bears a flash vaporization function and has a vapor outlet, liquid outlet, and feed inlet."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> "∀x(FlashDrum(x) ↔ Separator(x) ∧ ∃f(FlashVaporizationFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> "[ISO 15926-4] A <FLASH DRUM> is an <ARTEFACT> and a <VESSEL> in which a process stream is charged or pumped and where lighter products flash off or vaporize and are drawn off at the top. The remainer heavier fractions are drawn off at the bottom of the vessel"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> "[CFIHOS] A tank or vessel in which a process stream is charged or pumped and where lighter products flash off or vaporize and are drawn off at the top. The remainder heavier fractions are drawn off at the bottom of the vessel."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlashVaporizationFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000081>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000276> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000301>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> (fluid conduction function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> "fluid conduction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> "A flexible riser is a riser that has flexible material construction allowing vertical or near-vertical fluid conduction between seabed and surface while accommodating vessel movement."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> (fluid conduction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> "fluid conduction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidConductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> (flexible riser)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "flexible riser"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "A flexible riser is a riser that has flexible material construction allowing vertical or near-vertical fluid conduction between seabed and surface while accommodating vessel movement."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "Um riser flexível é um riser que possui construção de material flexível permitindo condução de fluido vertical ou quase vertical entre o fundo do mar e a superfície, acomodando o movimento da embarcação."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "Every flexible riser is a riser that has a flexible property"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "∀x(FlexibleRiser(x) → Riser(x) ∧ ∃q(FlexibleProperty(q) ∧ hasQuality(x,q)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "Constructive type where flexibility is a material/structural property. Under OWA, asserting equivalence would force any pipe with flexible qualities to be classified as a flexible riser, even if it serves different functions or has different deployment contexts. Starting with necessary conditions protects against false positives."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "[ISO 15926-4] A <FLEXIBLE RISER> is an <ARTEFACT> and a <RISER> that is a flexible vertical or near vertical pipe for the flow of liquid or gas between the seabed and the surface"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> "[CFIHOS] A flexible vertical or near vertical pipe for the flow of liquid or gas between the seabed and the surface."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000339>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000277> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FluidConductionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> (flow measurement function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> "flow measurement function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> "A flow meter is an instrument that bears a function to measure flow rate and produce corresponding signals or indications."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> (flow measurement process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> "flow measurement process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/MeasurementInformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> (flow meter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "flow meter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "A flow meter is an instrument that bears a function to measure flow rate and produce corresponding signals or indications."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "Um medidor de vazão é um instrumento que possui uma função de medir taxa de fluxo e produzir sinais ou indicações correspondentes."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "Every flow meter is an instrument that bears a flow measurement function and has component parts including a flow sensing element and signal processing unit"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "∀x(FlowMeter(x) ↔ Instrument(x) ∧ ∃f(FlowMeasurementFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "Over-reaching equivalence (ODR-022 §17). The definition is \"measure flow rate AND produce corresponding signals or indications\" — indication is beyond FlowMeasurementFunction, so that function alone is not sufficient. As equivalent it absorbed flow element and orifice plate, which CFIHOS and POSC define as distinct from a meter (element produces a signal; meter measures and indicates)."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "[CFIHOS] A detecting instrument intended to measure and indicate flow rate and/or produce a signal which represents the measured flow rate."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "[SLB Glossary] A device installed in a pump manifold or treating line to measure the fluid flow rate."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> "[POSC Caesar] A detecting instrument intended to measure and indicate flow rate and/or produce a signal which represents the measured flow rate."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingFunction> (flow switching function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingFunction> "flow switching function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingFunction> "A flow switch is an instrument that bears a flow switching function to automatically open or close electrical circuits when fluid flow rate reaches predetermined threshold values."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingProcess> (flow switching process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingProcess> "flow switching process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000279> (flow switch)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000279> "flow switch"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000279> "A flow switch is an instrument that bears a flow switching function to automatically open or close electrical circuits when fluid flow rate reaches predetermined threshold values."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000279> "Um interruptor de fluxo é um instrumento que possui uma função de comutação de fluxo para automaticamente abrir ou fechar circuitos elétricos quando a taxa de fluxo de fluido atinge valores de limiar predeterminados."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000279> "[ISO 15926-4] A <FLOW SWITCH> is an <INSTRUMENTATION ITEM> and a <PROCESS SWITCH> and a <FLOW MEASURING INSTRUMENT>, that is specially and exclusively designed for <SWITCHING> at a given <FLOW RATE>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000279> "[CFIHOS] A functional switch that is intended to give a signal when the flow have reached a pre-set value."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000279> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowSwitchingFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidTransportFunction> (fluid transport function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidTransportFunction> "fluid transport function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FluidTransportFunction> "A flowline is a pipeline that transports oil, gas, or water directly from a wellhead to a manifold or production facility."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidTransportFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidTransportFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidTransportProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidTransportFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidTransportProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidTransportProcess> (fluid transport process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidTransportProcess> "fluid transport process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidTransportProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidTransportProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/HydrocarbonFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidTransportProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/HydrocarbonFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> (flowline)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "flowline"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "A flowline is a pipeline that transports oil, gas, or water directly from a wellhead to a manifold or production facility."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "Uma linha de fluxo é um duto que transporta óleo, gás ou água diretamente de uma cabeça de poço para um manifold ou instalação de produção."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "Every flowline is a pipeline that bears a fluid transport function, has a wellhead connection, has a manifold or production facility connection, and transports hydrocarbon fluids."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "∀x(Flowline(x) ↔ Pipeline(x) ∧ ∃f(FluidTransportFunction(f) ∧ bearerOf(x,f)) ∧ ∃w(Wellhead(w) ∧ connectsDirectly(x,w)) ∧ ∃m((Manifold(m) ∨ ProductionFacility(m)) ∧ connectsDirectly(x,m)) ∧ ∃h(HydrocarbonFluid(h) ∧ hasInput(x,h)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "[ISO 15926-4] A <FLOWLINE> is an <ARTEFACT> and  a <PIPELINE> carrying oil, gas or water that connects the wellhead to a manifold or to production facilities, such as heater-treaters and separators"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "[SLB Glossary] The large-diameter metal pipe that connects the bell nipple under the rotary table to the possum belly at the mud tanks."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> "[OnePetro] The pipe connection between the well and the separators or tank battery."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000326>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000280> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000196> <https://www.inf.ufrgs.br/ontologies/copi/FluidTransportFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingFunction> (reactive heating function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingFunction> "reactive heating function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingFunction> "A furnace is a heater that bears the function to induce chemical reactions in process fluids through heating."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReactiveHeatingFunction> <https://www.inf.ufrgs.br/ontologies/copi/HeatingFunction>)
