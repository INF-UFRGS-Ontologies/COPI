SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoolingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> (cooler)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> "cooler"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> "A cooler is a heat exchanger that bears a CoolingFunction."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> "Um resfriador é um trocador de calor que possui uma FunçãoDeResfriamento."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> "Every cooler is a heat exchanger that has the function of cooling."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> "∀x (Cooler(x) ↔ HeatExchanger(x) ∧ ∃f (CoolingFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> "[ISO 15926-4] A <COOLER> is a <HEAT EXCHANGER> that has a capability of <COOLING>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> "[CFIHOS] A heat exchanger that is intended to cool a physical object."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> "[POSC Caesar] A heat exchanger that is intended to cool a physical object."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/CoolingFunction>)))
