SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoolingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> (cooling tower)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "cooling tower"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "A cooling tower is a heat exchanger that incorporates a tall tower structure through which air circulates by convection to remove heat from process fluids."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "Uma torre de resfriamento é um trocador de calor que incorpora uma estrutura de torre alta através da qual o ar circula por convecção para remover calor de fluidos de processo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "Every cooling tower is a heat exchanger that has a tower structure as component part at all times and participates in convective air circulation processes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "∀x(CoolingTower(x) ↔ HeatExchanger(x) ∧ ∃t(Tower(t) ∧ hasComponentPartAtAllTimes(x,t)) ∧ ∃p(ConvectiveAirCirculationProcess(p) ∧ participatesIn(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "[ISO 15926-4] A <COOLING TOWER> is an <AIR COOLED HEAT EXCHANGER> and a <TOWER> that is a tall structure through which air circulates by convection"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "[CFIHOS] A cooler and an air cooled heat exchanger that is a tall structure through which air circulates by convection."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> "[POSC Caesar] A cooler and an air cooled heat exchanger that is a tall structure through which air circulates by convection"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000235>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/CoolingFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000236> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000124>)
