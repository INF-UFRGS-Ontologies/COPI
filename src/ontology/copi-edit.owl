SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/GasDetectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/CompositionMeasurementResult>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> (gas detecting measuring element)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> "gas detecting measuring element"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> "A measuring element that bears a gas detection function, used for detecting the presence of a specified concentration of a gas."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> "Um elemento de medição que possui uma função de detecção de gás, usado para detectar a presença de uma concentração especificada de um gás."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> "GasDetectionFunction is already the sufficient condition for the 'gas detector' instrument. A measuring element bears it as a component; parthood is not a sufficient condition."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> "[ISO 15926-4] A <GAS DETECTING MEASURING ELEMENT> is a <MEASURING ELEMENT> for the detection of the presence of a specified concentration of a gas"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000573>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/GasDetectionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationFunction> (primary well isolation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationFunction> "primary well isolation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationFunction> "A valve that bears a primary well isolation function and is a component of a christmas tree, controlling all flow from the wellbore."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PrimaryWellIsolationProcess> (primary well isolation process)

