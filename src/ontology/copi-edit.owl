SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/CarrierFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/CompositionMeasurementResult>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/CompositionMeasurementResult>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> (chromatograph)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> "chromatograph"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> "A chromatograph is a process analyzer that bears a chromatographic analysis function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> "Um cromatógrafo é um analisador de processo que possui uma função de análise cromatográfica."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> "Every chromatograph is a process analyzer that has the function of chromatographic analysis."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> "∀x (Chromatograph(x) ↔ ProcessAnalyzer(x) ∧ ∃f (ChromatographicAnalysisFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> "[ISO 15926-4] A <CHROMATOGRAPH> is a <PROCESS ANALYSER> that analyses the molecular composition of a substance"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> "[CFIHOS] An analysing instrument that applies the principle of chromatography to analyse the molecular composition of a substance."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisFunction>)))
