SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementAndTransmissionProcess> <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementAndTransmissionProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementAndTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementAndTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementResult>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementResult>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> (differential pressure transmitter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> "differential pressure transmitter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> "A differential pressure transmitter is a pressure transmitter that bears a differential pressure transmission function, enabling it to measure the pressure difference between two input pressure signals and transmit this difference as a standardized output signal."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> "Um transmissor de pressão diferencial é um transmissor de pressão que possui uma função de transmissão de pressão diferencial, permitindo medir a diferença de pressão entre dois sinais de pressão de entrada e transmitir essa diferença como um sinal de saída padronizado."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> "Every differential pressure transmitter is a pressure transmitter that bears a differential pressure transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> "∀x (DifferentialPressureTransmitter(x) ↔ PressureTransmitter(x) ∧ ∃f (DifferentialPressureTransmissionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> "[ISO 15926-4] A <DIFFERENTIAL PRESSURE TRANSMITTER> is a <PRESSURE TRANSMITTER> and a <DIFFERENTIAL PRESSURE MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> "[CFIHOS] A pressure transmitter that is producing a standardized output signal dependent of a received pressure difference signal."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000110> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureTransmissionFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A double block and bleed valve is a valve that incorporates two seats each providing sealing capability and includes a means of venting the space between the seats."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> (double block and bleed valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "double block and bleed valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "A double block and bleed valve is a valve that incorporates two seats each providing sealing capability and includes a means of venting the space between the seats."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "Uma válvula de bloqueio duplo e sangria é uma válvula que incorpora duas sedes, cada uma proporcionando capacidade de vedação, e inclui um meio de ventilação do espaço entre as sedes."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "Every double block and bleed valve is a valve that has a primary seat and has a secondary seat and has a bleed port."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "∀x (DoubleBlockAndBleedValve(x) → (Valve(x) ∧ ∃p,s,b (PrimarySeat(p) ∧ SecondarySeat(s) ∧ BleedPort(b) ∧ hasComponentPartAtAllTimes(x,p) ∧ hasComponentPartAtAllTimes(x,s) ∧ hasComponentPartAtAllTimes(x,b))))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "Constructive basis - the structural differentia (dual seats plus bleed port) defines necessary conditions, but under OWA we cannot assert that ANY artifact with these structural components is definitively a double block and bleed valve, as specialized multi-way valves or custom manifolds might contain similar mechanisms without being standard maintenance categories."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "[ISO 15926-4] A <DOUBLE BLOCK AND BLEED VALVE> is a <BLOCK AND BLEED VALVE> and a <DOUBLE BLOCK VALVE> that is incorporating two seats, each of which provides a seal, and a means of venting the space between the seats. The seats may isolate with the pressure differential acting in the same or in opposite directions depending on the design"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> "[CFIHOS] A block and bleed valve that is incorporating two seats, each of which provides a seal, and a means of venting the space between the seats. The seats may isolate with the pressure differential acting in the same or in opposite directions depending on the design."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000111> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyFunction> (subsurface safety function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyFunction> "subsurface safety function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyFunction> "A down hole safety valve is a safety valve that bears a subsurface safety function for pressure relief and flow control operations in wellbore or other subsurface environments."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyFunction> <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyProcess> (subsurface safety process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyProcess> "subsurface safety process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyProcess> <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> (down hole safety valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> "down hole safety valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> "A down hole safety valve is a safety valve that bears a subsurface safety function for pressure relief and flow control operations in wellbore or other subsurface environments."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> "Uma válvula de segurança de fundo de poço é uma válvula de segurança que possui uma função de segurança subsuperficial para operações de alívio de pressão e controle de fluxo em poços ou outros ambientes subsuperficiais."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> "Every down hole safety valve is a safety valve that bears a SubsurfaceSafetyFunction and participates in SubsurfaceOperationProcess"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> "∀x(DownHoleSafetyValve(x) ↔ SafetyValve(x) ∧ ∃f(SubsurfaceSafetyFunction(f) ∧ bearerOf(x,f)) ∧ ∃p(SubsurfaceOperationProcess(p) ∧ participatesIn(x,p)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> "[ISO 15926-4] A <DOWN HOLE SAFETY VALVE> is a <SAFETY VALVE> that is intended for subsurface control/check operation"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> "[CFIHOS] A valve that is intended for subsurface control/check operation."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceSafetyFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000112> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionFunction> (electric to mechanical conversion function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionFunction> "electric to mechanical conversion function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionFunction> "An electric motor is an assembly that bears an electric-to-mechanical energy conversion function and has both a stator and rotor as essential components."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionProcess> (electric to mechanical conversion process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionProcess> "electric to mechanical conversion process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> (electric motor)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> "electric motor"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> "An electric motor is an assembly that bears an electric-to-mechanical energy conversion function and has both a stator and rotor as essential components."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> "Um motor elétrico é um conjunto que possui uma função de conversão de energia elétrica para mecânica e tem tanto um estator quanto um rotor como componentes essenciais."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> "Every electric motor is an assembly that bears an electric-to-mechanical conversion function and has component parts including a stator and rotor at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> "ElectricMotor(x) ↔ Assembly(x) ∧ ∃f(ElectricToMechanicalConversionFunction(f) ∧ bearerOf(x,f)) ∧ ∃s(Stator(s) ∧ hasComponentPartAtAllTimes(x,s)) ∧ ∃r(Rotor(r) ∧ hasComponentPartAtAllTimes(x,r))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> "[ISO 15926-4] An <ELECTRIC MOTOR> is an <ELECTRIC ROTATING MACHINE> and a <MOTOR> and an <ELECTRIC TO MECHANICAL ENERGY CONVERTER>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> "[CFIHOS] An electric machine for transforming electric energy into mechanical energy."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> "[POSC Caesar] An electric machine for transforming electric energy into mechanical energy"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ElectricToMechanicalConversionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownFunction> (emergency shut down function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownFunction> "emergency shut down function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownFunction> "An emergency shut down valve is a valve that bears an emergency shut down function, enabling rapid flow isolation in emergency situations through actuated mechanisms with fail-safe capability."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EmergencyShutDownProcess> (emergency shut down process)

