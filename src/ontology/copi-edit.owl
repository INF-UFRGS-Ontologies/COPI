SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/DownholeToolAssembly>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000378> (wireline)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000378> "wireline"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000378> "A wireline is an electrical cable that bears a wireline logging function for lowering tools into wellbores and transmitting data about wellbore conditions."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000378> "Um wireline é um cabo elétrico que possui uma função de perfilagem wireline para descer ferramentas em poços e transmitir dados sobre as condições do poço."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000378> "[ISO 15926-4] A <WIRELINE> is an <ELECTRICAL CABLE> used to lower tools into and transmit data about the conditions of the wellbore called wireline logs. Usually consisting of braided cables, wirelines are used to perform wireline logging, as well."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000378> "[SLB Glossary] schlumberger wireline, well logging, well intervention, slickline, formation evaluation"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000378> "[OnePetro] Related to any aspect of logging that employs an electrical cable to lower tools into the borehole and to transmit data. Wireline logging is distinct from measurements-while-drilling (MWD) and mud logging."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000378> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/BraidedConductor>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BraidedConductor> "braided conductor"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BraidedConductor> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementFunction> (property measurement function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementFunction> "property measurement function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementFunction> "A material artifact that bears a property measurement function, used for the measurement of a property and defined independently from the measuring instrument that handles that measurement result."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementFunction> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PropertyMeasurementProcess> (property measurement process)

