SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferMedium>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferMedium>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> (kettle reboiler)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "kettle reboiler"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "A kettle reboiler is a reboiler that has horizontal orientation and contains a separate vapour space for vapor-liquid disengagement."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "Um refervedor tipo kettle é um refervedor que possui orientação horizontal e contém um espaço de vapor separado para desengajamento vapor-líquido."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "Every kettle reboiler is a reboiler that has horizontal orientation and has a separate vapour space as component part."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "∀x(KettleReboiler(x) → Reboiler(x) ∧ ∃q(HorizontalOrientation(q) ∧ hasQuality(x,q)) ∧ ∃v(SeparateVapourSpace(v) ∧ hasComponentPartAtAllTimes(x,v)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "Constructive type defined by specific physical configuration. Under Open World Assumption, sufficient conditions could incorrectly classify equipment with horizontal orientation and vapor space but fundamentally different purposes (e.g., horizontal separators, flash drums) as kettle reboilers. The structural differentia provides necessary conditions for the kettle reboiler maintenance/procurement category."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "[ISO 15926-4] A <KETTLE REBOILER> is a <REBOILER> that is horizontal and has a separate vapour space."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> "[CFIHOS] A reboiler often boils liquid coming from the bottom of a distillation column, after which the resulting vapour is returned to the distillation column."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ReboilingFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000307> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/SeparateVapourSpace>))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparateVapourSpace> "separate vapour space"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparateVapourSpace> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationFunction> (knock out separation function)

