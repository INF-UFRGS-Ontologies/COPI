SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowlineIsolationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/FormationFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> (wing valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> "wing valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> "A valve that bears a flowline isolation function and is a component of a christmas tree, located on the flow line downstream of the master valve."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> "Uma válvula que possui uma função de isolamento de linha de fluxo e é um componente de uma árvore de natal, localizada na linha de fluxo a jusante da válvula mestra."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> "Definition is positional relative to the master valve and the flow line; not a sufficient condition under OWA."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> "[SLB Glossary] A valve located on the side of a Christmas tree or temporary surface flow equipment, such as may be used for a drillstem test."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> "[OnePetro] A valve located at the tree, above the master valve, on the flow line."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowlineIsolationFunction>))

)
