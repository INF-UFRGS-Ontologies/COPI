AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "actuation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "A diaphragm actuator is an actuator that uses a diaphragm as an essential component for converting control signals into mechanical motion or force to operate other equipment."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> (actuation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> "actuation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/ControlSignal>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> (diaphragm actuator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> "diaphragm actuator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> "A diaphragm actuator is an actuator that uses a diaphragm as an essential component for converting control signals into mechanical motion or force to operate other equipment."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> "Um atuador de diafragma é um atuador que utiliza um diafragma como componente essencial para converter sinais de controle em movimento mecânico ou força para operar outros equipamentos."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> "Classification basis is constructive - identity given by diaphragm mechanism. Under OWA, sufficient conditions would force any equipment with a diaphragm component to be classified as a diaphragm actuator, potentially including complex hybrid systems or custom equipment where the diaphragm serves auxiliary functions. Starting with necessary conditions protects against such false positives."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> "[ISO 15926-4] A <DIAPHRAGM ACTUATOR> is an <INSTRUMENTATION ITEM> and a <CONTROLLED ACTUATOR> that is using a <DIAPHRAGM>"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000248> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> (pumping function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> "pumping function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> "A diaphragm pump is a reciprocating pump that uses flexible diaphragms to displace liquid and seal the pumped fluid from atmospheric leakage."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> (pumping process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> "pumping process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PumpingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> (diaphragm pump)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "diaphragm pump"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "A diaphragm pump is a reciprocating pump that uses flexible diaphragms to displace liquid and seal the pumped fluid from atmospheric leakage."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "Uma bomba de diafragma é uma bomba alternativa que usa diafragmas flexíveis para deslocar líquido e selar o fluido bombeado contra vazamento atmosférico."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "Every diaphragm pump is a reciprocating pump that has flexible diaphragm as component part at all times and participates in diaphragm sealing."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "∀x(DiaphragmPump(x) → (ReciprocatingPump(x) ∧ ∃d(FlexibleDiaphragm(d) ∧ hasComponentPartAtAllTimes(x,d)) ∧ ∃p(DiaphragmSealing(p) ∧ participatesIn(x,p))))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "Using necessary conditions because this is a constructive type defined by physical mechanism. Under OWA, any pump with a flexible diaphragm component could be classified as a diaphragm pump, but there may be hybrid or specialized equipment containing diaphragms that should not be automatically classified into this maintenance category."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "[ISO 15926-4] A <DIAPHRAGM PUMP> is a <RECIPROCATING PUMP> intended to pump a liquid with a small capacity. This is done by means of thin flexible diaphragms to seal pumped fluid from leakage to atmosphere; flow rate is achieved through reciprocatory motion of the diaphragm"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> "[POSC Caesar] A reciprocating pump intended to pump a liquid with a small capacity. This is done by means of thin flexible diaphragms to seal pumped fluid from leakage to atmosphere."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000337>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PumpingFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/FlexibleDiaphragm>))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlexibleDiaphragm> "flexible diaphragm"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlexibleDiaphragm> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000102>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000249> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000289>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> (mechanical energy generation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> "mechanical energy generation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> "A diesel engine is an engine that ignites fuel through compression heat rather than spark ignition, requiring compression ignition and fuel injection systems."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> (mechanical energy generation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> "mechanical energy generation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FuelPortion>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfAir>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/ExhaustGas>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> (diesel engine)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> "diesel engine"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> "A diesel engine is an engine that ignites fuel through compression heat rather than spark ignition, requiring compression ignition and fuel injection systems."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> "Um motor diesel é um motor que inflama combustível através do calor de compressão em vez de ignição por centelha, requerendo sistemas de ignição por compressão e injeção de combustível."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> "Using necessary conditions for this constructive type. While compression ignition is characteristic of diesel engines, under OWA we cannot be certain that any engine with compression ignition systems is necessarily a diesel engine - there could be hybrid or specialized engines with similar mechanisms that should not be auto-classified as standard diesel engines without expert validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> "[ISO 15926-4] A <DIESEL ENGINE> is  an <INTERNAL COMBUSTION ENGINE> and a <RECIPROCATING PISTON ENGINE> in which ignition of the fuel injected into the cylinder is performed by the heat of compression of the air charge"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> "[CFIHOS] An internal combustion engine in which ignition of the fuel injected into the cylinder is performed by the heat of compression of the air charge."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> "[POSC Caesar] An internal combustion engine in which ignition of the fuel injected into the cylinder is performed by the heat of compression of the air charge."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000264>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/MechanicalEnergyGenerationFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000250> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000286>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementFunction> (differential pressure measurement function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementFunction> "differential pressure measurement function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementFunction> "A pressure element that bears a differential pressure measurement function and that consists in sensing the pressure difference between two fluid media or connection points to enable measurement of differential pressure through mechanical deflection proportional to the pressure difference."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementFunction> <https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureSensingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementProcess> (differential pressure measurement process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementProcess> "differential pressure measurement process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000251> (differential pressure measuring element)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000251> "differential pressure measuring element"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000251> "A pressure element that bears a differential pressure measurement function and that consists in sensing the pressure difference between two fluid media or connection points to enable measurement of differential pressure through mechanical deflection proportional to the pressure difference."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000251> "Um elemento de pressão que porta uma função de medição de pressão diferencial e que consiste em detectar a diferença de pressão entre duas mídias fluidas ou pontos de conexão para permitir a medição de pressão diferencial através de deflexão mecânica proporcional à diferença de pressão."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000251> "[ISO 15926-4] A <DIFFERENTIAL PRESSURE MEASURING ELEMENT> is a <PRESSURE MEASURING ELEMENT> for the measurement of <DIFFERENTIAL PRESSURE>"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000251> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000142> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureMeasurementFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingFunction> (differential pressure switching function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingFunction> "differential pressure switching function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingFunction> "A differential pressure switch is a pressure switch that bears a differential pressure switching function to switch or provide on/off signals when the measured differential pressure between two inputs reaches a pre-set value."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingProcess> (differential pressure switching process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingProcess> "differential pressure switching process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> (differential pressure switch)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> "differential pressure switch"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> "A differential pressure switch is a pressure switch that bears a differential pressure switching function to switch or provide on/off signals when the measured differential pressure between two inputs reaches a pre-set value."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> "Um interruptor de pressão diferencial é um interruptor de pressão que possui uma função de comutação de pressão diferencial para comutar ou fornecer sinais liga/desliga quando a pressão diferencial medida entre duas entradas atinge um valor pré-estabelecido."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> "Every differential pressure switch is a pressure switch that has the function to switch based on differential pressure measurements between two pressure inputs."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> "∀x(DifferentialPressureSwitch(x) ↔ PressureSwitch(x) ∧ ∃f(DifferentialPressureSwitchingFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> "[ISO 15926-4] A <DIFFERENTIAL PRESSURE SWITCH> is a <PRESSURE SWITCH> and a <DIFFERENTIAL PRESSURE MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> "[CFIHOS] A pilot switch intended to switch or give an on/off signal when the measured differential pressure has reached a pre-set value."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/DifferentialPressureSwitchingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000279>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000252> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionFunction> (energy diffusion function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionFunction> "energy diffusion function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionFunction> "A diffuser is an assembly that has the designed function of converting kinetic energy of fluid flow into pressure energy through controlled deceleration in a diverging passage."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionProcess> (energy diffusion process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionProcess> "energy diffusion process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> (diffuser)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> "diffuser"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> "A diffuser is an assembly that has the designed function of converting kinetic energy of fluid flow into pressure energy through controlled deceleration in a diverging passage."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> "Um difusor é um conjunto que tem a função projetada de converter energia cinética do fluxo de fluido em energia de pressão através de desaceleração controlada em uma passagem divergente."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> "Every diffuser is an assembly that bears an energy diffusion function and has a diverging channel as component part at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> "∀x(Diffuser(x) ↔ Assembly(x) ∧ ∃f(EnergyDiffusionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> "[ISO 15926-4] A <DIFFUSER> is a <FunctionalObject> that has the capability of <DIFFUSING> which is used in pumps to convert kinetic energy imparted by impeller to potential energy i.e. pressure head."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> "[CFIHOS] A physical object that contains a diverging channel-shaped chamber in which part of the kinetic energy of the fluid is converted into pressure energy."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnergyDiffusionFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/DivergingChannel>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DivergingChannel> "diverging channel"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DivergingChannel> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000253> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000316>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayFunction> (information display function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayFunction> "information display function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayFunction> "A Display is an Instrument that bears an InformationDisplayFunction and that presents information visually to operators or users."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayProcess> (information display process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayProcess> "information display process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/VisualIndication>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> (display)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> "display"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> "A Display is an Instrument that bears an InformationDisplayFunction and that presents information visually to operators or users."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> "Um Display é um Instrumento que possui uma InformationDisplayFunction e que apresenta informações visualmente para operadores ou usuários."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> "Display is an Instrument that necessarily bears an InformationDisplayFunction"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> "∀x(Display(x) ↔ Instrument(x) ∧ ∃f(InformationDisplayFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> "[ISO 15926-4] A <DISPLAY> is a <FunctionalObject> that is capable of <DISPLAYING> something"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> "[POSC Caesar] A physical object that is intended for presenting information."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000254> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/InformationDisplayFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> (distillation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> "distillation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> "A distillation column is a separator that bears a distillation function to enable separation of fluid mixtures based on differences in component boiling points through vapor-liquid equilibrium."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess> (distillation process)

