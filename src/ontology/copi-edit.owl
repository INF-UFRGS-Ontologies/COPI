AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionFunction> "force to electrical transduction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionFunction> "A load cell is an instrument that converts mechanical force (tension, compression, pressure, or torque) into a proportional electrical signal for measurement purposes."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionProcess> (force to electrical transduction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionProcess> "force to electrical transduction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> (load cell)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> "load cell"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> "A load cell is an instrument that converts mechanical force (tension, compression, pressure, or torque) into a proportional electrical signal for measurement purposes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> "Uma célula de carga é um instrumento que converte força mecânica (tração, compressão, pressão ou torque) em um sinal elétrico proporcional para fins de medição."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> "[ISO 15926-4] A <LOAD CELL> is an <ARTEFACT> and a <FORCE MEASURING ELEMENT> and a <TRANSDUCER> that converts a force such as tension, compression, pressure, or torque into an electrical signal that can be measured"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> "[CFIHOS] A transducer which produces a signal with a defined relationship to the force applied to it."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> "[SLB Glossary] The sensor component in a weight-indicator system that detects the tensional or compressional forces being imparted to the running string at surface."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> "[OnePetro] A device based on strain gauge technology that helps measure the surface weight of coiled tubing."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ForceToElectricalTransductionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000310> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> (fluid distribution function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> "fluid distribution function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> "A manifold is an assembly that has a chamber with multiple fluid openings designed to distribute fluid flow."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> (fluid distribution process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> "fluid distribution process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> (manifold)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "manifold"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "A manifold is an assembly that has a chamber with multiple fluid openings designed to distribute fluid flow."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "Um manifold é um conjunto que possui uma câmara com múltiplas aberturas de fluido projetada para distribuir o fluxo de fluido."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "Every manifold is an assembly that has-component-part-at-all-times some chamber and has-component-part-at-all-times some multiple fluid openings and bears some fluid distribution function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "∀x(Manifold(x) → Assembly(x) ∧ ∃c(Chamber(c) ∧ hasComponentPartAtAllTimes(x,c)) ∧ ∃o(MultipleFluidOpenings(o) ∧ hasComponentPartAtAllTimes(x,o)) ∧ ∃f(FluidDistributionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "As a constructive type, manifolds are defined by structural configuration. Under OWA, asserting equivalence would force any assembly with a chamber and multiple openings to be classified as a manifold, potentially misclassifying complex equipment with manifold-like components (e.g., turbine casings, complex valves). Starting with necessary conditions protects against false positives."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "[ISO 15926-4] A <MANIFOLD> is an <ARTEFACT> and a <FLUID CONDUCTOR> that is an arrangement of piping or valves designed to control, distribute and typically monitor fluid flow"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "[CFIHOS] A physical object that contains a chamber with several openings."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "[SLB Glossary] An arrangement of piping or valves designed to control, distribute and typically monitor fluid flow."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "[OnePetro] A junction or center for connecting several pipes and selectively routing the flow."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "[POSC Caesar] A fluid container that contains a chamber with several openings."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> "[POSC Caesar] IMF purpose entity"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FluidDistributionFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000722>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000311> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/FluidOpening>))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FluidOpening> "fluid opening"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FluidOpening> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> (actuation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "actuation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "A manual actuator is an actuator that converts human-operated control inputs into mechanical movement or force through direct physical operation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> (actuation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> "actuation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/ControlSignal>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000312> (manual actuator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000312> "manual actuator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000312> "A manual actuator is an actuator that converts human-operated control inputs into mechanical movement or force through direct physical operation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000312> "Um atuador manual é um atuador que converte entradas de controle operadas por humanos em movimento mecânico ou força através de operação física direta."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000312> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000312> "[ISO 15926-4] A <MANUAL ACTUATOR> is an <ARTEFACT> and an <ACTUATOR> which action has to be trigged manually"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000312> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000312> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingFunction> (material processing function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingFunction> "material processing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingFunction> "A mill is an assembly that bears a material processing function to reduce particle size or modify solid materials through mechanical grinding, cutting, or crushing operations."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingProcess> (material processing process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingProcess> "material processing process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfSolid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfSolid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> (mill)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> "mill"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> "A mill is an assembly that bears a material processing function to reduce particle size or modify solid materials through mechanical grinding, cutting, or crushing operations."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> "Um moinho é um conjunto que possui uma função de processamento de material para reduzir o tamanho de partículas ou modificar materiais sólidos através de operações mecânicas de moagem, corte ou trituração."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> "Every mill is an assembly that has the function to process materials, and every assembly that has the function to process materials is a mill."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> "∀x(Mill(x) ↔ (Assembly(x) ∧ ∃f(MaterialProcessingFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> "[ISO 15926-4] A <MILL> is a <FACILITY> that consists of the land, buildings, machinery, apparatus, and fixtures, mostly employed in <MANUFACTURING> of discrete <COMMODITY MATERIAL>s"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> "[SLB Glossary] A mill is usually used to remove junk in the hole or to grind away all or part of a casing string."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> "[OnePetro] A cutting tool used to grind up metal, dress off a fish, or open up a window for a kick-off."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/MaterialProcessingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000313> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MixingFunction> (mixing function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MixingFunction> "mixing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/MixingFunction> "A mixer is an assembly that has the designed function to blend or combine two or more fluid ingredients into a homogeneous mixture."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MixingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MixingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MixingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MixingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MixingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MixingProcess> (mixing process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MixingProcess> "mixing process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MixingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MixingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MixingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> (mixer)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "mixer"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "A mixer is an assembly that has the designed function to blend or combine two or more fluid ingredients into a homogeneous mixture."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "Um misturador é um conjunto que tem a função projetada de misturar ou combinar dois ou mais ingredientes fluidos em uma mistura homogênea."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "Every mixer is an assembly that bears a mixing function, and every assembly that bears a mixing function is a mixer."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "∀x (Mixer(x) ↔ (Assembly(x) ∧ ∃f (MixingFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "[ISO 15926-4] A <MIXER> is a <FunctionalObject> that has a capability of <MIXING>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "[CFIHOS] A physical object intended to be used for fluid mixing processes typically a rotating piece of equipment comprised of a driver such as a motor which rotates an agitator immersed in the fluid(s) that need to be mixed."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "[DEXPI] An apparatus or machine that has the capability of mixing (from ``_)."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> "[POSC Caesar] A fluid container that mixes two ore more fluid ingredients."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/MixingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)
