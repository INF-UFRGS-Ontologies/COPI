SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/IndicationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementProcess> (pressure measurement process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementProcess> "pressure measurement process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementResult>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> (pressure gauge)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "pressure gauge"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "A pressure gauge is an indicator that bears the function of measuring and displaying pressure values."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "Um manômetro é um indicador que possui a função de medir e exibir valores de pressão."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "Every pressure gauge is an instrument that has the function to measure and display pressure"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "∀x (PressureGauge(x) ↔ (Instrument(x) ∧ ∃f (PressureMeasurementFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "[ISO 15926-4] A <PRESSURE GAUGE> is a <PROCESS GAUGE> and a <PRESSURE MEASURING INSTRUMENT> using a <PRESSURE MEASURING ELEMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "[CFIHOS] A gauge intended to measure and display a representation of a measured pressure."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "[SLB Glossary] A device used to measure pressure."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> "[POSC Caesar] A 'pressure measuring gauge' intended to measure and display a representation of a measured pressure"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000127> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PressureMeasurementFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000143> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> (pressure transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> "pressure transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> "A pressure transmitter is a transmitter that converts pressure measurements into standardized output signals for transmission to control or monitoring systems."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction>)
