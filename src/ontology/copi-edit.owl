SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/CompressorInternals>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> (compressor casing)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> "compressor casing"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> "A Casing that is intended for housing compressor internals including the shaft with impellers and other compressor-specific mechanical components."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> "Um Invólucro que é destinado a abrigar componentes internos do compressor, incluindo o eixo com impulsores e outros componentes mecânicos específicos do compressor."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> "CompressorCasing ⊑ Casing ⊓ ∃intendedForUseWith.Compressor"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> "∀x (CompressorCasing(x) → (Casing(x) ∧ ∃y (Compressor(y) ∧ intendedForUseWith(x,y))))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> "Constructive type based on structural configuration. Under OWA, sufficient conditions for compressor-specific casing identity could lead to false positives where any enclosure intended for compressors might be classified as a standard compressor casing, including specialized or hybrid enclosures that warrant distinct classification."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> "[ISO 15926-4] A <COMPRESSOR CASING> is a  <CASING> that is the typical enclosure for compressors housing the shaft with impeller(s) and other compressor internals"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000231> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CondensationFunction> (condensation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CondensationFunction> "condensation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/CondensationFunction> "A condenser is a heat exchanger that bears a designed function to condense vapor to liquid by removing latent heat of vaporization."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CondensationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CondensationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CondensationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CondensationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CondensationProcess>))

