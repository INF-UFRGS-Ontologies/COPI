SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FiredHeatingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FiredHeatingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FiredHeatingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FiredHeatingProcess>))

