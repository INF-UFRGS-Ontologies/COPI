SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> (choke control valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "choke control valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "A choke control valve is a control valve that has a choke geometry component for pressure reduction through flow restriction."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "Uma válvula de controle de choke é uma válvula de controle que possui um componente de geometria de choke para redução de pressão através de restrição de fluxo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "Every choke control valve is a control valve that has a choke geometry component at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "∀x (ChokeControlValve(x) → ControlValve(x) ∧ ∃y (ChokeGeometry(y) ∧ hasComponentPartAtAllTimes(x,y)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "Using necessary conditions because this is classified as 'both' functional and constructive. The constructive differentia (choke geometry) makes it safer to use necessary conditions to avoid forcing all valves with choke components into this specific control category under the Open World Assumption."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "[ISO 15926-4] A <CHOKE CONTROL VALVE> is an <INSTRUMENTATION ITEM> and a <CONTROL VALVE> and a <CHOKE VALVE>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> "[CFIHOS] A choke valve that is equipped with an actuator that manipulates a stream of fluid in the response to a signal from an external sensing element and with input of energy from an external source."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000087>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000114>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000104> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureReductionFunction> (pressure reduction function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureReductionFunction> "pressure reduction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PressureReductionFunction> "A choke valve is a valve that bears a pressure reduction function, designed to reduce fluid pressure from inlet to outlet through controlled flow restriction and energy dissipation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReductionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReductionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureReductionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReductionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureReductionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureReductionProcess> (pressure reduction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureReductionProcess> "pressure reduction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReductionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> (choke valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> "choke valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> "A choke valve is a valve that bears a pressure reduction function, designed to reduce fluid pressure from inlet to outlet through controlled flow restriction and energy dissipation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> "Uma válvula choke é uma válvula que possui uma função de redução de pressão, projetada para reduzir a pressão do fluido da entrada para a saída através de restrição controlada do fluxo e dissipação de energia."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> "Every choke valve is a valve that bears a pressure reduction function and has a flow restriction element as component part at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> "∀x (ChokeValve(x) ↔ (Valve(x) ∧ ∃f (PressureReductionFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> "[ISO 15926-4] A <CHOKE VALVE> is an <ARTEFACT> and a <VALVE> in which a solid cylinder is raised and lowered, and which is placed around or inside another cylinder that has holes or slots. The design of a choke valve means fluids flowing through the cage are coming from all sides and that the streams of flow (through the holes or slots) collide with each other at the center of the cage cylinder, thereby dissipating the energy of the fluid through flow impingement. The main advantage of choke valves is that they can be designed to be totally linear in their flow rate"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> "[CFIHOS] A valve that can be used to obstruct the fluid passing inside, and has the ability to reduce the pressure from the inlet port to the outlet port."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> "[POSC Caesar] A valve that can be used to obstruct the fluid passing inside, and has the ability to reduce the pressure from the inlet port to the outlet port."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000105> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PressureReductionFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionFunction> (electrical current interruption function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionFunction> "electrical current interruption function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionFunction> "A circuit breaker is a material artifact that bears an electrical current interruption function and regularly participates in processes that safely interrupt electrical current."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionProcess> (electrical current interruption process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionProcess> "electrical current interruption process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> (circuit breaker)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> "circuit breaker"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> "A circuit breaker is a material artifact that bears an electrical current interruption function and regularly participates in processes that safely interrupt electrical current."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> "Um disjuntor é um dispositivo de chaveamento elétrico que possui uma função de interrupção de corrente elétrica e participa regularmente em processos que interrompem com segurança a corrente elétrica."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> "[ISO 15926-4] A <CIRCUIT BREAKER> is an <ELECTRICAL APPARATUS> and a <SWITCHING DEVICE> that at regular intervals interrupts an electric current"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> "[CFIHOS] A mechanical switching device that at regular intervals interrupts an electric current."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> "[POSC Caesar] A mechanical switching device that at regular intervals interrupts an electric current."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCurrentInterruptionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000282>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CoalescenceFunction> (coalescence function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CoalescenceFunction> "coalescence function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/CoalescenceFunction> "A coalescer is a separator that uses coalescence media to promote droplet merger in immiscible liquid mixtures, enabling gravity-based separation where the less dense liquid phase can be skimmed off."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoalescenceFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoalescenceFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CoalescenceProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoalescenceFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CoalescenceProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CoalescenceProcess> (coalescence process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CoalescenceProcess> "coalescence process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoalescenceProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoalescenceProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoalescenceProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CoalescenceProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> (coalescer)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> "coalescer"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> "A coalescer is a separator that uses coalescence media to promote droplet merger in immiscible liquid mixtures, enabling gravity-based separation where the less dense liquid phase can be skimmed off."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> "Um coalescedor é um separador que usa meio de coalescência para promover a fusão de gotículas em misturas líquidas imiscíveis, permitindo separação por gravidade onde a fase líquida menos densa pode ser removida por escumação."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> "Every coalescer is a separator that bears a coalescence function and participates in gravity separation processes to produce skimmable liquid portions."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> "∀x (Coalescer(x) ↔ (Separator(x) ∧ ∃f(CoalescenceFunction(f) ∧ bearerOf(x,f)) ∧ ∃p(GravitySeparationProcess(p) ∧ participatesIn(x,p)) ∧ ∃o(SkimmableLiquidPortion(o) ∧ hasOutput(x,o))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> "[ISO 15926-4] A <COALESCER> is a <GRAVITY SEPARATOR> where two liquid substances separates and where the substance with the less gravity can be skimmed off."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> "[CFIHOS] A gravity separator where two liquid substances separates and where the substance with the less gravity can be skimmed off."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> "[POSC Caesar] A gravity separator where two liquid substances separates and where the substance with the less gravity can be skimmed off."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/CoalescenceFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000107> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225>)
