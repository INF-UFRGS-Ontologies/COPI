SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CombustionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CombustionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FuelPortion>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CombustionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfAir>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CombustionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/CombustionProduct>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220> (burner)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220> "burner"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220> "A burner is a heater that releases thermal energy by burning a combustible mixture of fuel and air."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220> "Um queimador é um aquecedor que libera energia térmica através da queima de uma mistura combustível de combustível e ar."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220> "Every burner is a heater that has the function of combustion, which is realized by burning a fuel-air mixture to release thermal energy."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220> "∀x (Burner(x) ↔ (Heater(x) ∧ ∃f (CombustionFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220> "[ISO 15926-4] A <BURNER> is a <FunctionalObject> that is intended to release thermal energy by burning a combustible mixture"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000220> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000124> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/CombustionFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CableSupportFunction> (cable support function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CableSupportFunction> "cable support function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/CableSupportFunction> "A cable tray is an assembly that bears a cable support function and consists of a continuous base with raised edges, forming a rigid structural system for securely supporting and routing electrical cables."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CableSupportFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CableSupportFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CableSupportProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CableSupportFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CableSupportProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CableSupportProcess> (cable support process)

