SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ChromatographicAnalysisProcess>))

