SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureSignalTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> (pressure transmitter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> "pressure transmitter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> "A pressure transmitter is a transmitter that converts pressure measurements into standardized output signals for transmission to control or monitoring systems."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> "Um transmissor de pressão é um transmissor que converte medições de pressão em sinais de saída padronizados para transmissão a sistemas de controle ou monitoramento."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> "[ISO 15926-4] A <PRESSURE TRANSMITTER> is a <PROCESS VARIABLE TRANSMITTER> and a <PRESSURE MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> "[CFIHOS] A transmitter that is producing a standardized output signal dependent of a received input signal from a pressure element."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> "[ISA 5.1] ISA 5.1 tag abbreviation 'PT'. First letter 'P': Pressure. Succeeding letters: 'T' = Transmit."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureReliefFunction> (pressure relief function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureReliefFunction> "pressure relief function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PressureReliefFunction> "A relief valve is a valve that is designed to automatically open at a predetermined pressure setpoint to relieve excess pressure and prevent unsafe pressure levels in a system."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReliefFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReliefFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureReliefProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReliefFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureReliefProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureReliefProcess> (pressure relief process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureReliefProcess> "pressure relief process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReliefProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReliefProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureReliefProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> (relief valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "relief valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "A relief valve is a valve that is designed to automatically open at a predetermined pressure setpoint to relieve excess pressure and prevent unsafe pressure levels in a system."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "Uma válvula de alívio é uma válvula projetada para abrir automaticamente em um ponto de ajuste de pressão predeterminado para aliviar o excesso de pressão e prevenir níveis de pressão inseguros em um sistema."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "Every relief valve is a valve that bears a pressure relief function, which realizes a pressure relief process that automatically opens the valve when system pressure exceeds a predetermined setpoint."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "∀x (ReliefValve(x) ↔ (Valve(x) ∧ ∃f (PressureReliefFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "[ISO 15926-4] A <RELIEF VALVE> is an <INSTRUMENTATION ITEM> and a <PRESSURE RELIEF DEVICE> that is set to open at a certain pressure level to prevent the pressure in a container or system from reaching unsafe levels"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "[CFIHOS] A self operating valve that is set to open at a certain pressure level to prevent the pressure in a container or system from reaching unsafe levels."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "[SLB Glossary] A quick-acting, spring-loaded valve that opens to relieve pressure when the pressure exceeds the spring setting."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "[OnePetro] A valve in a pressurized system that is set to open and relieve pressure at a certain pressure level."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> "[POSC Caesar] A self operating valve that is set to open at a certain pressure level to prevent the pressure in a container or system from reaching unsafe levels."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PressureReliefFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000145> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionFunction> (flow restriction function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionFunction> "flow restriction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionFunction> "A restriction orifice is a flow modification accessory that bears the function to restrict fluid flow by creating controlled pressure drop through geometric constriction."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionProcess> (flow restriction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionProcess> "flow restriction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> (restriction orifice)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> "restriction orifice"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> "A restriction orifice is a flow modification accessory that bears the function to restrict fluid flow by creating controlled pressure drop through geometric constriction."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> "Um orifício de restrição é um acessório de modificação de fluxo que possui a função de restringir o fluxo de fluido criando queda de pressão controlada através de constrição geométrica."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> "Every restriction orifice is a flow modification accessory that bears a flow restriction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> "∀x(RestrictionOrifice(x) ↔ FlowModificationAccessory(x) ∧ ∃f(FlowRestrictionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> "[ISO 15926-4] A <RESTRICTION ORIFICE> is a <FLOW MODIFICATION ACCESSORY> that is intended for use as a restrictor"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000083> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowRestrictionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000146> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction> (safety relief function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction> "safety relief function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction> "A safety relief valve is a valve that bears a safety relief function combining both safety protection and pressure relief capabilities."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> (safety relief process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> "safety relief process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000147> (safety relief valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000147> "safety relief valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000147> "A safety relief valve is a valve that bears a safety relief function combining both safety protection and pressure relief capabilities."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000147> "Uma válvula de segurança e alívio é uma válvula que possui uma função de alívio de segurança que combina capacidades de proteção de segurança e alívio de pressão."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000147> "Every safety relief valve is a valve that has the function of providing both safety protection and pressure relief."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000147> "∀x(SafetyReliefValve(x) ↔ (Valve(x) ∧ ∃f(SafetyReliefFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000147> "[ISO 15926-4] A <SAFETY RELIEF VALVE> is a <SAFETY VALVE> and a <RELIEF VALVE>"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000147> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SafetyVentingFunction> (safety venting function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SafetyVentingFunction> "safety venting function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SafetyVentingFunction> "A safety valve is a valve that bears a safety venting function for automatic pressure relief through rapid full opening to protect against dangerous overpressure conditions."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyVentingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyVentingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyVentingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> (safety relief process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> "safety relief process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SafetyReliefProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> (safety valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> "safety valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> "A safety valve is a valve that bears a safety venting function for automatic pressure relief through rapid full opening to protect against dangerous overpressure conditions."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> "Uma válvula de segurança é uma válvula que possui uma função de ventilação de segurança para alívio automático de pressão por abertura rápida e total para proteção contra condições perigosas de sobrepressão."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> "Every safety valve is a valve that has the function to automatically relieve excess pressure for emergency protection"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> "∀x(SafetyValve(x) ↔ Valve(x) ∧ ∃f(SafetyReliefFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> "[ISO 15926-4] A <SAFETY VALVE> is an <INSTRUMENTATION ITEM> and a <PRESSURE RELIEF DEVICE> that is used in gas service"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> "[SLB Glossary] A quick-opening, pop-action valve used for fast relief of excessive pressure."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> "[OnePetro] Various. Generally used in describing a surface or subsurface safety valve."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SafetyVentingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000148> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A self-operating valve is a valve that includes an internal means of operation (such as spring, gravity, fluid pressure, or counterbalance) and does not depend on an external source of energy for its actuation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> (self-operating valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "self-operating valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "A self-operating valve is a valve that includes an internal means of operation (such as spring, gravity, fluid pressure, or counterbalance) and does not depend on an external source of energy for its actuation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "Uma válvula auto-operante é uma válvula que inclui um mecanismo interno de operação (como mola, gravidade, pressão do fluido ou contrapeso) e não depende de uma fonte externa de energia para seu acionamento."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "Every self-operating valve is a valve that has a self-operating mechanism as component part at all times and bears the capability of energy-independent operation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "∀x(SelfOperatingValve(x) → Valve(x) ∧ ∃m(SelfOperatingMechanism(m) ∧ hasComponentPartAtAllTimes(x,m)) ∧ ∃c(EnergyIndependentOperationCapability(c) ∧ bearerOf(x,c)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "Using necessary conditions because this is a constructive type defined by physical configuration (self-operating mechanism). Under OWA, any valve with an internal operating mechanism might be classified as self-operating even if it has additional external actuators or specialized applications. Domain expert validation needed to confirm structural differentia is sufficient."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "[ISO 15926-4] A <SELF-OPERATING VALVE> is an <INSTRUMENTATION FUNCTION> and a <VALVE> that includes a means of operation (e.g. spring / gravity / fluid pressure / counter balance), and is not depending on an external source of energy"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> "[CFIHOS] A valve that includes a means of operation (e.g. spring / gravity / fluid pressure / counter balance), and is not depending on an external source of energy."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000149> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A solenoid valve is a valve that has a solenoid actuator for electrical control of fluid flow."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> (solenoid valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "solenoid valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "A solenoid valve is a valve that has a solenoid actuator for electrical control of fluid flow."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "Uma válvula solenoide é uma válvula que possui um atuador solenoide para controle elétrico do fluxo de fluido."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "Every solenoid valve is a valve that has a solenoid actuator component and bears an electrical control function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "∀x (SolenoidValve(x) → Valve(x) ∧ ∃s (SolenoidActuator(s) ∧ hasComponentPartAtAllTimes(x,s)) ∧ ∃f (ElectricalControlFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "Using necessary conditions because this is a constructive type where the solenoid mechanism is the distinguishing structural feature. Under OWA, making it equivalent could incorrectly classify complex valve assemblies that contain solenoid components but are not standard solenoid valves."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "[ISO 15926-4] A <SOLENOID VALVE> is an <ACTUATED VALVE> and an <ELECTRICAL ELEMENT> with a linear action, fitted with a solenoid for quick operation"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "[CFIHOS] A valve that has linear action which is fitted with a solenoid for quick operation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> "[POSC Caesar] A valve that has linear action which is fitted with a solenoid for quick operation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000150> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000133>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/StorageFunction> (storage function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/StorageFunction> "storage function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/StorageFunction> "A storage tank is a vessel that is designed to store fluids or materials for extended periods without transformation or active processing."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StorageFunction> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StorageFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/StorageProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StorageFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/StorageProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/StorageProcess> (storage process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/StorageProcess> "storage process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StorageProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StorageProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StorageProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> (storage tank)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> "storage tank"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> "A storage tank is a vessel that is designed to store fluids or materials for extended periods without transformation or active processing."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> "Um tanque de armazenamento é um vaso projetado para armazenar fluidos ou materiais por períodos prolongados sem transformação ou processamento ativo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> "Every storage tank is a tank that has the function to store materials for extended periods."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> "∀x(StorageTank(x) ↔ (Tank(x) ∧ ∃f(ExtendedStorageFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> "[ISO 15926-4] A <STORAGE TANK> is an <ARTEFACT> and a <TANK> that is intended for storage"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/StorageFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> (separation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> "separation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> "A strainer is a material artifact that bears a separation function and has a filtering element, designed to separate solid particles from fluids by passing the fluid through screens or perforations."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> (separation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> "separation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfSolid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> (strainer)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "strainer"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "A strainer is a material artifact that bears a separation function and has a filtering element, designed to separate solid particles from fluids by passing the fluid through screens or perforations."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "Um filtro grosso é um artefato material que possui uma função de separação e tem um elemento filtrante, projetado para separar partículas sólidas de fluidos fazendo o fluido passar através de telas ou perfurações."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "Every strainer is a material artifact that bears a separation function and has a filtering element as component part at all times and participates in solid-liquid separation processes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "∀x(Strainer(x) ↔ (MaterialArtifact(x) ∧ ∃f(SeparationFunction(f) ∧ bearerOf(x,f)) ∧ ∃e(FilteringElement(e) ∧ hasComponentPartAtAllTimes(x,e)) ∧ ∃p(SolidLiquidSeparationProcess(p) ∧ participatesIn(x,p))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "[ISO 15926-4] A <STRAINER> is a <FunctionalObject> that is capable of <STRAINING>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "[CFIHOS] A filter that is separating solid particles from a fluid by passing the fluid through a wire mesh, screen or metal plates containing perforations or slits."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "[SLB Glossary] A device used to catch and hold the debris flowing in pipelines."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> "[POSC Caesar] A mechanical separator that is separating solid particles from a fluid by passing the fluid through a wire mesh, screen or metal plates containing perforations or slits."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000152> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> (backflow prevention function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "backflow prevention function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "A swing check valve is a check valve that has a closure member consisting of a disc which swings freely on a hinge mechanism and opens automatically when flow is established and closes automatically when flow ceases or reverses."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> (backflow prevention process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> "backflow prevention process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> (swing check valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "swing check valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "A swing check valve is a check valve that has a closure member consisting of a disc which swings freely on a hinge mechanism and opens automatically when flow is established and closes automatically when flow ceases or reverses."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "Uma válvula de retenção basculante é uma válvula de retenção que possui um elemento de fechamento consistindo de um disco que gira livremente em um mecanismo de dobradiça e abre automaticamente quando o fluxo é estabelecido e fecha automaticamente quando o fluxo cessa ou se inverte."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "Every swing check valve is a check valve that has a hinged disc as component part and has a swing arm as component part"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "∀x(SwingCheckValve(x) → CheckValve(x) ∧ ∃d(HingedDisc(d) ∧ hasComponentPartAtAllTimes(x,d)) ∧ ∃a(SwingArm(a) ∧ hasComponentPartAtAllTimes(x,a)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "Using necessary conditions for this constructive type to avoid false positives under OWA. Any artifact with a hinged disc mechanism should not automatically be classified as a swing check valve without domain expert validation, as specialized equipment may contain swing mechanisms but serve different primary functions."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "[ISO 15926-4] A <SWING CHECK VALVE> is an <ARTEFACT> and a <CHECK VALVE> where the closure member is a disc which swings freely on a hinge and which opens automatically when flow is established and closes automatically when flow ceases or is reversed"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "[CFIHOS] A check valve that is a check valve where the closure member is a disc which swings freely on a hinge and which opens automatically when flow is established and closes automatically when flow ceases or is reversed."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "[SLB Glossary] A check valve in which the closure element is a hinged clapper that swings or rotates about a supporting shaft."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> "[POSC Caesar] A check valve that is a check valve where the closure member is a disc which swings freely on a hinge and which opens automatically when flow is established and closes automatically when flow ceases or is reversed."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000153> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> (temperature indication function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> "temperature indication function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> "A temperature indicator is an indicator that measures temperature and displays the measured value locally at the instrument location."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> <https://www.inf.ufrgs.br/ontologies/copi/IndicationFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/IndicationFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/IndicationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess> (temperature indication process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess> "temperature indication process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementResult>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000154> (temperature indicator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000154> "temperature indicator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000154> "A temperature indicator is an indicator that measures temperature and displays the measured value locally at the instrument location."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000154> "Um indicador de temperatura é um indicador que mede temperatura e exibe o valor medido localmente na localização do instrumento."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000154> "[ISA 5.1] A temperature indicator (TI) is an instrument that measures temperature and displays the measured value locally at the instrument location. It typically consists of a temperature sensing element (thermocouple, RTD, or bimetal), a transmitting or mechanical linkage, and a local display. Unlike a temperature transmitter, it does not produce a standardized remote output signal; its function is limited to local indication for operator reading."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000154> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000127> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionFunction> (temperature measurement and transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionFunction> "temperature measurement and transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionFunction> "A temperature transmitter is a transmitter that measures temperature and produces a standardized output signal dependent on the received input signal from a temperature element."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionProcess> (temperature measurement and transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionProcess> "temperature measurement and transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementResult>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> (temperature transmitter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "temperature transmitter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "A temperature transmitter is a transmitter that measures temperature and produces a standardized output signal dependent on the received input signal from a temperature element."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "Um transmissor de temperatura é um transmissor que mede temperatura e produz um sinal de saída padronizado dependente do sinal de entrada recebido de um elemento de temperatura."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "Every temperature transmitter is a transmitter that has the function to measure temperature and transmit standardized signals based on temperature input."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "∀x(TemperatureTransmitter(x) ↔ Transmitter(x) ∧ ∃f(TemperatureMeasurementAndTransmissionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "[ISO 15926-4] A <TEMPERATURE TRANSMITTER>is a <PROCESS VARIABLE TRANSMITTER> and a <TEMPERATURE MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "[CFIHOS] A transmitter that is producing a standardized output signal dependent of a received input signal from a temperature element."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "[ISA 5.1] ISA 5.1 tag abbreviation 'TT'. First letter 'T': Temperature. Succeeding letters: 'T' = Transmit."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> "[POSC Caesar] A 'transmitter' that is producing a standardized output signal dependent of a received input signal from a 'temperature element'."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementAndTransmissionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> (temperature sensor protection function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> "temperature sensor protection function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> "A thermowell is an instrument that is a pressure-tight receptacle adapted to receive a temperature sensing element, provided with external threads or other means for pressure-tight attachment to a vessel or pipe."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess> (temperature sensor protection process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess> "temperature sensor protection process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/SensingElement>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/SensingElement>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> (thermowell)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "thermowell"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "A thermowell is an instrument that is a pressure-tight receptacle adapted to receive a temperature sensing element, provided with external threads or other means for pressure-tight attachment to a vessel or pipe."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "Um poço termométrico é um instrumento que é um receptáculo resistente à pressão adaptado para receber um elemento sensor de temperatura, provido com roscas externas ou outros meios para fixação resistente à pressão a um vaso ou tubulação."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "Every thermowell is an instrument that has a pressure-tight receptacle as component part and has a process connection as component part and is designed for temperature sensing elements."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "∀x (Thermowell(x) → Instrument(x) ∧ ∃r,c,f (PressureTightReceptacle(r) ∧ ProcessConnection(c) ∧ TemperatureSensorProtectionFunction(f) ∧ hasComponentPartAtAllTimes(x,r) ∧ hasComponentPartAtAllTimes(x,c) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "Thermowell has constructive classification basis. The structural differentia (pressure-tight receptacle with process connection) defines necessary conditions, but making these sufficient under OWA could lead to false classifications of other threaded pressure-tight devices that happen to contain receptacles but are not intended as thermowells."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "[ISO 15926-4] A <THERMOWELL> is an <INSTRUMENT COMPONENT> that is a pressure-tight receptacle adapted to receive a temperature sensing element, provided with external threads or other means for pressure-tight attachment to a vessel or pipe"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "[CFIHOS] A physical object that is a pressure-tight receptacle adapted to receive a temperature sensing element, provided with external threads or other means for pressure-tight attachment to a vessel or pipe."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> "[POSC Caesar] An 'artefact' that is a pressure-tight receptacle adapted to receive a temperature sensing element, provided with external threads or other means for pressure-tight attachment to a vessel or pipe"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000156> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction> (signal transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction> "signal transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction> "A transmitter is an instrument that bears a signal transmission function, receiving process variable signals from sensors and converting them into standardized output signals for transmission to control systems."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction> <https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InstrumentationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess> (signal transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess> "signal transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/MeasurementInformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> (transmitter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> "transmitter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> "A transmitter is an instrument that bears a signal transmission function, receiving process variable signals from sensors and converting them into standardized output signals for transmission to control systems."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> "Um transmissor é um instrumento que possui uma função de transmissão de sinal, recebendo sinais de variáveis de processo de sensores e convertendo-os em sinais de saída padronizados para transmissão a sistemas de controle."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> "[ISO 15926-4] A <TRANSMITTER> is a <FunctionalObject> that is capable of <TRANSMITTING>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> "[CFIHOS] A physical object that is an element that receives a process variable signal from a sensor and converts it into an output signal."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> "[DEXPI] A detecting instrument that generates a process variable signal and converts it into an output signal."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> "[ISA 5.1] a device that senses a process variable through the medium of a sensor or measuring element and has an output whose steady-state value varies only as a predetermined function of the process variable."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> "[POSC Caesar] A 'detecting instrument' that generates a process variable signal and converts it into an output signal."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207>)

