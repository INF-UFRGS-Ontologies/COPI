SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidBulkStorageProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidBulkStorageProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfSolid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SolidBulkStorageProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfSolid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> (silo)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> "silo"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> "A silo is a vessel that bears a solid bulk storage function and has a conical bottom section for facilitating the storage and discharge of bulk solid materials."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> "Um silo é um vaso que possui uma função de armazenamento de sólidos a granel e tem uma seção inferior cônica para facilitar o armazenamento e descarga de materiais sólidos a granel."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> "Every silo is a vessel that has the function of storing bulk solids and has a conical bottom component."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> "∀x (Silo(x) ↔ (Vessel(x) ∧ ∃f(SolidBulkStorageFunction(f) ∧ bearerOf(x,f)) ∧ ∃c(ConicalBottom(c) ∧ hasComponentPartAtAllTimes(x,c))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> "[ISO 15926-4] A <SILO> is a <CONTAINER> with a conical shape that is intended to store solids in bulk"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> "[CFIHOS] A vessel that has a bottom in the shape of a cone and is intended to store solid particles."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> "[DEXPI] A with a conical shape that is intended to store solids in bulk (from ``_)."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000351> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SolidBulkStorageFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportFunction> (equipment support function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportFunction> "equipment support function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportFunction> "A skid is an assembly that bears an equipment support function, consisting of a support frame and mounting points, designed to support equipment items during manufacturing, transportation, handling, and installation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportProcess> (equipment support process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportProcess> "equipment support process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/EquipmentItem>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/EquipmentItem>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> (skid)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "skid"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "A skid is an assembly that bears an equipment support function, consisting of a support frame and mounting points, designed to support equipment items during manufacturing, transportation, handling, and installation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "Um skid é uma montagem que possui uma função de suporte de equipamento, consistindo de uma estrutura de suporte e pontos de montagem, projetada para suportar itens de equipamento durante fabricação, transporte, manuseio e instalação."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "Every skid is an assembly that bears an equipment support function and has a support frame and mounting points as component parts at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "∀x(Skid(x) ↔ (Assembly(x) ∧ ∃f(EquipmentSupportFunction(f) ∧ bearerOf(x,f)) ∧ ∃s(SupportFrame(s) ∧ hasComponentPartAtAllTimes(x,s)) ∧ ∃m(MountingPoint(m) ∧ hasComponentPartAtAllTimes(x,m))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "[ISO 15926-4] A <SKID> is an <ARTEFACT> and a <SUPPORT> intended to support items when being manufactured, transported, handled or installed"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "[SLB Glossary] A steel frame on which portable equipment is mounted to facilitate handling with cranes or flatbed trucks."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "[OnePetro] Move a well to a close-by locations with minimum rig down of equipment."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> "[POSC Caesar] A 'support' intended to support items when being manufactured, transported, handled or installed."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000352> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EquipmentSupportFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> (actuation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "actuation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "A solenoid actuator is an electric actuator that utilizes a continuous duty linear solenoid to convert electrical energy into mechanical power via a plunger with an axial stroke in either a push or pull action."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> (actuation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> "actuation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> (solenoid actuator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> "solenoid actuator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> "A solenoid actuator is an electric actuator that utilizes a continuous duty linear solenoid to convert electrical energy into mechanical power via a plunger with an axial stroke in either a push or pull action."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> "Um atuador solenoide é um atuador elétrico que utiliza um solenoide linear de serviço contínuo para converter energia elétrica em energia mecânica através de um êmbolo com curso axial em ação de empurrar ou puxar."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> "Constructive type defined by solenoid mechanism. Under OWA, sufficient conditions would force any device with solenoid and plunger components to be classified as a solenoid actuator, potentially misclassifying complex hybrid devices or specialized equipment containing solenoid components but serving different primary functions."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> "[ISO 15926-4] A <SOLENOID ACTUATOR> is an <ELECTRIC ACTUATOR> and an <ELECTRIC TO MECHANICAL ENERGY CONVERTER> and an <ELECTROMECHANICAL DEVICE>  that is utilizing a continuous duty linear solenoid to convert electrical energy into mechanical power via a plunger with an axial stroke in either a push or pull action"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000260>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000353> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SpacingFunction> (spacing function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SpacingFunction> "spacing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SpacingFunction> "A spacer is a material artifact that has the function of maintaining spatial separation or distance between physical objects or fluids."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SpacingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SpacingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SpacingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SpacingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SpacingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SpacingProcess> (spacing process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SpacingProcess> "spacing process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SpacingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SpacingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PhysicalObject>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SpacingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PhysicalObject>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> (spacer)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "spacer"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "A spacer is a material artifact that has the function of maintaining spatial separation or distance between physical objects or fluids."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "Um espaçador é um artefato material que tem a função de manter separação espacial ou distância entre objetos físicos ou fluidos."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "Every spacer is a material artifact that bears a spacing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "∀x(Spacer(x) ↔ MaterialArtifact(x) ∧ ∃f(SpacingFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "[ISO 15926-4] A <SPACER> is a <FunctionalObject> that has the capability of <SPACING>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "[CFIHOS] A physical object that is intended to keep other physical objects at a predefined distance and hence having a spacer function."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "[SLB Glossary] A viscous fluid used to aid removal of drilling fluids before a primary cementing operation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> "[OnePetro] In the context of pumping, a spacer is a fluid used between two fluids to prevent contamination."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/MaterialArtifact> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SpacingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000354> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentFunction> (stationary machine component function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentFunction> "stationary machine component function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentFunction> "A MaterialArtifact that bears a StationaryMachineComponentFunction and that is the stationary structural component within rotating machinery, providing housing and positional stability for active elements such as windings, vanes, or seals."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentProcess> (stationary machine component process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentProcess> "stationary machine component process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> (stator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "stator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "A MaterialArtifact that bears a StationaryMachineComponentFunction and that is the stationary structural component within rotating machinery, providing housing and positional stability for active elements such as windings, vanes, or seals."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "Um MaterialArtifact que possui uma StationaryMachineComponentFunction e que é o componente estrutural estacionário dentro de máquinas rotativas, fornecendo alojamento e estabilidade posicional para elementos ativos como bobinas, palhetas ou vedações."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "Every Stator is a MaterialArtifact that bears a StationaryMachineComponentFunction and is part of some RotatingMachine"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "∀x(Stator(x) → MaterialArtifact(x) ∧ ∃f(StationaryMachineComponentFunction(f) ∧ bearerOf(x,f)) ∧ ∃m(RotatingMachine(m) ∧ partOf(x,m)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "Constructive classification based on structural positioning within rotating machinery. Under OWA, any artifact described as stationary within a rotating machine context could be classified as a stator, but this may include specialized hybrid components, mounting structures, or custom configurations that should not be automatically asserted into the standard stator maintenance category. The structural differentia (stationary positioning) is necessary but making it sufficient requires domain expert validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "[ISO 15926-4] A <STATOR> is a <MACHINE COMPONENT> that is the arrangement of primary coils being the stator winding and being the stationary part of a machine"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> "[OnePetro] In the context of a PDM motor, a stator is the stationary rubber element of a PDM motor."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/StationaryMachineComponentFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000355> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtSomeTime> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionFunction> (electrical conduction function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionFunction> "electrical conduction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionFunction> "A switch contact is an electrical contact that is one of the conductive parts forming a contact assembly."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionProcess> (electrical conduction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionProcess> "electrical conduction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> (switch contact)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> "switch contact"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> "A switch contact is an electrical contact that is one of the conductive parts forming a contact assembly."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> "Um contato de chave é um contato elétrico que é uma das partes condutoras que formam um conjunto de contato."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> "Constructive type based on structural role as a conductive part. Under OWA, asserting sufficient conditions could incorrectly classify any conductive part of an electrical contact as a switch contact, when there may be other specialized conductive components (bus bars, terminals, etc.) that serve different structural roles."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> "[ISO 15926-4] A <SWITCH CONTACT> is an <ELECTRICAL CONTACT> that is one of the conductive parts forming a contact."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000356> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalConductionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlFunction> (electrical circuit control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlFunction> "electrical circuit control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlFunction> "A switchboard is electrical equipment that consists of panels accommodating switches, indicators, and control apparatus for connecting, disconnecting, and controlling various circuits of an electrical system."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlProcess> (electrical circuit control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlProcess> "electrical circuit control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> (switchboard)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> "switchboard"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> "A switchboard is electrical equipment that consists of panels accommodating switches, indicators, and control apparatus for connecting, disconnecting, and controlling various circuits of an electrical system."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> "Um quadro de distribuição é um equipamento elétrico que consiste em painéis que acomodam chaves, indicadores e aparatos de controle para conectar, desconectar e controlar vários circuitos de um sistema elétrico."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> "[ISO 15926-4] A <SWITCHBOARD> is an <ARTEFACT> and a <SWITCHING DEVICE>that is one or more panels accommodating control switches, indicators, and other apparatus for operating electric circuits"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> "[CFIHOS] A switchgear and controlgear bearing a set of switches for connecting and disconnecting the various circuits of an electrical system, as of a telegraph, telephone, etc."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> "[POSC Caesar] A switchgear and controlgear bearing a set of switches for connecting and disconnecting the various circuits of an electrical system, as of a telegraph, telephone, etc."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCircuitControlFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000724>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/ControlIndicator>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ControlIndicator> "control indicator"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ControlIndicator> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000357> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000113>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementFunction> (temperature measurement function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementFunction> "temperature measurement function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementFunction> "A temperature measuring element is a measuring element that has the function to measure temperature."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementProcess> (temperature measurement process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementProcess> "temperature measurement process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/MeasurementInformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> (temperature measuring element)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> "temperature measuring element"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> "A temperature measuring element is a measuring element that has the function to measure temperature."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> "Um elemento de medição de temperatura é um elemento de medição que tem a função de medir temperatura."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> "Every temperature measuring element is a measuring element that has a temperature measurement function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> "∀x(TemperatureMeasuringElement(x) ↔ MeasuringElement(x) ∧ ∃f(TemperatureMeasurementFunction(f) ∧ hasFunction(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> "[ISO 15926-4] A <TEMPERATURE MEASURING ELEMENT> is a <MEASURING ELEMENT> for the measurement of <TEMPERATURE>"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000076> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureMeasurementFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000358> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000082>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> (temperature sensor protection function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> "temperature sensor protection function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> "A thermowell stem is a fiat object part that is part of a thermowell and that has a hollow cylindrical shape positioned to protrude into the process medium, providing protective housing for temperature sensing elements while enabling thermal conduction."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess> (temperature sensor protection process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess> "temperature sensor protection process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> (thermowell stem)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> "thermowell stem"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> "A thermowell stem is a fiat object part that is part of a thermowell and that has a hollow cylindrical shape positioned to protrude into the process medium, providing protective housing for temperature sensing elements while enabling thermal conduction."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> "Um termowell stem é uma parte de objeto fiducial que é parte de um termowell e que tem uma forma cilíndrica oca posicionada para se projetar no meio do processo, fornecendo habitação protetora para elementos de detecção de temperatura enquanto permite condução térmica."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> "Every thermowell stem is a fiat object part that is part of some thermowell and has hollow cylindrical shape and is located in process medium intrusion zone."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> "∀x(ThermowellStem(x) → FiatObjectPart(x) ∧ ∃y(Thermowell(y) ∧ partOf(x,y)) ∧ ∃q(HollowCylindricalShape(q) ∧ hasQuality(x,q)) ∧ ∃l(ProcessMediumIntrusionZone(l) ∧ hasLocation(x,l)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> "Constructive classification basis. The structural differentia (hollow cylindrical shape, positioning in process medium) is necessary but may not be sufficient under OWA - there could be other specialized parts of thermowells with similar geometry but different specific roles or configurations."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> "[ISO 15926-4] A <THERMOWELL STEM> is an <INSTRUMENTATION ITEM> and a <Feature> and an <ENCLOSURE> that is the hollow cylindrical part of a thermowell that is housing the thermocouple or thermoelement and is protruding into the process medium"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000359> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureSensorProtectionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportFunction> (structural support function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportFunction> "structural support function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportFunction> "A Plate that has thin thickness geometry and is manufactured through cold forming processes, typically used for structural support applications requiring reduced weight or specific geometric constraints."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportProcess> (structural support process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportProcess> "structural support process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> (thin plate)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> "thin plate"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> "A Plate that has thin thickness geometry and is manufactured through cold forming processes, typically used for structural support applications requiring reduced weight or specific geometric constraints."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> "Uma Placa que possui geometria de espessura fina e é fabricada através de processos de conformação a frio, tipicamente usada para aplicações de suporte estrutural que requerem peso reduzido ou restrições geométricas específicas."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> "ThinPlate ⊑ Plate ⊓ ∃hasQuality.ThinThickness ⊓ ∃hasQuality.ColdFormedManufacturing"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> "∀x(ThinPlate(x) → Plate(x) ∧ ∃q1(ThinThickness(q1) ∧ hasQuality(x,q1)) ∧ ∃q2(ColdFormedManufacturing(q2) ∧ hasQuality(x,q2)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> "Constructive type defined by physical geometry (thinness) and manufacturing method (cold forming). Under OWA, sufficient conditions for thin plates are difficult to specify without risking false positives from specialized hybrid structures that contain thin cold-formed elements but should not be classified as standard thin plates."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> "[ISO 15926-4] A <THIN PLATE> is a <PLATE> that is a thin steel plate format (Sheet plate) Normally made by coldforming"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000360> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/StructuralSupportFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationFunction> (three phase separation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationFunction> "three phase separation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationFunction> "A three-phase separator is a separator that bears a three-phase separation function to separate well fluids into gas, oil, and water phases."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationFunction> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess> (three phase separation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess> "three phase separation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfOil>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfWater>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> (three-phase separator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> "three-phase separator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> "A three-phase separator is a separator that bears a three-phase separation function to separate well fluids into gas, oil, and water phases."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> "Um separador trifásico é um separador que possui uma função de separação trifásica para separar fluidos de poço em fases gasosa, oleosa e aquosa."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> "Every three-phase separator is a separator that has the function of separating fluid into gas, oil, and water phases, and has gas outlet, oil outlet, and water outlet as component parts."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> "∀x (ThreePhaseSeparator(x) ↔ (Separator(x) ∧ ∃f (ThreePhaseSeparationFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> "[ISO 15926-4] A <THREE-PHASE SEPARATOR> is an <ARTEFACT> and a <FLUID SEPARATOR> intended to separate three fluids in different phases, typically gas and liquid and water"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> "[SLB Glossary] A vessel that separates the well fluids into gas and two types of liquids: oil and water."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> "[POSC Caesar] A separator intended to separate three fluids in different phases, typically gas and liquid and water"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ThreePhaseSeparationFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000361> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TransductionFunction> (transduction function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TransductionFunction> "transduction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TransductionFunction> "A transducer is an instrument that bears a TransductionFunction to convert information from one form or magnitude of energy to another form or magnitude."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TransductionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TransductionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TransductionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TransductionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TransductionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TransductionProcess> (transduction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TransductionProcess> "transduction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TransductionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TransductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/MeasurementInformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TransductionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> (transducer)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> "transducer"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> "A transducer is an instrument that bears a TransductionFunction to convert information from one form or magnitude of energy to another form or magnitude."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> "Um transdutor é um instrumento que possui uma FunçãoDeTransdução para converter informação de uma forma ou magnitude de energia para outra forma ou magnitude."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> "Every transducer is an instrument that has the designed function to convert energy or signal forms while preserving information content."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> "∀x (Transducer(x) ↔ Instrument(x) ∧ ∃f (TransductionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> "[ISO 15926-4] A <TRANSDUCER> is an <ENERGY CONVERTER> that is capable of converting a <PROCESS VARIABLE> in one form or magnitude of energy to another form or magnitude of the same energy"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> "[ISA 5.1] a general term for a device, which can be a primary element, transmitter, relay, converter or other device, that receives information in the form of one or more physical quantities, modifies the information or its form, or both if required, and produces a resultant output signal."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> "[POSC Caesar] An artefact that accepts information in the form of a physical or chemical variable (its input variable) and converts it into an output variable of the same or another nature, according to a definite law."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000362> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TransductionFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> (enclosure function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "enclosure function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "A transmitter housing is an Assembly that bears an EnclosureFunction and that has a transmitter electronic circuit as a component part at all times, designed to provide environmental protection and physical containment for transmitter components."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> (enclosure process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> "enclosure process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> (transmitter housing)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> "transmitter housing"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> "A transmitter housing is an Assembly that bears an EnclosureFunction and that has a transmitter electronic circuit as a component part at all times, designed to provide environmental protection and physical containment for transmitter components."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> "Um invólucro de transmissor é uma Assembly que possui uma EnclosureFunction e que tem um circuito eletrônico de transmissor como parte componente em todos os momentos, projetado para fornecer proteção ambiental e contenção física para componentes do transmissor."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> "TransmitterHousing ⊑ Assembly ⊓ ∃bearerOf.EnclosureFunction ⊓ ∃hasComponentPartAtAllTimes.TransmitterElectronicCircuit"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> "∀x(TransmitterHousing(x) → Assembly(x) ∧ ∃f(EnclosureFunction(f) ∧ bearerOf(x,f)) ∧ ∃c(TransmitterElectronicCircuit(c) ∧ hasComponentPartAtAllTimes(x,c)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> "Constructive type based on physical structure as housing. Under OWA, sufficient conditions for transmitter housing would require specifying exact structural features (materials, dimensions, sealing mechanisms) that distinguish it from other instrument housings. The necessary conditions establish the core identity without risking false positives from other housing types that might share some structural features."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> "[ISO 15926-4] A <TRANSMITTER HOUSING> is an <INSTRUMENT HOUSING> of a transmitter."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000363> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportFunction> (tubing support function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportFunction> "tubing support function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportFunction> "A tubing hanger is an assembly that supports tubing strings in wellheads with integrated sealing to isolate tubing conduit from annulus."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportProcess> (tubing support process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportProcess> "tubing support process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/TubingString>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/TubingString>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> (tubing hanger)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "tubing hanger"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "A tubing hanger is an assembly that supports tubing strings in wellheads with integrated sealing to isolate tubing conduit from annulus."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "Um suporte de coluna de produção é um conjunto que suporta colunas de produção em cabeças de poço com vedação integrada para isolar o conduto da coluna do anular."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "Every tubing hanger is an assembly that bears a tubing support function and has component parts including a sealing system, support mechanism, and tubing connection."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "∀x(TubingHanger(x) ↔ (Assembly(x) ∧ ∃f(TubingSupportFunction(f) ∧ bearerOf(x,f)) ∧ ∃s(SealingSystem(s) ∧ hasComponentPartAtAllTimes(x,s)) ∧ ∃m(SupportMechanism(m) ∧ hasComponentPartAtAllTimes(x,m)) ∧ ∃c(TubingConnection(c) ∧ hasComponentPartAtAllTimes(x,c))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "[ISO 15926-4] A <TUBING HANGER> is a <WELL STRING HANGER> that is installed on top of the tubing string and supports the string when landed in the tubing hanger or tubing head."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "[CFIHOS] A well string hanger that is used for production tubing. The tubing hanger incorporates a sealing system to ensure that the tubing conduit and annulus are hydraulically isolated."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "[SLB Glossary] A device attached to the topmost tubing joint in the wellhead to support the tubing string."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> "[OnePetro] A slip set or donut that suspends and holds the top of the tubing in the wellhead."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/SealingSystem>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SealingSystem> "sealing system"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingSystem> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000228>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionFunction> (tubing support and connection function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionFunction> "tubing support and connection function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionFunction> "A tubing head is a wellhead component that supports the tubing hanger and provides a connection interface for attaching the Christmas tree to the wellhead assembly."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionProcess> (tubing support and connection process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionProcess> "tubing support and connection process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000364>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/TubingString>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/ChristmasTreeConnectionPoint>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> (tubing head)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> "tubing head"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> "A tubing head is a wellhead component that supports the tubing hanger and provides a connection interface for attaching the Christmas tree to the wellhead assembly."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> "Uma cabeça de coluna é um componente de cabeça de poço que suporta o suspensor de coluna e fornece uma interface de conexão para fixar a árvore de natal ao conjunto de cabeça de poço."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> "Every tubing head is a wellhead component that bears a tubing support and connection function, has a tubing bowl as component part, and has a Christmas tree connection interface as component part."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> "∀x(TubingHead(x) ↔ WellheadComponent(x) ∧ ∃f(TubingSupportAndConnectionFunction(f) ∧ bearerOf(x,f)) ∧ ∃p1(TubingBowl(p1) ∧ hasComponentPartAtAllTimes(x,p1)) ∧ ∃p2(ChristmasTreeConnectionInterface(p2) ∧ hasComponentPartAtAllTimes(x,p2)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> "[ISO 15926-4] A <TUBING HEAD> is a <DRILLING COMPONENT> that is fixed to the top of the tubing set in a well."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> "[SLB Glossary] A wellhead component that supports the tubing hanger and provides a means of attaching the Christmas tree to the wellhead."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> "[OnePetro] A flanged spool containing the tubing bowl where the tubing hanger will set and seal."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000365> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/TubingSupportAndConnectionFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000733>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnergyExtractionFunction> (energy extraction function)

