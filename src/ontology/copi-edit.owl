SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BottomHoleDrillingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BottomHoleDrillingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BottomHoleDrillingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BottomHoleDrillingProcess>))

