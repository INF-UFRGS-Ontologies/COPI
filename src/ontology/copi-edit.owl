SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PigLaunchingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> (pig launcher)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> "pig launcher"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> "A pig launcher is a vessel that bears a pig launching function for inserting pipeline pigs into pipeline systems."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> "Um lançador de pig é um vaso que possui função de lançamento de pig para inserir pigs de duto em sistemas de tubulação."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> "Every pig launcher is a vessel that has the function to launch pipeline pigs and has a pipeline connection component."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> "∀x(PigLauncher(x) ↔ (Vessel(x) ∧ ∃f(PigLaunchingFunction(f) ∧ bearerOf(x,f)) ∧ ∃c(PipelineConnection(c) ∧ hasComponentPartAtAllTimes(x,c))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> "[ISO 15926-4] A <PIG LAUNCHER> is a <FunctionalObject> that is capable of <LAUNCHING> a <PIPE PIG> into a pipeline"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> "[CFIHOS] A pressure vessel intended for sending a pig into a pipeline."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> "[POSC Caesar] A chamber connected to a pipeline intended for sending pigs into the pipeline."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PigLaunchingFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000318> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000319>)

