SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> (vessel)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> "vessel"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> "A vessel is an assembly designed to contain fluids or solids for storage and/or processing purposes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> "Um vaso é um conjunto projetado para conter fluidos ou sólidos para fins de armazenamento e/ou processamento."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> "Every vessel is an assembly that bears a containment function and has a vessel shell and vessel head as component parts at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> "∀x(Vessel(x) ↔ Assembly(x) ∧ ∃f(ContainmentFunction(f) ∧ bearerOf(x,f)) ∧ ∃s(VesselShell(s) ∧ hasComponentPartAtAllTimes(x,s)) ∧ ∃h(VesselHead(h) ∧ hasComponentPartAtAllTimes(x,h)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> "[ISO 15926-4] A <VESSEL> is a <FLUID CONTAINER>, intended for storage and/or processing of fluids"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> "[CFIHOS] A container intended for storage and/or processing of fluids."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> "[DEXPI] A container intended for storage and/or processing of fluids or solids."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/VibrationTransmissionFunction> (vibration transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/VibrationTransmissionFunction> "vibration transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/VibrationTransmissionFunction> "A vibration transmitter is a transmitter that measures mechanical vibrations and produces an output signal proportional to the measured vibration parameters."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/VibrationTransmissionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/VibrationTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/VibrationMeasurementAndTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/VibrationTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/VibrationMeasurementAndTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/VibrationMeasurementAndTransmissionProcess> (vibration measurement and transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/VibrationMeasurementAndTransmissionProcess> "vibration measurement and transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/VibrationMeasurementAndTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/VibrationMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/VibrationMeasurementResult>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/VibrationMeasurementAndTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> (vibration transmitter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> "vibration transmitter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> "A vibration transmitter is a transmitter that measures mechanical vibrations and produces an output signal proportional to the measured vibration parameters."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> "Um transmissor de vibração é um transmissor que mede vibrações mecânicas e produz um sinal de saída proporcional aos parâmetros de vibração medidos."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> "Every vibration transmitter is a transmitter that has a vibration signal as input and bears a vibration measurement function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> "∀x (VibrationTransmitter(x) ↔ (Transmitter(x) ∧ ∃v (VibrationMeasurementResult(v) ∧ hasInput(x,v)) ∧ ∃f (VibrationMeasurementFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> "[ISO 15926-4] A <VIBRATION TRANSMITTER> is a <PROCESS VARIABLE TRANSMITTER> and a <VIBRATION MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> "[CFIHOS] A transmitter of which the output is proportional to a measured vibration."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/VibrationTransmissionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000159> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> (backflow prevention function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "backflow prevention function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "A wafer check valve is a check valve that has a wafer pattern valve body designed for mounting between flanges."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> (backflow prevention process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> "backflow prevention process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> (wafer check valve)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "wafer check valve"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "A wafer check valve is a check valve that has a wafer pattern valve body designed for mounting between flanges."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "Uma válvula de retenção wafer é uma válvula de retenção que possui um corpo de válvula padrão wafer projetado para montagem entre flanges."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "Every wafer check valve is a check valve that has a wafer pattern valve body as component part at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "∀x(WaferCheckValve(x) → CheckValve(x) ∧ ∃y(WaferPatternValveBody(y) ∧ hasComponentPartAtAllTimes(x,y)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "Using necessary conditions because this is a constructive subtype (both functional and structural aspects). The wafer pattern mounting configuration is a structural differentia that, while characteristic, may have edge cases or specialized variants that should not be automatically classified without expert validation. The structural differentia should be confirmed as both necessary and sufficient in industrial practice before upgrading to equivalent mode."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "[ISO 15926-4] A <WAFER CHECK VALVE> is a <WAFER PATTERN VALVE> and a <CHECK VALVE>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "[CFIHOS] A wafer pattern valve that is a check valve with a wafer pattern valve body."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> "[POSC Caesar] A wafer pattern valve that is a check valve with a wafer pattern valve body."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000103>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000160> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> (pressure transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> "pressure transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> "An absolute pressure transmitter is a pressure transmitter that has a vacuum reference chamber on one side of the pressure sensor while the other side receives the process pressure."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionProcess> (pressure transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionProcess> "pressure transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> (absolute pressure transmitter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "absolute pressure transmitter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "An absolute pressure transmitter is a pressure transmitter that has a vacuum reference chamber on one side of the pressure sensor while the other side receives the process pressure."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "Um transmissor de pressão absoluta é um transmissor de pressão que possui uma câmara de referência de vácuo de um lado do sensor de pressão enquanto o outro lado recebe a pressão do processo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "Every absolute pressure transmitter is a pressure transmitter that has a vacuum reference chamber as a component part at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "∀x (AbsolutePressureTransmitter(x) → PressureTransmitter(x) ∧ ∃y (VacuumReferenceChamber(y) ∧ hasComponentPartAtAllTimes(x,y)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "Constructive classification based on vacuum reference chamber configuration. Under Open World Assumption, defining sufficient conditions could lead to unintended classification of complex instruments that contain vacuum chambers but serve different primary functions. The structural differentia is necessary but making it sufficient requires domain expert validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "[ISO 15926-4] An <ABSOLUTE PRESSURE TRANSMITTER> is a <PRESSURE TRANSMITTER> and an <ABSOLUTE PRESSURE MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> "[CFIHOS] A pressure transmitter where pressure is applied to one side of the sensor while the other side has a vacuum chamber."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PressureTransmissionFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/VacuumReferenceChamber>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000205> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/PressureSensor>))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/VacuumReferenceChamber> "vacuum reference chamber"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/VacuumReferenceChamber> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PressureSensor> "pressure sensor"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PressureSensor> <https://spec.industrialontologies.org/ontology/construct/Assembly>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/AccumulationFunction> (accumulation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/AccumulationFunction> "accumulation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/AccumulationFunction> "An accumulator is a vessel that has the designed function to accumulate (store and controllably release) energy or matter."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AccumulationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AccumulationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/AccumulationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AccumulationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/AccumulationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/AccumulationProcess> (accumulation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/AccumulationProcess> "accumulation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AccumulationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AccumulationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AccumulationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> (accumulator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "accumulator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "An accumulator is a vessel that has the designed function to accumulate (store and controllably release) energy or matter."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "Um acumulador é um vaso que tem a função projetada de acumular (armazenar e liberar de forma controlada) energia ou matéria."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "Every accumulator is a vessel that bears an accumulation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "∀x (Accumulator(x) ↔ (Vessel(x) ∧ ∃f (AccumulationFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "[ISO 15926-4] An <ACCUMULATOR> is a <FunctionalObject> that has a capability of <ACCUMULATING> matter and/or energy"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "[CFIHOS] A physical object for storing energy, and which after discharge may be recharged."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "[SLB Glossary] A device used in a hydraulic system to store energy or, in some applications, dampen pressure fluctuations."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "[OnePetro] In context of a pressure control device, accumulators are canisters of hydraulic fluid, pressurized with a nitrogen gas cap of sufficient pressure and volume to operate all the rams on a BOP in case of power failure to the BOP.\n        \n        In context of a processing plant, an accumulator is a vessel that receives and temporarily stores a liquid used in the feed stock or the processing of a feed stream in a gas plant or other processing facility."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> "[POSC Caesar] A functional object capable of storing energy, and which after discharge may be recharged."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000158> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/AccumulationFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000206> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> (actuation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "actuation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> "An actuator is an assembly that bears an actuation function to convert energy from an external source into kinetic motion in response to control signals."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> (actuation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> "actuation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ActuationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/ControlSignal>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> (actuator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> "actuator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> "An actuator is an assembly that bears an actuation function to convert energy from an external source into kinetic motion in response to control signals."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> "Um atuador é um conjunto que possui uma função de atuação para converter energia de uma fonte externa em movimento cinético em resposta a sinais de controle."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> "[ISO 15926-4] An <ACTUATOR> is a <FunctionalObject> that is capable of <ACTUATING>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> "[CFIHOS] A physical object for changing a signal into a corresponding movement."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> "[OnePetro] An actuator is a type of motor for moving or controlling a mechanism or system. Actuator's are a vital part of offshore operations."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> "[POSC Caesar] A transducer that is intended to convert energy (electric, mechanical, pneumatic or hydraulic) from an external source into kinetic energy (motion) in response to a signal or or power input."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000207> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ActuationFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/AgitationFunction> (agitation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/AgitationFunction> "agitation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/AgitationFunction> "An agitator is a mixer that stirs or shakes fluids by reaction force from moving vanes."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AgitationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AgitationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/AgitationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AgitationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/AgitationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/AgitationProcess> (agitation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/AgitationProcess> "agitation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AgitationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AgitationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/AgitationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> (agitator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> "agitator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> "An agitator is a mixer that stirs or shakes fluids by reaction force from moving vanes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> "Um agitador é um misturador que mexe ou agita fluidos por força de reação de palhetas móveis."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> "Every agitator is a mixer that has the function to agitate fluids and has moving vanes as component parts at all times."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> "∀x(Agitator(x) ↔ Mixer(x) ∧ ∃f(AgitationFunction(f) ∧ bearerOf(x,f)) ∧ ∃v(MovingVane(v) ∧ hasComponentPartAtAllTimes(x,v)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> "[ISO 15926-4] An <AGITATOR> is a <DYNAMIC MIXER> that stirs or shakes fluids by reaction force from moving vanes"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> "[CFIHOS] A propeller like device with agitational or rotational movement located in a tank to prevent the content of the tank to build component segments."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> "[DEXPI] An Agitator is a dynamic mixer that stirs or shakes fluids by reaction force from moving vanes."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/AgitationFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/MovingVane>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MovingVane> "moving vane"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MovingVane> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000208> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> (heat transfer function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> "heat transfer function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> "An air cooled heat exchanger is a heat exchanger that has finned air cooling surfaces and uses ambient air as the cooling medium to transfer thermal energy from process fluids."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> (heat transfer process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> "heat transfer process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfAir>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/HeatTransferProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfAir>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> (air cooled heat exchanger)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "air cooled heat exchanger"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "An air cooled heat exchanger is a heat exchanger that has finned air cooling surfaces and uses ambient air as the cooling medium to transfer thermal energy from process fluids."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "Um trocador de calor resfriado a ar é um trocador de calor que possui superfícies aletadas de resfriamento a ar e usa ar ambiente como meio de resfriamento para transferir energia térmica de fluidos de processo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "Every air cooled heat exchanger is a heat exchanger that has component parts including an air fin system and tube bundle, and participates in air cooling processes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "∀x(AirCooledHeatExchanger(x) → HeatExchanger(x) ∧ ∃y(AirFinSystem(y) ∧ hasComponentPartAtAllTimes(x,y)) ∧ ∃z(TubeBundle(z) ∧ hasComponentPartAtAllTimes(x,z)) ∧ ∃p(AirCoolingProcess(p) ∧ participatesIn(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "Under the Open World Assumption, defining air cooling constructively as sufficient conditions could lead to false positives. Complex hybrid equipment or specialized configurations with air cooling components might be inappropriately classified. Starting with necessary conditions allows for proper validation by domain experts before upgrading to equivalence."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "[ISO 15926-4] An <AIR COOLED HEAT EXCHANGER> is a <HEAT EXCHANGER> and an <AIR COOLED OBJECT> and a <FLUID CONTAINER>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "[CFIHOS] A cooler that is intended to use air as the cooling medium."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> "[POSC Caesar] A cooler that is intended to use air as the cooling medium."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/HeatTransferFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000209> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000074>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> (temperature indication function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> "temperature indication function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> "An analogue temperature indicator is an instrument that bears a temperature indication function and has an analogue dial for visual temperature display."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> <https://www.inf.ufrgs.br/ontologies/copi/IndicationFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/IndicationFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/IndicationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/TemperatureIndicationProcess> (temperature indication process)

