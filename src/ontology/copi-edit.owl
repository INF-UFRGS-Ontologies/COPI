SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CableSupportProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CableSupportProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCable>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CableSupportProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/ElectricalCable>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> (cable tray)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> "cable tray"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> "A cable tray is an assembly that bears a cable support function and consists of a continuous base with raised edges, forming a rigid structural system for securely supporting and routing electrical cables."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> "Uma bandeja de cabos é um conjunto que possui função de suporte de cabos e consiste em uma base contínua com bordas elevadas, formando um sistema estrutural rígido para suportar e rotear cabos elétricos de forma segura."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> "Every cable tray is an assembly that has the function to support cables and has a continuous base part and raised edge parts."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> "∀x(CableTray(x) ↔ Assembly(x) ∧ ∃f(CableSupportFunction(f) ∧ bearerOf(x,f)) ∧ ∃b(ContinuousBase(b) ∧ hasComponentPartAtAllTimes(x,b)) ∧ ∃e(RaisedEdge(e) ∧ hasComponentPartAtAllTimes(x,e)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> "[CFIHOS] A unit or assembly of units or sections and associated fittings forming a rigid structural system used to securely fasten or support cables and raceways."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> "[POSC Caesar] An artefact and electrical cable conduit consisting of a continuous base, raised edges and no covering"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/CableSupportFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/ContinuousBase>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/RaisedEdge>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ContinuousBase> "continuous base"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContinuousBase> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/RaisedEdge> "raised edge"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/RaisedEdge> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000221> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000321>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> (enclosure function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "enclosure function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "A casing is an assembly that provides structural enclosure with pressure containment capability, characterized by walls that separate internal components or fluids from the external environment."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> (enclosure process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> "enclosure process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/MaterialComponent>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/MaterialComponent>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> (casing)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "casing"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "A casing is an assembly that provides structural enclosure with pressure containment capability, characterized by walls that separate internal components or fluids from the external environment."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "Um casing é um conjunto que fornece invólucro estrutural com capacidade de contenção de pressão, caracterizado por paredes que separam componentes internos ou fluidos do ambiente externo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "Every casing is an assembly that has an enclosure function and has component part some casing wall and has function some pressure containment function."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "∀x(Casing(x) → Assembly(x) ∧ ∃f(EnclosureFunction(f) ∧ bearerOf(x,f)) ∧ ∃w(CasingWall(w) ∧ hasComponentPartAtAllTimes(x,w)) ∧ ∃p(PressureContainmentFunction(p) ∧ hasFunction(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "Constructive classification based on structural configuration. Under OWA, sufficient conditions for enclosure structure could lead to over-classification of complex assemblies that contain enclosure elements but serve different primary functions (e.g., pressure vessels, housings, containers)."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "[ISO 15926-4] A <CASING> is an <ARTEFACT> and an <ENCLOSURE> that is the stationary enclosure of a machine intended to contain a fluid and equipment internals"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "[CFIHOS] An enclosure that can maintain a pressure difference."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "[SLB Glossary] Large-diameter pipe lowered into an openhole and cemented in place."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> "[OnePetro] One of several strings of steel pipe in a well design that, together with cement, forms a barrier to fluid movement along the drilled hole. It is commonly at least partly cemented in the wellbore."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionFunction> (cathodic protection function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionFunction> "cathodic protection function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionFunction> "A cathodic protection system is a corrosion protection system that uses electrochemical cathodic protection mechanisms with anodes to prevent corrosion of carbon and low-alloy steel equipment or structures."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionProcess> (cathodic protection process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionProcess> "cathodic protection process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/MetallicStructure>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/MetallicStructure>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000223> (cathodic protection system)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000223> "cathodic protection system"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000223> "A cathodic protection system is a corrosion protection system that uses electrochemical cathodic protection mechanisms with anodes to prevent corrosion of carbon and low-alloy steel equipment or structures."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000223> "Um sistema de proteção catódica é um sistema de proteção contra corrosão que usa mecanismos eletroquímicos de proteção catódica com ânodos para prevenir a corrosão de equipamentos ou estruturas de aço carbono e baixa liga."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000223> "[ISO 15926-4] A <CATHODIC PROTECTION SYSTEM> is an <ARTEFACT> and a <CORROSION PROTECTION SYSTEM> using sacrificial anodes or impressed current anodes offering material and giving protection to carbon and low-alloy steel equipment or structures"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000223> "[CFIHOS] A corrosion protection system using sacrificial anodes or impressed current anodes offering material and giving protection to carbon and low-alloy steel equipment or structures."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000223> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000196> <https://www.inf.ufrgs.br/ontologies/copi/CathodicProtectionFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtSomeTime> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000212>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> (enclosure function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "enclosure function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "A casing that is specifically designed and dimensioned for structural compatibility with centrifugal compressor mechanisms, providing enclosure and protection for rotating impellers and associated flow components."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> (enclosure process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> "enclosure process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000101>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> (centrifugal compressor casing)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> "centrifugal compressor casing"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> "A casing that is specifically designed and dimensioned for structural compatibility with centrifugal compressor mechanisms, providing enclosure and protection for rotating impellers and associated flow components."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> "Um invólucro que é especificamente projetado e dimensionado para compatibilidade estrutural com mecanismos de compressor centrífugo, fornecendo contenção e proteção para impulsores rotativos e componentes de fluxo associados."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> "Every centrifugal compressor casing is a casing that is intended for use with centrifugal compressors"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> "∀x(CentrifugalCompressorCasing(x) → Casing(x) ∧ ∃y(CentrifugalCompressor(y) ∧ intendedFor(x,y)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> "Constructive type defined by structural compatibility. Under OWA, asserting equivalence could force classification of any casing with centrifugal compressor compatibility, including hybrid or specialized equipment that should not be automatically classified as standard centrifugal compressor casings."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> "[ISO 15926-4] A <CENTRIFUGAL COMPRESSOR CASING> is a <COMPRESSOR CASING> that is intended to be used for a centrifugal compressor."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000222>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000224> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> (separation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> "separation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> "A centrifuge is a separator that uses centrifugal force generated by a rotating drum to separate phases of different densities."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> (separation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> "separation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> (centrifuge)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "centrifuge"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "A centrifuge is a separator that uses centrifugal force generated by a rotating drum to separate phases of different densities."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "Uma centrífuga é um separador que usa força centrífuga gerada por um tambor rotativo para separar fases de diferentes densidades."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "Every centrifuge is a separator that has a rotating drum as component part and participates in centrifugal force processes."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "∀x (Centrifuge(x) → Separator(x) ∧ ∃d (RotatingDrum(d) ∧ hasComponentPartAtAllTimes(x,d)) ∧ ∃p (CentrifugalForceProcess(p) ∧ participatesIn(x,p)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "Although functionally defined as a separator, the constructive differentia (centrifugal mechanism) makes sufficient conditions complex under OWA. Any equipment with a rotating drum could potentially be classified as a centrifuge even if designed for other purposes (mixing, drying, etc.). Starting with necessary conditions protects against false positives."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "[ISO 15926-4] A <CENTRIFUGE> is a <MACHINE> and a <SEPARATOR> that uses centrifugal force to separate phases of different densities"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "[CFIHOS] A physical object that uses centrifugal force to separate phases of different densities."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "[SLB Glossary] An item of solids-removal equipment that removes fine and ultrafine solids."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "[OnePetro] A device that separates materials by density through a centrifugal motion."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> "[POSC Caesar] A 'separator' and 'machine' that uses centrifugal force to separate phases of different densities."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction>))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000314>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000225> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000258>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> (enclosure function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "enclosure function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> "A valve body that is specifically designed to accommodate and house the internal mechanisms of a check valve within a pressure-containing boundary."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> (enclosure process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> "enclosure process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnclosureProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> (check valve body)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> "check valve body"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> "A valve body that is specifically designed to accommodate and house the internal mechanisms of a check valve within a pressure-containing boundary."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> "Um corpo de válvula que é especificamente projetado para acomodar e alojar os mecanismos internos de uma válvula de retenção dentro de uma barreira de contenção de pressão."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> "CheckValveBody subClassOf ValveBody and (designedFor some CheckValve)"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> "∀x(CheckValveBody(x) → ValveBody(x) ∧ ∃y(CheckValve(y) ∧ designedFor(x,y)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> "Constructive identity based on structural design for check valve accommodation. Under OWA, any housing designed for check valves could include specialized configurations, custom manifolds, or hybrid designs that should not be automatically classified as standard check valve bodies without domain expert validation of the structural differentia."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> "[ISO 15926-4] A <CHECK VALVE BODY> is a <VALVE BODY> of a check valve"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000078>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000226> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnclosureFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> (backflow prevention function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "backflow prevention function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> "A MaterialArtifact that is a component part of a check valve and that bears a BackflowPreventionFunction, consisting in a mechanical element that prevents fluid flow reversal by physically blocking the flow path when pressure conditions indicate potential backflow."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> (backflow prevention process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> "backflow prevention process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> (check valve closure member)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> "check valve closure member"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> "A MaterialArtifact that is a component part of a check valve and that bears a BackflowPreventionFunction, consisting in a mechanical element that prevents fluid flow reversal by physically blocking the flow path when pressure conditions indicate potential backflow."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> "Um MaterialArtifact que é uma parte componente de uma válvula de retenção e que possui uma BackflowPreventionFunction, consistindo em um elemento mecânico que previne o refluxo de fluido bloqueando fisicamente o caminho de fluxo quando as condições de pressão indicam potencial refluxo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> "Every check valve closure member is a MaterialArtifact that is component part of some check valve and bears some BackflowPreventionFunction"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> "∀x(CheckValveClosureMember(x) → MaterialArtifact(x) ∧ ∃y(CheckValve(y) ∧ isComponentPartOf(x,y)) ∧ ∃f(BackflowPreventionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> "Constructive type defined by structural role and mechanism. Under OWA, sufficient conditions would force classification of any artifact with backflow prevention function and check valve association, potentially including hybrid or specialized designs that should not be automatically classified as standard closure members without domain expert validation."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> "[ISO 15926-4] A <CHECK VALVE CLOSURE MEMBER> is an <ARTEFACT> and a <VALVE CLOSURE MEMBER> that is intended to prevent back flow"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000227> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/BackflowPreventionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlFunction> (well fluid control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlFunction> "well fluid control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlFunction> "A christmas tree is an assembly that bears a well fluid control function, is connected to a wellhead, and contains master valves for controlling formation fluids from oil and gas wells."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WellFluidControlProcess> (well fluid control process)

