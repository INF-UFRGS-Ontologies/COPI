AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/TubingHangerSeatingFunction> "A material artifact that is the section of a tubing head which accommodates the tubing hanger, where it sets and seals."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingHangerSeatingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingHangerSeatingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TubingHangerSeatingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/TubingHangerSeatingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/TubingHangerSeatingProcess>))

