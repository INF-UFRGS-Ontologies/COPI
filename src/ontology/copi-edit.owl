SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyExtractionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyExtractionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/EnergyExtractionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> (turbine)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> "turbine"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> "A turbine is an assembly that bears an energy extraction function and has rotating shaft and fluid-interacting blades that extract energy from flowing fluids and convert it into useful mechanical work."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> "Uma turbina é um conjunto que possui uma função de extração de energia e tem eixo rotativo e pás de interação com fluidos que extraem energia de fluidos em movimento e a convertem em trabalho mecânico útil."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> "[ISO 15926-4] A <TURBINE> is an <ARTEFACT> and a <DRIVER(function)> that is a rotary mechanical device that extracts energy from a fluid flow and converts it into useful work"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> "[CFIHOS] A physical object that is intended to rotate within a fluid and to transform energy within a fluid into mechanical power."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> "[DEXPI] An object that is a rotary mechanical device that extracts energy from a fluid flow and converts it into useful work (from ``_)."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/EnergyExtractionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000366> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionFunction> (multi service transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionFunction> "multi service transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionFunction> "An umbilical is an assembly that is a flexible and easily disconnectable bundle containing both cables and tubing for multi-service transmission including control, power, communication, and chemical injection."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess> (multi service transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess> "multi service transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> (umbilical)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "umbilical"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "An umbilical is an assembly that is a flexible and easily disconnectable bundle containing both cables and tubing for multi-service transmission including control, power, communication, and chemical injection."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "Um umbilical é uma montagem que é um feixe flexível e facilmente desconectável contendo cabos e tubulação para transmissão de múltiplos serviços incluindo controle, energia, comunicação e injeção química."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "Every umbilical is an assembly that has component parts including cable bundles and tubing bundles, and has the qualities of flexibility and easy disconnectability."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "∀x (Umbilical(x) → Assembly(x) ∧ ∃c,t,s,conn (CableBundle(c) ∧ TubeBundle(t) ∧ ProtectiveSheathing(s) ∧ ConnectorAssembly(conn) ∧ hasComponentPartAtAllTimes(x,c) ∧ hasComponentPartAtAllTimes(x,t) ∧ hasComponentPartAtAllTimes(x,s) ∧ hasComponentPartAtAllTimes(x,conn) ∧ hasQuality(x,Flexibility) ∧ hasQuality(x,EasyDisconnectability)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "Constructive basis requires necessary conditions only. Under OWA, any assembly with cables, tubing, flexibility, and disconnectability could be forcibly classified as umbilical, including specialized multi-service bundles, complex wiring harnesses, or custom transmission assemblies that contain these elements but serve different industrial contexts and maintenance categories."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "[ISO 15926-4] A <UMBILICAL> is a <DRILLING COMPONENT> that is a flexible and easily disconnectable collection of cables and/or tubing for control, power, communication or chemical injection purposes."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "[CFIHOS] An assembly of hydraulic hoses which can also include electrical cables or optic fibres, used to control a sub sea structure or remote operated vehicle from a platform or a vessel."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "[OnePetro] A control line attached to a remove piece of equipment, usually a subsea wellhead, to provide hydraulic or electrical control, or inject small amounts of chemicals."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> "[POSC Caesar] A device which is a flexible and easily disconnectable collection of cables and/or tubing for control, power, communication or chemical injection purposes."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/MultiServiceTransmissionFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/CableBundle>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732>))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/CableBundle> "cable bundle"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/CableBundle> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000321>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000367> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000296>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyFunction> (uninterrupted power supply function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyFunction> "uninterrupted power supply function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyFunction> "A UPS unit is electrical equipment that bears the designed function of maintaining uninterrupted AC electric power supply to protected equipment during power disturbances."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyProcess> (uninterrupted power supply process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyProcess> "uninterrupted power supply process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> (ups unit)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> "ups unit"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> "A UPS unit is electrical equipment that bears the designed function of maintaining uninterrupted AC electric power supply to protected equipment during power disturbances."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> "Uma unidade UPS é um equipamento elétrico que possui a função projetada de manter o fornecimento ininterrupto de energia elétrica AC para equipamentos protegidos durante distúrbios de energia."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> "[ISO 15926-4] An <UPS UNIT> is an <AC ELECTRIC POWER SUPPLY UNIT> that maintains a uninterrupted supply of electric power to the equipment it protects"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> "[CFIHOS] An ac power supply unit that maintains a continuous supply of electric power to the equipment it protects."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> "[POSC Caesar] An A.C. power supply unit that maintains a continuous supply of electric power to the equipment it protects."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/UninterruptedPowerSupplyFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000086>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000368> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000106>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> (distillation function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> "distillation function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> "A vacuum column is a distillation column that is designed to withstand outside pressure during vacuum operation."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess> (distillation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess> "distillation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FluidMixture>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/DistillationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> (vacuum column)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "vacuum column"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "A vacuum column is a distillation column that is designed to withstand outside pressure during vacuum operation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "Uma coluna de vácuo é uma coluna de destilação projetada para resistir à pressão externa durante operação sob vácuo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "Every vacuum column is a distillation column that bears a vacuum pressure resistance quality."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "∀x(VacuumColumn(x) → DistillationColumn(x) ∧ ∃q(VacuumPressureResistanceQuality(q) ∧ bearerOf(x,q)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "Constructive type based on structural capability. Under OWA, defining sufficient conditions for vacuum-capable design would be complex and could lead to false positives. The structural differentia (vacuum resistance) requires domain expert validation of what constitutes adequate vacuum design capability."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "[ISO 15926-4] A <VACUUM COLUMN> is an <ARTEFACT> and a <DISTILLATION COLUMN> intended to withstand outside pressure"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "[CFIHOS] A distillation column intended to withstand outside pressure."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> "[POSC Caesar] A distillation column intended to withstand outside pressure"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000255>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000369> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/DistillationFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> (flow control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "flow control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> "A MaterialArtifact that is a component part of a valve and that is positioned in the flow stream to permit, obstruct, divert or regulate flow through mechanical positioning."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> (flow control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> "flow control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> <https://www.inf.ufrgs.br/ontologies/copi/FlowControl>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControl> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> (valve closure member)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> "valve closure member"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> "A MaterialArtifact that is a component part of a valve and that is positioned in the flow stream to permit, obstruct, divert or regulate flow through mechanical positioning."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> "Um MaterialArtifact que é uma parte componente de uma válvula e que é posicionado no fluxo para permitir, obstruir, desviar ou regular o fluxo através de posicionamento mecânico."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> "Every valve closure member is a material artifact that is a component part of some valve and participates in flow control processes by being positioned within the flow stream."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> "∀x (ValveClosureMember(x) → MaterialArtifact(x) ∧ ∃v (Valve(v) ∧ isComponentPartOf(x,v)) ∧ ∃p (FlowControlProcess(p) ∧ participatesIn(x,p)) ∧ ∃q (PositionableInFlowStream(q) ∧ hasQuality(x,q)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> "As a constructive type defined by physical configuration and mechanical role, the valve closure member should use necessary conditions. The structural differentia (being positioned in flow stream) is harder to make sufficient under OWA - other components or hybrid devices might satisfy the conditions but not be classified as standard valve closure members."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> "[ISO 15926-4] A <VALVE CLOSURE MEMBER> is a <CLOSURE> that is the part of a valve which is positioned in the flow stream to permit, obstruct, divert or regulate flow"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000370> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> (sealing function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> "sealing function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> "A MaterialArtifact that is part of a valve and that provides the seating surface against which the closure member bears to achieve shut-off and control of process fluid flow."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SurfaceSealingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SealingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SurfaceSealingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SurfaceSealingProcess> (surface sealing process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SurfaceSealingProcess> "surface sealing process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SurfaceSealingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SurfaceSealingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SurfaceSealingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> (valve seat)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> "valve seat"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> "A MaterialArtifact that is part of a valve and that provides the seating surface against which the closure member bears to achieve shut-off and control of process fluid flow."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> "Um MaterialArtifact que é parte de uma válvula e que fornece a superfície de assentamento contra a qual o membro de fechamento se apoia para alcançar o fechamento e controle do fluxo de fluido de processo."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> "Valve seat is a constructive type defined by its structural configuration and interface role. Under the Open World Assumption, making this an equivalence class could lead to false positives where any artifact that is part of a valve and adjacent to a closure member gets classified as a valve seat, even if it serves a different structural role (such as guides, stops, or supports)."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> "[ISO 15926-4] A <VALVE SEAT> is a <VALVE COMPONENT> that is the part of a valve against which the closure member bears to provide shut-off and throughput of process fluids flows"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000371> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/SealingFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionFunction> (force transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionFunction> "force transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionFunction> "An Assembly that bears a ForceTransmissionFunction and that has a valve stem seal as a component part, specifically designed to transmit motion from a valve operator to the valve closure member."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionProcess> (force transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionProcess> "force transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> (valve stem)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> "valve stem"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> "An Assembly that bears a ForceTransmissionFunction and that has a valve stem seal as a component part, specifically designed to transmit motion from a valve operator to the valve closure member."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> "Um Assembly que porta uma ForceTransmissionFunction e que tem um selo de haste de válvula como parte componente, especificamente projetado para transmitir movimento de um operador de válvula para o membro de fechamento da válvula."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> "Constructive type defined by physical structure (rod/shaft mechanism). Under Open World Assumption, sufficient conditions would force any assembly with a valve stem seal and force transmission function to be classified as a valve stem, which could include complex multi-component assemblies, manifolds, or specialized valve mechanisms that contain these elements but should not be asserted into the standard valve stem maintenance category."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> "[ISO 15926-4] A <VALVE STEM> is a <VALVE COMPONENT> and a <TRANSMITTER(force)> that is a rod or shaft which is transmitting motion from an operator to the closure member of a valve"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> <https://spec.industrialontologies.org/ontology/construct/Assembly>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000372> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ForceTransmissionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> (containment function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> "containment function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> "A FiatObjectPart that is part of a vessel and that closes a vessel shell by providing an end boundary for containment."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> (containment process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> "containment process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> (vessel head)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> "vessel head"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> "A FiatObjectPart that is part of a vessel and that closes a vessel shell by providing an end boundary for containment."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> "Uma FiatObjectPart que é parte de um vaso e que fecha o casco do vaso fornecendo uma fronteira terminal para contenção."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> "Every vessel head is a fiat object part that is part of some vessel and realizes a vessel closure role."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> "∀x(VesselHead(x) → FiatObjectPart(x) ∧ ∃y(Vessel(y) ∧ partOf(x,y)) ∧ ∃r(VesselClosureRole(r) ∧ realizes(x,r)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> "Constructive type based on structural configuration. Under OWA, asserting sufficient conditions for vessel head closure would inappropriately classify any part that closes a vessel (including specialized manifolds, complex multi-port heads, or custom closures) as standard vessel heads, potentially creating false positives in maintenance categorization."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> "[ISO 15926-4] A <VESSEL HEAD> is an <EQUIPMENT COMPONENT> that is intended to close a vessel shell."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000373> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> (containment function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> "containment function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> "A fiat object part that is the outer pressure-containing structural boundary of a vessel, designed to enclose and isolate internal contents while withstanding internal pressure loads."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> (containment process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> "containment process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ContainmentProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> (vessel shell)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> "vessel shell"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> "A fiat object part that is the outer pressure-containing structural boundary of a vessel, designed to enclose and isolate internal contents while withstanding internal pressure loads."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> "Uma parte de objeto por fiat que é o limite estrutural externo de contenção de pressão de um vaso, projetada para encerrar e isolar o conteúdo interno enquanto suporta cargas de pressão interna."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> "VesselShell SubClassOf: FiatObjectPart and partOf some Vessel and bearerOf some PressureContainmentFunction"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> "∀x(VesselShell(x) → FiatObjectPart(x) ∧ ∃y(Vessel(y) ∧ partOf(x,y)) ∧ ∃f(PressureContainmentFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> "Constructive type defined by structural configuration as outer pressure-containing part of vessel. Under Open World Assumption, sufficient conditions are difficult to establish - other structural components might also be pressure-containing parts of vessels in specialized designs."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> "[ISO 15926-4] A <VESSEL SHELL> is an <ARTEFACT> and a <SHELL(structure)> that is all or part of the pressure containing outer part of a vessel"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000374> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/ContainmentFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionFunction> (subsurface resource interaction function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionFunction> "subsurface resource interaction function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionFunction> "A well is an engineered system that interacts with subsurface resources through a drilled wellbore, designed to obtain, produce, store, or inject materials into or from the earth."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionProcess> (subsurface resource interaction process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionProcess> "subsurface resource interaction process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/MaterialEntity>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/MaterialEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> (well)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> "well"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> "A well is an engineered system that interacts with subsurface resources through a drilled wellbore, designed to obtain, produce, store, or inject materials into or from the earth."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> "Um poço é um sistema projetado que interage com recursos do subsolo através de um furo perfurado, projetado para obter, produzir, armazenar ou injetar materiais na terra ou a partir dela."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> "Every well is an engineered system that bears a subsurface resource interaction function and has a wellbore as component part."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> "∀x(Well(x) ↔ EngineeredSystem(x) ∧ ∃f(SubsurfaceResourceInteractionFunction(f) ∧ bearerOf(x,f)) ∧ ∃w(Wellbore(w) ∧ hasComponentPartAtSomeTime(x,w)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> "[ISO 15926-4] A <WELL> is a <FunctionalObject> that is arranged to obtain or produce from, or store or inject a material into, the earth"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> "[CFIHOS] A well is a collection of (zero or more) holes drilled into the Earth for the purpose of either (1) finding or producing underground resources; or (2) providing services related to the production of underground resources."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> "[PPDM] A Well is a permitted or actual drilled hole in the ground designed to exchange (or facilitate the exchange of) fluids between a subsurface reservoir and the surface (or another reservoir), or to enable the detection and measurement of rock properties. Key concept: A physical Well is created each time the drill bit breaks the surface of the earth. Clarification: A Well is the parent of the Wellhead Stream(s), Well Origin, and all Well Components down hole from its Well Origin. A Well has a single Well Origin and all Wellbore(s) that extend from this Well Origin are parts of the Well. Re-entry through the same Well Origin for a Well that has not been plugged and abandoned does not create a new Well. A Well that has the same geographic coordinates as a previously existing plugged and abandoned, reclaimed or undrilled Well is a new Well. WB2-Cl2 Diagram Note: The Well depicted on page 3 groups multiple Well Components, including: one active Well WB2-C1 Origin (WO1), one inactive Wellbore (WB1), two active Wellbores (WB2, WB3), three inactive Wellbore Completions (WB1-C1, WB1-C2, WB1-C3) and three active Wellbore Completions (WB2-C1, WB3-C1, WB3-C2) and two active Wellbore Contact Intervals (WB2- CI1, WB2-CI2). ® Copyright 2014, PPDM Association. All Rights Reserved PAGE 4"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/EngineeredSystem> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000196> <https://www.inf.ufrgs.br/ontologies/copi/SubsurfaceResourceInteractionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000326>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000151>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> (wellbore)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "wellbore"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "A wellbore is a site that provides a drilled pathway for subsurface access and is spatially contained within a well system."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "Um poço perfurado é um local que fornece um caminho perfurado para acesso subsuperficial e está espacialmente contido dentro de um sistema de poço."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "Every wellbore is a site that has the function of providing subsurface access and is spatially contained within a well."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "∀x(Wellbore(x) ↔ Site(x) ∧ ∃f(SubsurfaceAccessFunction(f) ∧ hasFunction(x,f)) ∧ ∃w(Well(w) ∧ spatiallyContainedIn(x,w)))"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "[SLB Glossary] The drilled hole or borehole, including the openhole or uncased portion of the well."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "[OnePetro] In drilling, the drilled hole."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> "[PPDM] A Wellbore is a path of drilled footage, from the Well Origin (top/start) to a terminating point (bottom/end). Key concept: Wellbores do not need to be drilled in one continuous operation; they are defined as a path from the Well Origin to a terminating point. Clarification: There are one or more Wellbores in a planned or drilled Well, namely the original Wellbore, and a Wellbore for each intended, actual or accidental sidetrack. Each Wellbore has a unique terminating point. A deepening of an existing Wellbore is considered a new Wellbore with the same Well Origin. Note that in this case, the original terminating point will be located within the new Wellbore. Widening of an existing Wellbore does not constitute a new, separate Wellbore."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000376> <http://purl.obolibrary.org/obo/BFO_0000029>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlFunction> (well surface control function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlFunction> "well surface control function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlFunction> "A wellhead is an assembly that bears a well surface control function and provides the structural and control interface between a wellbore and surface equipment."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlProcess> (well surface control process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlProcess> "well surface control process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FormationFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/FormationFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> (wellhead)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "wellhead"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "A wellhead is an assembly that bears a well surface control function and provides the structural and control interface between a wellbore and surface equipment."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "Um cabeçal de poço é um conjunto que porta uma função de controle superficial do poço e fornece a interface estrutural e de controle entre um poço e os equipamentos de superfície."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "Every wellhead is an assembly that bears a well surface control function and has component parts including casing hangers and connection to wellbore"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "∀x(Wellhead(x) ↔ Assembly(x) ∧ ∃f(WellSurfaceControlFunction(f) ∧ bearerOf(x,f)) ∧ ∃h(CasingHanger(h) ∧ hasComponentPartAtAllTimes(x,h)) ∧ ∃w(Wellbore(w) ∧ hasConnectionTo(x,w)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "[ISO 15926-4] A <WELLHEAD> is an <ARTEFACT> that is the top of the casing of a production oil well including the attached control and flow valves"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "[CFIHOS] The wellhead is assembled from, or incorporates facilities for, the upper casing and tubing hangers. This effectively provides the upper termination of the wellbore and provides a mounting position for the surface flow-control equipment or Christmas tree."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "[SLB Glossary] The system of spools, valves and assorted adapters that provide pressure control of a production well."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> "[OnePetro] The mechanical connection between the tree and the casing. May house tubular hangers, annular access valves. It is connected to the casing by welding, threads, hydraulic forming or set screws."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> ObjectIntersectionOf(<https://spec.industrialontologies.org/ontology/construct/Assembly> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/WellSurfaceControlFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/WellheadSpool>)))
AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WellheadSpool> "wellhead spool"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WellheadSpool> <https://spec.industrialontologies.org/ontology/construct/MaterialArtifact>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000377> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingFunction> (wireline logging function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingFunction> "wireline logging function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingFunction> "A wireline is an electrical cable that bears a wireline logging function for lowering tools into wellbores and transmitting data about wellbore conditions."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/WirelineLoggingProcess> (wireline logging process)

