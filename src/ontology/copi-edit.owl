SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> (injection pump)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> "injection pump"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> "An injection pump is a pump that is specifically designed to inject fluid into reservoirs or production systems, typically at relatively high pressures."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> "Uma bomba de injeção é uma bomba especificamente projetada para injetar fluido em reservatórios ou sistemas de produção, tipicamente em pressões relativamente altas."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> "Every injection pump is a pump that bears an injection function for delivering fluids to reservoirs or production systems."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> "∀x(InjectionPump(x) ↔ Pump(x) ∧ ∃f(InjectionFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> "[ISO 15926-4] An <INJECTION PUMP> is a < POSITIVE DISPLACEMENT PUMP> that is typically applied for relatively high pressures in case of injection systems"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> "[SLB Glossary] Any pump used to inject fluid into the reservoir or production system."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000304> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> (injection function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> "injection function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> "An injection well is a well that bears the designed function of injecting materials into a reservoir at pressure higher than formation pressure."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess> (injection process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess> "injection process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/InjectionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> (injection well)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> "injection well"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> "An injection well is a well that bears the designed function of injecting materials into a reservoir at pressure higher than formation pressure."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> "Um poço de injeção é um poço que possui a função projetada de injetar materiais em um reservatório a uma pressão superior à pressão da formação."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> "Every injection well is a well that has the function to inject materials into a reservoir under pressure."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> "∀x (InjectionWell(x) ↔ (Well(x) ∧ ∃f (InjectionFunction(f) ∧ bearerOf(x,f))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> "[ISO 15926-4] An <INJECTION WELL> is  a <WELL> with the purpose of injecting a material into a reservoir, normally with a pressure higher than the formation pressure"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> "[SLB Glossary] A well in which fluids are injected rather than produced, the primary objective typically being to maintain reservoir pressure."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> "[OnePetro] A well either specifically drilled, or, more likely, a poor producer that is converted to inject fluids to stabilize the decline of pressure in a productive zone. An injector is required to have a pressure connection to the pay and to a producing well. Water is typically injected at the base of the pay or, in a gas well, or gas is injected into the gas cap."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000305> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000375> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000196> <https://www.inf.ufrgs.br/ontologies/copi/InjectionFunction>)))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> (power transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> "power transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> "An input shaft is a shaft that serves as the entrance point for mechanical energy from an external energy source in a power transmission system."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess> (power transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess> "power transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> (input shaft)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> "input shaft"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> "An input shaft is a shaft that serves as the entrance point for mechanical energy from an external energy source in a power transmission system."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> "Um eixo de entrada é um eixo que serve como ponto de entrada para energia mecânica de uma fonte de energia externa em um sistema de transmissão de potência."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/isPrimitive> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> "true"^^xsd:boolean)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/primitiveRationale> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> "Constructive type based on physical configuration as energy entrance point. Under OWA, defining sufficient conditions could lead to false positives where any shaft receiving external energy input would be classified as a standard input shaft, even specialized or hybrid configurations that should remain in different maintenance categories."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> "[ISO 15926-4] An <INPUT SHAFT> is a <SHAFT> that is the entrance of mechanical energy and driven by an external energy source."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000346>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000306> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/PowerTransmissionFunction>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ReboilingFunction> (reboiling function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ReboilingFunction> "reboiling function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ReboilingFunction> "A kettle reboiler is a reboiler that has horizontal orientation and contains a separate vapour space for vapor-liquid disengagement."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ReboilingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ReboilingProcess> (reboiling process)

