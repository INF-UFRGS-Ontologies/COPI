SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/MovementCompensationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/MovementCompensationProcess>))

