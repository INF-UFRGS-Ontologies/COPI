SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowIndicationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowIndicationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/VisualIndication>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> (flow indicator)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> "flow indicator"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> "A flow indicator is an indicator that is designed to indicate flow rates using a flow element and display element."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> "Um indicador de fluxo é um indicador projetado para indicar taxas de fluxo usando um elemento de medição de fluxo e elemento de exibição."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> "Every flow indicator is an instrument that bears a flow indication function and has a flow element and display element as component parts."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> "∀x (FlowIndicator(x) ↔ (Instrument(x) ∧ ∃f(FlowIndicationFunction(f) ∧ bearerOf(x,f)) ∧ ∃e(FlowMeasuringElement(e) ∧ hasComponentPartAtSomeTime(x,e)) ∧ ∃d(DisplayElement(d) ∧ hasComponentPartAtAllTimes(x,d))))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> "[ISO 15926-4] A <FLOW INDICATOR> is an <INSTRUMENTATION ITEM> and a <FLOW MEASURING INSTRUMENT> and a <INDICATOR> that, using a <FLOW MEASURING ELEMENT>, is specially and exclusively designed for <INDICATING> a <FLOW RATE>"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000127> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowIndicationFunction>) ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000116>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000117> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionFunction> (flow signal transmission function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionFunction> "flow signal transmission function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionFunction> "A flow transmitter is a transmitter that produces standardized output signals proportional to flow measurements from flow sensing elements."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionFunction> <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionProcess> (flow signal transmission process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionProcess> "flow signal transmission process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionProcess> <https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SignalTransmissionProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/FlowMeasurementResult>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> (flow transmitter)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> "flow transmitter"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> "A flow transmitter is a transmitter that produces standardized output signals proportional to flow measurements from flow sensing elements."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> "Um transmissor de fluxo é um transmissor que produz sinais de saída padronizados proporcionais às medições de fluxo provenientes de elementos sensores de fluxo."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> "[ISO 15926-4] A <FLOW TRANSMITTER> is a <PROCESS VARIABLE TRANSMITTER> and a <FLOW MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> "[CFIHOS] A flow transmitter providing an output signal that is proportional to the flow inputs from a flow element."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> "[ISA 5.1] ISA 5.1 tag abbreviation 'FT'. First letter 'F': Flow, Flow Rate. Succeeding letters: 'T' = Transmit."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> "[POSC Caesar] A transmitter that is producing a standardized output signal dependent of a received input signal from a flow sensor."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowSignalTransmissionFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000144>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000155>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000118> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000131>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> (process controlled flow function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> "process controlled flow function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> "A gate control valve is a control valve that uses a gate or wedge closure element moving perpendicular to the flow path to modulate fluid flow in response to control signals."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> <https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/FlowControlFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/ProcessControlledFlowProcess> (process controlled flow process)

