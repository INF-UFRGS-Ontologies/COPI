SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationProcess> (knock out separation process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationProcess> "knock out separation process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationProcess> <https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>)
Declaration(Class(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/SeparationProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfGas>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfLiquid>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> (knock out drum)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> "knock out drum"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> "A knock out drum is a separator designed to separate relatively small quantities of liquid from a vapor stream through gravitational and momentum-based phase separation."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> "Um vaso separador de condensado é um separador projetado para separar quantidades relativamente pequenas de líquido de uma corrente de vapor através de separação de fases gravitacional e baseada em momento."@pt-br)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> "Every knock out drum is a separator that bears a knock out separation function, which is realized in processes that separate small quantities of liquid from vapor streams."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicAxiom> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> "∀x(KnockOutDrum(x) ↔ Separator(x) ∧ ∃f(KnockOutSeparationFunction(f) ∧ bearerOf(x,f)))"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> "[ISO 15926-4] A <KNOCK OUT DRUM> is an <ARTEFACT> and a <VESSEL> and a <VAPOUR-LIQUID SEPATATOR> intended to separate relatively small quantities of liquid from a vapour stream"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> "[CFIHOS] A drum intended to separate relatively small quantities of liquid from a vapour stream."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> "[POSC Caesar] A drum intended to separate relatively small quantities of liquid from a vapour stream"@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/KnockOutSeparationFunction>)))
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000073>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000072>)
DisjointClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000308> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000092>)

# Class: <https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingFunction> (level switching function)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingFunction> "level switching function"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingFunction> "A level switch is an instrument that bears a LevelSwitchingFunction, combining level detection with switching capability to provide discrete on/off electrical signals when fluid or particulate material levels reach preset values."@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingFunction> <https://spec.industrialontologies.org/ontology/construct/DesignedFunction>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingFunction> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingProcess>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingFunction> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000054> <https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingProcess>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingProcess> (level switching process)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingProcess> "level switching process"@en)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingProcess> <https://spec.industrialontologies.org/ontology/construct/PlannedProcess>)
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasInput> <https://www.inf.ufrgs.br/ontologies/copi/PortionOfFluid>))
SubClassOf(<https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingProcess> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput> <https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity>))

# Class: <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309> (level switch)

AnnotationAssertion(rdfs:label <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309> "level switch"@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309> "A level switch is an instrument that bears a LevelSwitchingFunction, combining level detection with switching capability to provide discrete on/off electrical signals when fluid or particulate material levels reach preset values."@en)
AnnotationAssertion(<https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309> "Um interruptor de nível é um instrumento que possui uma Função de Comutação de Nível, combinando detecção de nível com capacidade de comutação para fornecer sinais elétricos discretos ligado/desligado quando níveis de fluidos ou materiais particulados atingem valores predefinidos."@pt-br)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309> "[ISO 15926-4] A <LEVEL SWITCH> is an <INSTRUMENTATION ITEM> and a <LEVEL MEASURING INSTRUMENT>"@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309> "[CFIHOS] A functional switch that is intended to give an on/off signal when particulate material or fluid level have reached a pre-set value."@en)
AnnotationAssertion(skos:definition <https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309> "[POSC Caesar] A functional switch that is intended to give an on/off signal when particulate material or fluid level have reached a preset value."@en)
EquivalentClasses(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000309> ObjectIntersectionOf(<https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091> ObjectSomeValuesFrom(<https://spec.industrialontologies.org/ontology/construct/hasFunction> <https://www.inf.ufrgs.br/ontologies/copi/LevelSwitchingFunction>)))

