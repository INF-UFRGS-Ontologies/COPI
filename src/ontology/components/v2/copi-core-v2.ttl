copi:COPI_0000023 a owl:Class ;
    rdfs:label "flow-control device"@en , "dispositivo de controle de fluxo"@pt-br ;
    rdfs:subClassOf iof-constr:MaterialArtifact ;
    owl:equivalentClass [ owl:intersectionOf ( iof-constr:MaterialArtifact [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom copi:COPI_0000026 ] ) ] ;
    iof-av:naturalLanguageDefinition "material artifact that bears a flow control function"@en ;
    iof-av:naturalLanguageDefinition "artefato material que porta uma função de controle de fluxo"@pt-br ;
    rdfs:comment "material artifact that bears a flow control function"@en ;
    rdfs:comment "artefato material que porta uma função de controle de fluxo"@pt-br ;
    iof-av:semiFormalNaturalLanguageDefinition "x is a 'flow-control device' if and only if x is a 'material artifact' that is 'bearer of' some 'flow control function'"@en ;
    iof-av:semiFormalNaturalLanguageDefinition "x é um 'dispositivo de controle de fluxo' se e somente se x é um 'artefato material' que é 'portador de' alguma 'função de controle de fluxo'"@pt-br ;
    iof-av:firstOrderLogicDefinition "∀x (FlowControlDevice(x) ↔ MaterialArtifact(x) ∧ ∃f (FlowControlFunction(f) ∧ bearerOf(x,f)))"@en ;
    skos:example "A control valve (regulate); a gate valve in isolation service (stop); a relief valve."@en ;
    skos:example "Uma válvula de controle (regular); uma válvula gaveta em serviço de bloqueio (interromper); uma válvula de alívio."@pt-br ;
    iof-av:explanatoryNote " Defined class: redefinition of the FOMI 2026 category over its genus-level function instead of its operation; keeps its IRI. Partitions (AllDisjointClasses) among its species are declared where the qualifier is exclusive (e.g. pump × compressor)."@en ;
    iof-av:explanatoryNote "Classe definida: redefinição da categoria do FOMI 2026 (ODR-011/012) sobre sua função de gênero em vez da sua operação; mantém o IRI. As partições (AllDisjointClasses) entre suas espécies são declaradas onde o qualificador é exclusivo. A função de controle de fluxo (copi-vocab COPI_0000026) é reparentada sob controle de magnitude: cobre regular e interromper."@pt-br ;
    iof-av:isPrimitive false ;
    iof-av:adaptedFrom "McCabe, W.L., Smith, J.C. & Harriott, P. (2005). Unit Operations of Chemical Engineering, 7th ed. McGraw-Hill (unit-operation categories of the FOMI 2026 paper, now by function)" ;
    dcterms:source "ODR-025 §4" ;
    dcterms:source "ODR-012 (superseded: categories by operation)" ;
    dcterms:source "ODR-011 (superseded)" ;
    dcterms:source "McCabe, W.L., Smith, J.C. & Harriott, P. (2005). Unit Operations of Chemical Engineering, 7th ed. McGraw-Hill" ;
    rdfs:isDefinedBy copi:copi-core .

copi:COPI_0000091 a owl:Class ;
    rdfs:label "instrument"@en , "instrumento"@pt-br ;
    rdfs:subClassOf iof-constr:MaterialArtifact ;
    owl:equivalentClass [ owl:intersectionOf ( iof-constr:MaterialArtifact [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom copi:COPI_0001019 ] ) ] ;
    iof-av:naturalLanguageDefinition "material artifact that bears a signalling function: sensing, indicating or processing a signal"@en ;
    iof-av:naturalLanguageDefinition "artefato material que porta uma função de sinalização: sentir, indicar ou processar um sinal"@pt-br ;
    rdfs:comment "material artifact that bears a signalling function: sensing, indicating or processing a signal"@en ;
    rdfs:comment "artefato material que porta uma função de sinalização: sentir, indicar ou processar um sinal"@pt-br ;
    iof-av:semiFormalNaturalLanguageDefinition "x is an 'instrument' if and only if x is a 'material artifact' that is 'bearer of' some 'signalling function'"@en ;
    iof-av:semiFormalNaturalLanguageDefinition "x é um 'instrumento' se e somente se x é um 'artefato material' que é 'portador de' alguma 'função de sinalização'"@pt-br ;
    iof-av:firstOrderLogicDefinition "∀x (Instrument(x) ↔ MaterialArtifact(x) ∧ ∃f (SignallingFunction(f) ∧ bearerOf(x,f)))"@en ;
    skos:example "A pressure transmitter; a level gauge; a controller; a limit switch; a control valve positioner."@en ;
    skos:example "Um transmissor de pressão; um indicador de nível; um controlador; uma chave fim de curso; um posicionador de válvula de controle."@pt-br ;
    iof-av:explanatoryNote "ISA 5.1: instruments include primary elements, indicators, controllers, final control elements and switches. Measurement instruments are the sensing subset."@en ;
    iof-av:explanatoryNote "ISA 5.1: instrumentos incluem elementos primários, indicadores, controladores, elementos finais de controle e chaves. Instrumentos de medição são o subconjunto que sente e emite conteúdo de medição. Fecha o ODR-023 pela leitura A: instrumento ⊒ instrumento de medição, como a ISA 5.1 e a ISO 15926 leem."@pt-br ;
    iof-av:isPrimitive false ;
    iof-av:adaptedFrom "ANSI/ISA-5.1-2009 Instrumentation Symbols and Identification: instrument" ;
    dcterms:source "ODR-023 (reading A)" ;
    dcterms:source "ODR-025 §5" ;
    dcterms:source "ANSI/ISA-5.1-2009 Instrumentation Symbols and Identification" ;
    dcterms:source "ISO 15926-4 reference data (RDL): stream and equipment classes" ;
    rdfs:isDefinedBy copi:copi-core .

copi:COPI_0000024 a owl:Class ;
    rdfs:label "measurement instrument"@en , "instrumento de medição"@pt-br ;
    rdfs:subClassOf copi:COPI_0000091 ;
    owl:equivalentClass [ owl:intersectionOf ( iof-constr:MaterialArtifact [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom [ owl:intersectionOf ( copi:COPI_0001035 [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom [ a owl:Restriction ; owl:onProperty copi:COPI_0001005 ; owl:someValuesFrom [ owl:intersectionOf ( copi:COPI_0001003 [ a owl:Restriction ; owl:onProperty obo:BFO_0000059 ; owl:someValuesFrom copi:COPI_0001051 ] ) ] ] ] ) ] ] ) ] ;
    iof-av:naturalLanguageDefinition "instrument that bears a sensing function realized in a process whose outflow is a signal flow concretizing measurement content"@en ;
    iof-av:naturalLanguageDefinition "instrumento que porta uma função de sensoriamento realizada num processo cujo fluxo de saída é um fluxo de sinal que concretiza conteúdo de medição"@pt-br ;
    rdfs:comment "instrument that bears a sensing function realized in a process whose outflow is a signal flow concretizing measurement content"@en ;
    rdfs:comment "instrumento que porta uma função de sensoriamento realizada num processo cujo fluxo de saída é um fluxo de sinal que concretiza conteúdo de medição"@pt-br ;
    iof-av:semiFormalNaturalLanguageDefinition "x is a 'measurement instrument' if and only if x is a 'material artifact' that is 'bearer of' some 'sensing function' that is 'realized in' some process that 'has outflow' some 'signal flow' that 'concretizes' some 'measurement content'"@en ;
    iof-av:semiFormalNaturalLanguageDefinition "x é um 'instrumento de medição' se e somente se x é um 'artefato material' que é 'portador de' alguma 'função de sensoriamento' que é 'realizada em' algum processo que 'tem fluxo de saída' algum 'fluxo de sinal' que 'concretiza' algum 'conteúdo de medição'"@pt-br ;
    iof-av:firstOrderLogicDefinition "∀x (MeasurementInstrument(x) ↔ MaterialArtifact(x) ∧ ∃f (SensingFunction(f) ∧ bearerOf(x,f) ∧ ∃p (realizedIn(f,p) ∧ ∃s (SignalFlow(s) ∧ hasOutflow(p,s) ∧ ∃c (MeasurementContent(c) ∧ concretizes(s,c))))))"@en ;
    skos:example "A pressure transmitter; a temperature element with its transmitter; a Coriolis flow meter."@en ;
    skos:example "Um transmissor de pressão; um elemento de temperatura com seu transmissor; um medidor de vazão Coriolis."@pt-br ;
    iof-av:explanatoryNote "MeasurementInstrument ⊑ Instrument is now inferred in the direction ISA 5.1 and ISO 15926 read it. Its realization is a bfo:Process, not iof:MeasurementProcess (planned): continuous sensing is not a planned measurement."@en ;
    iof-av:explanatoryNote "'Instrumento de medição ⊑ instrumento' passa a ser inferido no sentido em que a ISA 5.1 e a ISO 15926 leem. Sua realização é um bfo:Process, não iof:MeasurementProcess (planejado): sensoriamento contínuo não é medição planejada (ODR-009 §4 superseded). Um controlador (processar), uma chave (sentir com conteúdo de estado) e um elemento final (regular com entrada de controle) são instrumentos sem ser de medição. O guard check_tsensor_subclass_mesinstr.sparql continua válido."@pt-br ;
    iof-av:isPrimitive false ;
    iof-av:adaptedFrom "ANSI/ISA-5.1-2009 Instrumentation Symbols and Identification: measuring instrument; ISO 15926-4 reference data (RDL): stream and equipment classes" ;
    dcterms:source "ODR-023 (reading A)" ;
    dcterms:source "ODR-025 §5" ;
    dcterms:source "ODR-009 §4 (superseded)" ;
    dcterms:source "ANSI/ISA-5.1-2009 Instrumentation Symbols and Identification" ;
    dcterms:source "Industrial Ontologies Foundry, IOF Core 202603 (spec.industrialontologies.org/ontology/core/Core/): MeasurementProcess (planned)" ;
    rdfs:isDefinedBy copi:copi-core .

copi:COPI_0000003 a owl:Class ;
    rdfs:label "momentum transfer"@en , "transferência de quantidade de movimento"@pt-br ;
    rdfs:subClassOf obo:BFO_0000015 ;
    owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000015 [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom copi:COPI_0001054 ] ) ] ;
    iof-av:naturalLanguageDefinition "process that realizes a momentum transfer function"@en ;
    iof-av:naturalLanguageDefinition "processo que realiza uma função de máquina de fluxo"@pt-br ;
    rdfs:comment "process that realizes a momentum transfer function"@en ;
    rdfs:comment "processo que realiza uma função de máquina de fluxo"@pt-br ;
    iof-av:semiFormalNaturalLanguageDefinition "p is a 'momentum transfer' if and only if p is a 'process' that 'realizes' some 'fluid machine function'"@en ;
    iof-av:semiFormalNaturalLanguageDefinition "p é uma 'transferência de quantidade de movimento' se e somente se p é um 'processo' que 'realiza' alguma 'função de máquina de fluxo'"@pt-br ;
    iof-av:firstOrderLogicDefinition "∀p (MomentumTransfer(p) ↔ Process(p) ∧ ∃f (FluidMachineFunction(f) ∧ realizes(p,f)))"@en ;
    skos:example "The pumping of a liquid; the compression of a gas; the expansion of a gas through a turbine."@en ;
    skos:example "O bombeamento de um líquido; a compressão de um gás; a expansão de um gás numa turbina."@pt-br ;
    iof-av:explanatoryNote "Defined class over the genus-level function. Carries no identity (ODR-011 superseded); copi:Operation ⊑ PlannedProcess (COPI_0000001) is removed; planned-ness is orthogonal (ODR-009)."@en ;
    iof-av:explanatoryNote "Classe definida sobre a função de gênero. Não carrega identidade (ODR-011 superseded); copi:Operation ⊑ PlannedProcess (COPI_0000001) é removida; o caráter planejado é ortogonal (ODR-009 §2). Mantém rótulo, definição e adaptedFrom do FOMI 2026 (McCabe-Smith-Harriott) como classe de consulta."@pt-br ;
    iof-av:isPrimitive false ;
    iof-av:adaptedFrom "McCabe, W.L., Smith, J.C. & Harriott, P. (2005). Unit Operations of Chemical Engineering, 7th ed. McGraw-Hill" ;
    dcterms:source "ODR-024 §3" ;
    dcterms:source "ODR-009 §2" ;
    dcterms:source "ODR-011 (superseded)" ;
    dcterms:source "McCabe, W.L., Smith, J.C. & Harriott, P. (2005). Unit Operations of Chemical Engineering, 7th ed. McGraw-Hill" ;
    rdfs:isDefinedBy copi:copi-core .

copi:COPI_0000004 a owl:Class ;
    rdfs:label "heat transfer"@en , "transferência de calor"@pt-br ;
    rdfs:subClassOf obo:BFO_0000015 ;
    owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000015 [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom copi:COPI_0001055 ] ) ] ;
    iof-av:naturalLanguageDefinition "process that realizes a heat transfer function"@en ;
    iof-av:naturalLanguageDefinition "processo que realiza uma função de transferência de calor"@pt-br ;
    rdfs:comment "process that realizes a heat transfer function"@en ;
    rdfs:comment "processo que realiza uma função de transferência de calor"@pt-br ;
    iof-av:semiFormalNaturalLanguageDefinition "p is a 'heat transfer' if and only if p is a 'process' that 'realizes' some 'heat transfer function'"@en ;
    iof-av:semiFormalNaturalLanguageDefinition "p é uma 'transferência de calor' se e somente se p é um 'processo' que 'realiza' alguma 'função de transferência de calor'"@pt-br ;
    iof-av:firstOrderLogicDefinition "∀p (HeatTransfer(p) ↔ Process(p) ∧ ∃f (HeatTransferFunction(f) ∧ realizes(p,f)))"@en ;
    skos:example "Cooling a product stream against seawater; preheating crude against a hot product; condensing overheads against cooling water."@en ;
