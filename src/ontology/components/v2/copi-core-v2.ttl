copi:COPI_0000091 a owl:Class ;
    rdfs:label "instrument"@en , "instrumento"@pt-br ;
    dcterms:source "ODR-023 (reading A)" ;
    rdfs:isDefinedBy copi:copi-core ;
    rdfs:subClassOf iof-constr:MaterialArtifact ;
    owl:equivalentClass [ owl:intersectionOf ( iof-constr:MaterialArtifact [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom copi:COPI_0001019 ] ) ] ;
    iof-av:naturalLanguageDefinition "material artifact that bears a signalling function: sensing, indicating or processing a signal"@en ;
    iof-av:explanatoryNote "ISA 5.1: instruments include primary elements, indicators, controllers, final control elements and switches. Measurement instruments are the sensing subset."@en ;
    iof-av:isPrimitive false .

copi:COPI_0000024 a owl:Class ;
    rdfs:label "measurement instrument"@en , "instrumento de medição"@pt-br ;
    dcterms:source "ODR-023 (reading A)" ;
    rdfs:isDefinedBy copi:copi-core ;
    rdfs:subClassOf copi:COPI_0000091 ;
    owl:equivalentClass [ owl:intersectionOf ( iof-constr:MaterialArtifact [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom [ owl:intersectionOf ( copi:COPI_0001035 [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom [ a owl:Restriction ; owl:onProperty copi:COPI_0001005 ; owl:someValuesFrom [ owl:intersectionOf ( copi:COPI_0001003 [ a owl:Restriction ; owl:onProperty obo:BFO_0000059 ; owl:someValuesFrom copi:COPI_0001051 ] ) ] ] ] ) ] ] ) ] ;
    iof-av:naturalLanguageDefinition "instrument that bears a sensing function realized in a process whose outflow is a signal flow concretizing measurement content"@en ;
    iof-av:explanatoryNote "MeasurementInstrument ⊑ Instrument is now inferred in the direction ISA 5.1 and ISO 15926 read it. Its realization is a bfo:Process, not iof:MeasurementProcess (planned): continuous sensing is not a planned measurement."@en ;
    iof-av:isPrimitive false .

