copi:COPI_0001068 a owl:AnnotationProperty ; rdfs:label "signature"@en ; iof-av:naturalLanguageDefinition "JSON signature of a term function: verb, secondary, tertiary, inflows, outflows, primary flow, interface"@en ; dcterms:source "ODR-025" .
copi:COPI_0001069 a owl:AnnotationProperty ; rdfs:label "primary function"@en ; iof-av:naturalLanguageDefinition "IRI of the function that gives the artifact its box (curation convention; design context)"@en ; dcterms:source "ODR-025" .
