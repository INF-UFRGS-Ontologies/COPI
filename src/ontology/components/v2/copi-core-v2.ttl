    iof-av:naturalLanguageDefinition "heat exchange: operation leaf kept from v1; its equivalence to 'process that realizes some <term function>' is emitted by the export"@en ;
    iof-av:isPrimitive true .

copi:COPI_0000011 owl:disjointWith copi:COPI_0000012 .   # liquid × gas pressure increase: exclusive qualifier

copi:COPI_0000015 a owl:Class ;
    rdfs:label "loss of containment"@en , "perda de contenção"@pt-br ;
    dcterms:source "ODR-009 §3" ;
    rdfs:isDefinedBy copi:copi-core ;
    rdfs:subClassOf obo:BFO_0000015 ;
    iof-av:naturalLanguageDefinition "process in which contained material leaves its containment device other than through an outflow of its storing function"@en ;
    iof-av:isPrimitive true .

