copi:COPI_0000011 a owl:Class ;
    rdfs:label "liquid pressure increase"@en , "aumento de pressão de líquido"@pt-br ;
    rdfs:subClassOf copi:COPI_0000003 ;
    iof-av:naturalLanguageDefinition "liquid pressure increase: operation leaf kept from v1; its equivalence to 'process that realizes some <term function>' is emitted by the export"@en ;
    iof-av:naturalLanguageDefinition "aumento de pressão de líquido: folha de operação mantida do v1; sua equivalência a 'processo que realiza alguma <função de termo>' é emitida pelo export"@pt-br ;
    rdfs:comment "liquid pressure increase: operation leaf kept from v1; its equivalence to 'process that realizes some <term function>' is emitted by the export"@en ;
    rdfs:comment "aumento de pressão de líquido: folha de operação mantida do v1; sua equivalência a 'processo que realiza alguma <função de termo>' é emitida pelo export"@pt-br ;
    iof-av:semiFormalNaturalLanguageAxiom "if p is a 'liquid pressure increase' then p is an instance of its parent operation; the export states p is a 'liquid pressure increase' if and only if p realizes the corresponding term function"@en ;
    iof-av:semiFormalNaturalLanguageAxiom "se p é uma 'aumento de pressão de líquido' então p é instância da sua operação pai; o export afirma que p é uma 'aumento de pressão de líquido' se e somente se p realiza a função de termo correspondente"@pt-br ;
    iof-av:firstOrderLogicAxiom "∀p (LiquidPressureIncrease(p) → Process(p))"@en ;
    skos:example "Pumping crude from a separator to a header; boosting water for injection."@en ;
    skos:example "Bombear óleo cru de um separador para um coletor; elevar a pressão da água de injeção."@pt-br ;
    iof-av:explanatoryNote "FOMI 2026 operation leaf kept on its IRI; it no longer carries identity. The equivalence to the term function (liquid pressure increase ≡ process that realizes some pumping function) comes from the enriched export."@en ;
    iof-av:explanatoryNote "Folha de operação do FOMI 2026 mantida pelo IRI; deixa de carregar identidade. A equivalência à função de termo (ex.: aumento de pressão de líquido ≡ processo que realiza alguma função de bombeamento) vem do export enriquecido."@pt-br ;
    iof-av:isPrimitive true ;
    iof-av:primitiveRationale "Kept primitive in the core; the export adds the defining equivalence from the enriched term function."@en ;
    iof-av:primitiveRationale "Mantida primitiva no core; o export acrescenta a equivalência definidora a partir da função de termo enriquecida."@pt-br ;
    iof-av:adaptedFrom "McCabe, W.L., Smith, J.C. & Harriott, P. (2005). Unit Operations of Chemical Engineering, 7th ed. McGraw-Hill" ;
    dcterms:source "ODR-011 (leaf kept)" ;
    dcterms:source "ODR-024 §3" ;
    dcterms:source "McCabe, W.L., Smith, J.C. & Harriott, P. (2005). Unit Operations of Chemical Engineering, 7th ed. McGraw-Hill" ;
    rdfs:isDefinedBy copi:copi-core .

copi:COPI_0000012 a owl:Class ;
    rdfs:label "gas pressure increase"@en , "aumento de pressão de gás"@pt-br ;
    rdfs:subClassOf copi:COPI_0000003 ;
