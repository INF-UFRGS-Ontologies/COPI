  </rdf:Description>
  <rdf:Description rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b157">
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
    <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000660"/>
