  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000409">
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b46"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b45"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical stirring of a liquid to promote mixing, suspension of solids, or heat transfer.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">agitation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de agitação</rdfs:label>
  </rdf:Description>
