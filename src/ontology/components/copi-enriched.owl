  </rdf:Description>
  <rdf:Description rdf:nodeID="n0bdf7dc8f7a94e27b16f376933615bb6b658">
    <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
    <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/InformationContentEntity"/>
