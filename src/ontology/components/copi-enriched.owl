  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000531">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the guidance or steering of fluid flow in a defined direction within a process system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em guiar ou orientar o escoamento de fluido em uma direção definida dentro de um sistema de processo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fluid direction function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de direcionamento de fluido</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001403"/>
    <rdfs:subClassOf rdf:nodeID="n001404"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the guidance or steering of fluid flow in a defined direction within a process system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000532">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which fluid flow is guided or steered in a defined direction within a process system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o escoamento de fluido é guiado ou orientado em uma direção definida dentro de um sistema de processo.</iof-av:naturalLanguageDefinition>
