    <rdfs:subClassOf rdf:nodeID="n0bdf7dc8f7a94e27b16f376933615bb6b1400"/>
    <rdfs:subClassOf rdf:nodeID="n0bdf7dc8f7a94e27b16f376933615bb6b2312"/>
    <rdfs:subClassOf rdf:nodeID="n0bdf7dc8f7a94e27b16f376933615bb6b1388"/>
    <rdfs:subClassOf rdf:nodeID="n0bdf7dc8f7a94e27b16f376933615bb6b62"/>
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a HeatTransferProcess and that consists in facilitating the transfer of thermal energy between two or more fluid media while maintaining their physical separation.</iof-av:naturalLanguageDefinition>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a HeatTransferProcess and that consists in facilitating the transfer of thermal energy between two or more fluid media while maintaining their physical separation.</skos:definition>
    <rdfs:label xml:lang="en">heat transfer function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transferência de calor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/StatorWinding">
    <rdfs:label xml:lang="en">stator winding</rdfs:label>
    <rdfs:label xml:lang="pt-br">enrolamento de estator</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the stationary winding of an electric motor or generator that produces or responds to the rotating magnetic field in petroleum production rotating electrical equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000193">
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of electrical energy into rotational or linear mechanical motion.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="n0bdf7dc8f7a94e27b16f376933615bb6b914"/>
    <rdfs:subClassOf rdf:nodeID="n0bdf7dc8f7a94e27b16f376933615bb6b913"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <rdfs:label xml:lang="en">electric to mechanical conversion function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de conversão elétrico-mecânica</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
