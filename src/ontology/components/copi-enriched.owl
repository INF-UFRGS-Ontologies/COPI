    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1577"/>
    <rdfs:label xml:lang="en">level indication process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de indicação de nível</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
