    <owl:intersectionOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2035"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b1289">
    <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasComponentPartAtAllTimes"/>
