  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000579">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1704"/>
