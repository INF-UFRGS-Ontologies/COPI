  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000448">
    <rdfs:label xml:lang="en">cooling function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de resfriamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b528"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b541"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b542"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b529"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the removal of thermal energy from a process stream or equipment component to reduce its temperature.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b1403">
