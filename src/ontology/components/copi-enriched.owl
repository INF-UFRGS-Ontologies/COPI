    <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasFunction"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000172"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b1244">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
    <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000386"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000070">
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2416"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2415"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <rdfs:label xml:lang="pt-br">função de sensoriamento de temperatura</rdfs:label>
    <rdfs:label xml:lang="en">temperature sensing function</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the detection and measurement of the temperature of a process stream or equipment surface.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000566">
    <rdfs:label xml:lang="en">level switching function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de chaveamento de nível</rdfs:label>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the generation of a discrete switching signal when the fluid level in a vessel crosses a defined high or low threshold.</skos:definition>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b1623"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b1622"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2153">
    <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000037"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasInput"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b1145">
    <owl:someValuesFrom rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementInformationContentEntity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000178">
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2017"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000028"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2018"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure measurement function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de medição de pressão</rdfs:label>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the measurement and local display of the pressure of a process stream.</skos:definition>
  </rdf:Description>
