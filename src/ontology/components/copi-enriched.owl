    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a body or housing artifact provides structural containment and protection for internal mechanical components or assemblies.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000502">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the dispersion of thermal, acoustic, or kinetic energy over a larger volume or surface to reduce its local intensity.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em dispersar energia térmica, acústica ou cinética por um volume ou superfície maior para reduzir sua intensidade local.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">energy diffusion function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de difusão de energia</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001249"/>
    <rdfs:subClassOf rdf:nodeID="n001250"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the dispersion of thermal, acoustic, or kinetic energy over a larger volume or surface to reduce its local intensity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000503">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which thermal, acoustic, or kinetic energy is dispersed over a larger volume or surface to reduce its local intensity.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que energia térmica, acústica ou cinética é dispersa por um volume ou superfície maior para reduzir sua intensidade local.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">energy diffusion process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de difusão de energia</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001251"/>
    <rdfs:subClassOf rdf:nodeID="n001252"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which thermal, acoustic, or kinetic energy is dispersed over a larger volume or surface to reduce its local intensity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000504">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the recovery of useful work or heat from a process stream, pressure differential, or thermal source.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em recuperar trabalho útil ou calor de uma corrente de processo, de um diferencial de pressão ou de uma fonte térmica.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">energy extraction function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de extração de energia</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001253"/>
    <rdfs:subClassOf rdf:nodeID="n001254"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the recovery of useful work or heat from a process stream, pressure differential, or thermal source.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000505">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which useful work or heat is recovered from a process stream, pressure differential, or thermal source in petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que trabalho útil ou calor é recuperado de uma corrente de processo, de um diferencial de pressão ou de uma fonte térmica em equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">energy extraction process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de extração de energia</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001255"/>
    <rdfs:subClassOf rdf:nodeID="n001256"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which useful work or heat is recovered from a process stream, pressure differential, or thermal source in petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000506">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the movement of energy in the form of heat, work, or electromagnetic radiation from one medium or system to another.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em transferir energia, na forma de calor, trabalho ou radiação eletromagnética, de um meio ou sistema para outro.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">energy transfer function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transferência de energia</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001257"/>
    <rdfs:subClassOf rdf:nodeID="n001258"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the movement of energy in the form of heat, work, or electromagnetic radiation from one medium or system to another.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000507">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which energy in the form of heat, work, or electromagnetic radiation is transferred from one medium or system to another.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que energia, na forma de calor, trabalho ou radiação eletromagnética, é transferida de um meio ou sistema para outro.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">energy transfer process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transferência de energia</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001259"/>
    <rdfs:subClassOf rdf:nodeID="n001260"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which energy in the form of heat, work, or electromagnetic radiation is transferred from one medium or system to another.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000508">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical support of process equipment to maintain its position and transmit loads to a structural foundation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em sustentar mecanicamente equipamentos de processo, mantendo sua posição e transmitindo as cargas a uma fundação estrutural.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">equipment support function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de suporte de equipamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001261"/>
    <rdfs:subClassOf rdf:nodeID="n001262"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical support of process equipment to maintain its position and transmit loads to a structural foundation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000509">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which process equipment is mechanically supported to maintain its position and transmit structural loads to a foundation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que equipamentos de processo são sustentados mecanicamente, mantendo sua posição e transmitindo as cargas estruturais a uma fundação.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">equipment support process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de suporte de equipamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001263"/>
    <rdfs:subClassOf rdf:nodeID="n001264"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which process equipment is mechanically supported to maintain its position and transmit structural loads to a foundation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000510">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which particles, contaminants, or unwanted substances are selectively retained from a fluid stream by a filter element through mechanical screening or other separation mechanisms while clean fluid passes through.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que partículas, contaminantes ou substâncias indesejadas são retidos seletivamente de uma corrente de fluido por um elemento filtrante, por peneiramento mecânico ou outros mecanismos de separação, enquanto o fluido limpo passa.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">filtration process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de filtração</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001265"/>
    <rdfs:subClassOf rdf:nodeID="n001266"/>
    <rdfs:subClassOf rdf:nodeID="n001267"/>
    <rdfs:subClassOf rdf:nodeID="n001268"/>
    <rdfs:subClassOf rdf:nodeID="n001269"/>
    <rdfs:subClassOf rdf:nodeID="n001270"/>
    <rdfs:subClassOf rdf:nodeID="n001271"/>
    <rdfs:subClassOf rdf:nodeID="n001272"/>
    <rdfs:subClassOf rdf:nodeID="n001273"/>
    <rdfs:subClassOf rdf:nodeID="n001274"/>
    <rdfs:subClassOf rdf:nodeID="n001275"/>
    <rdfs:subClassOf rdf:nodeID="n001276"/>
    <rdfs:subClassOf rdf:nodeID="n001277"/>
    <rdfs:subClassOf rdf:nodeID="n001278"/>
    <rdfs:subClassOf rdf:nodeID="n001279"/>
    <rdfs:subClassOf rdf:nodeID="n001280"/>
    <rdfs:subClassOf rdf:nodeID="n001281"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000006"/>
    <skos:definition xml:lang="en">A PlannedProcess in which particles, contaminants, or unwanted substances are selectively retained from a fluid stream by a filter element through mechanical screening or other separation mechanisms while clean fluid passes through.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000511">
    <iof-av:naturalLanguageDefinition xml:lang="en">A heating function borne by petroleum production equipment whose realization constitutes the transfer of thermal energy generated by combustion to a process stream or vessel.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de aquecimento portada por equipamento de produção de petróleo cuja realização consiste em transferir a energia térmica gerada por combustão a uma corrente de processo ou a um vaso.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fired heating function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de aquecimento a combustão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001282"/>
    <rdfs:subClassOf rdf:nodeID="n001283"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000190"/>
    <skos:definition xml:lang="en">A heating function borne by petroleum production equipment whose realization constitutes the transfer of thermal energy generated by combustion to a process stream or vessel.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000512">
    <iof-av:naturalLanguageDefinition xml:lang="en">A heating process in which thermal energy is generated by the combustion of fuel and transferred to a process stream or vessel through a fired heater.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de aquecimento em que energia térmica é gerada pela combustão de um combustível e transferida a uma corrente de processo ou a um vaso por meio de um forno.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fired heating process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de aquecimento a combustão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001284"/>
    <rdfs:subClassOf rdf:nodeID="n001285"/>
    <rdfs:subClassOf rdf:nodeID="n001286"/>
    <rdfs:subClassOf rdf:nodeID="n001287"/>
    <rdfs:subClassOf rdf:nodeID="n001288"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000548"/>
    <skos:definition xml:lang="en">A heating process in which thermal energy is generated by the combustion of fuel and transferred to a process stream or vessel through a fired heater.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000513">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the prevention of flame propagation through a flammable gas mixture by quenching the flame front in narrow passages.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em impedir a propagação de chama através de uma mistura gasosa inflamável, extinguindo a frente de chama em passagens estreitas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flame arrest function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de contenção de chama</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001289"/>
    <rdfs:subClassOf rdf:nodeID="n001290"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the prevention of flame propagation through a flammable gas mixture by quenching the flame front in narrow passages.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000514">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which flame propagation through a flammable gas mixture is prevented by quenching the flame front in narrow passages of a flame arrester.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a propagação de chama através de uma mistura gasosa inflamável é impedida pela extinção da frente de chama nas passagens estreitas de um corta-chamas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flame arrest process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de contenção de chama</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001291"/>
    <rdfs:subClassOf rdf:nodeID="n001292"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which flame propagation through a flammable gas mixture is prevented by quenching the flame front in narrow passages of a flame arrester.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000515">
    <iof-av:naturalLanguageDefinition xml:lang="en">A detection function borne by petroleum production equipment whose realization constitutes the sensing of the presence of a flame or combustion event by detecting radiant energy or other combustion signatures.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de detecção portada por equipamento de produção de petróleo cuja realização consiste em detectar a presença de chama ou de um evento de combustão pela energia radiante ou por outras assinaturas da combustão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flame detection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de detecção de chama</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001293"/>
    <rdfs:subClassOf rdf:nodeID="n001294"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000465"/>
    <skos:definition xml:lang="en">A detection function borne by petroleum production equipment whose realization constitutes the sensing of the presence of a flame or combustion event by detecting radiant energy or other combustion signatures.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000516">
    <iof-av:naturalLanguageDefinition xml:lang="en">A detection process in which the presence of a flame or combustion event is sensed by detecting radiant energy or other combustion signatures.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de detecção em que a presença de chama ou de um evento de combustão é detectada pela energia radiante ou por outras assinaturas da combustão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flame detection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de detecção de chama</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001295"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000466"/>
    <skos:definition xml:lang="en">A detection process in which the presence of a flame or combustion event is sensed by detecting radiant energy or other combustion signatures.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000517">
    <iof-av:naturalLanguageDefinition xml:lang="en">A GasDisengagementFunction that is realized in a FlashVaporizationProcess and that consists in letting lighter products of a process stream flash off or vaporize in a drum, so that the vapour is drawn off at the top and the heavier liquid fractions at the bottom.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma GasDisengagementFunction que é realizada em um FlashVaporizationProcess e que consiste em permitir que os produtos mais leves de uma corrente de processo vaporizem instantaneamente em um tambor, de modo que o vapor é retirado no topo e as frações líquidas mais pesadas no fundo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flash vaporization function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de vaporização flash</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001296"/>
    <rdfs:subClassOf rdf:nodeID="n001297"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000796"/>
    <skos:definition xml:lang="en">A GasDisengagementFunction that is realized in a FlashVaporizationProcess and that consists in letting lighter products of a process stream flash off or vaporize in a drum, so that the vapour is drawn off at the top and the heavier liquid fractions at the bottom.</skos:definition>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the partial vaporisation of a pressurised liquid stream caused by a rapid reduction in pressure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000518">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a pressurised liquid stream is partially vaporised as a result of a rapid reduction in pressure.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que uma corrente líquida pressurizada é parcialmente vaporizada em consequência de uma redução rápida de pressão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flash vaporization process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de vaporização flash</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001298"/>
    <rdfs:subClassOf rdf:nodeID="n001299"/>
    <rdfs:subClassOf rdf:nodeID="n001300"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000008"/>
    <skos:definition xml:lang="en">A planned process in which a pressurised liquid stream is partially vaporised as a result of a rapid reduction in pressure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000519">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a flexible membrane that separates two chambers and transmits pressure between them in petroleum production measurement or control equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é uma membrana flexível que separa duas câmaras e transmite pressão entre elas em equipamentos de medição ou controle de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flexible diaphragm</rdfs:label>
    <rdfs:label xml:lang="pt-br">diafragma flexível</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a flexible membrane that separates two chambers and transmits pressure between them in petroleum production measurement or control equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000520">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which fluid flow is regulated, directed, or restricted through a valve body by positioning internal closure elements to achieve desired flow characteristics.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que o escoamento de fluido é regulado, direcionado ou restringido através do corpo de uma válvula pelo posicionamento de elementos internos de fechamento, obtendo as características de escoamento desejadas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow control process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de controle de fluxo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001301"/>
    <rdfs:subClassOf rdf:nodeID="n001302"/>
