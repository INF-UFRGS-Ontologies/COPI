  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000509">
    <rdfs:label xml:lang="en">equipment support process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de suporte de equipamento</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2301"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2302"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A planned process in which process equipment is mechanically supported to maintain its position and transmit structural loads to a foundation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1730">
    <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
