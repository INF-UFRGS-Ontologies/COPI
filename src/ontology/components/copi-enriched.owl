    <rdfs:subClassOf rdf:nodeID="n001341"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A PlannedProcess in which fluid flow is regulated, directed, or restricted through a valve body by positioning internal closure elements to achieve desired flow characteristics.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000521">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the instantaneous flow rate of a process stream is measured and displayed locally or transmitted to a remote monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a vazão instantânea de uma corrente de processo é medida e exibida localmente ou transmitida a um sistema de monitoramento remoto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow indication process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de indicação de fluxo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001342"/>
    <rdfs:subClassOf rdf:nodeID="n001343"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which the instantaneous flow rate of a process stream is measured and displayed locally or transmitted to a remote monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000522">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a measuring element determines the flow rate of a fluid by sensing flow-related physical phenomena and converting them into measurable signals or indications.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que um elemento de medição determina a vazão de um fluido detectando fenômenos físicos relacionados ao escoamento e convertendo-os em sinais ou indicações mensuráveis.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow measurement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição de fluxo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001344"/>
    <rdfs:subClassOf rdf:nodeID="n001345"/>
    <rdfs:subClassOf rdf:nodeID="n001346"/>
    <rdfs:subClassOf rdf:nodeID="n001347"/>
    <rdfs:subClassOf rdf:nodeID="n001348"/>
    <rdfs:subClassOf rdf:nodeID="n001349"/>
    <rdfs:subClassOf rdf:nodeID="n001350"/>
    <rdfs:subClassOf rdf:nodeID="n001351"/>
    <rdfs:subClassOf rdf:nodeID="n001352"/>
    <rdfs:subClassOf rdf:nodeID="n001353"/>
    <rdfs:subClassOf rdf:nodeID="n001354"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a measuring element determines the flow rate of a fluid by sensing flow-related physical phenomena and converting them into measurable signals or indications.</skos:definition>
    <skos:definition xml:lang="en">A measurement process in which the flow rate of a process stream is determined by sensing a flow-dependent physical effect and expressing it as a quantitative value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000523">
    <iof-av:naturalLanguageDefinition xml:lang="en">A FlowControlFunction that is realized in a FlowModificationProcess and that consists in altering the characteristics of fluid flow (such as velocity profile, turbulence, pressure drop pattern, or flow distribution) without primarily controlling the flow rate or direction.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma FlowControlFunction que é realizada em um FlowModificationProcess e que consiste em alterar características do escoamento (como perfil de velocidade, turbulência, padrão de perda de carga ou distribuição) sem controlar primariamente a vazão ou o sentido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow modification function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de modificação de fluxo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001355"/>
    <rdfs:subClassOf rdf:nodeID="n001356"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000026"/>
    <skos:definition xml:lang="en">A FlowControlFunction that is realized in a FlowModificationProcess and that consists in altering the characteristics of fluid flow (such as velocity profile, turbulence, pressure drop pattern, or flow distribution) without primarily controlling the flow rate or direction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000524">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which the characteristics of fluid flow are altered by a flow modification accessory, resulting in changes to flow patterns, velocity profiles, turbulence levels, or pressure drop characteristics while the fluid passes through or around the device.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que as características do escoamento são alteradas por um acessório de modificação de escoamento, mudando padrões de escoamento, perfis de velocidade, níveis de turbulência ou características de perda de carga enquanto o fluido passa pelo dispositivo ou ao redor dele.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow modification process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de modificação de fluxo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001357"/>
    <rdfs:subClassOf rdf:nodeID="n001358"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A PlannedProcess in which the characteristics of fluid flow are altered by a flow modification accessory, resulting in changes to flow patterns, velocity profiles, turbulence levels, or pressure drop characteristics while the fluid passes through or around the device.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000525">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the flow rate or pressure of a fluid stream is reduced in a controlled manner by introducing a fixed or variable resistance.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a vazão ou a pressão de uma corrente de fluido é reduzida de forma controlada pela introdução de uma resistência fixa ou variável.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow restriction process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de restrição de fluxo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001359"/>
    <rdfs:subClassOf rdf:nodeID="n001360"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which the flow rate or pressure of a fluid stream is reduced in a controlled manner by introducing a fixed or variable resistance.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000526">
    <iof-av:naturalLanguageDefinition xml:lang="en">A signal transmission process in which a standardised signal representing a measured flow rate is transmitted to a remote control or monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de transmissão de sinal em que um sinal padronizado que representa uma vazão medida é transmitido a um sistema remoto de controle ou monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow signal transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transmissão de sinal de fluxo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001361"/>
    <rdfs:subClassOf rdf:nodeID="n001362"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000035"/>
    <skos:definition xml:lang="en">A signal transmission process in which a standardised signal representing a measured flow rate is transmitted to a remote control or monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000527">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the generation of a discrete switching signal when the flow rate of a process stream crosses a defined threshold.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em gerar um sinal de chaveamento discreto quando a vazão de uma corrente de processo ultrapassa um limite definido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow switching function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de chaveamento de fluxo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001363"/>
    <rdfs:subClassOf rdf:nodeID="n001364"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the generation of a discrete switching signal when the flow rate of a process stream crosses a defined threshold.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000528">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a discrete switching signal is generated when the flow rate of a process stream crosses a defined threshold.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um sinal de chaveamento discreto é gerado quando a vazão de uma corrente de processo ultrapassa um limite definido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flow switching process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de chaveamento de fluxo</rdfs:label>
