  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000663">
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2441"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2440"/>
