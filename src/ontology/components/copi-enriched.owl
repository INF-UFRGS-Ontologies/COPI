    <skos:definition xml:lang="en">A planned process in which fluid flow is guided or steered in a defined direction within a process system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000533">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the splitting and delivery of a fluid stream to multiple downstream points in defined proportions.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em dividir uma corrente de fluido e entregá-la a vários pontos a jusante em proporções definidas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fluid distribution function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de distribuição de fluido</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001407"/>
    <rdfs:subClassOf rdf:nodeID="n001408"/>
    <rdfs:subClassOf rdf:nodeID="n001409"/>
    <rdfs:subClassOf rdf:nodeID="n001410"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the splitting and delivery of a fluid stream to multiple downstream points in defined proportions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000534">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a fluid stream is split and delivered to multiple downstream points in defined proportions.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que uma corrente de fluido é dividida e entregue a vários pontos a jusante em proporções definidas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fluid distribution process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de distribuição de fluido</rdfs:label>
