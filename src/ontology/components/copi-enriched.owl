  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000535">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes an opening in the body of petroleum production equipment through which fluid enters or exits.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é uma abertura no corpo de um equipamento de produção de petróleo pela qual o fluido entra ou sai.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fluid opening</rdfs:label>
    <rdfs:label xml:lang="pt-br">abertura de fluido</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes an opening in the body of petroleum production equipment through which fluid enters or exits.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000536">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fluid port</rdfs:label>
    <rdfs:label xml:lang="pt-br">porta de fluido</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000329"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a port or connection point through which fluid enters or exits a component of petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000537">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conveyance of a fluid over distance by exploiting pressure differentials, gravity, or imparted energy.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em transportar um fluido a distância aproveitando diferenciais de pressão, gravidade ou energia fornecida.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fluid transport function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transporte de fluido</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001415"/>
    <rdfs:subClassOf rdf:nodeID="n001416"/>
    <rdfs:subClassOf rdf:nodeID="n001417"/>
    <rdfs:subClassOf rdf:nodeID="n001418"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conveyance of a fluid over distance by exploiting pressure differentials, gravity, or imparted energy.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000538">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a fluid is conveyed over distance by exploiting pressure differentials, gravity, or energy imparted by petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um fluido é transportado a distância aproveitando diferenciais de pressão, gravidade ou energia fornecida por equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">fluid transport process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transporte de fluido</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001419"/>
