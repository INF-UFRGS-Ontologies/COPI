  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000616">
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b338"/>
    <rdfs:subClassOf rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b2095"/>
