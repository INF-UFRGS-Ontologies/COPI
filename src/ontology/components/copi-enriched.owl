    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2204"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1214"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1212"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2356"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2357"/>
