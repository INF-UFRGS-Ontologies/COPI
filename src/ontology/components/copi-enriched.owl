    <rdfs:subClassOf rdf:nodeID="n001422"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which a fluid is conveyed over distance by exploiting pressure differentials, gravity, or energy imparted by petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000539">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of a mechanical force or pressure into a proportional electrical signal.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em converter uma força mecânica ou uma pressão em um sinal elétrico proporcional.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">force to electrical transduction function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transdução força-elétrica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001423"/>
    <rdfs:subClassOf rdf:nodeID="n001424"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of a mechanical force or pressure into a proportional electrical signal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000540">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a mechanical force or pressure is converted into a proportional electrical signal by petroleum production instrumentation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que uma força mecânica ou uma pressão é convertida em um sinal elétrico proporcional pela instrumentação de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">force to electrical transduction process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transdução força-elétrica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001425"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which a mechanical force or pressure is converted into a proportional electrical signal by petroleum production instrumentation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000541">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a ForceTransmissionProcess and that consists in transmitting mechanical force or motion from one component to another through direct physical coupling.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um ForceTransmissionProcess e que consiste em transmitir força ou movimento mecânico de um componente a outro por acoplamento físico direto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">force transmission function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transmissão de força</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001426"/>
    <rdfs:subClassOf rdf:nodeID="n001427"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a ForceTransmissionProcess and that consists in transmitting mechanical force or motion from one component to another through direct physical coupling.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000542">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which mechanical force or motion is transferred from an input component to an output component through direct physical coupling and mechanical linkage.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que força ou movimento mecânico é transferido de um componente de entrada para um componente de saída por acoplamento físico direto e ligação mecânica.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">force transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transmissão de força</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which mechanical force or motion is transferred from an input component to an output component through direct physical coupling and mechanical linkage.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000543">
    <iof-av:naturalLanguageDefinition xml:lang="en">A detection function borne by petroleum production equipment whose realization constitutes the sensing and identification of the presence or concentration of a specific gas or vapour in the surrounding atmosphere.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de detecção portada por equipamento de produção de petróleo cuja realização consiste em detectar e identificar a presença ou a concentração de um gás ou vapor específico na atmosfera ao redor.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas detection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de detecção de gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001428"/>
    <rdfs:subClassOf rdf:nodeID="n001429"/>
    <rdfs:subClassOf rdf:nodeID="n001430"/>
    <rdfs:subClassOf rdf:nodeID="n001431"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000465"/>
    <skos:definition xml:lang="en">A detection function borne by petroleum production equipment whose realization constitutes the sensing and identification of the presence or concentration of a specific gas or vapour in the surrounding atmosphere.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000544">
    <iof-av:naturalLanguageDefinition xml:lang="en">A detection process in which the presence or concentration of a specific gas or vapour in the surrounding atmosphere is sensed and identified.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de detecção em que a presença ou a concentração de um gás ou vapor específico na atmosfera ao redor é detectada e identificada.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas detection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de detecção de gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001432"/>
    <rdfs:subClassOf rdf:nodeID="n001433"/>
    <rdfs:subClassOf rdf:nodeID="n001434"/>
    <rdfs:subClassOf rdf:nodeID="n001435"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000466"/>
    <skos:definition xml:lang="en">A detection process in which the presence or concentration of a specific gas or vapour in the surrounding atmosphere is sensed and identified.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000545">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which gas is transported from one location to another by imparting kinetic or pressure energy to the gas stream.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que gás é transportado de um local a outro pela transferência de energia cinética ou de pressão à corrente gasosa.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas movement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de movimentação de gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001436"/>
    <rdfs:subClassOf rdf:nodeID="n001437"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which gas is transported from one location to another by imparting kinetic or pressure energy to the gas stream.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000546">
    <iof-av:naturalLanguageDefinition xml:lang="en">A separation function borne by petroleum production equipment whose realization constitutes the separation of phases of differing densities by the action of gravity in a settling vessel.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de separação portada por equipamento de produção de petróleo cuja realização consiste em separar fases de densidades diferentes pela ação da gravidade em um vaso de decantação.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gravity separation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de separação gravitacional</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001438"/>
    <rdfs:subClassOf rdf:nodeID="n001439"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000195"/>
    <skos:definition xml:lang="en">A separation function borne by petroleum production equipment whose realization constitutes the separation of phases of differing densities by the action of gravity in a settling vessel.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000547">
    <iof-av:naturalLanguageDefinition xml:lang="en">A separation process in which phases of differing densities are separated by the action of gravity in a vessel or settler.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de separação em que fases de densidades diferentes são separadas pela ação da gravidade em um vaso ou decantador.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gravity separation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de separação gravitacional</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001440"/>
    <rdfs:subClassOf rdf:nodeID="n001441"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000635"/>
    <skos:definition xml:lang="en">A separation process in which phases of differing densities are separated by the action of gravity in a vessel or settler.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000548">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which thermal energy is transferred to a process stream or vessel to raise its temperature.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que energia térmica é transferida a uma corrente de processo ou a um vaso para elevar sua temperatura.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">heating process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de aquecimento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001442"/>
    <rdfs:subClassOf rdf:nodeID="n001443"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000004"/>
    <skos:definition xml:lang="en">A planned process in which thermal energy is transferred to a process stream or vessel to raise its temperature.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000549">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the moisture content or relative humidity of a gas stream is measured by petroleum production instrumentation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o teor de umidade ou a umidade relativa de uma corrente gasosa é medido pela instrumentação de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">humidity measurement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição de umidade</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001444"/>
    <rdfs:subClassOf rdf:nodeID="n001445"/>
    <rdfs:subClassOf rdf:nodeID="n001446"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the moisture content or relative humidity of a gas stream is measured by petroleum production instrumentation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000550">
    <iof-av:naturalLanguageDefinition xml:lang="en">A pumping function borne by petroleum production equipment whose realization constitutes the transfer of mechanical energy to a hydraulic fluid to transmit power or actuate hydraulic equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de bombeamento portada por equipamento de produção de petróleo cuja realização consiste em transferir energia mecânica a um fluido hidráulico para transmitir potência ou acionar equipamentos hidráulicos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">hydraulic pumping function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de bombeamento hidráulico</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001447"/>
    <rdfs:subClassOf rdf:nodeID="n001448"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000066"/>
    <skos:definition xml:lang="en">A pumping function borne by petroleum production equipment whose realization constitutes the transfer of mechanical energy to a hydraulic fluid to transmit power or actuate hydraulic equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000551">
    <iof-av:naturalLanguageDefinition xml:lang="en">A pumping process in which mechanical energy is imparted to a hydraulic fluid to transmit power or actuate hydraulic equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de bombeamento em que energia mecânica é transferida a um fluido hidráulico para transmitir potência ou acionar equipamentos hidráulicos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">hydraulic pumping process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de bombeamento hidráulico</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001449"/>
    <rdfs:subClassOf rdf:nodeID="n001450"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000616"/>
    <skos:definition xml:lang="en">A pumping process in which mechanical energy is imparted to a hydraulic fluid to transmit power or actuate hydraulic equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000552">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the value of a process variable is measured and displayed locally or transmitted to enable monitoring.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o valor de uma variável de processo é medido e exibido localmente ou transmitido para permitir o monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">indication process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de indicação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001451"/>
    <rdfs:subClassOf rdf:nodeID="n001452"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the value of a process variable is measured and displayed locally or transmitted to enable monitoring.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000554">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in an InformationDisplayProcess and that consists in presenting or exhibiting information visually to operators or other users for the purpose of communication, monitoring, or decision-making.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um InformationDisplayProcess e que consiste em apresentar informação visualmente a operadores ou outros usuários para fins de comunicação, monitoramento ou tomada de decisão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">information display function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de exibição de informação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001453"/>
    <rdfs:subClassOf rdf:nodeID="n001454"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in an InformationDisplayProcess and that consists in presenting or exhibiting information visually to operators or other users for the purpose of communication, monitoring, or decision-making.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000555">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which information is visually presented or exhibited by a display device to operators or users, enabling communication, monitoring, or decision-making activities.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que informação é apresentada visualmente por um dispositivo de exibição a operadores ou usuários, permitindo atividades de comunicação, monitoramento ou tomada de decisão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">information display process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de exibição de informação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001455"/>
    <rdfs:subClassOf rdf:nodeID="n001456"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which information is visually presented or exhibited by a display device to operators or users, enabling communication, monitoring, or decision-making activities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000556">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the introduction of a fluid, chemical, or material into a process stream, vessel, or wellbore under controlled conditions.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em introduzir, sob condições controladas, um fluido, produto químico ou material em uma corrente de processo, vaso ou poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">injection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de injeção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001457"/>
    <rdfs:subClassOf rdf:nodeID="n001458"/>
    <rdfs:subClassOf rdf:nodeID="n001459"/>
    <rdfs:subClassOf rdf:nodeID="n001460"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the introduction of a fluid, chemical, or material into a process stream, vessel, or wellbore under controlled conditions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000557">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a fluid, chemical, or material is introduced into a process stream, vessel, or wellbore under controlled conditions.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um fluido, produto químico ou material é introduzido, sob condições controladas, em uma corrente de processo, vaso ou poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">injection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de injeção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001461"/>
    <rdfs:subClassOf rdf:nodeID="n001462"/>
    <rdfs:subClassOf rdf:nodeID="n001463"/>
    <rdfs:subClassOf rdf:nodeID="n001464"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which a fluid, chemical, or material is introduced into a process stream, vessel, or wellbore under controlled conditions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000558">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which physical process variables are measured, transmitted, or controlled by instrumentation to enable monitoring and regulation of petroleum production operations.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que variáveis físicas do processo são medidas, transmitidas ou controladas por instrumentação para permitir o monitoramento e a regulação das operações de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">instrumentation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de instrumentação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001465"/>
    <rdfs:subClassOf rdf:nodeID="n001466"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which physical process variables are measured, transmitted, or controlled by instrumentation to enable monitoring and regulation of petroleum production operations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000559">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in an InterfacingProcess and that consists in providing a standardized point of interface for communication, connection, or interaction with another object or system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um InterfacingProcess e que consiste em prover um ponto padronizado de interface para comunicação, conexão ou interação com outro objeto ou sistema.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">interfacing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de interfaceamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001467"/>
    <rdfs:subClassOf rdf:nodeID="n001468"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in an InterfacingProcess and that consists in providing a standardized point of interface for communication, connection, or interaction with another object or system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000560">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a port establishes and maintains a point of interface that enables communication, connection, or interaction between distinct objects or systems.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que uma porta estabelece e mantém um ponto de interface que permite comunicação, conexão ou interação entre objetos ou sistemas distintos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">interfacing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de interfaceamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001469"/>
    <rdfs:subClassOf rdf:nodeID="n001470"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a port establishes and maintains a point of interface that enables communication, connection, or interaction between distinct objects or systems.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000561">
    <iof-av:naturalLanguageDefinition xml:lang="en">A GasDisengagementFunction that is realized in a KnockOutSeparationProcess and that consists in separating relatively small quantities of liquid from a vapour stream held in a drum, so that the liquid is removed and the vapour leaves with reduced liquid content.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma GasDisengagementFunction que é realizada em um KnockOutSeparationProcess e que consiste em separar quantidades relativamente pequenas de líquido de uma corrente de vapor contida em um tambor, de modo que o líquido é removido e o vapor sai com teor de líquido reduzido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">knock out separation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de separação knock-out</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001471"/>
    <rdfs:subClassOf rdf:nodeID="n001472"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000796"/>
    <skos:definition xml:lang="en">A GasDisengagementFunction that is realized in a KnockOutSeparationProcess and that consists in separating relatively small quantities of liquid from a vapour stream held in a drum, so that the liquid is removed and the vapour leaves with reduced liquid content.</skos:definition>
    <skos:definition xml:lang="en">A separation function borne by petroleum production equipment whose realization constitutes the removal of entrained liquid droplets from a gas stream by gravity or inertial impingement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000562">
    <iof-av:naturalLanguageDefinition xml:lang="en">A separation process in which entrained liquid droplets are removed from a gas stream by gravity or inertial impingement in a knockout vessel.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de separação em que gotículas de líquido arrastadas são removidas de uma corrente gasosa por gravidade ou impacto inercial em um vaso separador.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">knock out separation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de separação knock-out</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001473"/>
    <rdfs:subClassOf rdf:nodeID="n001474"/>
    <rdfs:subClassOf rdf:nodeID="n001475"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000635"/>
    <skos:definition xml:lang="en">A separation process in which entrained liquid droplets are removed from a gas stream by gravity or inertial impingement in a knockout vessel.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000563">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the fluid level within a vessel is detected as reaching a defined high or low threshold.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que se detecta que o nível de fluido em um vaso atingiu um limite alto ou baixo definido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">level detection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de detecção de nível</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001476"/>
    <rdfs:subClassOf rdf:nodeID="n001477"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the fluid level within a vessel is detected as reaching a defined high or low threshold.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000564">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the fluid level within a vessel or container is measured and displayed locally or transmitted to a remote monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o nível de fluido em um vaso ou recipiente é medido e exibido localmente ou transmitido a um sistema de monitoramento remoto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">level indication process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de indicação de nível</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001478"/>
    <rdfs:subClassOf rdf:nodeID="n001479"/>
    <rdfs:subClassOf rdf:nodeID="n001480"/>
    <rdfs:subClassOf rdf:nodeID="n001481"/>
    <rdfs:subClassOf rdf:nodeID="n001482"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the fluid level within a vessel or container is measured and displayed locally or transmitted to a remote monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000565">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the fluid level within a vessel is measured and the corresponding signal transmitted to a remote control or monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o nível de fluido em um vaso é medido e o sinal correspondente é transmitido a um sistema remoto de controle ou monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">level measurement and transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição e transmissão de nível</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001483"/>
    <rdfs:subClassOf rdf:nodeID="n001484"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the fluid level within a vessel is measured and the corresponding signal transmitted to a remote control or monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000566">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the generation of a discrete switching signal when the fluid level in a vessel crosses a defined high or low threshold.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em gerar um sinal de chaveamento discreto quando o nível de fluido em um vaso ultrapassa um limite alto ou baixo definido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">level switching function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de chaveamento de nível</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001485"/>
    <rdfs:subClassOf rdf:nodeID="n001486"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the generation of a discrete switching signal when the fluid level in a vessel crosses a defined high or low threshold.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000567">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a discrete switching signal is generated when the fluid level in a vessel crosses a defined high or low threshold.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um sinal de chaveamento discreto é gerado quando o nível de fluido em um vaso ultrapassa um limite alto ou baixo definido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">level switching process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de chaveamento de nível</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001487"/>
    <rdfs:subClassOf rdf:nodeID="n001488"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which a discrete switching signal is generated when the fluid level in a vessel crosses a defined high or low threshold.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000569">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the physical or chemical transformation of a material to alter its composition, form, or physical state.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste na transformação física ou química de um material para alterar sua composição, forma ou estado físico.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">material processing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de processamento de material</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001489"/>
    <rdfs:subClassOf rdf:nodeID="n001490"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the physical or chemical transformation of a material to alter its composition, form, or physical state.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000570">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a material is physically or chemically transformed to alter its composition, form, or physical state in petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um material é transformado física ou quimicamente para alterar sua composição, forma ou estado físico em equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">material processing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de processamento de material</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001491"/>
    <rdfs:subClassOf rdf:nodeID="n001492"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which a material is physically or chemically transformed to alter its composition, form, or physical state in petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000573">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/MEASURING_ELEMENT"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that bears a property measurement function, used for the measurement of a property and defined independently from the measuring instrument that handles that measurement result.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que possui uma função de medição de propriedade, usado para a medição de uma propriedade e definido independentemente do instrumento de medição que trata esse resultado.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Same-genus same-function (CLAUDE.md): the element's identity-giving function is the sensing captured by InstrumentationFunction, which its genus Instrument already bears, so equivalence would collapse the two. What distinguishes the element is stated by ISO 15926 relationally — it is "defined independently from a MEASURING INSTRUMENT that is handling that measurement result" — and a relational condition is not sufficient under OWA.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">measuring element</rdfs:label>
    <rdfs:label xml:lang="pt-br">elemento de medição</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001493"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000091"/>
    <skos:definition xml:lang="en">A material artifact that bears a property measurement function, used for the measurement of a property and defined independently from the measuring instrument that handles that measurement result.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that constitutes a primary measurement element within petroleum production instrumentation that directly responds to the measured variable.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000574">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of thermal, chemical, or electrical energy into mechanical energy in the form of rotational or linear motion.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em converter energia térmica, química ou elétrica em energia mecânica na forma de movimento rotativo ou linear.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">mechanical energy generation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de geração de energia mecânica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001494"/>
    <rdfs:subClassOf rdf:nodeID="n001495"/>
    <rdfs:subClassOf rdf:nodeID="n001496"/>
    <rdfs:subClassOf rdf:nodeID="n001497"/>
    <rdfs:subClassOf rdf:nodeID="n001498"/>
    <rdfs:subClassOf rdf:nodeID="n001499"/>
    <rdfs:subClassOf rdf:nodeID="n001500"/>
    <rdfs:subClassOf rdf:nodeID="n001501"/>
    <rdfs:subClassOf rdf:nodeID="n001502"/>
    <rdfs:subClassOf rdf:nodeID="n001503"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of thermal, chemical, or electrical energy into mechanical energy in the form of rotational or linear motion.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000575">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which thermal, chemical, or electrical energy is converted into rotational or linear mechanical energy by petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que energia térmica, química ou elétrica é convertida em energia mecânica rotativa ou linear por equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">mechanical energy generation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de geração de energia mecânica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001504"/>
    <rdfs:subClassOf rdf:nodeID="n001505"/>
    <rdfs:subClassOf rdf:nodeID="n001506"/>
    <rdfs:subClassOf rdf:nodeID="n001507"/>
    <rdfs:subClassOf rdf:nodeID="n001508"/>
    <rdfs:subClassOf rdf:nodeID="n001509"/>
    <rdfs:subClassOf rdf:nodeID="n001510"/>
    <rdfs:subClassOf rdf:nodeID="n001511"/>
    <rdfs:subClassOf rdf:nodeID="n001512"/>
    <rdfs:subClassOf rdf:nodeID="n001513"/>
    <rdfs:subClassOf rdf:nodeID="n001514"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which thermal, chemical, or electrical energy is converted into rotational or linear mechanical energy by petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000578">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the combination and blending of two or more fluid streams or components to achieve a homogeneous mixture.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em combinar e misturar duas ou mais correntes de fluido ou componentes para obter uma mistura homogênea.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">mixing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de mistura</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001515"/>
    <rdfs:subClassOf rdf:nodeID="n001516"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the combination and blending of two or more fluid streams or components to achieve a homogeneous mixture.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000579">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which two or more fluid streams or components are combined and blended to achieve a homogeneous mixture.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que duas ou mais correntes de fluido ou componentes são combinados e misturados para obter uma mistura homogênea.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">mixing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de mistura</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001517"/>
    <rdfs:subClassOf rdf:nodeID="n001518"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which two or more fluid streams or components are combined and blended to achieve a homogeneous mixture.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000580">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the accommodation of relative movement between connected components caused by thermal expansion, vibration, or settlement.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em acomodar o movimento relativo entre componentes conectados causado por dilatação térmica, vibração ou recalque.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">movement compensation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de compensação de movimentação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001519"/>
    <rdfs:subClassOf rdf:nodeID="n001520"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the accommodation of relative movement between connected components caused by thermal expansion, vibration, or settlement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000581">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which relative movement between connected components caused by thermal expansion, vibration, or settlement is accommodated without transmitting excessive stress.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o movimento relativo entre componentes conectados, causado por dilatação térmica, vibração ou recalque, é acomodado sem transmitir esforços excessivos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">movement compensation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de compensação de movimentação</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which relative movement between connected components caused by thermal expansion, vibration, or settlement is accommodated without transmitting excessive stress.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000583">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a moving blade or vane within a turbine, pump, or separator that interacts with a fluid stream in petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é uma pá ou palheta móvel dentro de uma turbina, bomba ou separador que interage com uma corrente de fluido em equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">moving vane</rdfs:label>
    <rdfs:label xml:lang="pt-br">palheta móvel</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a moving blade or vane within a turbine, pump, or separator that interacts with a fluid stream in petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000584">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the simultaneous measurement and transmission of multiple process variables to a remote control or monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em medir e transmitir simultaneamente várias variáveis de processo a um sistema remoto de controle ou monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">multi service transmission function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transmissão de múltiplos serviços</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001521"/>
    <rdfs:subClassOf rdf:nodeID="n001522"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the simultaneous measurement and transmission of multiple process variables to a remote control or monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000585">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which multiple process variables are simultaneously measured and their corresponding signals transmitted to a remote control or monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que várias variáveis de processo são medidas simultaneamente e seus sinais correspondentes são transmitidos a um sistema remoto de controle ou monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">multi service transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transmissão de múltiplos serviços</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001523"/>
    <rdfs:subClassOf rdf:nodeID="n001524"/>
    <rdfs:subClassOf rdf:nodeID="n001525"/>
    <rdfs:subClassOf rdf:nodeID="n001526"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which multiple process variables are simultaneously measured and their corresponding signals transmitted to a remote control or monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000586">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the attenuation of acoustic energy in a fluid stream or mechanical system to reduce radiated noise to acceptable levels.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em atenuar a energia acústica em uma corrente de fluido ou sistema mecânico para reduzir o ruído irradiado a níveis aceitáveis.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">noise silencing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de silenciamento de ruído</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001527"/>
    <rdfs:subClassOf rdf:nodeID="n001528"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the attenuation of acoustic energy in a fluid stream or mechanical system to reduce radiated noise to acceptable levels.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000587">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which acoustic energy in a fluid stream or mechanical system is attenuated to reduce radiated noise to an acceptable level.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a energia acústica em uma corrente de fluido ou sistema mecânico é atenuada para reduzir o ruído irradiado a um nível aceitável.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">noise silencing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de silenciamento de ruído</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001529"/>
    <rdfs:subClassOf rdf:nodeID="n001530"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which acoustic energy in a fluid stream or mechanical system is attenuated to reduce radiated noise to an acceptable level.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000588">
    <iof-av:naturalLanguageDefinition xml:lang="en">A circuit protection function borne by petroleum production equipment whose realization constitutes the interruption of electrical current in a circuit through the intentional melting of a fusible element when current exceeds a rated value.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de proteção de circuito portada por equipamento de produção de petróleo cuja realização consiste em interromper a corrente elétrica de um circuito pela fusão intencional de um elemento fusível quando a corrente excede um valor nominal.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">overcurrent protection by fusing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de proteção contra sobrecorrente por fusível</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001531"/>
    <rdfs:subClassOf rdf:nodeID="n001532"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A circuit protection function borne by petroleum production equipment whose realization constitutes the interruption of electrical current in a circuit through the intentional melting of a fusible element when current exceeds a rated value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000589">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the phase sequence of an alternating-current electrical supply is measured and verified by petroleum production instrumentation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a sequência de fases de uma alimentação elétrica de corrente alternada é medida e verificada pela instrumentação de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">phase sequence measurement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição de sequência de fases</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001533"/>
    <rdfs:subClassOf rdf:nodeID="n001534"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the phase sequence of an alternating-current electrical supply is measured and verified by petroleum production instrumentation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000590">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes both the controlled introduction of a pipeline pig into a pipeline and its retrieval after passage through the line.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste tanto na introdução controlada de um pig em um duto quanto em sua recuperação após a passagem pela linha.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pig launching and receiving function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de lançamento e recebimento de pig</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001535"/>
    <rdfs:subClassOf rdf:nodeID="n001536"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes both the controlled introduction of a pipeline pig into a pipeline and its retrieval after passage through the line.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000591">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a pipeline pig is introduced into a pipeline under operating pressure and subsequently retrieved after completing its passage.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um pig é introduzido em um duto sob pressão de operação e depois recuperado ao completar sua passagem.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pig launching and receiving process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de lançamento e recebimento de pig</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001537"/>
    <rdfs:subClassOf rdf:nodeID="n001538"/>
    <rdfs:subClassOf rdf:nodeID="n001539"/>
    <rdfs:subClassOf rdf:nodeID="n001540"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which a pipeline pig is introduced into a pipeline under operating pressure and subsequently retrieved after completing its passage.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000592">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the controlled introduction of a pipeline pig into a pipeline under operating pressure.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste na introdução controlada de um pig em um duto sob pressão de operação.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pig launching function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de lançamento de pig</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001541"/>
    <rdfs:subClassOf rdf:nodeID="n001542"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the controlled introduction of a pipeline pig into a pipeline under operating pressure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000593">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a pipeline pig is introduced into a pipeline under operating pressure to perform internal cleaning, inspection, or product separation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um pig é introduzido em um duto sob pressão de operação para realizar limpeza interna, inspeção ou separação de produtos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pig launching process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de lançamento de pig</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001543"/>
    <rdfs:subClassOf rdf:nodeID="n001544"/>
    <rdfs:subClassOf rdf:nodeID="n001545"/>
    <rdfs:subClassOf rdf:nodeID="n001546"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which a pipeline pig is introduced into a pipeline under operating pressure to perform internal cleaning, inspection, or product separation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000594">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the controlled retrieval and containment of a pipeline pig after its passage through a pipeline.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste na recuperação e contenção controladas de um pig após sua passagem por um duto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pig receiving function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de recebimento de pig</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001547"/>
    <rdfs:subClassOf rdf:nodeID="n001548"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the controlled retrieval and containment of a pipeline pig after its passage through a pipeline.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000595">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a pipeline pig is retrieved and contained in a receiving trap after completing its passage through a pipeline.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um pig é recuperado e contido em um recebedor após completar sua passagem por um duto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pig receiving process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de recebimento de pig</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001549"/>
    <rdfs:subClassOf rdf:nodeID="n001550"/>
    <rdfs:subClassOf rdf:nodeID="n001551"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which a pipeline pig is retrieved and contained in a receiving trap after completing its passage through a pipeline.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000596">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical cutting of a tubular string within a wellbore to enable emergency well control.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste no corte mecânico de uma coluna tubular dentro do poço para permitir o controle de poço em emergência.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pipe shearing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de corte de tubulação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001552"/>
    <rdfs:subClassOf rdf:nodeID="n001553"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical cutting of a tubular string within a wellbore to enable emergency well control.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000597">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a tubular string within a wellbore is mechanically cut to enable emergency well control.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que uma coluna tubular dentro do poço é cortada mecanicamente para permitir o controle de poço em emergência.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pipe shearing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de corte de tubulação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001554"/>
    <rdfs:subClassOf rdf:nodeID="n001555"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which a tubular string within a wellbore is mechanically cut to enable emergency well control.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000598">
    <iof-av:naturalLanguageDefinition xml:lang="en">A device inserted into a pipeline and driven along it by the flowing product to clean, gauge, inspect, or separate products in the line.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um dispositivo inserido em um duto e impulsionado pelo próprio produto em escoamento para limpar, calibrar, inspecionar ou separar produtos na linha.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pipeline pig</rdfs:label>
    <rdfs:label xml:lang="pt-br">pig de pipeline</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
    <skos:definition xml:lang="en">A device inserted into a pipeline and driven along it by the flowing product to clean, gauge, inspect, or separate products in the line.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that constitutes a device inserted into and propelled through a pipeline to perform internal inspection, cleaning, or gauging operations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000599">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which compressed-gas energy is converted into rotational mechanical energy by pneumatic actuators or motors.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a energia de um gás comprimido é convertida em energia mecânica rotativa por atuadores ou motores pneumáticos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pneumatic energy conversion process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de conversão de energia pneumática</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001556"/>
    <rdfs:subClassOf rdf:nodeID="n001557"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which compressed-gas energy is converted into rotational mechanical energy by pneumatic actuators or motors.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000600">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of compressed-gas energy into rotational mechanical motion.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em converter a energia de um gás comprimido em movimento mecânico rotativo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pneumatic motor function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de acionamento pneumático</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001558"/>
    <rdfs:subClassOf rdf:nodeID="n001559"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of compressed-gas energy into rotational mechanical motion.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000601">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the end-of-travel or open or closed position of a moving mechanical component is detected and signalled.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a posição de fim de curso, ou de aberto ou fechado, de um componente mecânico móvel é detectada e sinalizada.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">position limit detection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de detecção de limite de posição</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001560"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the end-of-travel or open or closed position of a moving mechanical component is detected and signalled.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000602">
    <iof-av:naturalLanguageDefinition xml:lang="en">A measurement process in which the position of a mechanical component is measured and the corresponding signal transmitted to a remote control or monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de medição em que a posição de um componente mecânico é medida e o sinal correspondente é transmitido a um sistema remoto de controle ou monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">position measurement and transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição e transmissão de posição</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001561"/>
    <rdfs:subClassOf rdf:nodeID="n001562"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A measurement process in which the position of a mechanical component is measured and the corresponding signal transmitted to a remote control or monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000603">
    <iof-av:naturalLanguageDefinition xml:lang="en">A signal transmission function borne by petroleum production equipment whose realization constitutes the measurement of the position of a mechanical component and the transmission of the corresponding signal to a remote monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de transmissão de sinal portada por equipamento de produção de petróleo cuja realização consiste em medir a posição de um componente mecânico e transmitir o sinal correspondente a um sistema de monitoramento remoto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">position transmission function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transmissão de posição</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001563"/>
    <rdfs:subClassOf rdf:nodeID="n001564"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000030"/>
    <skos:definition xml:lang="en">A signal transmission function borne by petroleum production equipment whose realization constitutes the measurement of the position of a mechanical component and the transmission of the corresponding signal to a remote monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000604">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which mechanical energy is transmitted through rotational motion from one component to another via a rotating shaft, enabling the transfer of torque and angular velocity to mounted components.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que energia mecânica é transmitida por movimento rotativo de um componente a outro por meio de um eixo, permitindo a transferência de torque e velocidade angular aos componentes montados.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">power transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transmissão de potência</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which mechanical energy is transmitted through rotational motion from one component to another via a rotating shaft, enabling the transfer of torque and angular velocity to mounted components.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000605">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a fluid is held within a defined pressure boundary to prevent uncontrolled release to the environment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um fluido é mantido dentro de um limite de pressão definido para evitar sua liberação descontrolada para o ambiente.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure containment process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de contenção de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001565"/>
    <rdfs:subClassOf rdf:nodeID="n001566"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A planned process in which a fluid is held within a defined pressure boundary to prevent uncontrolled release to the environment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000606">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the measurement of process pressure and both its local display and the transmission of the corresponding signal to a remote monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em medir a pressão do processo e tanto exibi-la localmente quanto transmitir o sinal correspondente a um sistema de monitoramento remoto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure indicating and transmission function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de indicação e transmissão de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001567"/>
    <rdfs:subClassOf rdf:nodeID="n001568"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the measurement of process pressure and both its local display and the transmission of the corresponding signal to a remote monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000607">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which process pressure is measured and both displayed locally and transmitted as a standardised signal to a remote monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a pressão do processo é medida, exibida localmente e transmitida como sinal padronizado a um sistema de monitoramento remoto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure indicating and transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de indicação e transmissão de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001569"/>
    <rdfs:subClassOf rdf:nodeID="n001570"/>
    <rdfs:subClassOf rdf:nodeID="n001571"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which process pressure is measured and both displayed locally and transmitted as a standardised signal to a remote monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000608">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the absolute or gauge pressure of a process stream is measured and expressed as a quantitative value.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a pressão absoluta ou manométrica de uma corrente de processo é medida e expressa como um valor quantitativo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure measurement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001572"/>
    <rdfs:subClassOf rdf:nodeID="n001573"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the absolute or gauge pressure of a process stream is measured and expressed as a quantitative value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000609">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the pressure of a fluid is reduced from a higher upstream value to a controlled lower downstream value.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a pressão de um fluido é reduzida de um valor mais alto a montante para um valor mais baixo controlado a jusante.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure reduction process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de redução de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001574"/>
    <rdfs:subClassOf rdf:nodeID="n001575"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which the pressure of a fluid is reduced from a higher upstream value to a controlled lower downstream value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000610">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a flow path is automatically opened to discharge fluid when process pressure exceeds a defined set point, protecting equipment from overpressure.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que uma passagem é aberta automaticamente para descarregar fluido quando a pressão do processo ultrapassa um valor de ajuste definido, protegendo o equipamento contra sobrepressão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure relief process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de alívio de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001576"/>
    <rdfs:subClassOf rdf:nodeID="n001577"/>
    <rdfs:subClassOf rdf:nodeID="n001578"/>
    <rdfs:subClassOf rdf:nodeID="n001579"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which a flow path is automatically opened to discharge fluid when process pressure exceeds a defined set point, protecting equipment from overpressure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000611">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which fluid pressure is detected and converted into a measurable electrical or pneumatic signal.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a pressão de um fluido é detectada e convertida em um sinal elétrico ou pneumático mensurável.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure sensing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de sensoriamento de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001580"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which fluid pressure is detected and converted into a measurable electrical or pneumatic signal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000612">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a sensing element assembly that measures fluid pressure and converts it into an electrical or pneumatic signal.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um conjunto de elemento sensor que mede a pressão de um fluido e a converte em um sinal elétrico ou pneumático.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure sensor</rdfs:label>
    <rdfs:label xml:lang="pt-br">sensor de pressão</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Assembly"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a sensing element assembly that measures fluid pressure and converts it into an electrical or pneumatic signal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000613">
    <iof-av:naturalLanguageDefinition xml:lang="en">A signal transmission process in which a standardised signal representing a measured pressure value is transmitted to a remote control or monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de transmissão de sinal em que um sinal padronizado que representa um valor de pressão medido é transmitido a um sistema remoto de controle ou monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure signal transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transmissão de sinal de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001581"/>
    <rdfs:subClassOf rdf:nodeID="n001582"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000035"/>
    <skos:definition xml:lang="en">A signal transmission process in which a standardised signal representing a measured pressure value is transmitted to a remote control or monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000614">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a standardised signal representing a measured pressure value is transmitted to a remote control or monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um sinal padronizado que representa um valor de pressão medido é transmitido a um sistema remoto de controle ou monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pressure transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transmissão de pressão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001583"/>
    <rdfs:subClassOf rdf:nodeID="n001584"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which a standardised signal representing a measured pressure value is transmitted to a remote control or monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000615">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes the enclosed space within a pump casing in which fluid is pressurised by the impeller or piston.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é o espaço fechado dentro da carcaça de uma bomba no qual o fluido é pressurizado pelo impelidor ou pistão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pump chamber</rdfs:label>
    <rdfs:label xml:lang="pt-br">câmara de bomba</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the enclosed space within a pump casing in which fluid is pressurised by the impeller or piston.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000616">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which mechanical energy is imparted to a fluid to increase its pressure, velocity, or elevation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que energia mecânica é transferida a um fluido para aumentar sua pressão, velocidade ou elevação.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pumping process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de bombeamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001585"/>
    <rdfs:subClassOf rdf:nodeID="n001586"/>
    <rdfs:subClassOf rdf:nodeID="n001587"/>
    <rdfs:subClassOf rdf:nodeID="n001588"/>
    <rdfs:subClassOf rdf:nodeID="n001589"/>
    <rdfs:subClassOf rdf:nodeID="n001590"/>
    <rdfs:subClassOf rdf:nodeID="n001591"/>
    <rdfs:subClassOf rdf:nodeID="n001592"/>
    <rdfs:subClassOf rdf:nodeID="n001593"/>
    <rdfs:subClassOf rdf:nodeID="n001594"/>
    <rdfs:subClassOf rdf:nodeID="n001595"/>
    <rdfs:subClassOf rdf:nodeID="n001596"/>
    <rdfs:subClassOf rdf:nodeID="n001597"/>
    <rdfs:subClassOf rdf:nodeID="n001598"/>
    <rdfs:subClassOf rdf:nodeID="n001599"/>
    <rdfs:subClassOf rdf:nodeID="n001600"/>
    <rdfs:subClassOf rdf:nodeID="n001601"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which mechanical energy is imparted to a fluid to increase its pressure, velocity, or elevation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000617">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a raised rim or flange on a component of petroleum production equipment that provides a sealing surface or structural boundary.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é uma borda ou ressalto elevado em um componente de equipamento de produção de petróleo que provê uma superfície de vedação ou um limite estrutural.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">raised edge</rdfs:label>
    <rdfs:label xml:lang="pt-br">borda saliente</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a raised rim or flange on a component of petroleum production equipment that provides a sealing surface or structural boundary.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000618">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which pressure within a process system is discharged at an accelerated rate to a safe destination in an emergency.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a pressão de um sistema de processo é descarregada em ritmo acelerado para um destino seguro em uma emergência.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rapid depressurization process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de despressurização rápida</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001602"/>
    <rdfs:subClassOf rdf:nodeID="n001603"/>
    <rdfs:subClassOf rdf:nodeID="n001604"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which pressure within a process system is discharged at an accelerated rate to a safe destination in an emergency.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000619">
    <iof-av:naturalLanguageDefinition xml:lang="en">A heating function borne by petroleum production equipment whose realization constitutes the generation and transfer of thermal energy through an exothermic chemical reaction.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de aquecimento portada por equipamento de produção de petróleo cuja realização consiste em gerar e transferir energia térmica por meio de uma reação química exotérmica.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reactive heating function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de aquecimento reativo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001605"/>
    <rdfs:subClassOf rdf:nodeID="n001606"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000190"/>
    <skos:definition xml:lang="en">A heating function borne by petroleum production equipment whose realization constitutes the generation and transfer of thermal energy through an exothermic chemical reaction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000620">
    <iof-av:naturalLanguageDefinition xml:lang="en">A heating process in which thermal energy is generated by a chemical reaction and transferred to the process, such as in a reactor or fired heater.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de aquecimento em que energia térmica é gerada por uma reação química e transferida ao processo, como em um reator ou forno.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reactive heating process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de aquecimento reativo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001607"/>
    <rdfs:subClassOf rdf:nodeID="n001608"/>
    <rdfs:subClassOf rdf:nodeID="n001609"/>
    <rdfs:subClassOf rdf:nodeID="n001610"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000548"/>
    <skos:definition xml:lang="en">A heating process in which thermal energy is generated by a chemical reaction and transferred to the process, such as in a reactor or fired heater.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000621">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the partial vaporisation of liquid at the base of a distillation column by supplying heat to drive vapour upward through the column.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em vaporizar parcialmente o líquido da base de uma coluna de destilação fornecendo calor, de modo a impulsionar vapor para cima ao longo da coluna.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reboiling function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de refervimento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001611"/>
    <rdfs:subClassOf rdf:nodeID="n001612"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the partial vaporisation of liquid at the base of a distillation column by supplying heat to drive vapour upward through the column.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000622">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which liquid at the base of a distillation column is partially vaporised by the supply of heat to drive vapour upward through the column.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o líquido da base de uma coluna de destilação é parcialmente vaporizado pelo fornecimento de calor, impulsionando vapor para cima ao longo da coluna.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reboiling process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de refervimento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001613"/>
    <rdfs:subClassOf rdf:nodeID="n001614"/>
    <rdfs:subClassOf rdf:nodeID="n001615"/>
    <rdfs:subClassOf rdf:nodeID="n001616"/>
    <rdfs:subClassOf rdf:nodeID="n001617"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000008"/>
    <skos:definition xml:lang="en">A planned process in which liquid at the base of a distillation column is partially vaporised by the supply of heat to drive vapour upward through the column.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000624">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes an assembly of vanes attached to a rotating element that interacts with a fluid stream in petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um conjunto de palhetas fixadas a um elemento rotativo que interage com uma corrente de fluido em equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rotating vanes</rdfs:label>
    <rdfs:label xml:lang="pt-br">palhetas rotativo</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes an assembly of vanes attached to a rotating element that interacts with a fluid stream in petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000625">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a RotationalEnergyTransferProcess and that consists in the capacity to transfer mechanical energy through rotational motion within a machine assembly.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um RotationalEnergyTransferProcess e que consiste na capacidade de transferir energia mecânica por movimento rotativo dentro de um conjunto de máquina.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rotational energy transfer function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transferência de energia rotacional</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001618"/>
    <rdfs:subClassOf rdf:nodeID="n001619"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a RotationalEnergyTransferProcess and that consists in the capacity to transfer mechanical energy through rotational motion within a machine assembly.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000626">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a rotor transfers mechanical energy through its rotational motion, enabling the operation of rotating machinery such as motors, compressors, pumps, and turbines.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que um rotor transfere energia mecânica por seu movimento rotativo, permitindo o funcionamento de máquinas rotativas como motores, compressores, bombas e turbinas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rotational energy transfer process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transferência de energia rotacional</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a rotor transfers mechanical energy through its rotational motion, enabling the operation of rotating machinery such as motors, compressors, pumps, and turbines.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000627">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical removal of deposits, scale, or coatings from the interior surface of a pipeline or vessel.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em remover mecanicamente depósitos, incrustações ou revestimentos da superfície interna de um duto ou vaso.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">scraping function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de raspagem</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001620"/>
    <rdfs:subClassOf rdf:nodeID="n001621"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical removal of deposits, scale, or coatings from the interior surface of a pipeline or vessel.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000628">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which deposits, scale, or coatings are mechanically removed from the interior surface of a pipeline or vessel.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que depósitos, incrustações ou revestimentos são removidos mecanicamente da superfície interna de um duto ou vaso.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">scraping process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de raspagem</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001622"/>
    <rdfs:subClassOf rdf:nodeID="n001623"/>
    <rdfs:subClassOf rdf:nodeID="n001624"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which deposits, scale, or coatings are mechanically removed from the interior surface of a pipeline or vessel.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000630">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a SurfaceSealingProcess and that consists in preventing leakage of fluid between two mating parts by providing a surface against which a closure element is pressed.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um SurfaceSealingProcess e que consiste em impedir o vazamento de fluido entre duas partes correspondentes, provendo uma superfície contra a qual um elemento de fechamento é pressionado.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sealing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de vedação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001625"/>
    <rdfs:subClassOf rdf:nodeID="n001626"/>
    <rdfs:subClassOf rdf:nodeID="n001627"/>
    <rdfs:subClassOf rdf:nodeID="n001628"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a SurfaceSealingProcess and that consists in preventing leakage of fluid between two mating parts by providing a surface against which a closure element is pressed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000631">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a valve seat provides a sealing interface for a closure element (gate, ball, disc) to bear against, preventing fluid passage when the valve is closed.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que a sede de uma válvula provê uma interface de vedação contra a qual se apoia um elemento de fechamento (gaveta, esfera, disco), impedindo a passagem de fluido quando a válvula está fechada.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sealing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de vedação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001629"/>
    <rdfs:subClassOf rdf:nodeID="n001630"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a valve seat provides a sealing interface for a closure element (gate, ball, disc) to bear against, preventing fluid passage when the valve is closed.</skos:definition>
    <skos:definition xml:lang="en">A planned process in which a barrier is formed between two mating surfaces to prevent the leakage of fluid across a joint or interface in petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000632">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes the assembly of seals, gaskets, and packing that prevents leakage between two components of petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é o conjunto de selos, juntas e gaxetas que impede vazamentos entre dois componentes de equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sealing system</rdfs:label>
    <rdfs:label xml:lang="pt-br">sistema de vedação</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the assembly of seals, gaskets, and packing that prevents leakage between two components of petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000633">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a primary element that directly responds to a physical or chemical variable to generate a measurement signal in petroleum production instrumentation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um elemento primário que responde diretamente a uma variável física ou química gerando um sinal de medição na instrumentação de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sensing element</rdfs:label>
    <rdfs:label xml:lang="pt-br">elemento de sensoriamento</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a primary element that directly responds to a physical or chemical variable to generate a measurement signal in petroleum production instrumentation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000634">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a distinct vapour space within petroleum production equipment where disengaged gas accumulates above the liquid level.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um espaço de vapor distinto dentro de um equipamento de produção de petróleo, onde o gás liberado se acumula acima do nível de líquido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">separate vapour space</rdfs:label>
    <rdfs:label xml:lang="pt-br">espaço separado de vapor</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a distinct vapour space within petroleum production equipment where disengaged gas accumulates above the liquid level.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000635">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a heterogeneous mixture is divided into two or more fractions of differing composition by exploiting differences in physical properties.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que uma mistura heterogênea é dividida em duas ou mais frações de composições diferentes, explorando diferenças de propriedades físicas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">separation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de separação</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001631"/>
    <rdfs:subClassOf rdf:nodeID="n001632"/>
    <rdfs:subClassOf rdf:nodeID="n001633"/>
    <rdfs:subClassOf rdf:nodeID="n001634"/>
    <rdfs:subClassOf rdf:nodeID="n001635"/>
    <rdfs:subClassOf rdf:nodeID="n001636"/>
    <rdfs:subClassOf rdf:nodeID="n001637"/>
    <rdfs:subClassOf rdf:nodeID="n001638"/>
    <rdfs:subClassOf rdf:nodeID="n001639"/>
    <rdfs:subClassOf rdf:nodeID="n001640"/>
    <rdfs:subClassOf rdf:nodeID="n001641"/>
    <rdfs:subClassOf rdf:nodeID="n001642"/>
    <rdfs:subClassOf rdf:nodeID="n001643"/>
    <rdfs:subClassOf rdf:nodeID="n001644"/>
    <rdfs:subClassOf rdf:nodeID="n001645"/>
    <rdfs:subClassOf rdf:nodeID="n001646"/>
    <rdfs:subClassOf rdf:nodeID="n001647"/>
    <rdfs:subClassOf rdf:nodeID="n001648"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000006"/>
    <skos:definition xml:lang="en">A planned process in which a heterogeneous mixture is divided into two or more fractions of differing composition by exploiting differences in physical properties.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000636">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the application of oscillating mechanical motion to a screen or separator to promote separation of solids from a fluid.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em aplicar movimento mecânico oscilante a uma peneira ou separador para promover a separação de sólidos de um fluido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">shaking function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de agitação mecânica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001649"/>
    <rdfs:subClassOf rdf:nodeID="n001650"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the application of oscillating mechanical motion to a screen or separator to promote separation of solids from a fluid.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000637">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which oscillating mechanical motion is applied to a screen or separator to promote the separation of solids from a fluid.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que movimento mecânico oscilante é aplicado a uma peneira ou separador para promover a separação de sólidos de um fluido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">shaking process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de agitação mecânica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001651"/>
    <rdfs:subClassOf rdf:nodeID="n001652"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000006"/>
    <skos:definition xml:lang="en">A planned process in which oscillating mechanical motion is applied to a screen or separator to promote the separation of solids from a fluid.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000638">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes the cutting blade of a shear ram in a blowout preventer that severs a tubular string for well control purposes.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é a lâmina de corte da gaveta cisalhante de um preventor de erupção, que secciona uma coluna tubular para fins de controle de poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">shearing blade</rdfs:label>
    <rdfs:label xml:lang="pt-br">lâmina de cisalhamento</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the cutting blade of a shear ram in a blowout preventer that severs a tubular string for well control purposes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000639">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a lateral outlet port on a vessel or pipe fitting through which fluid is discharged from the side of the equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é uma saída lateral em um vaso ou conexão de tubulação pela qual o fluido é descarregado pela lateral do equipamento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">side outlet</rdfs:label>
    <rdfs:label xml:lang="pt-br">saída lateral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a lateral outlet port on a vessel or pipe fitting through which fluid is discharged from the side of the equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000640">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the reception and re-transmission of a control or monitoring signal to extend its range or provide electrical isolation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em receber e retransmitir um sinal de controle ou monitoramento para ampliar seu alcance ou prover isolamento elétrico.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">signal relay function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de retransmissão de sinal</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001653"/>
    <rdfs:subClassOf rdf:nodeID="n001654"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the reception and re-transmission of a control or monitoring signal to extend its range or provide electrical isolation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000641">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a control or monitoring signal is received and re-transmitted to extend its range or provide electrical isolation between circuits.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um sinal de controle ou monitoramento é recebido e retransmitido para ampliar seu alcance ou prover isolamento elétrico entre circuitos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">signal relay process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de retransmissão de sinal</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001655"/>
    <rdfs:subClassOf rdf:nodeID="n001656"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which a control or monitoring signal is received and re-transmitted to extend its range or provide electrical isolation between circuits.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000642">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the containment and temporary storage of solid bulk materials such as catalyst, proppant, or chemical reagents.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em conter e armazenar temporariamente materiais sólidos a granel, como catalisador, agente de sustentação ou reagentes químicos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">solid bulk storage function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de armazenamento de sólidos a granel</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001657"/>
    <rdfs:subClassOf rdf:nodeID="n001658"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the containment and temporary storage of solid bulk materials such as catalyst, proppant, or chemical reagents.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000643">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which solid bulk materials such as catalyst, proppant, or chemical reagents are contained and held for subsequent use.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que materiais sólidos a granel, como catalisador, agente de sustentação ou reagentes químicos, são contidos e mantidos para uso posterior.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">solid bulk storage process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de armazenamento de sólidos a granel</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001659"/>
    <rdfs:subClassOf rdf:nodeID="n001660"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A planned process in which solid bulk materials such as catalyst, proppant, or chemical reagents are contained and held for subsequent use.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000644">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the storage of solid materials and their controlled dispensing in metered quantities into a process stream.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em armazenar materiais sólidos e dosá-los de forma controlada, em quantidades medidas, em uma corrente de processo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">solid storage and dispensing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de armazenamento e distribuição de sólidos</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001661"/>
    <rdfs:subClassOf rdf:nodeID="n001662"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the storage of solid materials and their controlled dispensing in metered quantities into a process stream.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000645">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which solid materials are stored and dispensed in metered quantities into a process stream.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que materiais sólidos são armazenados e dosados, em quantidades medidas, em uma corrente de processo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">solid storage and dispensing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de armazenamento e distribuição de sólidos</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001663"/>
    <rdfs:subClassOf rdf:nodeID="n001664"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A planned process in which solid materials are stored and dispensed in metered quantities into a process stream.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000646">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the maintenance of a defined spatial separation between components to ensure correct alignment, clearance, or insulation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em manter um afastamento espacial definido entre componentes para garantir alinhamento, folga ou isolamento corretos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">spacing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de espaçamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001665"/>
    <rdfs:subClassOf rdf:nodeID="n001666"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the maintenance of a defined spatial separation between components to ensure correct alignment, clearance, or insulation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000647">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a defined spatial separation between components is maintained to ensure correct alignment, clearance, or insulation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que se mantém um afastamento espacial definido entre componentes para garantir alinhamento, folga ou isolamento corretos.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">spacing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de espaçamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001667"/>
    <rdfs:subClassOf rdf:nodeID="n001668"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which a defined spatial separation between components is maintained to ensure correct alignment, clearance, or insulation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000648">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a StationaryMachineComponentProcess and that consists in providing a stationary structural foundation and housing for active elements (such as windings, vanes, or seals) within rotating machinery, maintaining positional stability relative to moving components.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um StationaryMachineComponentProcess e que consiste em prover uma base estrutural estacionária e um alojamento para elementos ativos (como enrolamentos, palhetas ou selos) em máquinas rotativas, mantendo sua estabilidade posicional em relação às partes móveis.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">stationary machine component function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de componente estacionário de máquina</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001669"/>
    <rdfs:subClassOf rdf:nodeID="n001670"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a StationaryMachineComponentProcess and that consists in providing a stationary structural foundation and housing for active elements (such as windings, vanes, or seals) within rotating machinery, maintaining positional stability relative to moving components.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000649">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a stator maintains its fixed position relative to rotating components within machinery, providing structural support and housing for electromagnetic windings, guide vanes, or other functional elements that require stable positioning.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que um estator mantém sua posição fixa em relação às partes rotativas de uma máquina, provendo sustentação estrutural e alojamento para enrolamentos eletromagnéticos, palhetas-guia ou outros elementos que exigem posicionamento estável.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">stationary machine component process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de componente estacionário de máquina</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a stator maintains its fixed position relative to rotating components within machinery, providing structural support and housing for electromagnetic windings, guide vanes, or other functional elements that require stable positioning.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000651">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a fluid or material is held within a contained space for a defined period before further processing or distribution.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um fluido ou material é mantido em um espaço contido por um período definido antes de processamento ou distribuição posterior.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">storage process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de armazenamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001671"/>
    <rdfs:subClassOf rdf:nodeID="n001672"/>
    <rdfs:subClassOf rdf:nodeID="n001673"/>
    <rdfs:subClassOf rdf:nodeID="n001674"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A planned process in which a fluid or material is held within a contained space for a defined period before further processing or distribution.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000652">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a StructuralSupportProcess and that consists in providing mechanical support, load distribution, or structural integrity within an engineered system through a flat, planar configuration.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um StructuralSupportProcess e que consiste em prover sustentação mecânica, distribuição de cargas ou integridade estrutural em um sistema de engenharia por meio de uma configuração plana.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">structural support function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de suporte estrutural</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001675"/>
    <rdfs:subClassOf rdf:nodeID="n001676"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a StructuralSupportProcess and that consists in providing mechanical support, load distribution, or structural integrity within an engineered system through a flat, planar configuration.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000653">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a structural element bears loads, distributes forces, or maintains structural integrity within a system, typically through its geometric configuration and material properties.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que um elemento estrutural suporta cargas, distribui esforços ou mantém a integridade estrutural de um sistema, tipicamente por sua configuração geométrica e propriedades do material.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">structural support process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de suporte estrutural</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a structural element bears loads, distributes forces, or maintains structural integrity within a system, typically through its geometric configuration and material properties.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000654">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">subsurface access process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de acesso subsuperficial</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001677"/>
    <rdfs:subClassOf rdf:nodeID="n001678"/>
    <rdfs:subClassOf rdf:nodeID="n001679"/>
    <rdfs:subClassOf rdf:nodeID="n001680"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which access to subsurface formations is established and maintained through a wellbore to enable exploration, production, or injection activities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000655">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the controlled physical interaction with subsurface formations to enable exploration, drilling, completion, or production activities.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste na interação física controlada com formações de subsuperfície para permitir atividades de exploração, perfuração, completação ou produção.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">subsurface resource interaction function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de interação com recursos subsuperficiais</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001681"/>
    <rdfs:subClassOf rdf:nodeID="n001682"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the controlled physical interaction with subsurface formations to enable exploration, drilling, completion, or production activities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000656">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which petroleum production equipment physically interacts with subsurface formations to enable drilling, completion, or production operations.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que equipamentos de produção de petróleo interagem fisicamente com formações de subsuperfície para permitir operações de perfuração, completação ou produção.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">subsurface resource interaction process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de interação com recursos subsuperficiais</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001683"/>
    <rdfs:subClassOf rdf:nodeID="n001684"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which petroleum production equipment physically interacts with subsurface formations to enable drilling, completion, or production operations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000657">
    <iof-av:naturalLanguageDefinition xml:lang="en">A safety relief process in which the wellbore flow path is automatically closed by a downhole safety valve to prevent uncontrolled flow of reservoir fluids to surface.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de alívio de segurança em que a passagem de escoamento do poço é fechada automaticamente por uma válvula de segurança de subsuperfície para impedir o escoamento descontrolado de fluidos do reservatório para a superfície.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">subsurface safety process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de segurança subsuperficial</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001685"/>
    <rdfs:subClassOf rdf:nodeID="n001686"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000034"/>
    <skos:definition xml:lang="en">A safety relief process in which the wellbore flow path is automatically closed by a downhole safety valve to prevent uncontrolled flow of reservoir fluids to surface.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000658">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes the port at which fluid enters the suction side of a pump, compressor, or ejector in petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é a abertura pela qual o fluido entra no lado de sucção de uma bomba, compressor ou ejetor em equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">suction port</rdfs:label>
    <rdfs:label xml:lang="pt-br">bocal de sucção</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000536"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the port at which fluid enters the suction side of a pump, compressor, or ejector in petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000659">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the bearing of mechanical loads from attached components or piping to maintain their position and structural integrity.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em suportar cargas mecânicas de componentes ou tubulações acoplados, mantendo sua posição e integridade estrutural.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">support function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de suporte</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001687"/>
    <rdfs:subClassOf rdf:nodeID="n001688"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the bearing of mechanical loads from attached components or piping to maintain their position and structural integrity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000660">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which mechanical loads from attached components or piping are borne by a structural element to maintain their position and integrity.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que cargas mecânicas de componentes ou tubulações acoplados são suportadas por um elemento estrutural para manter sua posição e integridade.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">supporting process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de suporte</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001689"/>
    <rdfs:subClassOf rdf:nodeID="n001690"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which mechanical loads from attached components or piping are borne by a structural element to maintain their position and integrity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000662">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a sensed temperature is converted into mechanical or visual displacement of an indicator, without remote signal transmission.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que uma temperatura detectada é convertida em deslocamento mecânico ou visual de um indicador, sem transmissão remota de sinal.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">temperature indication process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de indicação de temperatura</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001691"/>
    <rdfs:subClassOf rdf:nodeID="n001692"/>
    <rdfs:subClassOf rdf:nodeID="n001693"/>
    <rdfs:subClassOf rdf:nodeID="n001694"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a sensed temperature is converted into mechanical or visual displacement of an indicator, without remote signal transmission.</skos:definition>
    <skos:definition xml:lang="en">A planned process in which the temperature of a process stream or equipment surface is measured and displayed locally or transmitted to a remote monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000663">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which process temperature is measured and the corresponding signal transmitted to a remote control or monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a temperatura do processo é medida e o sinal correspondente é transmitido a um sistema remoto de controle ou monitoramento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">temperature measurement and transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição e transmissão de temperatura</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001695"/>
    <rdfs:subClassOf rdf:nodeID="n001696"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which process temperature is measured and the corresponding signal transmitted to a remote control or monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000666">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which thermal energy is detected and converted into a measurable signal representing the temperature of a process stream or component.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que energia térmica é detectada e convertida em um sinal mensurável que representa a temperatura de uma corrente de processo ou componente.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">temperature sensing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de sensoriamento de temperatura</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001697"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which thermal energy is detected and converted into a measurable signal representing the temperature of a process stream or component.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000667">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a protective barrier shields a temperature sensing element from direct contact with the process medium while maintaining thermal conductivity to enable accurate temperature measurement.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que uma barreira de proteção impede o contato direto de um elemento sensor de temperatura com o meio de processo, mantendo a condução térmica para permitir uma medição de temperatura precisa.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">temperature sensor protection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de proteção de sensor de temperatura</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001698"/>
    <rdfs:subClassOf rdf:nodeID="n001699"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a protective barrier shields a temperature sensing element from direct contact with the process medium while maintaining thermal conductivity to enable accurate temperature measurement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000668">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the absorption of dimensional changes in piping or structures caused by variations in process temperature.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em absorver variações dimensionais em tubulações ou estruturas causadas por mudanças na temperatura do processo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">thermal expansion accommodation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de acomodação de expansão térmica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001700"/>
    <rdfs:subClassOf rdf:nodeID="n001701"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the absorption of dimensional changes in piping or structures caused by variations in process temperature.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000669">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which dimensional changes in piping or structures caused by variations in process temperature are absorbed without transmitting excessive stress to connected equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que variações dimensionais em tubulações ou estruturas causadas por mudanças na temperatura do processo são absorvidas sem transmitir esforços excessivos aos equipamentos conectados.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">thermal expansion accommodation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de acomodação de expansão térmica</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which dimensional changes in piping or structures caused by variations in process temperature are absorbed without transmitting excessive stress to connected equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000670">
    <iof-av:naturalLanguageDefinition xml:lang="en">A separation function borne by petroleum production equipment whose realization constitutes the separation of a gas–liquid hydrocarbon–produced water mixture into three distinct phases by gravity and residence time.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de separação portada por equipamento de produção de petróleo cuja realização consiste em separar uma mistura de gás, hidrocarboneto líquido e água produzida em três fases distintas por gravidade e tempo de residência.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">three phase separation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de separação trifásica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001702"/>
    <rdfs:subClassOf rdf:nodeID="n001703"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000195"/>
    <skos:definition xml:lang="en">A separation function borne by petroleum production equipment whose realization constitutes the separation of a gas–liquid hydrocarbon–produced water mixture into three distinct phases by gravity and residence time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000671">
    <iof-av:naturalLanguageDefinition xml:lang="en">A separation process in which a mixture of gas, liquid hydrocarbon, and produced water is divided into three distinct phases by gravity and residence time.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de separação em que uma mistura de gás, hidrocarboneto líquido e água produzida é dividida em três fases distintas por gravidade e tempo de residência.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">three phase separation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de separação trifásica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001704"/>
    <rdfs:subClassOf rdf:nodeID="n001705"/>
    <rdfs:subClassOf rdf:nodeID="n001706"/>
    <rdfs:subClassOf rdf:nodeID="n001707"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000635"/>
    <skos:definition xml:lang="en">A separation process in which a mixture of gas, liquid hydrocarbon, and produced water is divided into three distinct phases by gravity and residence time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000672">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of one form of physical signal or energy into another form suitable for measurement or transmission.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em converter uma forma de sinal físico ou de energia em outra adequada para medição ou transmissão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">transduction function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transdução</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001708"/>
    <rdfs:subClassOf rdf:nodeID="n001709"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of one form of physical signal or energy into another form suitable for measurement or transmission.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000673">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which one form of physical signal or energy is converted into another form suitable for measurement or transmission.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que uma forma de sinal físico ou de energia é convertida em outra adequada para medição ou transmissão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">transduction process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transdução</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001710"/>
    <rdfs:subClassOf rdf:nodeID="n001711"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which one form of physical signal or energy is converted into another form suitable for measurement or transmission.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000674">
    <iof-av:naturalLanguageDefinition xml:lang="en">A string of production or injection tubing joints run inside a well's casing to convey fluids between the reservoir and the surface.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma coluna de tubos de produção ou injeção descida por dentro do revestimento de um poço para conduzir fluidos entre o reservatório e a superfície.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tubing string</rdfs:label>
    <rdfs:label xml:lang="pt-br">coluna de coluna de produção</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the continuous string of tubing that conveys production fluids from the wellbore to the surface or delivers injection fluids downhole.</skos:definition>
    <skos:definition xml:lang="en">A string of production or injection tubing joints run inside a well's casing to convey fluids between the reservoir and the surface.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000675">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes both the mechanical support of tubing strings within a wellbore and their connection to surface or subsurface equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste tanto na sustentação mecânica das colunas de produção dentro do poço quanto em sua conexão a equipamentos de superfície ou de subsuperfície.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tubing support and connection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de suporte e conexão de coluna de produção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001712"/>
    <rdfs:subClassOf rdf:nodeID="n001713"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes both the mechanical support of tubing strings within a wellbore and their connection to surface or subsurface equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000676">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which downhole tubing strings are mechanically supported within a wellbore and connected to surface or subsurface equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que colunas de produção são sustentadas mecanicamente dentro do poço e conectadas a equipamentos de superfície ou de subsuperfície.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tubing support and connection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de suporte e conexão de coluna de produção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001714"/>
    <rdfs:subClassOf rdf:nodeID="n001715"/>
    <rdfs:subClassOf rdf:nodeID="n001716"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which downhole tubing strings are mechanically supported within a wellbore and connected to surface or subsurface equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000677">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical suspension and support of downhole tubing strings within a wellbore.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em suspender e sustentar mecanicamente as colunas de produção dentro do poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tubing support function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de suporte de coluna de produção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001717"/>
    <rdfs:subClassOf rdf:nodeID="n001718"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical suspension and support of downhole tubing strings within a wellbore.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000678">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which downhole tubing strings are mechanically suspended and supported within a wellbore.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que colunas de produção são suspensas e sustentadas mecanicamente dentro do poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tubing support process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de suporte de coluna de produção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001719"/>
    <rdfs:subClassOf rdf:nodeID="n001720"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which downhole tubing strings are mechanically suspended and supported within a wellbore.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000679">
    <iof-av:naturalLanguageDefinition xml:lang="en">An assembly of rotor blades, stator vanes, and casing components that extracts energy from a fluid stream in a turbine stage of petroleum production turbomachinery.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um conjunto de palhetas do rotor, palhetas do estator e componentes da carcaça que extrai energia de uma corrente de fluido em um estágio de turbina de turbomáquinas de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">turbine section</rdfs:label>
    <rdfs:label xml:lang="pt-br">seção de turbina</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Assembly"/>
    <skos:definition xml:lang="en">An assembly of rotor blades, stator vanes, and casing components that extracts energy from a fluid stream in a turbine stage of petroleum production turbomachinery.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000680">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of fluid enthalpy into shaft power through interaction with rotating turbine blades.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em converter a entalpia de um fluido em potência de eixo pela interação com as palhetas rotativas de uma turbina.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">turbomachinery power generation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de geração de energia por turbomáquina</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001721"/>
    <rdfs:subClassOf rdf:nodeID="n001722"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the conversion of fluid enthalpy into shaft power through interaction with rotating turbine blades.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000681">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which fluid enthalpy is converted into shaft power through the interaction of a fluid stream with rotating turbine blades.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a entalpia de um fluido é convertida em potência de eixo pela interação de uma corrente de fluido com as palhetas rotativas de uma turbina.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">turbomachinery power generation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de geração de energia por turbomáquina</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001723"/>
    <rdfs:subClassOf rdf:nodeID="n001724"/>
    <rdfs:subClassOf rdf:nodeID="n001725"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which fluid enthalpy is converted into shaft power through the interaction of a fluid stream with rotating turbine blades.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000682">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the provision of continuous electrical power to critical loads during interruptions to the main power supply.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em fornecer energia elétrica contínua a cargas críticas durante interrupções da alimentação principal.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">uninterrupted power supply function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de fornecimento ininterrupto de energia</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001726"/>
    <rdfs:subClassOf rdf:nodeID="n001727"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the provision of continuous electrical power to critical loads during interruptions to the main power supply.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000683">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which continuous electrical power is provided to critical loads during interruptions to the main power supply.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que energia elétrica contínua é fornecida a cargas críticas durante interrupções da alimentação principal.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">uninterrupted power supply process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de fornecimento ininterrupto de energia</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which continuous electrical power is provided to critical loads during interruptions to the main power supply.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000684">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a sealed chamber maintained at a vacuum reference, against which process pressure is compared to determine an absolute pressure measurement.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é uma câmara selada mantida em vácuo de referência, com a qual a pressão do processo é comparada para determinar uma medição de pressão absoluta.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">vacuum reference chamber</rdfs:label>
    <rdfs:label xml:lang="pt-br">câmara de vácuo de referência</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a sealed chamber maintained at a vacuum reference, against which process pressure is compared to determine an absolute pressure measurement.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000685">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the amplitude or frequency of mechanical vibration is measured and the corresponding signal transmitted to a remote monitoring system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a amplitude ou a frequência da vibração mecânica é medida e o sinal correspondente é transmitido a um sistema de monitoramento remoto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">vibration measurement and transmission process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição e transmissão de vibração</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001728"/>
    <rdfs:subClassOf rdf:nodeID="n001729"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which the amplitude or frequency of mechanical vibration is measured and the corresponding signal transmitted to a remote monitoring system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000686">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a VisualInspectionProcess and that consists in enabling direct optical observation of internal conditions, fluid properties, or process states within containers, vessels, or piping systems for operational monitoring, safety verification, or maintenance purposes.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um VisualInspectionProcess e que consiste em permitir a observação óptica direta de condições internas, propriedades do fluido ou estados do processo em recipientes, vasos ou tubulações, para monitoramento operacional, verificação de segurança ou manutenção.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">visual inspection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de inspeção visual</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001730"/>
    <rdfs:subClassOf rdf:nodeID="n001731"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000029"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a VisualInspectionProcess and that consists in enabling direct optical observation of internal conditions, fluid properties, or process states within containers, vessels, or piping systems for operational monitoring, safety verification, or maintenance purposes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000687">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which an operator or automated vision system directly observes the interior of a vessel or piping system through a transparent window or port to assess fluid level, flow conditions, phase behavior, contamination, or other visual indicators of process state.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que um operador ou sistema de visão automatizado observa diretamente o interior de um vaso ou tubulação através de uma janela ou visor transparente para avaliar nível de fluido, condições de escoamento, comportamento de fases, contaminação ou outros indicadores visuais do estado do processo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">visual inspection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de inspeção visual</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001732"/>
    <rdfs:subClassOf rdf:nodeID="n001733"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which an operator or automated vision system directly observes the interior of a vessel or piping system through a transparent window or port to assess fluid level, flow conditions, phase behavior, contamination, or other visual indicators of process state.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000688">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the thermal destruction of waste gases, liquids, or solids by controlled combustion.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste na destruição térmica de gases, líquidos ou sólidos residuais por combustão controlada.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">waste combustion function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de combustão de resíduos</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001734"/>
    <rdfs:subClassOf rdf:nodeID="n001735"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the thermal destruction of waste gases, liquids, or solids by controlled combustion.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000689">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which waste gases, liquids, or solids are thermally destroyed by controlled combustion in petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que gases, líquidos ou sólidos residuais são destruídos termicamente por combustão controlada em equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">waste combustion process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de combustão de resíduos</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001736"/>
    <rdfs:subClassOf rdf:nodeID="n001737"/>
    <rdfs:subClassOf rdf:nodeID="n001738"/>
    <rdfs:subClassOf rdf:nodeID="n001739"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000007"/>
    <skos:definition xml:lang="en">A planned process in which waste gases, liquids, or solids are thermally destroyed by controlled combustion in petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000690">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which surplus or waste gas is combusted in a flare or incinerator to destroy it safely and prevent atmospheric venting.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que gás excedente ou residual é queimado em um flare ou incinerador para destruí-lo com segurança e evitar sua ventilação para a atmosfera.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">waste gas burning process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de queima de gás residual</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001740"/>
    <rdfs:subClassOf rdf:nodeID="n001741"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000007"/>
    <skos:definition xml:lang="en">A planned process in which surplus or waste gas is combusted in a flare or incinerator to destroy it safely and prevent atmospheric venting.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000691">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the safe disposal of waste or surplus gas streams by combustion, venting, or re-injection into a formation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste no descarte seguro de correntes de gás residual ou excedente por combustão, ventilação ou reinjeção em uma formação.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">waste gas disposal function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de descarte de gás residual</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001742"/>
    <rdfs:subClassOf rdf:nodeID="n001743"/>
    <rdfs:subClassOf rdf:nodeID="n001744"/>
    <rdfs:subClassOf rdf:nodeID="n001745"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the safe disposal of waste or surplus gas streams by combustion, venting, or re-injection into a formation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000692">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which waste or surplus gas streams are safely disposed of by combustion, venting, or re-injection into a subsurface formation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que correntes de gás residual ou excedente são descartadas com segurança por combustão, ventilação ou reinjeção em uma formação de subsuperfície.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">waste gas disposal process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de descarte de gás residual</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001746"/>
    <rdfs:subClassOf rdf:nodeID="n001747"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000007"/>
    <skos:definition xml:lang="en">A planned process in which waste or surplus gas streams are safely disposed of by combustion, venting, or re-injection into a subsurface formation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000693">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the regulation of fluid flow from a well to maintain production targets and prevent uncontrolled release.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em regular o escoamento de fluido de um poço para manter as metas de produção e evitar liberações descontroladas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">well fluid control function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de controle de fluido de poço</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001748"/>
    <rdfs:subClassOf rdf:nodeID="n001749"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the regulation of fluid flow from a well to maintain production targets and prevent uncontrolled release.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000694">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which the flow of fluids from a well is regulated to maintain production targets and prevent uncontrolled release.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o escoamento de fluidos de um poço é regulado para manter as metas de produção e evitar liberações descontroladas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">well fluid control process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de controle de fluido de poço</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001750"/>
    <rdfs:subClassOf rdf:nodeID="n001751"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which the flow of fluids from a well is regulated to maintain production targets and prevent uncontrolled release.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000695">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the control of wellbore conditions from surface to manage production flow, monitor integrity, and enable well interventions.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em controlar, a partir da superfície, as condições do poço para gerenciar o escoamento de produção, monitorar a integridade e permitir intervenções.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">well surface control function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de controle de superfície do poço</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001752"/>
    <rdfs:subClassOf rdf:nodeID="n001753"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the control of wellbore conditions from surface to manage production flow, monitor integrity, and enable well interventions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000696">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which wellbore conditions are controlled from surface to manage production flow, monitor well integrity, and enable intervention operations.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que as condições do poço são controladas a partir da superfície para gerenciar o escoamento de produção, monitorar a integridade do poço e permitir operações de intervenção.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">well surface control process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de controle de superfície do poço</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001754"/>
    <rdfs:subClassOf rdf:nodeID="n001755"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which wellbore conditions are controlled from surface to manage production flow, monitor well integrity, and enable intervention operations.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000697">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a spool piece installed between wellhead components to provide the correct bore alignment and connection points.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um carretel instalado entre componentes da cabeça de poço para prover o alinhamento correto do diâmetro de passagem e os pontos de conexão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">wellhead spool</rdfs:label>
    <rdfs:label xml:lang="pt-br">spool de cabeçal de poço</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a spool piece installed between wellhead components to provide the correct bore alignment and connection points.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000698">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the acquisition of subsurface formation and wellbore data by lowering measurement tools into the well on a wireline cable.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em adquirir dados da formação e do poço descendo ferramentas de medição no poço por um cabo de perfilagem.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">wireline logging function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de perfilagem por wireline</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001756"/>
    <rdfs:subClassOf rdf:nodeID="n001757"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the acquisition of subsurface formation and wellbore data by lowering measurement tools into the well on a wireline cable.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000699">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which measurement tools are lowered into a well on a wireline cable to acquire subsurface formation and wellbore data.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que ferramentas de medição são descidas no poço por um cabo de perfilagem para adquirir dados da formação e do poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">wireline logging process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de perfilagem por wireline</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001758"/>
    <rdfs:subClassOf rdf:nodeID="n001759"/>
    <rdfs:subClassOf rdf:nodeID="n001760"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which measurement tools are lowered into a well on a wireline cable to acquire subsurface formation and wellbore data.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000700">
    <iof-av:naturalLanguageDefinition xml:lang="en">An assembly of electrical cables routed together and secured as a group in a petroleum production installation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um conjunto de cabos elétricos encaminhados juntos e fixados como um grupo em uma instalação de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">cable bundle</rdfs:label>
    <rdfs:label xml:lang="pt-br">feixe de cabo</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Assembly"/>
    <skos:definition xml:lang="en">An assembly of electrical cables routed together and secured as a group in a petroleum production installation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000701">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which leakage of fluid between two parts is prevented by pressing a closure element against a mating seating surface.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que o vazamento de fluido entre duas partes é impedido pela compressão de um elemento de fechamento contra uma superfície de assentamento correspondente.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">surface sealing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de vedação por superfície</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001761"/>
    <rdfs:subClassOf rdf:nodeID="n001762"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A PlannedProcess in which leakage of fluid between two parts is prevented by pressing a closure element against a mating seating surface.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000702">
    <iof-av:naturalLanguageDefinition xml:lang="en">A heat transfer function borne by petroleum production equipment whose realization constitutes the enhancement of heat exchange between two fluids by increasing the effective surface area of a heat-transfer tube with fins.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de transferência de calor portada por equipamento de produção de petróleo cuja realização consiste em intensificar a troca de calor entre dois fluidos aumentando, por meio de aletas, a área efetiva de um tubo de troca térmica.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">extended surface heat transfer function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transferência de calor por superfície estendida</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001763"/>
    <rdfs:subClassOf rdf:nodeID="n001764"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A heat transfer function borne by petroleum production equipment whose realization constitutes the enhancement of heat exchange between two fluids by increasing the effective surface area of a heat-transfer tube with fins.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000703">
    <iof-av:naturalLanguageDefinition xml:lang="en">A heat transfer process in which thermal energy is exchanged between two fluids across a tube surface whose effective area has been increased by fins to enhance the rate of heat transfer.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de transferência de calor em que energia térmica é trocada entre dois fluidos através da superfície de um tubo cuja área efetiva foi aumentada por aletas para intensificar a taxa de transferência.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">extended surface heat transfer process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transferência de calor por superfície estendida</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001765"/>
    <rdfs:subClassOf rdf:nodeID="n001766"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000004"/>
    <skos:definition xml:lang="en">A heat transfer process in which thermal energy is exchanged between two fluids across a tube surface whose effective area has been increased by fins to enhance the rate of heat transfer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000704">
    <iof-av:naturalLanguageDefinition xml:lang="en">A well isolation function borne by petroleum production equipment whose realization constitutes the shutoff of flow between a wellbore and a lateral flowline connected to a wellhead or Christmas tree.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de isolamento de poço portada por equipamento de produção de petróleo cuja realização consiste em bloquear o escoamento entre o poço e uma linha lateral conectada à cabeça de poço ou à árvore de natal.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flowline isolation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de isolamento da linha de produção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001767"/>
    <rdfs:subClassOf rdf:nodeID="n001768"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A well isolation function borne by petroleum production equipment whose realization constitutes the shutoff of flow between a wellbore and a lateral flowline connected to a wellhead or Christmas tree.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000705">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which flow between a wellbore and a lateral flowline is shut off at a wellhead or Christmas tree.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o escoamento entre o poço e uma linha lateral é bloqueado na cabeça de poço ou na árvore de natal.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">flowline isolation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de isolamento da linha de produção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001769"/>
    <rdfs:subClassOf rdf:nodeID="n001770"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which flow between a wellbore and a lateral flowline is shut off at a wellhead or Christmas tree.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000706">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the structural support and fixed positioning of one or more instruments to enable their correct operation, access, or protection.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em sustentar estruturalmente e manter em posição fixa um ou mais instrumentos, permitindo sua operação correta, acesso ou proteção.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">instrument mounting function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de montagem de instrumentos</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001771"/>
    <rdfs:subClassOf rdf:nodeID="n001772"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the structural support and fixed positioning of one or more instruments to enable their correct operation, access, or protection.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000707">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which one or more instruments are structurally supported and held in a fixed position by a mounting artifact to enable their correct operation, access, or protection.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um ou mais instrumentos são sustentados estruturalmente e mantidos em posição fixa por um artefato de montagem, permitindo sua operação correta, acesso ou proteção.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">instrument mounting process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de montagem de instrumentos</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001773"/>
    <rdfs:subClassOf rdf:nodeID="n001774"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which one or more instruments are structurally supported and held in a fixed position by a mounting artifact to enable their correct operation, access, or protection.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000708">
    <iof-av:naturalLanguageDefinition xml:lang="en">A fluid conduction function borne by petroleum production equipment whose realization constitutes the simultaneous conveyance of fluid through multiple parallel flow paths within a single assembly.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de condução de fluido portada por equipamento de produção de petróleo cuja realização consiste em conduzir fluido simultaneamente por vários caminhos de escoamento paralelos dentro de um mesmo conjunto.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">multipath fluid conveyance function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de condução de fluido por múltiplos caminhos</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001775"/>
    <rdfs:subClassOf rdf:nodeID="n001776"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A fluid conduction function borne by petroleum production equipment whose realization constitutes the simultaneous conveyance of fluid through multiple parallel flow paths within a single assembly.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000709">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which fluid is conveyed simultaneously through multiple parallel flow paths within a single tube or cable assembly.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que fluido é conduzido simultaneamente por vários caminhos de escoamento paralelos dentro de um mesmo feixe de tubos ou cabo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">multipath fluid conveyance process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de condução de fluido por múltiplos caminhos</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001777"/>
    <rdfs:subClassOf rdf:nodeID="n001778"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which fluid is conveyed simultaneously through multiple parallel flow paths within a single tube or cable assembly.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000710">
    <iof-av:naturalLanguageDefinition xml:lang="en">A well isolation function borne by petroleum production equipment whose realization constitutes the primary, full-bore shutoff of flow between a wellbore and the surface production system.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função de isolamento de poço portada por equipamento de produção de petróleo cuja realização consiste no bloqueio primário, em passagem plena, do escoamento entre o poço e o sistema de produção de superfície.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">primary well isolation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de isolamento primário do poço</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001779"/>
    <rdfs:subClassOf rdf:nodeID="n001780"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A well isolation function borne by petroleum production equipment whose realization constitutes the primary, full-bore shutoff of flow between a wellbore and the surface production system.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000711">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which flow between a wellbore and the surface production system is fully shut off at the primary isolation point of a wellhead or Christmas tree.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o escoamento entre o poço e o sistema de produção de superfície é totalmente bloqueado no ponto de isolamento primário da cabeça de poço ou da árvore de natal.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">primary well isolation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de isolamento primário do poço</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001781"/>
    <rdfs:subClassOf rdf:nodeID="n001782"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A planned process in which flow between a wellbore and the surface production system is fully shut off at the primary isolation point of a wellhead or Christmas tree.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000712">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the sensing of a physical or chemical property of an entity, independently of any instrument that subsequently handles the resulting measurement result.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em detectar uma propriedade física ou química de uma entidade, independentemente do instrumento que depois trata o resultado da medição.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">property measurement function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de medição de propriedade</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001783"/>
    <rdfs:subClassOf rdf:nodeID="n001784"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000029"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the sensing of a physical or chemical property of an entity, independently of any instrument that subsequently handles the resulting measurement result.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000713">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a physical or chemical property of an entity is sensed and transduced into a measurement result, independently of the equipment handling that result.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que uma propriedade física ou química de uma entidade é detectada e convertida em um resultado de medição, independentemente do equipamento que trata esse resultado.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">property measurement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição de propriedade</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001785"/>
    <rdfs:subClassOf rdf:nodeID="n001786"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A planned process in which a physical or chemical property of an entity is sensed and transduced into a measurement result, independently of the equipment handling that result.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000714">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the cyclic linear displacement of a fluid volume through the reciprocating motion of a component within a cylinder.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste no deslocamento linear cíclico de um volume de fluido pelo movimento alternativo de um componente dentro de um cilindro.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reciprocating displacement function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de deslocamento alternativo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001787"/>
    <rdfs:subClassOf rdf:nodeID="n001788"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the cyclic linear displacement of a fluid volume through the reciprocating motion of a component within a cylinder.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000715">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a cylinder's internal volume is cyclically changed by reciprocating linear motion to displace and pressurise a fluid.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que o volume interno de um cilindro é alterado ciclicamente por movimento linear alternativo, deslocando e pressurizando um fluido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">reciprocating displacement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de deslocamento alternativo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001789"/>
    <rdfs:subClassOf rdf:nodeID="n001790"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000003"/>
    <skos:definition xml:lang="en">A planned process in which a cylinder's internal volume is cyclically changed by reciprocating linear motion to displace and pressurise a fluid.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000716">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical disintegration of subsurface rock through cutting, crushing, or shearing action to advance a wellbore.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste na desagregação mecânica da rocha de subsuperfície por corte, esmagamento ou cisalhamento, para avançar um poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rock cutting function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de corte de rocha</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001791"/>
    <rdfs:subClassOf rdf:nodeID="n001792"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the mechanical disintegration of subsurface rock through cutting, crushing, or shearing action to advance a wellbore.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000717">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which subsurface rock is mechanically disintegrated through cutting, crushing, or shearing action by a drill bit to advance a wellbore.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que a rocha de subsuperfície é desagregada mecanicamente por corte, esmagamento ou cisalhamento de uma broca, para avançar um poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rock cutting process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de corte de rocha</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001793"/>
    <rdfs:subClassOf rdf:nodeID="n001794"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which subsurface rock is mechanically disintegrated through cutting, crushing, or shearing action by a drill bit to advance a wellbore.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000718">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the selective passage of fluid constituents through a porous medium while retaining particulate or liquid contaminants above a defined size.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em permitir a passagem seletiva de constituintes de um fluido através de um meio poroso, retendo contaminantes particulados ou líquidos acima de um tamanho definido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">selective permeability function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de permeabilidade seletiva</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001795"/>
    <rdfs:subClassOf rdf:nodeID="n001796"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the selective passage of fluid constituents through a porous medium while retaining particulate or liquid contaminants above a defined size.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000719">
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that constitutes a cylindrical conduit used to convey fluid or provide structural support within petroleum production equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um conduto cilíndrico usado para conduzir fluido ou prover sustentação estrutural em equipamentos de produção de petróleo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tube</rdfs:label>
    <rdfs:label xml:lang="pt-br">tubo</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a cylindrical conduit used to convey fluid or provide structural support within petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000720">
    <iof-av:naturalLanguageDefinition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the reception, positioning, and sealed support of a tubing hanger to suspend and seal the production tubing string at the wellhead.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma função projetada portada por equipamento de produção de petróleo cuja realização consiste em receber, posicionar e sustentar com vedação um suspensor de coluna de produção, para suspender e vedar a coluna na cabeça de poço.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tubing hanger seating function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de assentamento do suspensor de coluna</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001797"/>
    <rdfs:subClassOf rdf:nodeID="n001798"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A designed function borne by petroleum production equipment whose realization constitutes the reception, positioning, and sealed support of a tubing hanger to suspend and seal the production tubing string at the wellhead.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000721">
    <iof-av:naturalLanguageDefinition xml:lang="en">A planned process in which a tubing hanger is received, positioned, and sealed within a wellhead housing to suspend and seal the production tubing string.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo planejado em que um suspensor de coluna é recebido, posicionado e vedado dentro do alojamento da cabeça de poço, para suspender e vedar a coluna de produção.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tubing hanger seating process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de assentamento do suspensor de coluna</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A planned process in which a tubing hanger is received, positioned, and sealed within a wellhead housing to suspend and seal the production tubing string.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000722">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/CHAMBER"/>
    <dcterms:source rdf:resource="https://www.jip36-cfihos.org/"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that is an enclosed space within a larger artifact, bearing a containment function.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um espaço fechado dentro de um artefato maior, possuindo uma função de contenção.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">ContainmentFunction is shared with every containing artifact in COPI, so it cannot be sufficient. Interiority is a relational condition, not a sufficient one.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">chamber</rdfs:label>
    <rdfs:label xml:lang="pt-br">câmara</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001799"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes an enclosed space within petroleum production equipment in which a process such as separation, compression, or storage takes place.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that is an enclosed space within a larger artifact, bearing a containment function.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000723">
    <dcterms:source rdf:resource="https://glossary.slb.com/en/terms/d/drill_bit"/>
    <dcterms:source rdf:resource="https://onepetro.org/search-results?page=1&amp;q=drill-bit"/>
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/DRILL_BIT"/>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that bears a rock cutting function, used to crush or cut formation rock in order to create a borehole.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que possui uma função de corte de rocha, usado para triturar ou cortar rocha da formação a fim de criar um poço.</iof-av:naturalLanguageDefinition>
    <owl:equivalentClass rdf:nodeID="n001800"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">drill bit</rdfs:label>
    <rdfs:label xml:lang="pt-br">broca</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that bears a rock cutting function, used to crush or cut formation rock in order to create a borehole.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that constitutes the rotating cutting tool at the bottom of a drill string that fragments rock to advance the wellbore.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000724">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/ELECTRICAL_SWITCH"/>
    <dcterms:source rdf:resource="https://www.jip36-cfihos.org/"/>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that bears an electrical switching function, turning electrical current on and/or off.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que possui uma função de chaveamento elétrico, ligando e/ou desligando a corrente elétrica.</iof-av:naturalLanguageDefinition>
    <owl:equivalentClass rdf:nodeID="n001805"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">electrical switch</rdfs:label>
    <rdfs:label xml:lang="pt-br">chave elétrica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001804"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that bears an electrical switching function, turning electrical current on and/or off.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that constitutes a device that opens or closes an electrical circuit in response to a manual or automatic input in petroleum production equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000725">
    <dcterms:source rdf:resource="https://glossary.slb.com/en/terms/f/filter_medium"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that is a permeable material used in a filtration device, through which filtrate passes and on which the filter cake is deposited.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um material permeável usado em um dispositivo de filtração, através do qual passa o filtrado e sobre o qual se deposita a torta de filtração.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">The medium is a component of the filter, not a filter; the distinction rests on parthood, which is not a sufficient condition.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">filter medium</rdfs:label>
    <rdfs:label xml:lang="pt-br">meio filtrante</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001809"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the porous material through which a fluid stream passes to remove suspended particulates or liquid droplets in petroleum production equipment.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that is a permeable material used in a filtration device, through which filtrate passes and on which the filter cake is deposited.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000726">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/FINNED_TUBE"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that is a tube extended with one or more fins to increase its outer surface area, bearing an extended-surface heat transfer function.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um tubo estendido com uma ou mais aletas para aumentar sua área de superfície externa, possuindo uma função de transferência de calor por superfície estendida.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">The differentia is structural (presence of fins), so under OWA it cannot be a sufficient condition.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">finned tube</rdfs:label>
    <rdfs:label xml:lang="pt-br">tubo aletado</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001810"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a heat transfer tube with extended surfaces—fins—that increase the external surface area to enhance heat exchange with a gas stream.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that is a tube extended with one or more fins to increase its outer surface area, bearing an extended-surface heat transfer function.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000727">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/GAS_DETECTING_MEASURING_ELEMENT"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A measuring element that bears a gas detection function, used for detecting the presence of a specified concentration of a gas.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um elemento de medição que possui uma função de detecção de gás, usado para detectar a presença de uma concentração especificada de um gás.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">GasDetectionFunction is already the sufficient condition for the 'gas detector' instrument. A measuring element bears it as a component; parthood is not a sufficient condition.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas detecting measuring element</rdfs:label>
    <rdfs:label xml:lang="pt-br">elemento de medição de detecção de gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001811"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000573"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a sensing element within petroleum production gas detection equipment that responds to the presence and concentration of a target gas.</skos:definition>
    <skos:definition xml:lang="en">A measuring element that bears a gas detection function, used for detecting the presence of a specified concentration of a gas.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000728">
    <dcterms:source rdf:resource="https://glossary.slb.com/en/terms/m/master_valve"/>
    <dcterms:source rdf:resource="https://onepetro.org/search-results?page=1&amp;q=master-valve"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A valve that bears a primary well isolation function and is a component of a christmas tree, controlling all flow from the wellbore.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma válvula que possui uma função de isolamento primário do poço e é um componente de uma árvore de natal, controlando todo o fluxo do poço.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">The definition is partly positional ('on the christmas tree', 'main shut-in valve on the well'); under OWA a positional differentia cannot be sufficient.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">master valve</rdfs:label>
    <rdfs:label xml:lang="pt-br">válvula mestra</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001812"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the main isolation valve at the base of a Christmas tree that controls fluid flow from the tubing head.</skos:definition>
    <skos:definition xml:lang="en">A valve that bears a primary well isolation function and is a component of a christmas tree, controlling all flow from the wellbore.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000729">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/PANEL"/>
    <dcterms:source rdf:resource="https://www.isa.org/standards-and-publications/isa-standards/isa-standards-committees/isa5"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that is a structure on which groups of instrument hardware are mounted and which houses the operator-process interface.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é uma estrutura sobre a qual grupos de instrumentos são montados e que abriga a interface operador-processo.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">The ISA definition is structure-led and enumerative (sections, cubicles, consoles, desks); no sufficient condition follows from it.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">panel</rdfs:label>
    <rdfs:label xml:lang="pt-br">painel</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001813"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a flat structural panel that provides a mounting surface for instrumentation, controls, or electrical equipment in a petroleum production installation.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that is a structure on which groups of instrument hardware are mounted and which houses the operator-process interface.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000730">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/PISTON"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact, normally cylindrical and provided with a closed end, that reciprocates within a hollow outer cylinder to change its internal volume in order to discharge pressurized liquid or gas.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material, normalmente cilíndrico e provido de uma extremidade fechada, que se move alternadamente dentro de um cilindro externo oco para alterar seu volume interno a fim de descarregar líquido ou gás pressurizado.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Shape constraints in the source definition are constructive; under OWA they cannot be sufficient conditions.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">piston</rdfs:label>
    <rdfs:label xml:lang="pt-br">pistão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001814"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a sliding disc or cylinder that moves within a cylindrical bore to compress gas or transmit hydraulic force in petroleum production equipment.</skos:definition>
    <skos:definition xml:lang="en">A material artifact, normally cylindrical and provided with a closed end, that reciprocates within a hollow outer cylinder to change its internal volume in order to discharge pressurized liquid or gas.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000731">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/STATOR_WINDING"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that is a winding on the stator of a machine, bearing an electromagnetic field generation function.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é um enrolamento no estator de uma máquina, possuindo uma função de geração de campo eletromagnético.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Differentia is positional (on the stator, not the rotor); positional conditions are not sufficient under OWA.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">stator winding</rdfs:label>
    <rdfs:label xml:lang="pt-br">enrolamento do estator</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001815"/>
    <rdfs:subClassOf rdf:nodeID="n001816"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the stationary winding of an electric motor or generator that produces or responds to the rotating magnetic field in petroleum production rotating electrical equipment.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that is a winding on the stator of a machine, bearing an electromagnetic field generation function.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000732">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/TUBE_BUNDLE"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">An assembly of several tubes assembled together, bearing a multipath fluid conveyance function that allows multiple flow paths from a single source.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma montagem de vários tubos reunidos, possuindo uma função de condução de fluido em múltiplos caminhos que permite vários percursos de fluxo a partir de uma única fonte.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">The differentia is the structural fact of several tubes assembled together; not sufficient under OWA.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tube bundle</rdfs:label>
    <rdfs:label xml:lang="pt-br">feixe tubular</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001817"/>
    <rdfs:subClassOf rdf:nodeID="n001818"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/Assembly"/>
    <skos:definition xml:lang="en">An assembly of heat transfer tubes, baffles, and tube sheets that forms the core of a shell-and-tube heat exchanger in petroleum production equipment.</skos:definition>
    <skos:definition xml:lang="en">An assembly of several tubes assembled together, bearing a multipath fluid conveyance function that allows multiple flow paths from a single source.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000733">
    <dcterms:source rdf:resource="https://onepetro.org/search-results?page=1&amp;q=tubing-bowl"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A material artifact that is the section of a tubing head which accommodates the tubing hanger, where it sets and seals.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um artefato material que é a seção de uma cabeça de produção que acomoda o suspensor da coluna, onde este assenta e veda.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Definition locates it within the wellhead rather than characterising it independently; parthood is not a sufficient condition.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tubing bowl</rdfs:label>
    <rdfs:label xml:lang="pt-br">alojamento da coluna de produção</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001819"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes the bowl at the top of a wellhead housing in which the tubing hanger is seated and sealed.</skos:definition>
    <skos:definition xml:lang="en">A material artifact that is the section of a tubing head which accommodates the tubing hanger, where it sets and seals.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000734">
    <dcterms:source rdf:resource="https://glossary.slb.com/en/terms/w/wing_valve"/>
    <dcterms:source rdf:resource="https://onepetro.org/search-results?page=1&amp;q=wing-valve"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A valve that bears a flowline isolation function and is a component of a christmas tree, located on the flow line downstream of the master valve.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma válvula que possui uma função de isolamento de linha de fluxo e é um componente de uma árvore de natal, localizada na linha de fluxo a jusante da válvula mestra.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Definition is positional relative to the master valve and the flow line; not a sufficient condition under OWA.</iof-av:primitiveRationale>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">wing valve</rdfs:label>
    <rdfs:label xml:lang="pt-br">válvula lateral</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001820"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a flow control valve on the side outlet of a Christmas tree that directs well production to a flowline or test separator.</skos:definition>
    <skos:definition xml:lang="en">A valve that bears a flowline isolation function and is a component of a christmas tree, located on the flow line downstream of the master valve.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000735">
    <iof-av:naturalLanguageDefinition xml:lang="en">A valve closure member, in the form of a ball with a flow passage, that is rotated about an axis transverse to the flow to open or close a ball valve.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um elemento de fechamento de válvula, em forma de esfera com passagem de escoamento, que é girado em torno de um eixo transversal ao escoamento para abrir ou fechar uma válvula esfera.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ball valve closure member</rdfs:label>
    <rdfs:label xml:lang="pt-br">elemento de fechamento de válvula esfera</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A valve closure member, in the form of a ball with a flow passage, that is rotated about an axis transverse to the flow to open or close a ball valve.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000736">
    <iof-av:naturalLanguageDefinition xml:lang="en">A disc-shaped valve closure member designed to be installed in a butterfly valve, rotating on a shaft that lies in or near the plane of the disc.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um elemento de fechamento de válvula em forma de disco projetado para ser instalado em uma válvula borboleta, girando sobre um eixo situado no plano do disco ou próximo dele.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">butterfly valve closure member</rdfs:label>
    <rdfs:label xml:lang="pt-br">elemento de fechamento de válvula borboleta</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A disc-shaped valve closure member designed to be installed in a butterfly valve, rotating on a shaft that lies in or near the plane of the disc.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000737">
    <iof-av:naturalLanguageDefinition xml:lang="en">A valve closure member, in the form of a disc or piston, that moves linearly normal to its seat to open, throttle or close a globe valve.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um elemento de fechamento de válvula, em forma de disco ou pistão, que se desloca linearmente na direção normal à sua sede para abrir, estrangular ou fechar uma válvula globo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">globe valve closure member</rdfs:label>
    <rdfs:label xml:lang="pt-br">elemento de fechamento de válvula globo</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A valve closure member, in the form of a disc or piston, that moves linearly normal to its seat to open, throttle or close a globe valve.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000738">
    <iof-av:naturalLanguageDefinition xml:lang="en">The inlet nozzle of a pump or compressor casing through which fluid enters the machine.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">O bocal de entrada da carcaça de uma bomba ou compressor pelo qual o fluido entra na máquina.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">suction nozzle</rdfs:label>
    <rdfs:label xml:lang="pt-br">bocal de sucção</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">The inlet nozzle of a pump or compressor casing through which fluid enters the machine.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000739">
    <iof-av:naturalLanguageDefinition xml:lang="en">A thin, flangeless check valve body designed to be clamped between two pipe flanges.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um corpo de válvula de retenção fino e sem flanges projetado para ser fixado entre dois flanges de tubo.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">wafer check valve body</rdfs:label>
    <rdfs:label xml:lang="pt-br">corpo de válvula de retenção tipo wafer</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A thin, flangeless check valve body designed to be clamped between two pipe flanges.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000740">
    <iof-av:naturalLanguageDefinition xml:lang="en">A check valve body designed to house the hinged, swinging disc of a swing check valve.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um corpo de válvula de retenção projetado para alojar o disco articulado e oscilante de uma válvula de retenção tipo portinhola.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">swing check valve body</rdfs:label>
    <rdfs:label xml:lang="pt-br">corpo de válvula de retenção portinhola</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A check valve body designed to house the hinged, swinging disc of a swing check valve.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000741">
    <iof-av:naturalLanguageDefinition xml:lang="en">A spiral-shaped casing passage of increasing cross-section around the impeller of a centrifugal pump that collects the discharged fluid and converts velocity into pressure.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma passagem em espiral de seção crescente na carcaça, em torno do impelidor de uma bomba centrífuga, que coleta o fluido descarregado e converte velocidade em pressão.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">volute</rdfs:label>
    <rdfs:label xml:lang="pt-br">voluta</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A spiral-shaped casing passage of increasing cross-section around the impeller of a centrifugal pump that collects the discharged fluid and converts velocity into pressure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000742">
    <iof-av:naturalLanguageDefinition xml:lang="en">A valve closure member, typically tapered or cylindrical, that fits into or against a seat to block or throttle flow.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um elemento de fechamento de válvula, em geral cônico ou cilíndrico, que se encaixa em uma sede ou contra ela para bloquear ou estrangular o escoamento.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">plug</rdfs:label>
    <rdfs:label xml:lang="pt-br">obturador</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A valve closure member, typically tapered or cylindrical, that fits into or against a seat to block or throttle flow.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000743">
    <iof-av:naturalLanguageDefinition xml:lang="en">A coiled strip made of two bonded metals with different thermal expansion that winds or unwinds with temperature change, fixed at one end and driving a pointer at the other in a bimetallic thermometer.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma tira em espiral formada por dois metais unidos com dilatação térmica diferente, que se enrola ou desenrola com a variação de temperatura, fixa em uma extremidade e acionando um ponteiro na outra em um termômetro bimetálico.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">bimetallic coil</rdfs:label>
    <rdfs:label xml:lang="pt-br">espiral bimetálica</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A coiled strip made of two bonded metals with different thermal expansion that winds or unwinds with temperature change, fixed at one end and driving a pointer at the other in a bimetallic thermometer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000744">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/BLANKING_CAP_PIPE_UNION"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (BlankingCapPipeUnion(x) → Cap(x) ∧ ∃f (ClosureFunction(f) ∧ bearerOf(x,f)) ∧ ∃u (FemaleUnionSub(u) ∧ hasComponentPartAtAllTimes(x,u)) ∧ ∃c (ThreadedPipeCap(c) ∧ hasComponentPartAtAllTimes(x,c)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A blanking cap pipe union (end of line terminator) is a cap assembly consisting of a female union sub with a threaded end, permanently fitted to a pipe, and a threaded cap screwed onto it to close off fluid flow at the end of a line.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um conjunto de tampa cega de uniao de tubo (terminador de fim de linha) e um conjunto de tampa formado por uma luva de uniao femea com extremidade rosqueada, fixada permanentemente a um tubo, e uma tampa rosqueada aparafusada sobre ela para fechar o fluxo de fluido na extremidade de uma linha.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive subtype reusing genus and function unchanged: sufficiency is not asserted so that any two-component threaded closure is not automatically classified into this specific union-sub-plus-cap assembly without confirmation.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every blanking cap pipe union is a cap that bears a closure function and has a female union sub and a threaded pipe cap as component parts, screwed together to close off fluid flow.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">blanking cap pipe union</rdfs:label>
    <rdfs:label xml:lang="pt-br">tampão cego com união</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001821"/>
    <rdfs:subClassOf rdf:nodeID="n001822"/>
    <rdfs:subClassOf rdf:nodeID="n001823"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000746"/>
    <skos:definition xml:lang="en">A blanking cap pipe union (end of line terminator) is a cap assembly consisting of a female union sub with a threaded end, permanently fitted to a pipe, and a threaded cap screwed onto it to close off fluid flow at the end of a line.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000745">
    <dcterms:source rdf:resource="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100005874"/>
    <dcterms:source rdf:resource="https://onepetro.org/search-results?page=1&amp;q=blind-flange"/>
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/BLIND_FLANGE"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (BlindFlange(x) ↔ Flange(x) ∧ ∃f (PipeEndClosureFunction(f) ∧ bearerOf(x,f)) ∧ ∃q (SolidPlateForm(q) ∧ hasQuality(x,q)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A blind flange is a flange that bears a pipe-end closure function: a solid plate with no central opening, bolted over a flanged pipe end to seal it off, rather than to connect it to another component.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um flange cego e um flange que possui uma funcao de fechamento de extremidade de tubo: uma placa solida sem abertura central, aparafusada sobre uma extremidade de tubo flangeada para veda-la, em vez de conecta-la a outro componente.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every blind flange is a flange that bears a pipe-end closure function and has a solid plate form quality, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001824"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">blind flange</rdfs:label>
    <rdfs:label xml:lang="pt-br">flange cego</rdfs:label>
    <skos:definition xml:lang="en">A blind flange is a flange that bears a pipe-end closure function: a solid plate with no central opening, bolted over a flanged pipe end to seal it off, rather than to connect it to another component.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000746">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/CAP"/>
    <dcterms:source rdf:resource="https://www.jip36-cfihos.org/"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (Cap(x) ↔ MaterialArtifact(x) ∧ ∃f (ClosureFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A cap is a material artifact that bears a closure function: a hood or covering for the top or end of something.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma tampa e um artefato material que possui uma funcao de fechamento: um capuz ou cobertura para o topo ou extremidade de algo.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every cap is a material artifact that bears a closure function, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001828"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">cap</rdfs:label>
    <rdfs:label xml:lang="pt-br">tampa</rdfs:label>
    <skos:definition xml:lang="en">A cap is a material artifact that bears a closure function: a hood or covering for the top or end of something.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000747">
    <iof-av:naturalLanguageDefinition xml:lang="en">A pressurized gas cylinder that supplies the inert carrier gas used as the mobile phase in a gas chromatograph.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um cilindro de gás pressurizado que fornece o gás de arraste inerte usado como fase móvel em um cromatógrafo a gás.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">carrier gas cylinder</rdfs:label>
    <rdfs:label xml:lang="pt-br">cilindro de portador de gás</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A pressurized gas cylinder that supplies the inert carrier gas used as the mobile phase in a gas chromatograph.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000748">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a ClosureProcess and that consists in covering or capping the top or end of an artefact, protecting or sealing it from the surrounding environment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um ClosureProcess e que consiste em cobrir ou tampar o topo ou a extremidade de um artefato, protegendo-o ou vedando-o em relação ao ambiente.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">closure function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de fechamento</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001832"/>
    <rdfs:subClassOf rdf:nodeID="n001833"/>
    <rdfs:subClassOf rdf:nodeID="n001834"/>
    <rdfs:subClassOf rdf:nodeID="n001835"/>
    <rdfs:subClassOf rdf:nodeID="n001836"/>
    <rdfs:subClassOf rdf:nodeID="n001837"/>
    <rdfs:subClassOf rdf:nodeID="n001838"/>
    <rdfs:subClassOf rdf:nodeID="n001839"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a ClosureProcess and that consists in covering or capping the top or end of an artefact, protecting or sealing it from the surrounding environment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000749">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a cap is fitted over the top or end of an artefact, covering or sealing it.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que uma tampa é colocada sobre o topo ou a extremidade de um artefato, cobrindo-o ou vedando-o.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">closure process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de fechamento</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a cap is fitted over the top or end of an artefact, covering or sealing it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000750">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/COALESCENT_FILTER"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (CoalescentFilter(x) ↔ Filter(x) ∧ ∃f (CoalescingFiltrationFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A coalescent filter (coalescing filter) is a filter designed to remove liquid particles from a gas stream, using a layered coalescing media pack that merges small droplets into larger drops for gravity drainage.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um filtro coalescente e um filtro projetado para remover particulas liquidas de uma corrente de gas, usando um pacote de meio filtrante em camadas que funde pequenas goticulas em gotas maiores para drenagem por gravidade.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every coalescent filter is a filter that bears a coalescing filtration function, and conversely, every filter that bears a coalescing filtration function is a coalescent filter.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001840"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">coalescent filter</rdfs:label>
    <rdfs:label xml:lang="pt-br">filtro coalescedor</rdfs:label>
    <skos:definition xml:lang="en">A coalescent filter (coalescing filter) is a filter designed to remove liquid particles from a gas stream, using a layered coalescing media pack that merges small droplets into larger drops for gravity drainage.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000751">
    <iof-av:naturalLanguageDefinition xml:lang="en">A display component that presents a measured or computed value to a human observer as numerals or characters rather than on an analogue scale.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um componente de exibição que apresenta a um observador um valor medido ou calculado na forma de algarismos ou caracteres, e não em uma escala analógica.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">digital display</rdfs:label>
    <rdfs:label xml:lang="pt-br">mostrador digital</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A display component that presents a measured or computed value to a human observer as numerals or characters rather than on an analogue scale.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000752">
    <iof-av:naturalLanguageDefinition xml:lang="en">The female-threaded half of a pipe union, fitted to a pipe end, onto which a mating threaded component such as a cap is screwed.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">A metade com rosca fêmea de uma união de tubo, fixada a uma extremidade de tubo, sobre a qual se rosqueia um componente correspondente, como uma tampa.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">female union sub</rdfs:label>
    <rdfs:label xml:lang="pt-br">luva de união fêmea</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">The female-threaded half of a pipe union, fitted to a pipe end, onto which a mating threaded component such as a cap is screwed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000753">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/GAS_CHROMATOGRAPH"/>
    <dcterms:source rdf:resource="https://www.jip36-cfihos.org/"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (GasChromatograph(x) → Chromatograph(x) ∧ ∃f (ChromatographicAnalysisFunction(f) ∧ bearerOf(x,f)) ∧ ∃p (CarrierGasCylinder(p) ∧ hasComponentPartAtAllTimes(x,p)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A gas chromatograph is a chromatograph that uses a pressurized carrier gas as its mobile phase, into which the sample is injected directly for separation in one or more columns.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um cromatografo a gas e um cromatografo que usa um gas de arraste pressurizado como fase movel, no qual a amostra e injetada diretamente para separacao em uma ou mais colunas.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive subtype reusing genus and function unchanged (CLAUDE.md same-genus-same-function rule): sufficiency is not asserted so that a hypothetical device bearing ChromatographicAnalysisFunction with a co-located gas cylinder for an unrelated reason is not forcibly classified as a gas chromatograph under OWA.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every gas chromatograph is a chromatograph that bears a chromatographic analysis function and has a carrier gas cylinder as a component part, which supplies the gaseous mobile phase.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas chromatograph</rdfs:label>
    <rdfs:label xml:lang="pt-br">cromatógrafo a gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001844"/>
    <rdfs:subClassOf rdf:nodeID="n001845"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000229"/>
    <skos:definition xml:lang="en">A gas chromatograph is a chromatograph that uses a pressurized carrier gas as its mobile phase, into which the sample is injected directly for separation in one or more columns.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000754">
    <iof-av:naturalLanguageDefinition xml:lang="en">A ContainmentFunction subtype that is realized in a GravityCollectionProcess and that consists in collecting and holding the heavier of two or more fluid phases, separated and accumulated by gravity.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um subtipo de ContainmentFunction que é realizado em um GravityCollectionProcess e que consiste em coletar e reter a mais pesada de duas ou mais fases fluidas, separada e acumulada por gravidade.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gravity collection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de coleta por gravidade</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001846"/>
    <rdfs:subClassOf rdf:nodeID="n001847"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000025"/>
    <skos:definition xml:lang="en">A ContainmentFunction subtype that is realized in a GravityCollectionProcess and that consists in collecting and holding the heavier of two or more fluid phases, separated and accumulated by gravity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000755">
    <iof-av:naturalLanguageDefinition xml:lang="en">A MaterialContainment process in which the heavier phase of a fluid mixture (e.g. drainage liquid from a lighter gas or vapour) settles and accumulates in a low-lying reservoir under gravity, to be held until removed.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de MaterialContainment em que a fase mais pesada de uma mistura fluida (por exemplo, o líquido drenado de um gás ou vapor mais leve) decanta e se acumula por gravidade em um reservatório baixo, onde fica retida até ser removida.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gravity collection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de coleta por gravidade</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001848"/>
    <rdfs:subClassOf rdf:nodeID="n001849"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A MaterialContainment process in which the heavier phase of a fluid mixture (e.g. drainage liquid from a lighter gas or vapour) settles and accumulates in a low-lying reservoir under gravity, to be held until removed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000758">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a MoistureMeasurementProcess and that consists in measuring and indicating the moisture content of a sample or medium.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um MoistureMeasurementProcess e que consiste em medir e indicar o teor de umidade de uma amostra ou meio.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">moisture measurement function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de medição de umidade</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001850"/>
    <rdfs:subClassOf rdf:nodeID="n001851"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a MoistureMeasurementProcess and that consists in measuring and indicating the moisture content of a sample or medium.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000759">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a moisture sensing element detects moisture content and a digital display presents the measured value.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que um elemento sensor de umidade detecta o teor de umidade e um mostrador digital apresenta o valor medido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">moisture measurement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de medição de umidade</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001852"/>
    <rdfs:subClassOf rdf:nodeID="n001853"/>
    <rdfs:subClassOf rdf:nodeID="n001854"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a moisture sensing element detects moisture content and a digital display presents the measured value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000760">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/MOISTURE_METER"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (MoistureMeter(x) ↔ Instrument(x) ∧ ∃f (MoistureMeasurementFunction(f) ∧ bearerOf(x,f)) ∧ ∃e (MoistureSensingElement(e) ∧ hasComponentPartAtAllTimes(x,e)) ∧ ∃d (DigitalDisplay(d) ∧ hasComponentPartAtAllTimes(x,d)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A moisture meter is an instrument that bears a moisture measurement function, using a moisture sensing element and a digital display to measure and indicate the moisture content of a sample or medium.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um medidor de umidade e um instrumento que possui uma funcao de medicao de umidade, usando um elemento sensor de umidade e um display digital para medir e indicar o teor de umidade de uma amostra ou meio.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every moisture meter is an instrument that bears a moisture measurement function and has a moisture sensing element and a digital display as component parts, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001855"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">moisture meter</rdfs:label>
    <rdfs:label xml:lang="pt-br">medidor de umidade</rdfs:label>
    <skos:definition xml:lang="en">A moisture meter is an instrument that bears a moisture measurement function, using a moisture sensing element and a digital display to measure and indicate the moisture content of a sample or medium.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000761">
    <iof-av:naturalLanguageDefinition xml:lang="en">The sensing element of a moisture meter that responds to the moisture content of a sample or medium and converts it into a measurable signal.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">O elemento sensor de um medidor de umidade que responde ao teor de umidade de uma amostra ou meio e o converte em um sinal mensurável.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">moisture sensing element</rdfs:label>
    <rdfs:label xml:lang="pt-br">elemento de umidade de sensoriamento</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">The sensing element of a moisture meter that responds to the moisture content of a sample or medium and converts it into a measurable signal.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000762">
    <dcterms:source rdf:resource="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100005967"/>
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/PIPE_CAP"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (PipeCap(x) → Cap(x) ∧ ∃f (ClosureFunction(f) ∧ bearerOf(x,f)) ∧ ∃q (OverFitRelation(q) ∧ hasQuality(x,q)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A pipe cap is a cap that fits on or over the outside of a pipe end, not inside it, to close it off.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma tampa de tubo e uma tampa que se encaixa sobre a parte externa de uma extremidade de tubo, nao por dentro, para fecha-la.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive subtype reusing genus and function unchanged: sufficiency is not asserted so that a cap-like covering for a non-pipe artefact is not automatically classified as a pipe cap under OWA.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every pipe cap is a cap that bears a closure function and has an over-fit relation quality, fitting on or over the outside of a pipe end.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pipe cap</rdfs:label>
    <rdfs:label xml:lang="pt-br">tampão de tubo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001863"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000746"/>
    <skos:altLabel xml:lang="en">quick connection cap</skos:altLabel>
    <skos:definition xml:lang="en">A pipe cap is a cap that fits on or over the outside of a pipe end, not inside it, to close it off.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000763">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a PipeEndClosureProcess and that consists in sealing off an open, flanged pipe end so no fluid can pass, without joining it to another pipe or component.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um PipeEndClosureProcess e que consiste em vedar uma extremidade flangeada de tubo aberta, impedindo a passagem de fluido, sem uni-la a outro tubo ou componente.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pipe end closure function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de fechamento de extremidade de tubo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001864"/>
    <rdfs:subClassOf rdf:nodeID="n001865"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a PipeEndClosureProcess and that consists in sealing off an open, flanged pipe end so no fluid can pass, without joining it to another pipe or component.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000764">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a flanged pipe end is sealed by bolting a solid plate over its opening, preventing any fluid flow through that end.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que uma extremidade flangeada de tubo é vedada pela fixação de uma placa maciça sobre sua abertura, impedindo qualquer escoamento por essa extremidade.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pipe end closure process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de fechamento de extremidade de tubo</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a flanged pipe end is sealed by bolting a solid plate over its opening, preventing any fluid flow through that end.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000765">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/PIPE_REDUCER_CONCENTRIC"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (ConcentricReducer(x) → PipeReducer(x) ∧ ∃f (FluidConductionFunction(f) ∧ bearerOf(x,f)) ∧ ∃q (CoaxialCenterline(q) ∧ hasQuality(x,q)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A concentric reducer is a pipe reducer whose larger and smaller pipe ends share a common, coaxial centerline, giving it a symmetric cone shape.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um reductor concentrico e um redutor de tubulacao cujas extremidades maior e menor compartilham uma linha de centro coaxial comum, conferindo-lhe formato conico simetrico.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive subtype reusing genus and function unchanged: sufficiency is not asserted so as not to preclude expert review of edge cases (e.g. slightly asymmetric fittings marketed as 'concentric').</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every concentric reducer is a pipe reducer that bears a fluid conduction function and has a coaxial centerline quality, distinguishing it from an eccentric reducer's offset centerline.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">pipe reducer concentric</rdfs:label>
    <rdfs:label xml:lang="pt-br">redução concêntrica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001866"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000324"/>
    <skos:definition xml:lang="en">A concentric reducer is a pipe reducer whose larger and smaller pipe ends share a common, coaxial centerline, giving it a symmetric cone shape.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000766">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/PROBE"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (Probe(x) ↔ Instrument(x) ∧ ∃f (ProbingFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A probe is an instrument that bears a probing function: it obtains specific information about, or a physical sample of, a process medium for diagnostic or experimental purposes, typically by direct insertion or immersion.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma sonda é um instrumento que porta uma função de sondagem: obtém informação específica sobre um meio de processo, ou uma amostra física dele, para fins de diagnóstico ou experimentais, em geral por inserção ou imersão direta.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every probe is an instrument that bears a probing function, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001867"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">probe</rdfs:label>
    <rdfs:label xml:lang="pt-br">sonda</rdfs:label>
    <skos:definition xml:lang="en">A probe is an instrument that bears a probing function: it obtains specific information about, or a physical sample of, a process medium for diagnostic or experimental purposes, typically by direct insertion or immersion.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000767">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a ProbingProcess and that consists in obtaining specific information about, or a physical sample of, a process medium for diagnostic or experimental purposes, typically by direct insertion or immersion into that medium.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um ProbingProcess e que consiste em obter informação específica sobre um meio de processo, ou uma amostra física dele, para fins de diagnóstico ou experimentais, em geral por inserção ou imersão direta nesse meio.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">probing function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de sondagem</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001871"/>
    <rdfs:subClassOf rdf:nodeID="n001872"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in a ProbingProcess and that consists in obtaining specific information about, or a physical sample of, a process medium for diagnostic or experimental purposes, typically by direct insertion or immersion into that medium.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000768">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a sensing or sampling element is inserted into or immersed in a process medium to obtain information about it or extract a physical sample, for diagnostic or experimental purposes.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que um elemento sensor ou de amostragem é inserido ou imerso em um meio de processo para obter informação sobre ele ou extrair uma amostra física, para fins de diagnóstico ou experimentais.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">probing process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de sondagem</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001873"/>
    <rdfs:subClassOf rdf:nodeID="n001874"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MeasurementProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a sensing or sampling element is inserted into or immersed in a process medium to obtain information about it or extract a physical sample, for diagnostic or experimental purposes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000769">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/PROCESS_VARIABLE_TRANSMITTER"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (ProcessVariableTransmitter(x) → Transmitter(x) ∧ ∃f (SignalTransmissionFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A process variable transmitter is a transmitter that sends a standardized signal representing the measurement of a process variable.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um transmissor de variável de processo é um transmissor que envia um sinal padronizado que representa a medição de uma variável de processo.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Same genus function as Transmitter (same-genus same-function rule): equivalence would collapse it onto Transmitter.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every process variable transmitter is a transmitter that bears a signal transmission function.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">process variable transmitter</rdfs:label>
    <rdfs:label xml:lang="pt-br">transmissor de variável de processo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001875"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000157"/>
    <skos:definition xml:lang="en">A process variable transmitter is a transmitter that sends a standardized signal representing the measurement of a process variable.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000770">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/QUICK_ACTING_VALVE"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (QuickActingValve(x) ↔ Valve(x) ∧ ∃f (RapidActuationFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A quick acting valve is a valve designed to open or close substantially faster than a conventional multi-turn valve of the same service, so as to admit or interrupt flow with minimal actuation delay.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma valvula de acao rapida e uma valvula projetada para abrir ou fechar substancialmente mais rapido que uma valvula multivolta convencional de mesmo servico, de modo a admitir ou interromper o fluxo com atraso minimo de acionamento.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every quick acting valve is a valve that bears a rapid actuation function, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001876"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">quick acting valve</rdfs:label>
    <rdfs:label xml:lang="pt-br">válvula de ação rápida</rdfs:label>
    <skos:definition xml:lang="en">A quick acting valve is a valve designed to open or close substantially faster than a conventional multi-turn valve of the same service, so as to admit or interrupt flow with minimal actuation delay.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000771">
    <iof-av:naturalLanguageDefinition xml:lang="en">A ConnectionFunction subtype that is realized in a QuickConnectionProcess and that consists in joining two parts, typically pipes, in a temporary connection that can be made and broken in a short time, without tools or extended procedure.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um subtipo de ConnectionFunction que é realizado em um QuickConnectionProcess e que consiste em unir duas partes, tipicamente tubos, por uma conexão temporária que pode ser feita e desfeita em pouco tempo, sem ferramentas ou procedimento demorado.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">quick connection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de conexão rápida</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001880"/>
    <rdfs:subClassOf rdf:nodeID="n001881"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000441"/>
    <skos:definition xml:lang="en">A ConnectionFunction subtype that is realized in a QuickConnectionProcess and that consists in joining two parts, typically pipes, in a temporary connection that can be made and broken in a short time, without tools or extended procedure.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000772">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which two parts, typically pipe ends, are joined or separated quickly, without the extended procedure (e.g. bolting) a permanent connection would require.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que duas partes, tipicamente extremidades de tubo, são unidas ou separadas rapidamente, sem o procedimento demorado (como aparafusar) que uma conexão permanente exigiria.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">quick connection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de conexão rápida</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001882"/>
    <rdfs:subClassOf rdf:nodeID="n001883"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which two parts, typically pipe ends, are joined or separated quickly, without the extended procedure (e.g. bolting) a permanent connection would require.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000773">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/QUICK_CONNECTOR"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (QuickConnector(x) ↔ MaterialArtifact(x) ∧ ∃f (QuickConnectionFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A quick connector is a material artifact that bears a quick connection function: a temporary connection, typically between pipes, that can be connected and disconnected in a short time.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um conector rapido e um artefato material que possui uma funcao de conexao rapida: uma conexao temporaria, tipicamente entre tubos, que pode ser conectada e desconectada em pouco tempo.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every quick connector is a material artifact that bears a quick connection function, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001884"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">quick connector</rdfs:label>
    <rdfs:label xml:lang="pt-br">conector rápido</rdfs:label>
    <skos:definition xml:lang="en">A quick connector is a material artifact that bears a quick connection function: a temporary connection, typically between pipes, that can be connected and disconnected in a short time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000774">
    <iof-av:naturalLanguageDefinition xml:lang="en">A FlowControlFunction that is realized in a RapidActuationProcess and that consists in opening or closing a valve's flow path substantially faster than a conventional multi-turn valve of the same service, so that flow admission or interruption occurs with minimal actuation delay.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma FlowControlFunction que é realizada em um RapidActuationProcess e que consiste em abrir ou fechar a passagem de escoamento de uma válvula de forma substancialmente mais rápida que uma válvula multivoltas convencional no mesmo serviço, de modo que a admissão ou interrupção do escoamento ocorra com atraso mínimo de atuação.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rapid actuation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de atuação rápida</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001888"/>
    <rdfs:subClassOf rdf:nodeID="n001889"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000026"/>
    <skos:definition xml:lang="en">A FlowControlFunction that is realized in a RapidActuationProcess and that consists in opening or closing a valve's flow path substantially faster than a conventional multi-turn valve of the same service, so that flow admission or interruption occurs with minimal actuation delay.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000775">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a valve's closure member is displaced from fully open to fully closed, or the reverse, within a short, bounded actuation time, admitting or interrupting fluid flow substantially faster than a comparable multi-turn valve operation would allow.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que o elemento de fechamento de uma válvula é deslocado de totalmente aberto a totalmente fechado, ou o inverso, em um tempo de atuação curto e limitado, admitindo ou interrompendo o escoamento de forma substancialmente mais rápida que a operação de uma válvula multivoltas comparável.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rapid actuation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de atuação rápida</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001890"/>
    <rdfs:subClassOf rdf:nodeID="n001891"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000010"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a valve's closure member is displaced from fully open to fully closed, or the reverse, within a short, bounded actuation time, admitting or interrupting fluid flow substantially faster than a comparable multi-turn valve operation would allow.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000776">
    <dcterms:source rdf:resource="https://www.jip36-cfihos.org/"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (SampleBomb(x) ↔ SampleVessel(x) ∧ ∃f (GasSampleCollectionFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A sample bomb (sampling cylinder) is a sample vessel constructed as a pressure-rated cylinder with a valve at each end, specially designed to collect, store, and transport high-pressure gas samples from the field to a laboratory.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um cilindro de amostragem (sample bomb) e um vaso de amostra construido como um cilindro classificado para pressao com uma valvula em cada extremidade, especialmente projetado para coletar, armazenar e transportar amostras de gas de alta pressao do campo ate um laboratorio.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every sample bomb is a sample vessel that bears a gas sample collection function, and conversely, every sample vessel that bears a gas sample collection function is a sample bomb.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001892"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sample bomb</rdfs:label>
    <rdfs:label xml:lang="pt-br">cilindro de amostragem</rdfs:label>
    <skos:definition xml:lang="en">A sample bomb (sampling cylinder) is a sample vessel constructed as a pressure-rated cylinder with a valve at each end, specially designed to collect, store, and transport high-pressure gas samples from the field to a laboratory.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000777">
    <iof-av:naturalLanguageDefinition xml:lang="en">A ContainmentFunction subtype that is realized in a SampleCollectionProcess and that consists in receiving, holding, and preserving a process sample so it can be transported intact to analytical equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um subtipo de ContainmentFunction que é realizado em um SampleCollectionProcess e que consiste em receber, reter e preservar uma amostra de processo para que ela possa ser transportada intacta até o equipamento de análise.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sample collection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de coleta de amostra</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001896"/>
    <rdfs:subClassOf rdf:nodeID="n001897"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000025"/>
    <skos:definition xml:lang="en">A ContainmentFunction subtype that is realized in a SampleCollectionProcess and that consists in receiving, holding, and preserving a process sample so it can be transported intact to analytical equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000778">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a sample is collected into a vessel, held there without loss or contamination, and transported to analytical equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que uma amostra é coletada em um vaso, mantida ali sem perda ou contaminação e transportada até o equipamento de análise.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sample collection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de coleta de amostra</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001898"/>
    <rdfs:subClassOf rdf:nodeID="n001899"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a sample is collected into a vessel, held there without loss or contamination, and transported to analytical equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000779">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/SAMPLE_COOLER"/>
    <dcterms:source rdf:resource="https://www.jip36-cfihos.org/"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (SampleCooler(x) ↔ Cooler(x) ∧ ∃f (SampleCoolingFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A sample cooler is a cooler designed to cool a sample drawn from a process stream, so that it can be safely handled and analysed.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um resfriador de amostra é um resfriador projetado para resfriar uma amostra retirada de uma corrente de processo, de modo que ela possa ser manuseada e analisada com segurança.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every sample cooler is a cooler that bears a sample cooling function, and conversely, every cooler that bears a sample cooling function is a sample cooler.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001900"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sample cooler</rdfs:label>
    <rdfs:label xml:lang="pt-br">resfriador de amostra</rdfs:label>
    <skos:definition xml:lang="en">A sample cooler is a cooler designed to cool a sample drawn from a process stream, so that it can be safely handled and analysed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000781">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/SAMPLE_VESSEL"/>
    <dcterms:source rdf:resource="https://www.jip36-cfihos.org/"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (SampleVessel(x) ↔ Vessel(x) ∧ ∃f (SampleCollectionFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A sample vessel is a vessel that bears a sample collection function: it receives, holds, and preserves a process sample so it can be transported intact to analytical equipment.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um vaso de amostra e um vaso que possui uma funcao de coleta de amostra: recebe, retem e preserva uma amostra de processo para que possa ser transportada intacta ate o equipamento analitico.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every sample vessel is a vessel that bears a sample collection function, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001904"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sample vessel</rdfs:label>
    <rdfs:label xml:lang="pt-br">vaso de amostragem</rdfs:label>
    <skos:definition xml:lang="en">A sample vessel is a vessel that bears a sample collection function: it receives, holds, and preserves a process sample so it can be transported intact to analytical equipment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000782">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/SIPHON"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (Siphon(x) ↔ Pipe(x) ∧ ∃f (SiphonicTransferFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A siphon is a pipe that bears a siphonic transfer function: once primed, it conveys liquid upward from a reservoir over a crest and down to a lower discharge point, sustained by atmospheric pressure and gravity without continuous external power.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um sifao e um tubo que possui uma funcao de transferencia sifonica: uma vez escorvado, conduz liquido para cima de um reservatorio sobre uma crista e para baixo ate um ponto de descarga mais baixo, sustentado por pressao atmosferica e gravidade sem energia externa continua.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every siphon is a pipe that bears a siphonic transfer function, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001908"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">siphon</rdfs:label>
    <rdfs:label xml:lang="pt-br">sifão</rdfs:label>
    <skos:altLabel xml:lang="en">syphon</skos:altLabel>
    <skos:definition xml:lang="en">A siphon is a pipe that bears a siphonic transfer function: once primed, it conveys liquid upward from a reservoir over a crest and down to a lower discharge point, sustained by atmospheric pressure and gravity without continuous external power.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000783">
    <iof-av:naturalLanguageDefinition xml:lang="en">A FlowControlFunction subtype (specializing FluidConductionFunction) that is realized in a SiphonicTransferProcess and that consists in conveying liquid from a reservoir up over a crest and down to a lower discharge point, sustained by atmospheric pressure and gravity once the tube is primed, without continuous external power input.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um subtipo de FluidConductionFunction que é realizado em um SiphonicTransferProcess e que consiste em conduzir líquido de um reservatório, subindo por cima de uma crista e descendo até um ponto de descarga mais baixo, sustentado pela pressão atmosférica e pela gravidade depois que o tubo é escorvado, sem aporte contínuo de energia externa.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">siphonic transfer function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de transferência por sifão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001912"/>
    <rdfs:subClassOf rdf:nodeID="n001913"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000529"/>
    <skos:definition xml:lang="en">A FlowControlFunction subtype (specializing FluidConductionFunction) that is realized in a SiphonicTransferProcess and that consists in conveying liquid from a reservoir up over a crest and down to a lower discharge point, sustained by atmospheric pressure and gravity once the tube is primed, without continuous external power input.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000784">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a primed column of liquid in a tube is driven from a source reservoir, over a crest above the source's free surface, and down to a discharge point below it, by the head difference between the tube's two legs and atmospheric pressure acting on the source surface.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que uma coluna de líquido escorvada dentro de um tubo é conduzida de um reservatório de origem, passando por uma crista acima da superfície livre da origem, até um ponto de descarga abaixo dela, pela diferença de carga entre os dois ramos do tubo e pela pressão atmosférica que atua sobre a superfície da origem.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">siphonic transfer process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de transferência por sifão</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001914"/>
    <rdfs:subClassOf rdf:nodeID="n001915"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a primed column of liquid in a tube is driven from a source reservoir, over a crest above the source's free surface, and down to a discharge point below it, by the head difference between the tube's two legs and atmospheric pressure acting on the source surface.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000785">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/SUMP"/>
    <dcterms:source rdf:resource="https://www.jip36-cfihos.org/"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (Sump(x) ↔ Vessel(x) ∧ ∃f (GravityCollectionFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A sump (drainage collector) is a vessel that bears a gravity collection function: it collects and holds the heavier of two or more fluid phases, accumulated by gravity.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um sump (coletor de drenagem) e um vaso que possui uma funcao de coleta gravitacional: coleta e retem a fase mais pesada de duas ou mais fases de fluido, acumulada por gravidade.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every sump is a vessel that bears a gravity collection function, and conversely.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001916"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sump</rdfs:label>
    <rdfs:label xml:lang="pt-br">poço coletor</rdfs:label>
    <skos:definition xml:lang="en">A sump (drainage collector) is a vessel that bears a gravity collection function: it collects and holds the heavier of two or more fluid phases, accumulated by gravity.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000786">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/TEMPERATURE_MEASURING_INSTRUMENT_-_BIMETAL"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (BimetallicThermometer(x) → AnalogueTemperatureIndicator(x) ∧ ∃f (TemperatureIndicationFunction(f) ∧ bearerOf(x,f)) ∧ ∃p (BimetallicCoil(p) ∧ hasComponentPartAtAllTimes(x,p)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A bimetallic thermometer is an analogue temperature indicator whose dial pointer is actuated by a coiled bimetallic strip that deflects with differential thermal expansion.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um termometro bimetalico e um indicador analogico de temperatura cujo ponteiro e acionado por uma lamina bimetalica enrolada que se deflete por expansao termica diferencial.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive subtype reusing genus and function unchanged (same-genus-same-function rule): sufficiency is not asserted so a device with an incidentally-present bimetallic component for an unrelated purpose is not forcibly classified as this instrument type under OWA.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every bimetallic thermometer is an analogue temperature indicator that bears a temperature indication function and has a bimetallic coil as a component part, which drives the dial pointer.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">temperature measuring instrument bimetal</rdfs:label>
    <rdfs:label xml:lang="pt-br">termômetro bimetálico</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001920"/>
    <rdfs:subClassOf rdf:nodeID="n001921"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000210"/>
    <skos:altLabel xml:lang="en">bi-metal thermometer</skos:altLabel>
    <skos:altLabel xml:lang="en">bimetallic thermometer</skos:altLabel>
    <skos:definition xml:lang="en">A bimetallic thermometer is an analogue temperature indicator whose dial pointer is actuated by a coiled bimetallic strip that deflects with differential thermal expansion.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000787">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/THREADED_PIPE_CAP"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (ThreadedPipeCap(x) → PipeCap(x) ∧ ∃f (ClosureFunction(f) ∧ bearerOf(x,f)) ∧ ∃q (ThreadedFit(q) ∧ hasQuality(x,q)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A threaded pipe cap is a pipe cap with a threaded pipe end, screwed onto a matching threaded pipe end to close it off.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma tampa de tubo rosqueada e uma tampa de tubo com uma extremidade de tubo rosqueada, aparafusada em uma extremidade de tubo rosqueada correspondente para fecha-la.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive subtype reusing genus and function unchanged: sufficiency is not asserted so that any generic pipe cap loosely described as fitting a threaded end is not automatically classified into this specific connection-type subtype without confirmation.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every threaded pipe cap is a pipe cap that bears a closure function and has a threaded fit quality.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">threaded pipe cap</rdfs:label>
    <rdfs:label xml:lang="pt-br">tampão rosqueado de tubo</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001922"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000762"/>
    <skos:definition xml:lang="en">A threaded pipe cap is a pipe cap with a threaded pipe end, screwed onto a matching threaded pipe end to close it off.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000788">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/THREE_WAY_VALVE"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (ThreeWayValve(x) → Valve(x) ∧ ∃f (FlowControlFunction(f) ∧ bearerOf(x,f)) ∧ ∃p (Port(p) ∧ hasComponentPartAtAllTimes(x,p)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A three way valve is a valve with three flow-path ports instead of the usual two, used to divert one inlet stream to either of two outlets or to mix two inlet streams into one outlet.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma valvula de tres vias e uma valvula com tres portas de passagem de fluxo em vez das duas usuais, usada para desviar um fluxo de entrada para uma de duas saidas ou para misturar dois fluxos de entrada em uma saida.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive type: under OWA, asserting sufficiency (equivalence) from a Port-existence differentia would risk misclassifying any valve that happens to assert a Port component (or any multi-port manifold-like fitting) as a ThreeWayValve. Necessary conditions only, pending expert review of whether the port-count distinction should ever be made sufficient.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every three way valve is a valve that bears a flow control function and has a port as a component part, distinguished from a generic valve by an additional flow-path participant in its process signature.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">three way valve</rdfs:label>
    <rdfs:label xml:lang="pt-br">válvula de três vias</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001923"/>
    <rdfs:subClassOf rdf:nodeID="n001924"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000077"/>
    <skos:definition xml:lang="en">A three way valve is a valve with three flow-path ports instead of the usual two, used to divert one inlet stream to either of two outlets or to mix two inlet streams into one outlet.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000789">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in an ElectricalSwitchingProcess and that consists in making, carrying, or breaking the flow of electrical current in a circuit on command.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um ElectricalSwitchingProcess e que consiste em estabelecer, conduzir ou interromper, sob comando, a passagem de corrente elétrica em um circuito.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">electrical switching function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de chaveamento elétrico</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001925"/>
    <rdfs:subClassOf rdf:nodeID="n001926"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in an ElectricalSwitchingProcess and that consists in making, carrying, or breaking the flow of electrical current in a circuit on command.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000790">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which a switching device makes, carries, or breaks an electrical circuit, starting, sustaining, or interrupting the flow of current through it.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que um dispositivo de manobra estabelece, conduz ou interrompe um circuito elétrico, iniciando, mantendo ou cortando a passagem de corrente por ele.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">electrical switching process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de chaveamento elétrico</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001927"/>
    <rdfs:subClassOf rdf:nodeID="n001928"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which a switching device makes, carries, or breaks an electrical circuit, starting, sustaining, or interrupting the flow of current through it.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000791">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in an ElectromagneticFieldGenerationProcess and that consists in producing a magnetic field when electrical current flows through a conductor arrangement, as in the winding of an electrical machine.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um ElectromagneticFieldGenerationProcess e que consiste em produzir um campo magnético quando corrente elétrica percorre um arranjo de condutores, como no enrolamento de uma máquina elétrica.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">electromagnetic field generation function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de geração de campo eletromagnético</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001929"/>
    <rdfs:subClassOf rdf:nodeID="n001930"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in an ElectromagneticFieldGenerationProcess and that consists in producing a magnetic field when electrical current flows through a conductor arrangement, as in the winding of an electrical machine.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000792">
    <iof-av:naturalLanguageDefinition xml:lang="en">A PlannedProcess in which electrical current flowing through a winding or other conductor arrangement produces a magnetic field that can do work, such as driving the rotor of an electrical machine.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um PlannedProcess em que a corrente elétrica que percorre um enrolamento ou outro arranjo de condutores produz um campo magnético capaz de realizar trabalho, como acionar o rotor de uma máquina elétrica.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">electromagnetic field generation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de geração de campo eletromagnético</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <skos:definition xml:lang="en">A PlannedProcess in which electrical current flowing through a winding or other conductor arrangement produces a magnetic field that can do work, such as driving the rotor of an electrical machine.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000793">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/DOUBLE_BALL_VALVE"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (DoubleBallValve(x) → BallValve(x) ∧ ∃f (FlowControlFunction(f) ∧ bearerOf(x,f)) ∧ ∃b1 ∃b2 (BallValve(b1) ∧ BallValve(b2) ∧ b1 ≠ b2 ∧ hasComponentPartAtAllTimes(x,b1) ∧ hasComponentPartAtAllTimes(x,b2)) ∧ ∃h (Housing(h) ∧ hasComponentPartAtAllTimes(x,h)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">A double ball valve is a ball valve consisting of two ball valves in one housing, providing double isolation of the flow path.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma válvula de esfera dupla é uma válvula de esfera composta por duas válvulas de esfera em um único corpo, provendo dupla isolação do escoamento.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive basis, and same function (FlowControlFunction) as its genus BallValve: an equivalence would let ELK collapse it onto BallValve, and under OWA would classify any manifold containing two ball valves as a double ball valve. Necessary conditions only.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every double ball valve is a ball valve that bears a flow control function, has at least two ball valves as component parts, and has a housing as a component part, the housing holding both ball valves in a single body.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">double ball valve</rdfs:label>
    <rdfs:label xml:lang="pt-br">válvula de esfera dupla</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001931"/>
    <rdfs:subClassOf rdf:nodeID="n001932"/>
    <rdfs:subClassOf rdf:nodeID="n001933"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000095"/>
    <skos:definition xml:lang="en">A double ball valve is a ball valve consisting of two ball valves in one housing, providing double isolation of the flow path.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000794">
    <dcterms:source rdf:resource="http://rds.posccaesar.org/ontology/plm/rdl/PCA_100005901"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (Drum(x) ↔ Separator(x) ∧ ∃f (GasDisengagementFunction(f) ∧ bearerOf(x,f)))</iof-av:firstOrderLogicAxiom>
    <iof-av:naturalLanguageDefinition xml:lang="en">A drum is a separator designed to enable gas or vapour to escape from process fluids.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um tambor é um separador projetado para permitir que gás ou vapor escape de fluidos de processo.</iof-av:naturalLanguageDefinition>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every drum is a separator that bears a gas disengagement function, and conversely, every separator that bears a gas disengagement function is a drum.</iof-av:semiFormalNaturalLanguageAxiom>
    <owl:equivalentClass rdf:nodeID="n001934"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">drum</rdfs:label>
    <rdfs:label xml:lang="pt-br">tambor</rdfs:label>
    <skos:definition xml:lang="en">A drum is a separator designed to enable gas or vapour to escape from process fluids.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000795">
    <dcterms:source rdf:resource="https://standards.iso.org/iso/15926/-4/reference-data-item/ECCENTRIC_BUTTERFLY_VALVE"/>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (EccentricButterflyValve(x) → ButterflyValve(x) ∧ ∃f (FlowControlFunction(f) ∧ bearerOf(x,f)) ∧ ∃p (OffsetValveDisc(p) ∧ hasComponentPartAtAllTimes(x,p)))</iof-av:firstOrderLogicAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
    <iof-av:naturalLanguageDefinition xml:lang="en">An eccentric butterfly valve is a butterfly valve whose disc rotates about an axis offset from the disc sealing plane and/or the pipe centreline, so that the disc follows an eccentric path during actuation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma válvula borboleta excêntrica é uma válvula borboleta cujo disco gira em torno de um eixo deslocado do plano de vedação do disco e/ou da linha de centro da tubulação, de modo que o disco descreve uma trajetória excêntrica durante a atuação.</iof-av:naturalLanguageDefinition>
    <iof-av:primitiveRationale xml:lang="en">Constructive basis and same function as its genus ButterflyValve (same-genus same-function rule): equivalence would collapse it onto ButterflyValve under ELK. Structural offset geometry is not safely sufficient under OWA.</iof-av:primitiveRationale>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every eccentric butterfly valve is a butterfly valve that bears a flow control function and has an offset valve disc as a component part, whose axis is offset so that the disc follows an eccentric path during actuation.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">eccentric butterfly valve</rdfs:label>
    <rdfs:label xml:lang="pt-br">válvula borboleta excêntrica</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001938"/>
    <rdfs:subClassOf rdf:nodeID="n001939"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000100"/>
    <skos:definition xml:lang="en">An eccentric butterfly valve is a butterfly valve whose disc rotates about an axis offset from the disc sealing plane and/or the pipe centreline, so that the disc follows an eccentric path during actuation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000796">
    <iof-av:naturalLanguageDefinition xml:lang="en">A SeparationFunction that is realized in a GasDisengagementProcess and that consists in enabling gas or vapour to escape from a process fluid held in a vessel, so that the gas and the remaining liquid can be drawn off separately.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma SeparationFunction que é realizada em um GasDisengagementProcess e que consiste em permitir que gás ou vapor escape de um fluido de processo contido em um vaso, de modo que o gás e o líquido remanescente possam ser retirados separadamente.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas disengagement function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de liberação de gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001940"/>
    <rdfs:subClassOf rdf:nodeID="n001941"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000195"/>
    <skos:definition xml:lang="en">A SeparationFunction that is realized in a GasDisengagementProcess and that consists in enabling gas or vapour to escape from a process fluid held in a vessel, so that the gas and the remaining liquid can be drawn off separately.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000797">
    <iof-av:naturalLanguageDefinition xml:lang="en">A MechanicalSeparation process in which gas or vapour escapes from a process fluid held in a vessel and is drawn off separately from the remaining liquid, without chemical reaction.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de MechanicalSeparation em que gás ou vapor escapa de um fluido de processo contido em um vaso e é retirado separadamente do líquido remanescente, sem reação química.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas disengagement process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de liberação de gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001942"/>
    <rdfs:subClassOf rdf:nodeID="n001943"/>
    <rdfs:subClassOf rdf:nodeID="n001944"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000006"/>
    <skos:definition xml:lang="en">A MechanicalSeparation process in which gas or vapour escapes from a process fluid held in a vessel and is drawn off separately from the remaining liquid, without chemical reaction.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000798">
    <iof-av:naturalLanguageDefinition xml:lang="en">A butterfly valve closure member in the form of a disc whose axis is offset from the line of flow, so that the disc moves along an eccentric path as it rotates.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um elemento de fechamento de válvula borboleta em forma de disco cujo eixo é deslocado em relação à linha de escoamento, de modo que o disco descreve uma trajetória excêntrica ao girar.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">offset valve disc</rdfs:label>
    <rdfs:label xml:lang="pt-br">disco excêntrico de válvula</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000736"/>
    <skos:definition xml:lang="en">A butterfly valve closure member in the form of a disc whose axis is offset from the line of flow, so that the disc moves along an eccentric path as it rotates.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000799">
    <iof-av:naturalLanguageDefinition xml:lang="en">A CoolingFunction that is realized in a SampleCoolingProcess and that consists in lowering the temperature of a sample drawn from a process stream so that it can be safely handled and analysed.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma CoolingFunction que é realizada em um SampleCoolingProcess e que consiste em reduzir a temperatura de uma amostra retirada de uma corrente de processo para que ela possa ser manuseada e analisada com segurança.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sample cooling function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de resfriamento de amostra</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001945"/>
    <rdfs:subClassOf rdf:nodeID="n001946"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000448"/>
    <skos:definition xml:lang="en">A CoolingFunction that is realized in a SampleCoolingProcess and that consists in lowering the temperature of a sample drawn from a process stream so that it can be safely handled and analysed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000800">
    <iof-av:naturalLanguageDefinition xml:lang="en">A HeatTransfer process in which heat is removed from a sample drawn from a process stream by a cooling medium, bringing the sample to a temperature at which it can be safely handled and analysed.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de HeatTransfer em que calor é retirado, por um meio de resfriamento, de uma amostra extraída de uma corrente de processo, levando-a a uma temperatura em que possa ser manuseada e analisada com segurança.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sample cooling process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de resfriamento de amostra</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001947"/>
    <rdfs:subClassOf rdf:nodeID="n001948"/>
    <rdfs:subClassOf rdf:nodeID="n001949"/>
    <rdfs:subClassOf rdf:nodeID="n001950"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000004"/>
    <skos:definition xml:lang="en">A HeatTransfer process in which heat is removed from a sample drawn from a process stream by a cooling medium, bringing the sample to a temperature at which it can be safely handled and analysed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000801">
    <iof-av:naturalLanguageDefinition xml:lang="en">A FiltrationFunction that is realized in a CoalescingFiltrationProcess and that consists in removing entrained liquid particles from a gas stream by making them coalesce into drops that can be drained.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma FiltrationFunction que é realizada em um CoalescingFiltrationProcess e que consiste em remover partículas líquidas arrastadas de uma corrente gasosa, fazendo-as coalescer em gotas que possam ser drenadas.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">coalescing filtration function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de filtração por coalescência</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001951"/>
    <rdfs:subClassOf rdf:nodeID="n001952"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000194"/>
    <skos:definition xml:lang="en">A FiltrationFunction that is realized in a CoalescingFiltrationProcess and that consists in removing entrained liquid particles from a gas stream by making them coalesce into drops that can be drained.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000802">
    <iof-av:naturalLanguageDefinition xml:lang="en">A MechanicalSeparation process in which liquid droplets entrained in a gas stream coalesce on a filter medium into larger drops that drain away, leaving the gas with reduced liquid content.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de MechanicalSeparation em que gotículas de líquido arrastadas por uma corrente gasosa coalescem em um meio filtrante formando gotas maiores que são drenadas, deixando o gás com teor de líquido reduzido.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">coalescing filtration process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de filtração por coalescência</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001953"/>
    <rdfs:subClassOf rdf:nodeID="n001954"/>
    <rdfs:subClassOf rdf:nodeID="n001955"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000006"/>
    <skos:definition xml:lang="en">A MechanicalSeparation process in which liquid droplets entrained in a gas stream coalesce on a filter medium into larger drops that drain away, leaving the gas with reduced liquid content.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000803">
    <iof-av:naturalLanguageDefinition xml:lang="en">A SampleCollectionFunction that is realized in a GasSampleCollectionProcess and that consists in collecting, holding and transporting a high-pressure gas sample from the field to a laboratory without loss or contamination.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma SampleCollectionFunction que é realizada em um GasSampleCollectionProcess e que consiste em coletar, reter e transportar uma amostra de gás a alta pressão do campo até um laboratório, sem perda ou contaminação.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas sample collection function</rdfs:label>
    <rdfs:label xml:lang="pt-br">função de coleta de amostra de gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001956"/>
    <rdfs:subClassOf rdf:nodeID="n001957"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000777"/>
    <skos:definition xml:lang="en">A SampleCollectionFunction that is realized in a GasSampleCollectionProcess and that consists in collecting, holding and transporting a high-pressure gas sample from the field to a laboratory without loss or contamination.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000804">
    <iof-av:naturalLanguageDefinition xml:lang="en">A MaterialContainment process in which a high-pressure gas sample is drawn into a pressure-rated cylinder, held there without loss or contamination, and transported to a laboratory.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um processo de MaterialContainment em que uma amostra de gás a alta pressão é admitida em um cilindro projetado para pressão, mantida ali sem perda ou contaminação e transportada até um laboratório.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">gas sample collection process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de coleta de amostra de gás</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n001958"/>
    <rdfs:subClassOf rdf:nodeID="n001959"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000009"/>
    <skos:definition xml:lang="en">A MaterialContainment process in which a high-pressure gas sample is drawn into a pressure-rated cylinder, held there without loss or contamination, and transported to a laboratory.</skos:definition>
  </rdf:Description>
