  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000237">
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um medidor de vazão que utiliza o princípio de Coriolis através de tubos de fluxo oscilantes especializados para medir diretamente a vazão mássica de fluidos.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="en">A flow meter that utilizes the Coriolis principle through specialized oscillating flow tubes to directly measure mass flow rate of fluids.</iof-av:naturalLanguageDefinition>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000278"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b559"/>
    <skos:definition xml:lang="en">A flow meter that utilizes the Coriolis principle through specialized oscillating flow tubes to directly measure mass flow rate of fluids.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">coriolis mass flow meter</rdfs:label>
    <rdfs:label xml:lang="pt-br">medidor de vazão Coriolis</rdfs:label>
    <iof-av:primitiveRationale xml:lang="en">Using necessary conditions for this constructive type. Under the Open World Assumption, defining sufficient conditions based on Coriolis principle usage could lead to false positives where other devices using Coriolis forces (like gyroscopes or accelerometers) might be incorrectly classified as flow meters. The structural differentia provides necessary conditions that can be validated by domain experts.</iof-av:primitiveRationale>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x(CoriolisMassFlowMeter(x) → FlowMeter(x) ∧ ∃y(CoriolisFlowTube(y) ∧ hasComponentPartAtAllTimes(x,y)) ∧ ∃z(CoriolisPrinciple(z) ∧ utilizesPhysicalPrinciple(x,z)))</iof-av:firstOrderLogicAxiom>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every coriolis mass flow meter is a flow meter that has component part at all times some Coriolis flow tube and utilizes the Coriolis principle.</iof-av:semiFormalNaturalLanguageAxiom>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000458">
    <rdfs:label xml:lang="pt-br">processo de desumidificação</rdfs:label>
    <rdfs:label xml:lang="en">dehumidification process</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b610"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b611"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b609"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A planned process in which water vapour is removed from a gas stream to reduce its relative humidity or dew point to a specified level.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000407">
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2131"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/DesignedFunction"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1675"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b877"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1920"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b696"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2307"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2130"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2308"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1419"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b39"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b695"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1674"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1919"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b876"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b38"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1418"/>
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in an ActuationProcess and that consists in the capacity to convert an input energy signal (electrical, pneumatic, or hydraulic) into controlled mechanical motion for operating other equipment components.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in an ActuationProcess and that consists in converting a control input to mechanical movement or force that positions or operates another equipment component, where the control input is provided manually by human operation.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in an ActuationProcess and that consists in converting control signals or energy inputs into mechanical motion or force to operate other equipment such as valves, dampers, or positioning mechanisms.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in an ActuationProcess and that consists in converting one form of energy into mechanical motion to operate a mechanism or device.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="pt-br">função de atuação</rdfs:label>
    <rdfs:label xml:lang="en">actuation function</rdfs:label>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in an ActuationProcess and that consists in converting a control input to mechanical movement or force that positions or operates another equipment component, where the control input is provided manually by human operation.</skos:definition>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in an ActuationProcess and that consists in converting control signals or energy inputs into mechanical motion or force to operate other equipment such as valves, dampers, or positioning mechanisms.</skos:definition>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in an ActuationProcess and that consists in converting one form of energy into mechanical motion to operate a mechanism or device.</skos:definition>
    <skos:definition xml:lang="en">A DesignedFunction that is realized in an ActuationProcess and that consists in the capacity to convert an input energy signal (electrical, pneumatic, or hydraulic) into controlled mechanical motion for operating other equipment components.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000496">
    <rdfs:label xml:lang="pt-br">processo de interrupção de corrente elétrica</rdfs:label>
    <rdfs:label xml:lang="en">electrical current interruption process</rdfs:label>
    <skos:definition xml:lang="en">A planned process in which an electrical circuit is opened to stop the flow of current, either under normal operating conditions or in response to a fault.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/PlannedProcess"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000562">
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1547"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000635"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1546"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1545"/>
    <rdfs:label xml:lang="pt-br">processo de separação knock-out</rdfs:label>
    <rdfs:label xml:lang="en">knock out separation process</rdfs:label>
    <skos:definition xml:lang="en">A separation process in which entrained liquid droplets are removed from a gas stream by gravity or inertial impingement in a knockout vessel.</skos:definition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2471">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2473"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000345">
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000084"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2207"/>
    <skos:definition xml:lang="en">A scrubber is a separator that cleans gas by washing the gas flow with liquid to remove contaminants such as dust, particles, or undesired substances.</skos:definition>
    <iof-av:firstOrderLogicAxiom xml:lang="en">∀x (Scrubber(x) ↔ Separator(x) ∧ ∃f,p,g,l (SeparationFunction(f) ∧ bearerOf(x,f) ∧ LiquidWashingProcess(p) ∧ participatesIn(x,p) ∧ PortionOfGas(g) ∧ PortionOfLiquid(l) ∧ hasInput(x,g) ∧ hasInput(x,l)))</iof-av:firstOrderLogicAxiom>
    <iof-av:semiFormalNaturalLanguageAxiom xml:lang="en">Every scrubber is a separator that has the function of separation and participates in liquid washing processes with both gas and liquid inputs.</iof-av:semiFormalNaturalLanguageAxiom>
    <rdfs:label xml:lang="en">scrubber</rdfs:label>
    <rdfs:label xml:lang="pt-br">lavador de gases</rdfs:label>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um lavador de gases é um separador que limpa gás através da lavagem do fluxo gasoso com líquido para remover contaminantes como poeira, partículas ou substâncias indesejadas.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="en">A scrubber is a separator that cleans gas by washing the gas flow with liquid to remove contaminants such as dust, particles, or undesired substances.</iof-av:naturalLanguageDefinition>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <iof-av:isPrimitive rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</iof-av:isPrimitive>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/Piston">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://spec.industrialontologies.org/ontology/construct/MaterialArtifact"/>
    <skos:definition xml:lang="en">A material artifact that constitutes a sliding disc or cylinder that moves within a cylindrical bore to compress gas or transmit hydraulic force in petroleum production equipment.</skos:definition>
    <rdfs:label xml:lang="en">piston</rdfs:label>
    <rdfs:label xml:lang="pt-br">pistão</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1547">
    <owl:onProperty rdf:resource="https://spec.industrialontologies.org/ontology/construct/hasSpecifiedOutput"/>
