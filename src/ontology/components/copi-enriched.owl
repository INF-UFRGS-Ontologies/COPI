    <skos:definition xml:lang="en">A planned process in which a discrete switching signal is generated when the flow rate of a process stream crosses a defined threshold.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000529">
    <iof-av:naturalLanguageDefinition xml:lang="en">A DesignedFunction that is realized in a FluidConductionProcess and that consists in conveying a fluid from one point to another through an enclosed conduit.</iof-av:naturalLanguageDefinition>
    <iof-av:naturalLanguageDefinition xml:lang="pt-br">Uma DesignedFunction que é realizada em um FluidConductionProcess e que consiste em conduzir um fluido de um ponto a outro por um conduto fechado.</iof-av:naturalLanguageDefinition>
