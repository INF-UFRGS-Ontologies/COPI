  </rdf:Description>
  <rdf:Description rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1881">
    <rdf:first rdf:resource="https://spec.industrialontologies.org/ontology/construct/EngineeredSystem"/>
    <rdf:rest rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1882"/>
