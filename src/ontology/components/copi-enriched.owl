    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2458"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2456"/>
    <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000635"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b2459"/>
    <rdfs:label xml:lang="en">three phase separation process</rdfs:label>
    <rdfs:label xml:lang="pt-br">processo de separação trifásica</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition xml:lang="en">A separation process in which a mixture of gas, liquid hydrocarbon, and produced water is divided into three distinct phases by gravity and residence time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b1251">
    <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000631"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000529">
