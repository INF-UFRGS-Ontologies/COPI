  <rdf:Description rdf:nodeID="nb16c18e101c44182af9fd62737a336a6b204">
    <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000618"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
