    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:nodeID="n0bdf7dc8f7a94e27b16f376933615bb6b2743"/>
  </rdf:Description>
