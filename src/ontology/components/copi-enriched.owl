  <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/copi/COPI_0000554">
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b797"/>
    <rdfs:subClassOf rdf:nodeID="ne8179f87f39249a5b317c58c25587df2b798"/>
